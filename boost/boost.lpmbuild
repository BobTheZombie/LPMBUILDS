#!/bin/bash
# LPM Linux - Boost C++ Libraries (full headers and shared libraries)
NAME="boost"
VERSION="1.92.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Boost C++ libraries, headers, and CMake package configurations"
URL="https://www.boost.org/"
LICENSE=("BSL-1.0")
SOURCE=(
    "https://archives.boost.io/release/${VERSION}/source/boost_1_92_0.tar.bz2"
)
SHA256SUMS=(
    "5c1d40cb8e19adbf740a4ec2da35b3e58f3f5804b1dce44deb53df72193cbc6c"
)
PATCHES=()
REQUIRES=("glibc")
BUILD_REQUIRES=("gcc")
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=("boost-headers" "boost-libs")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=("zlib" "bzip2" "xz" "zstd" "icu")
SUGGESTS=("python")
BUILD_OPTIONS=("@--optimize=2")

prepare() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    test -f "$src/bootstrap.sh"
    test -f "$src/Jamroot"
    cd "$src"
    # B2 source releases cannot be built with CMake; bootstrap B2 itself.
    # Exclude MPI and Python bindings to avoid mandatory OpenMPI/NumPy dependencies.
    ./bootstrap.sh --with-toolset=gcc --without-icu \
        --without-libraries=mpi,graph_parallel,python \
        --prefix=/usr --libdir=/usr/lib --includedir=/usr/include
}

build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cd "$src"
    ./b2 "-j${LPM_BUILD_JOBS:-$(nproc)}" \
        --layout=system --build-type=minimal \
        variant=release threading=multi link=shared runtime-link=shared \
        --without-mpi --without-graph_parallel --without-python \
        stage
}

staging() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    test -n "${pkgdir:-}" && test "$pkgdir" != / 
    cd "$src"
    # B2 does not use the CMake/Autotools DESTDIR convention. Install into
    # the staging prefix explicitly, then sanitize any absolute stage paths.
    ./b2 "-j${LPM_BUILD_JOBS:-$(nproc)}" \
        --layout=system --build-type=minimal \
        variant=release threading=multi link=shared runtime-link=shared \
        --without-mpi --without-graph_parallel --without-python \
        --prefix="$pkgdir/usr" \
        --libdir="$pkgdir/usr/lib" \
        --includedir="$pkgdir/usr/include" \
        --cmakedir="$pkgdir/usr/lib/cmake" \
        install

    test -f "$pkgdir/usr/include/boost/version.hpp"
    compgen -G "$pkgdir/usr/lib/libboost_filesystem.so*" >/dev/null
    compgen -G "$pkgdir/usr/lib/libboost_regex.so*" >/dev/null
    test -n "$(find "$pkgdir/usr/lib/cmake" -name BoostConfig.cmake -print -quit)"

    # Drop a stage prefix if Boost generated absolute paths in CMake files.
    while IFS= read -r -d '' cmakefile; do
        if grep -Fq -- "$pkgdir" "$cmakefile"; then
            sed -i "s|${pkgdir}||g" "$cmakefile"
        fi
    done < <(find "$pkgdir/usr/lib/cmake" -type f -name '*.cmake' -print0)
    if grep -R -F -q -- "$pkgdir" "$pkgdir/usr/lib/cmake"; then
        echo "ERROR: Boost CMake metadata still contains staged absolute paths" >&2
        return 1
    fi
}
