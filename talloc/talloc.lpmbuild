#!/bin/bash
# LPM build script for talloc

NAME="talloc"
VERSION="2.4.3"
RELEASE="2"
ARCH="${ARCH:-x86_64}"
SUMMARY="Hierarchical pool based memory allocator"
URL="https://www.samba.org/ftp/talloc/"
LICENSE=("GPL-3.0-or-later" "LGPL-3.0-or-later")

SOURCE=(
  "https://download.samba.org/pub/talloc/talloc-${VERSION}.tar.gz"
)

SHA256SUMS=("SKIP")

REQUIRES=(
  "glibc"
  "python"
)

BUILD_REQUIRES=(
  "python"
  "pkgconf"
)

PROVIDES=(
  "talloc"
  "libtalloc.so"
  "pytalloc-util"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  ./configure \
    --prefix=/usr \
    --libdir=/usr/lib

  make -j"$(nproc)"
}

check() {
  true
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  make DESTDIR="$pkgdir" install

  for f in COPYING LICENSE; do
    if [ -f "$f" ]; then
      install -Dm644 "$f" \
        "$pkgdir/usr/share/licenses/$NAME/$f"
    fi
  done
}