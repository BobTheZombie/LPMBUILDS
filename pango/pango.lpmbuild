NAME="pango"
VERSION="1.58.2"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Text layout and rendering library"
URL="https://pango.gnome.org/"
SOURCE=("https://download.gnome.org/sources/pango/${VERSION%.*}/pango-${VERSION}.tar.xz")
LICENSE=("LGPL-2.1-or-later")

REQUIRES=(
    "glib2" 
    "cairo" 
    "harfbuzz" 
    "freetype" 
    "fontconfig" 
    "fribidi"
)

BUILD_REQUIRES=(
    "fontconfig"
)

PROVIDES=("pango" "libpango-1.0.so")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/pango-${VERSION}"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/pango-${VERSION}"
    meson setup build \
  --prefix=/usr \
  --libdir=lib \
  --buildtype=release \
  --wrap-mode=nofallback \
  -Dintrospection=enabled
    ninja -C build -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/pango-${VERSION}"
    DESTDIR="$pkgdir" ninja -C build install
}

# Final audited source digests
SHA256SUMS=("f138f964a8390c8aecc6c79dc18756989cc2d4db624b12f94a01a92ec57111ff")
