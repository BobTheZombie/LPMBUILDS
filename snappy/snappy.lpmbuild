#!/bin/bash

NAME="snappy"
VERSION="1.3.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"

SUMMARY="Google Snappy fast compression and decompression library"
URL="https://github.com/google/snappy"
LICENSE=("BSD-3-Clause")

SOURCE=(
    "${NAME}-${VERSION}::git+https://github.com/google/snappy.git#tag=${VERSION}"
)
SHA256SUMS=()
PATCHES=()

REQUIRES=(
    "glibc"
)
BUILD_REQUIRES=(
    "cmake"
    "gcc"
    "ninja"
    "pkgconf"
)
PROVIDES=(
    "snappy"
    "libsnappy.so"
)
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    test -f CMakeLists.txt
    test -f snappy.h
    rm -rf build
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
        -DBUILD_SHARED_LIBS=ON \
        -DSNAPPY_INSTALL=ON \
        -DSNAPPY_BUILD_TESTS=OFF \
        -DSNAPPY_BUILD_BENCHMARKS=OFF \
        -DSNAPPY_FUZZING_BUILD=OFF

    cmake --build build --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    DESTDIR="$pkgdir" cmake --install build

    test -f "$pkgdir/usr/include/snappy.h"
    test -f "$pkgdir/usr/lib/cmake/Snappy/SnappyConfig.cmake"
    compgen -G "$pkgdir/usr/lib/libsnappy.so*" > /dev/null

    if [ -f COPYING ]; then
        install -Dm644 COPYING "$pkgdir/usr/share/licenses/$NAME/COPYING"
    elif [ -f LICENSE ]; then
        install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$NAME/LICENSE"
    fi
}
