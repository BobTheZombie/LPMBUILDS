#!/bin/bash
# LPM build script for xwud

NAME="xwud"
VERSION="1.0.8"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Display an X window dump image"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=("https://www.x.org/archive//individual/app/${NAME}-${VERSION}.tar.xz")
        
REQUIRES=(
  "glibc"
  "libX11"
  "libXaw"
  "libXmu"
)

PROVIDES=("xwud")
CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  ./configure --prefix=/usr
  make -j"$(nproc)"
}

check() { true; }

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  DESTDIR="$pkgdir" make install
}




# Final audited source digests
SHA256SUMS=("2e282648c34018fd870052b8d814ea4d35ad9fdb9bcfc8bdc5a06822c0f86e99")
