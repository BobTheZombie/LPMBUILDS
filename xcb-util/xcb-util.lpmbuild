#!/bin/bash
# LPM build script for xcb-util
# Core utility functions for XCB

NAME="xcb-util"
VERSION="0.4.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Additional utility libraries for XCB"
URL="https://xcb.freedesktop.org/"
LICENSE="MIT"

SOURCE=(
  "https://www.x.org/releases/individual/lib/${NAME}-${VERSION}.tar.xz"
)

REQUIRES=(
  "glibc"
  "libxcb"
  "pkg-config"
  "util-macros"
  "xorgproto"
  "autoconf"
  "automake"
  "libtool"
  "make"
)

PROVIDES=(
  "xcb-util"
  "libxcb-util.so"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
    set -euxo pipefail
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    : "${CC:=cc}"

    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --disable-static

    make -j"$(nproc)"
}

check() {
    # Tests are trivial, but rarely shipped — skip
    true
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"
    DESTDIR="$pkgdir" make install

    # License
    if [ -f COPYING ]; then
        install -Dm644 COPYING "$pkgdir/usr/share/licenses/$NAME/COPYING"
    fi

    # Strip ELF
    if command -v strip >/dev/null 2>&1; then
        find "$pkgdir/usr" -type f -exec sh -c '
            case "$(file -b "$1")" in
              *ELF*shared\ object*|*ELF*executable*)
                strip --strip-unneeded "$1" 2>/dev/null || true
              ;;
            esac
        ' _ {} \;
    fi
}
