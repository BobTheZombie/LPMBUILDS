#!/bin/bash
NAME="libXaw"
VERSION="1.0.16"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="libXaw from X.Org"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=(
  "https://www.x.org/releases/individual/lib/${NAME}-${VERSION}.tar.xz"
)

REQUIRES=(
  "glibc"
  "libX11"
  "libXt"
  "libXmu"
  "libXpm"
)

PROVIDES=("libXaw")
CONFLICTS=()
OBSOLETES=("libxaw")

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  ./configure --prefix=/usr
  make -j"$(nproc)"
}

check() { true; }

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  DESTDIR="$pkgdir" make install
  [ -f COPYING ] && install -Dm644 COPYING "$pkgdir/usr/share/licenses/$NAME/COPYING"
}




# Final audited source digests
SHA256SUMS=("731d572b54c708f81e197a6afa8016918e2e06dfd3025e066ca642a5b8c39c8f")
