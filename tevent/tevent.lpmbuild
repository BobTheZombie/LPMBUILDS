#!/bin/bash
# LPM build script for tevent

NAME="tevent"
VERSION="0.16.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Event system based on talloc"
URL="https://www.samba.org/"
LICENSE=("GPL-3.0-or-later")

SOURCE=(
  "https://download.samba.org/pub/tevent/tevent-${VERSION}.tar.gz"
)

SHA256SUMS=("SKIP")

REQUIRES=(
  "glibc"
  "talloc"
)

BUILD_REQUIRES=(
  "python"
  "pkgconf"
  "talloc"
)

PROVIDES=(
  "tevent"
  "libtevent.so"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  ./configure \
    --prefix=/usr \
    --libdir=/usr/lib

  make -j"$(nproc)"
}

check() {
  true
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  make DESTDIR="$pkgdir" install

  test -f "$pkgdir/usr/lib/libtevent.so"

  for f in COPYING LICENSE; do
    if [ -f "$f" ]; then
      install -Dm644 "$f" \
        "$pkgdir/usr/share/licenses/$NAME/$f"
    fi
  done
}
