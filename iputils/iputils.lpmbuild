#!/bin/bash
# LPM networking stack, release snapshot 2026-10-16
NAME="iputils"
VERSION="20250605"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY='IPv4 IPv6 ping arping and tracepath tools'
URL=https://github.com/iputils/iputils/releases/download/20250605/iputils-20250605.tar.xz
LICENSE=(GPL-2.0-or-later)
SOURCE=(https://github.com/iputils/iputils/releases/download/20250605/iputils-20250605.tar.xz)
SHA256SUMS=(
    "6f213700dbf96b5cc4499ca70cb15ecd69c09f405b06785bb4a1a10b572b6276"
)
PATCHES=()
REQUIRES=(glibc libcap libidn2)
BUILD_REQUIRES=(gcc meson ninja pkgconf gettext libcap libidn2)
PROVIDES=(iputils)
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
BUILD_OPTIONS=(@--stripping @--optimize=2)

_source() {
    if [ ! -d "$SRCROOT/${NAME}-${VERSION}" ] && [ -d "$SRCROOT/iputils-20250605" ]; then
        mv "$SRCROOT/iputils-20250605" "$SRCROOT/${NAME}-${VERSION}"
    fi
}

_licenses() {
    local f
    for f in COPYING COPYING.LIB LICENSE LICENSE.txt LICENCE README; do
        if [ -f "$f" ]; then
            install -Dm644 "$f" "$pkgdir/usr/share/licenses/$NAME/$(basename "$f")"
        fi
    done
}
_cleanup() {
    if [ -d "$pkgdir/usr/lib" ]; then
        find "$pkgdir/usr/lib" -type f \( -name '*.a' -o -name '*.la' \) -delete
    fi
    rm -f "$pkgdir/usr/share/info/dir"
}

prepare() { set -euxo pipefail; _source; cd "$SRCROOT/${NAME}-${VERSION}"; rm -rf _build; }
build() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    meson setup _build --prefix=/usr --bindir=bin --sbindir=bin --libdir=lib \
        --buildtype=release --wrap-mode=nodownload -DBUILD_MANS=false \
        -DBUILD_HTML_MANS=false -DSKIP_TESTS=true -DNO_SETCAP_OR_SUID=true
    meson compile -C _build -j "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    meson install -C _build --no-rebuild --destdir "$pkgdir"
    test -x "$pkgdir/usr/bin/ping"
    test -x "$pkgdir/usr/bin/tracepath"
    _licenses
}





# Final audited source digests
SHA256SUMS=("6f213700dbf96b5cc4499ca70cb15ecd69c09f405b06785bb4a1a10b572b6276")
