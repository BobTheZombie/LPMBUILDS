#!/bin/bash
# LPM Linux diagnostics for KDE KInfoCenter
NAME="wayland-utils"
VERSION="1.3.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Wayland protocol information utility"
URL="https://gitlab.freedesktop.org/wayland/wayland-utils"
LICENSE=("MIT")
SOURCE=("https://gitlab.freedesktop.org/wayland/wayland-utils/-/releases/1.3.0/downloads/wayland-utils-1.3.0.tar.xz")
SHA256SUMS=("a39d0e65617c6ae186d768c223f57060a3a435f6f9f02d03074f945313bfcf0d")
PATCHES=()
REQUIRES=("wayland")
BUILD_REQUIRES=("meson" "ninja" "pkgconf" "wayland" "wayland-protocols")
PROVIDES=("wayland-info")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/$NAME-$VERSION/meson.build"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    meson setup "$src/build" "$src" --prefix=/usr --libdir=lib --buildtype=release
        meson compile -C "$src/build" -j "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    DESTDIR="$pkgdir" meson install -C "$src/build" --no-rebuild
        test -x "$pkgdir/usr/bin/wayland-info"
}
