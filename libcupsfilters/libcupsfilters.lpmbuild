#!/bin/bash
# LPM Linux - OpenPrinting libcupsfilters 2.1.2
# Poppler-free, QPDF-based; JPEG XL enabled; Ghostscript PDF processing.
NAME="libcupsfilters"
VERSION="2.1.2"
RELEASE="2"
ARCH="${ARCH:-x86_64}"
SUMMARY="OpenPrinting filter library for CUPS 2.x"
URL="https://github.com/OpenPrinting/libcupsfilters"
LICENSE=("Apache-2.0 WITH LLVM-exception")
SOURCE=("https://github.com/OpenPrinting/libcupsfilters/releases/download/${VERSION}/libcupsfilters-${VERSION}.tar.xz")
SHA256SUMS=("cd1f0003af7cc35beeb4e7b13cb4392b53b9885684bd8b60099036ef0587e54f")
PATCHES=()

REQUIRES=(
    "glibc" "gcc-libs" "libcups" "glib2" "dbus" "lcms2" "qpdf"
    "fontconfig" "zlib" "libjxl" "libpng" "libjpeg-turbo"
    "libtiff" "libexif" "ghostscript"
)
BUILD_REQUIRES=(
    "gcc" "make" "pkgconf" "libcups" "glib2" "dbus" "lcms2"
    "qpdf" "fontconfig" "ghostscript" "gettext" "libpng"
    "libjpeg-turbo" "libtiff" "libexif" "libjxl"
)
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=("libcupsfilters" "libcupsfilters.so.2")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=("mutool" "mupdf-tools" "pdfio" "poppler")

prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/$NAME-$VERSION/configure"
}

build() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    cd "$src"
    command -v gs >/dev/null

    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --disable-static \
        --disable-poppler \
        --disable-mutool \
        --enable-ghostscript \
        --with-jpegxl=yes \
        --docdir="/usr/share/doc/libcupsfilters-$VERSION"

    make -j"${LPM_BUILD_JOBS:-$(nproc)}"
}

check() {
    set -euo pipefail
    test -f "$SRCROOT/$NAME-$VERSION/Makefile"
}

staging() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    make -C "$src" DESTDIR="$pkgdir" install
    test -e "$pkgdir/usr/lib/libcupsfilters.so.2" || \
        test -e "$pkgdir/usr/lib/libcupsfilters.so"
    test -d "$pkgdir/usr/include/cupsfilters"
    test -f "$pkgdir/usr/lib/pkgconfig/libcupsfilters.pc"

    if [[ -f "$src/LICENSE" ]]; then
        install -Dm644 "$src/LICENSE" "$pkgdir/usr/share/licenses/libcupsfilters/LICENSE"
    fi
}