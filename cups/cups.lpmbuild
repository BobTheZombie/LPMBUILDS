#!/bin/bash
# LPM Linux - OpenPrinting CUPS 2.4.20 daemon package (libcups split).
# LPM extracts to $SRCROOT/$NAME-$VERSION; libcups is packaged separately.
NAME="cups"
VERSION="2.4.20"
RELEASE="4"
ARCH="${ARCH:-x86_64}"
SUMMARY="OpenPrinting CUPS scheduler, spooler, filters, backends and printing tools"
URL="https://openprinting.github.io/cups/"
LICENSE=("Apache-2.0 WITH LLVM-exception" "BSD-3-Clause" "BSD-2-Clause" "Zlib")
SOURCE=("https://github.com/OpenPrinting/cups/releases/download/v${VERSION}/cups-${VERSION}-source.tar.gz")
SHA256SUMS=("ab4d9cd7f3e58060091d2b24972223d6401675f11c49b65abf4f6ef31dea22ff")
PATCHES=()

REQUIRES=(
    "libcups>=2.4.20" "glibc" "gnutls" "zlib" "acl" "avahi"
    "dbus" "pam" "systemd" "systemd-libs" "libpaper"
    "hicolor-icon-theme" "cups-filters"
)
BUILD_REQUIRES=(
    "gcc" "make" "pkgconf" "gnutls" "zlib" "acl" "avahi"
    "dbus" "pam" "systemd" "systemd-libs" "libpaper"
    "libusb" "libcups>=2.4.20"
)
PROVIDES=("cups")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=("xdg-utils" "logrotate")
SUGGESTS=("cups-browsed" "colord" "ipp-usb")

_srcdir() {
    local src="$SRCROOT/$NAME-$VERSION"
    if [[ ! -f "$src/configure" || ! -f "$src/Makefile" || ! -d "$src/scheduler" ]]; then
        printf '[ERROR] CUPS source not found at %s\n' "$src" >&2
        return 1
    fi
    printf '%s\n' "$src"
}

prepare() {
    set -euxo pipefail
    local src
    src="$(_srcdir)"
    test -f "$src/LICENSE"
    test -f "$src/cups/Makefile"
}

build() {
    set -euxo pipefail
    local src
    src="$(_srcdir)"
    cd "$src"

    # Client library is split to the independent libcups package.
    ./configure \
        --prefix=/usr \
        --sbindir=/usr/bin \
        --libdir=/usr/lib \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --with-cachedir=/var/cache/cups \
        --with-logdir=/var/log/cups \
        --with-rundir=/run/cups \
        --with-docdir=/usr/share/cups/doc \
        --with-pkgconfpath=/usr/lib/pkgconfig \
        --with-dbusdir=/usr/share/dbus-1 \
        --with-systemd=/usr/lib/systemd/system \
        --with-ondemand=systemd \
        --with-cups-user=209 \
        --with-cups-group=209 \
        --with-system-groups=lpadmin \
        --with-tls=gnutls \
        --with-dnssd=avahi \
        --enable-pam \
        --enable-dbus \
        --enable-libpaper \
        --enable-libusb \
        --disable-static

    make -j"${LPM_BUILD_JOBS:-$(nproc)}"
}

check() {
    set -euo pipefail
    local src
    src="$(_srcdir)"
    # Full upstream test suite exercises a live print service; verify build outputs.
    test -x "$src/scheduler/cupsd"
}

staging() {
    set -euxo pipefail
    local src
    src="$(_srcdir)"
    test -n "${pkgdir:-}"
    mkdir -p "$pkgdir"

    # CRITICAL: install-data + install-exec must run from the top-level tree.
    # The old cups/ install-headers/install-libs target staged only libcups,
    # leaving cupsd, filter backends, units, and cups.pc missing.
    env -u DSTROOT -u DESTDIR \
        make -C "$src" BUILDROOT="$pkgdir" install-data install-exec

    # The client-development interface belongs to the separate libcups package.
    rm -f "$pkgdir/usr/bin/cups-config" \
          "$pkgdir/usr/lib/libcups.so" "$pkgdir/usr/lib/libcups.so.2" \
          "$pkgdir/usr/lib/libcupsimage.so" "$pkgdir/usr/lib/libcupsimage.so.2" \
          "$pkgdir/usr/lib/libcups.a" "$pkgdir/usr/lib/libcupsimage.a"
    rm -rf "$pkgdir/usr/include/cups"

    # Ensure the fixed UID/GID is provisioned by sysusers during installation.
    # Verify numeric ID 209 is not allocated to an unrelated account in LPM.
    install -Dm644 /dev/stdin "$pkgdir/usr/lib/sysusers.d/cups.conf" <<'SYSUSERS'
# Dedicated CUPS service account, UID/GID 209.
g lp -
g lpadmin -
u cups 209 "CUPS printing service"
m cups lp
SYSUSERS

    install -Dm644 /dev/stdin "$pkgdir/usr/lib/tmpfiles.d/cups.conf" <<'TMPFILES'
# sysusers must run before tmpfiles.
d /run/cups             0755 root root -
d /var/cache/cups       0755 root cups -
d /var/cache/cups/rss   0755 root cups -
d /var/log/cups         0755 root cups -
d /var/spool/cups       0710 root cups -
d /var/spool/cups/tmp   1770 root cups -
TMPFILES

    install -Dm644 /dev/stdin "$pkgdir/etc/pam.d/cups" <<'PAMCONF'
auth       required    pam_unix.so
account    required    pam_unix.so
session    required    pam_unix.so
PAMCONF

    install -Dm644 /dev/stdin "$pkgdir/etc/logrotate.d/cups" <<'LOGROTATE'
/var/log/cups/*_log {
    missingok
    notifempty
    sharedscripts
}
LOGROTATE

    # Use a single log rotation policy and make sure CUPS uses numeric IDs.
    local config
    for config in "$pkgdir/etc/cups/cupsd.conf" "$pkgdir/etc/cups/cupsd.conf.default"; do
        if [[ -f "$config" ]]; then
            if grep -Eq '^[[:space:]#]*MaxLogSize[[:space:]]' "$config"; then
                sed -i -E 's/^[[:space:]#]*MaxLogSize[[:space:]].*$/MaxLogSize 0/' "$config"
            else
                printf '\nMaxLogSize 0\n' >> "$config"
            fi
        fi
    done
    for config in "$pkgdir/etc/cups/cups-files.conf" "$pkgdir/etc/cups/cups-files.conf.default"; do
        if [[ -f "$config" ]]; then
            sed -i -E \
                -e 's/^[[:space:]#]*User[[:space:]]+209[[:space:]]*$/User 209/' \
                -e 's/^[[:space:]#]*Group[[:space:]]+209[[:space:]]*$/Group 209/' \
                "$config"
        fi
    done

    # No SysV payload; retain unit files for systemd (and Lilly compatibility).
    rm -rf "$pkgdir/etc/init.d"
    find "$pkgdir/etc" -maxdepth 1 -type d -name 'rc*.d' -exec rm -rf -- {} + 2>/dev/null || :
    rm -rf "$pkgdir/run"

    install -Dm644 "$src/LICENSE" "$pkgdir/usr/share/licenses/cups/LICENSE"
    if [[ -f "$src/NOTICE" ]]; then
        install -Dm644 "$src/NOTICE" "$pkgdir/usr/share/licenses/cups/NOTICE"
    fi

    test -x "$pkgdir/usr/bin/cupsd"
    test -d "$pkgdir/usr/lib/cups"
    test -f "$pkgdir/usr/lib/pkgconfig/cups.pc"
    test -f "$pkgdir/usr/lib/sysusers.d/cups.conf"
    test -f "$pkgdir/usr/lib/tmpfiles.d/cups.conf"
    test -f "$pkgdir/etc/pam.d/cups"
    test -f "$pkgdir/etc/logrotate.d/cups"
    test -f "$pkgdir/usr/lib/systemd/system/cups.service"
    test -f "$pkgdir/usr/lib/systemd/system/cups.socket"
    test -f "$pkgdir/usr/lib/systemd/system/cups.path"
    test ! -e "$pkgdir/usr/bin/cups-config"
    test ! -e "$pkgdir/usr/lib/libcups.so.2"
    echo '[OK] CUPS scheduler/daemon package staged (libcups kept separate)'
}