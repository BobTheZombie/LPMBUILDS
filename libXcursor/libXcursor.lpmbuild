#!/bin/bash
NAME="libXcursor"
VERSION="1.2.2"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="libXcursor from X.Org"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=(
  "https://www.x.org/releases/individual/lib/${NAME}-${VERSION}.tar.xz"
)

REQUIRES=(
  "glibc"
  "util-macros"
  "libX11"
  "libXfixes"
  "libXrender"
  "libpng"
)

PROVIDES=("libXcursor")
CONFLICTS=()
OBSOLETES=("libxcursor")

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  ./configure --prefix=/usr
  make -j"$(nproc)"
}

check() { true; }

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  DESTDIR="$pkgdir" make install
  [ -f COPYING ] && install -Dm644 COPYING "$pkgdir/usr/share/licenses/$NAME/COPYING"
}
