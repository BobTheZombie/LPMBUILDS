NAME="bison"
VERSION="3.8.2"
RELEASE="1"
ARCH="x86_64"
SUMMARY="GNU parser generator"
URL="https://www.gnu.org/software/bison/"
SOURCE=("https://ftp.wayne.edu/gnu/bison/bison-${VERSION}.tar.xz")
LICENSE=("GPL-3.0-or-later")

REQUIRES=(
  "m4" 
  "flex"
  )
  
PROVIDES=("bison")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/bison-${VERSION}"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/bison-${VERSION}"
    ./configure --prefix=/usr --libdir=/usr/lib
    make -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/bison-${VERSION}"
    make DESTDIR="$pkgdir" install
}





# Final audited source digests
SHA256SUMS=("9bba0214ccf7f1079c5d59210045227bcf619519840ebfa80cd3849cff5a5bf2")
