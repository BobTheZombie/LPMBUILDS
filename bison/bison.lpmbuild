#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="bison"
VERSION="3.8.2"
RELEASE="2"
ARCH="${ARCH:-x86_64}"
SUMMARY="GNU parser generator"
URL="https://ftpmirror.gnu.org/bison/bison-3.8.2.tar.xz"
LICENSE=("GPL-3.0-or-later")
SOURCE=("https://ftpmirror.gnu.org/bison/bison-3.8.2.tar.xz")
SHA256SUMS=("9bba0214ccf7f1079c5d59210045227bcf619519840ebfa80cd3849cff5a5bf2")
PATCHES=()
REQUIRES=("glibc" "m4")
BUILD_REQUIRES=("gcc" "make" "pkgconf")
PROVIDES=("bison")
CONFLICTS=()
OBSOLETES=()

_srcdir="bison-3.8.2"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    :
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    ./configure --prefix=/usr
    make -j"${JOBS:-$(nproc)}"
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    make DESTDIR="$pkgdir" install

    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
