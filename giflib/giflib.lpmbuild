#!/bin/bash
# LPM Linux - giflib 6.1.3

NAME="giflib"
VERSION="6.1.3"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="GIF image library and utilities"
URL="https://giflib.sourceforge.net/"
LICENSE=("MIT")

SOURCE=(
    "https://downloads.sourceforge.net/project/giflib/giflib-6.x/giflib-${VERSION}.tar.gz"
)

SHA256SUMS=(
    "b65b66b99f0424b93525f987386f22fc5efb9da2bfc92ad4a532249aaffbab0e"
)

PATCHES=()

REQUIRES=("glibc")
BUILD_REQUIRES=("gcc" "make")
REQUIRES_PYTHON_DEPENDENCIES=()

PROVIDES=("giflib")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/$NAME-$VERSION/Makefile"
}

build() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"

    make -C "$src" -j"${LPM_BUILD_JOBS:-$(nproc)}"
}

check() {
    set -euxo pipefail
    make -C "$SRCROOT/$NAME-$VERSION" check
}

staging() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"

    make -C "$src" \
        PREFIX=/usr \
        LIBDIR=/usr/lib \
        DOCDIR="/usr/share/doc/giflib-$VERSION" \
        DESTDIR="$pkgdir" \
        install

    rm -f "$pkgdir/usr/lib/libgif.a"

    test -e "$pkgdir/usr/lib/libgif.so"
    test -f "$pkgdir/usr/include/gif_lib.h"
}