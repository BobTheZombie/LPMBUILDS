# LPM build script for alsa-utils
NAME="alsa-utils"
VERSION="1.2.16"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Utilities for the ALSA sound architecture"
URL="https://www.alsa-project.org/"
LICENSE="GPL-2.0-or-later"
SOURCE=("https://www.alsa-project.org/files/pub/utils/alsa-utils-${VERSION}.tar.bz2")
CHECKSUMS=("092399d5e8749a1d5e188e393157521cec4b75693b60ebb79bbce728cff2232c")
REQUIRES=("glibc" "alsa-lib" "ncurses" "systemd" "xmlto" "docbook-xml")
PROVIDES=("alsa-utils")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() { set -euxo pipefail; 
cd "$SRCROOT"; 
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/${NAME}-${VERSION}"
  ./configure --prefix=/usr --sysconfdir=/etc --disable-alsa-ucm-tests --disable-xmlto --with-udev-rules-dir=/usr/lib/udev/rules.d
  make -j"$(nproc)"
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/${NAME}-${VERSION}"
  make DESTDIR="$pkgdir" install
}




# Final audited source digests
SHA256SUMS=("092399d5e8749a1d5e188e393157521cec4b75693b60ebb79bbce728cff2232c")
