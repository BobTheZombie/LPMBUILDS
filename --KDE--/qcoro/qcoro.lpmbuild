#!/bin/bash
NAME="qcoro"
VERSION="0.13.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="C++20 coroutine support library for Qt6"
URL="https://qcoro.dev/"
LICENSE=("MIT")
SOURCE=("https://github.com/danvratil/qcoro/archive/v${VERSION}/qcoro-${VERSION}.tar.gz")
SHA256SUMS=("SKIP") # TODO: verify/pin source digest
PATCHES=()
REQUIRES=("qt6-base" "qt6-declarative")
BUILD_REQUIRES=("cmake" "ninja" "qt6-base" "qt6-declarative")
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=("qcoro6")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja         -DCMAKE_BUILD_TYPE=Release         -DCMAKE_INSTALL_PREFIX=/usr         -DCMAKE_INSTALL_LIBDIR=lib         -DUSE_QT_VERSION=6         -DBUILD_SHARED_LIBS=ON         -DBUILD_TESTING=OFF         -DQCORO_BUILD_EXAMPLES=OFF         -DQCORO_BUILD_TESTING=OFF         -DQCORO_WITH_QTWEBSOCKETS=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -f "$pkgdir/usr/lib/cmake/QCoro6/QCoro6Config.cmake"
}
