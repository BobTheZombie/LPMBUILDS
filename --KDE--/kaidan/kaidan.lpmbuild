#!/bin/bash
# LPM Linux KDE app - pin upstream tarball SHA256.
# Source-specific features and full dependencies require chroot validation.
NAME="kaidan"
VERSION="0.16.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE XMPP instant messaging client (upstream unstable archive)"
URL="https://apps.kde.org/kaidan/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/unstable/kaidan/${VERSION}/kaidan-${VERSION}.tar.xz")
SHA256SUMS=("b38a64c7b7524a32dffe08eeda034f76d3597a84d8f7afd25c658dab43fb074d")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "qt6-declarative"
    "qt6-multimedia"
    "qt6-location"
    "qt6-svg"
    "qxmpp"
    "qt6keychain"
    "kirigami6"
    "kirigami-addons"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "qt6-declarative"
    "qt6-multimedia"
    "qt6-location"
    "qt6-svg"
    "qxmpp"
    "qt6keychain"
    "kirigami6"
    "kirigami-addons"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
