#!/bin/bash
# KDE Gear 26.08.2: Qt6 build provides KExiv2Qt6 CMake package.
NAME="libkexiv2"
VERSION="26.08.2"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE Qt6 wrapper for Exiv2 image and wallpaper metadata"
URL="https://invent.kde.org/graphics/libkexiv2"
LICENSE=("BSD-3-Clause" "GPL-2.0-or-later")
SOURCE=("https://download.kde.org/stable/release-service/${VERSION}/src/libkexiv2-${VERSION}.tar.xz")
SHA256SUMS=("a0492337374ae19d9fa73a605451ba10536cfbf53108af7e9bf77defbe7bcd00")
PATCHES=()
REQUIRES=("glibc" "qt6-base" "exiv2")
BUILD_REQUIRES=("cmake" "ninja" "pkgconf" "extra-cmake-modules" "qt6-base" "exiv2")
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=("KExiv2Qt6" "libkexiv2-qt6")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        "-DCMAKE_JOB_POOLS=lpm_compile=${LPM_BUILD_JOBS:-6};lpm_link=${LPM_LINK_JOBS:-1}" \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DKDE_INSTALL_LIBDIR=lib \
        -DQT_MAJOR_VERSION=6 \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -f "$pkgdir/usr/lib/cmake/KExiv2Qt6/KExiv2Qt6Config.cmake"
    test -n "$(find "$pkgdir/usr/lib" -name 'libKExiv2Qt6.so*' -print -quit)"
}
