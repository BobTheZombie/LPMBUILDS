#!/bin/bash
# LPM Linux - independently released KDE application
# Source checksum pinned; runtime/build dependencies need LPM chroot testing.
NAME="gcompris"
VERSION="26.2"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE educational activities for children"
URL="https://apps.kde.org/gcompris/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/gcompris/qt/src/gcompris-qt-${VERSION}.tar.xz")
SHA256SUMS=("f876239f39397f554006f4218a3c229627e2af4317a8765ecf9462f0058dfcb4")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "qt6-declarative"
    "qt6-svg"
    "qt6-multimedia"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "qt6-declarative"
    "qt6-svg"
    "qt6-multimedia"
    "qt6-shadertools"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
