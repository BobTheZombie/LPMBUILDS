#!/bin/bash
# LPM Linux - KDE independently versioned application
# SHA256 pinned; full dependency closure requires chroot validation.
NAME="ruqola"
VERSION="2.9.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE Rocket.Chat desktop client"
URL="https://apps.kde.org/ruqola/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/ruqola/ruqola-${VERSION}.tar.xz")
SHA256SUMS=("6a09591cdbe2a1c5be364ed8e2ad457d48f86757fbb6c9c96bf44d8eecfe6ad5")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "qt6-declarative"
    "qt6-webengine"
    "kconfig6"
    "kcoreaddons6"
    "ki18n6"
    "kio6"
    "kirigami6"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "qt6-declarative"
    "qt6-webengine"
    "kconfig6"
    "kcoreaddons6"
    "ki18n6"
    "kio6"
    "kirigami6"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
