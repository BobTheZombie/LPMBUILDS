
#!/bin/bash
# LPM Linux - Qt Quick Timeline 6.12.0
# Qt Quick Timeline and BlendTrees for Qt Quick 3D.

NAME="qt6-quicktimeline"
VERSION="6.12.0"
BASE="${VERSION%.*}"
RELEASE="2"
ARCH="${ARCH:-x86_64}"

SUMMARY="Qt 6 keyframe-based animation and timeline framework"
URL="https://www.qt.io/"
LICENSE=("LGPL-3.0-only" "GPL-3.0-only WITH Qt-GPL-exception-1.0")

SOURCE=(
    "https://download.qt.io/archive/qt/${BASE}/${VERSION}/submodules/qtquicktimeline-everywhere-src-${VERSION}.tar.xz"
)

SHA256SUMS=(
    "6919153c841478c113f0ad20526f40e606590968334762ec6ccbc96002f8da19"
)

PATCHES=()

REQUIRES=(
    "qt6-base"
    "qt6-declarative"
)

BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "python"
    "qt6-base"
    "qt6-declarative"
)

REQUIRES_PYTHON_DEPENDENCIES=()

PROVIDES=("qtquicktimeline")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail

    local src="$SRCROOT/$NAME-$VERSION"
    local upstream="$SRCROOT/qtquicktimeline-everywhere-src-$VERSION"

    if [[ ! -f "$src/CMakeLists.txt" &&
          -f "$upstream/CMakeLists.txt" ]]; then
        mv "$upstream" "$src"
    fi

    if [[ ! -f "$src/CMakeLists.txt" ]]; then
        echo "[ERROR] Qt Quick Timeline source tree missing" >&2
        return 1
    fi

    # Avoid reusing a silently skipped CMake configuration.
    rm -rf "$src/build" "$src/.lpm-prereq"
}

build() {
    set -euxo pipefail

    local src="$SRCROOT/$NAME-$VERSION"
    local builddir="$src/build"
    local prereq="$src/.lpm-prereq"

    mkdir -p "$prereq"

    # Unquoted heredoc expands VERSION before CMake runs.
    cat > "$prereq/CMakeLists.txt" <<CMAKE
cmake_minimum_required(VERSION 3.22)
project(LPMQtQuickTimelinePrerequisites LANGUAGES CXX)

find_package(Qt6 ${VERSION} EXACT CONFIG REQUIRED
    COMPONENTS Core Quick)

if(NOT TARGET Qt6::Quick)
    message(FATAL_ERROR "Qt6::Quick unavailable; rebuild qt6-declarative")
endif()
CMAKE

    cmake -S "$prereq" -B "$prereq/build" -G Ninja \
        -DCMAKE_PREFIX_PATH=/usr

    rm -rf "$prereq"

    cmake -S "$src" -B "$builddir" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_PREFIX_PATH=/usr \
        -DQT_BUILD_TESTS=OFF \
        -DQT_BUILD_EXAMPLES=OFF \
        -DBUILD_TESTING=OFF \
        -DBUILD_SHARED_LIBS=ON

    if [[ ! -f "$builddir/build.ninja" ]] || \
       ! grep -q 'libQt6QuickTimeline\.so' "$builddir/build.ninja"; then
        echo "[ERROR] Qt Quick Timeline targets not generated" >&2
        echo "[ERROR] Check Qt Quick and CBOR support" >&2
        return 1
    fi

    cmake --build "$builddir" \
        --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail

    local builddir="$SRCROOT/$NAME-$VERSION/build"

    DESTDIR="$pkgdir" cmake --install "$builddir"

    if [[ ! -d "$pkgdir/usr/lib" ]]; then
        echo "[ERROR] Qt Quick Timeline staged no libraries" >&2
        return 1
    fi

    local component

    for component in QuickTimeline QuickTimelineBlendTrees; do
        if ! find "$pkgdir/usr/lib" -maxdepth 1 -type f \
            -name "libQt6${component}.so.*" \
            -print -quit | grep -q .; then
            echo "[ERROR] Missing libQt6${component}" >&2
            return 1
        fi

        if [[ ! -f "$pkgdir/usr/lib/cmake/Qt6${component}/Qt6${component}Config.cmake" ]]; then
            echo "[ERROR] Missing Qt6${component} CMake config" >&2
            return 1
        fi
    done

    if [[ ! -f "$pkgdir/usr/lib/qt6/qml/QtQuick/Timeline/qmldir" ]]; then
        echo "[ERROR] Missing QtQuick.Timeline QML module" >&2
        return 1
    fi

    if [[ ! -f "$pkgdir/usr/lib/qt6/qml/QtQuick/Timeline/BlendTrees/qmldir" ]]; then
        echo "[ERROR] Missing Timeline.BlendTrees QML module" >&2
        return 1
    fi

    echo "[OK] Qt Quick Timeline $VERSION staged successfully"
}
