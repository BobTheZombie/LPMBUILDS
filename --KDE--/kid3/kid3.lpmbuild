#!/bin/bash
# LPM Linux - independently released KDE application
# Source checksum pinned; runtime/build dependencies need LPM chroot testing.
NAME="kid3"
VERSION="3.10.2"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE audio metadata and tag editor"
URL="https://apps.kde.org/kid3/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/kid3/${VERSION}/kid3-${VERSION}.tar.xz")
SHA256SUMS=("ce776b87de4f7f35cc5223bc85c16c76c2afb9298b1a73fa795738be165037bb")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "qt6-declarative"
    "qt6-multimedia"
    "taglib"
    "kconfig6"
    "ki18n6"
    "kio6"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "qt6-declarative"
    "qt6-multimedia"
    "taglib"
    "kconfig6"
    "ki18n6"
    "kio6"
    "gettext"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
