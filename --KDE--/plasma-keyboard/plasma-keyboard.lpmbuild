#!/bin/bash
# LPM Linux - plasma-keyboard 6.8.1
# Verified upstream release archive. LPM normalizes to $SRCROOT/$NAME-$VERSION.
NAME="plasma-keyboard"
VERSION="6.8.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE Plasma Wayland on-screen keyboard, layouts and settings module"
URL="https://invent.kde.org/plasma/plasma-keyboard"
LICENSE=("GPL-2.0-or-later" "LGPL-2.1-or-later")
SOURCE=("https://download.kde.org/stable/plasma/${VERSION}/${NAME}-${VERSION}.tar.xz")
SHA256SUMS=("5a1ecd3e9737b2f5d2eccd6d40e6b90d849905b97195ac11b72c961c8f824700")
PATCHES=()
REQUIRES=("qt6-base" "qt6-declarative" "qt6-virtualkeyboard" "qt6-wayland" "kconfig6" "kcoreaddons6" "kcrash6" "ki18n6" "kcmutils6" "libplasma" "libxkbcommon" "wayland" "wayland-protocols")
BUILD_REQUIRES=("cmake" "ninja" "pkgconf" "extra-cmake-modules" "qt6-base" "qt6-declarative" "qt6-virtualkeyboard" "qt6-wayland" "kconfig6" "kcoreaddons6" "kcrash6" "ki18n6" "kcmutils6" "libplasma" "libxkbcommon" "wayland" "wayland-protocols" "qt6-tools")
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=()
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    test -f "$src/CMakeLists.txt"
}

build() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    local builddir="$src/build"
    cmake -S "$src" -B "$builddir" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_PREFIX_PATH=/usr \
        -DBUILD_TESTING=OFF \
        -DQT_BUILD_TESTS=OFF \
        -DQT_BUILD_EXAMPLES=OFF \
        -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_SHARED_LIBS=ON
    test -s "$builddir/build.ninja"
    cmake --build "$builddir" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    [[ -n "${pkgdir:-}" && "$pkgdir" != / ]] || return 1
    DESTDIR="$pkgdir" cmake --install "$src/build"
    test -d "$pkgdir/usr"
    test -x "$pkgdir/usr/bin/plasma-keyboard"
    test -d "$pkgdir/usr/share/plasma/keyboard"
}
