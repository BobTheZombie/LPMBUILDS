#!/bin/bash
# LPM Linux — qt5-wayland
# Builds on Qt5 Base and Declarative; installs Qt5 WaylandClient and QPA plugin.
NAME="qt5-wayland"
VERSION="5.15.19"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Qt5 Wayland client platform plugin and QtWayland libraries"
URL="https://www.qt.io/"
LICENSE=(
    "LGPL-3.0-only"
    "GPL-3.0-only"
)
SOURCE=("qtwayland::git+https://github.com/qt/qtwayland.git#tag=v5.15.19-lts-lgpl")
# Git sources are selected by the named release tag, not a tarball digest.
SHA256SUMS=()
PATCHES=()
REQUIRES=(
    "qt5-base"
    "qt5-declarative"
    "wayland"
    "libxkbcommon"
    "glibc"
    "gcc-libs"
    "libglvnd"
)
BUILD_REQUIRES=(
    "qt5-base"
    "qt5-declarative"
    "wayland"
    "wayland-protocols"
    "libxkbcommon"
    "vulkan-headers"
    "pkgconf"
    "make"
    "perl"
    "git"
)
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=()
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
BUILD_OPTIONS=("@--optimize=2" "@--stripping")

prepare() {
    set -euxo pipefail
    local src="$SRCROOT/qtwayland"
    test -f "$src/qtwayland.pro"
    rm -rf "$SRCROOT/qt5-wayland-build"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/qtwayland"
    local builddir="$SRCROOT/qt5-wayland-build"
    local jobs="${LPM_BUILD_JOBS:-$(nproc)}"
    test -x /usr/lib/qt5/bin/qmake
    test -f "$src/qtwayland.pro"
    mkdir -p "$builddir"
    cd "$builddir"
    PATH="/usr/lib/qt5/bin:$PATH" /usr/lib/qt5/bin/qmake "$src/qtwayland.pro" CONFIG+=release
    make -j"$jobs"
}
staging() {
    set -euxo pipefail
    local builddir="$SRCROOT/qt5-wayland-build"
    make -C "$builddir" INSTALL_ROOT="$pkgdir" install
    test -e "$pkgdir/usr/lib/libQt5WaylandClient.so.5"
    test -f "$pkgdir/usr/lib/cmake/Qt5WaylandClient/Qt5WaylandClientConfig.cmake"
    find "$pkgdir/usr/lib/qt5/plugins" -name 'libqwayland*.so' -print -quit | grep -q .
}
