#!/bin/bash
# LPM Linux - independent KDE application (outside KDE Gear release cadence)
# Source version and SHA256 verified against KDE or distribution release metadata.
# Dependency closure and compilation require LPM chroot validation.
NAME="kstars"
VERSION="3.8.5"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE planetarium and astrophotography application"
URL="https://apps.kde.org/kstars/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/kstars/${VERSION}/kstars-${VERSION}.tar.xz")
SHA256SUMS=("18f578944bfba800f7091aef83550d898e0c36bddfe2969f7bb87807df60e5b3")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "qt6-declarative"
    "qt6-svg"
    "qt6-graphs"
    "qt6-websockets"
    "kcoreaddons6"
    "kconfig6"
    "kconfigwidgets6"
    "ki18n6"
    "kio6"
    "eigen3"
    "cfitsio"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "qt6-declarative"
    "qt6-svg"
    "qt6-graphs"
    "qt6-websockets"
    "kcoreaddons6"
    "kconfig6"
    "kconfigwidgets6"
    "ki18n6"
    "kio6"
    "eigen3"
    "cfitsio"
    "gettext"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
