#!/bin/bash
# LPM Linux - independent KDE application (outside KDE Gear release cadence)
# Source version and SHA256 verified against KDE or distribution release metadata.
# Dependency closure and compilation require LPM chroot validation.
NAME="kdiff3"
VERSION="1.12.6"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE graphical three-way file and folder comparison"
URL="https://apps.kde.org/kdiff3/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/kdiff3/kdiff3-${VERSION}.tar.xz")
SHA256SUMS=("edeaa2313cb74b650958d24cd98b300b73173ac8a9c87067de62babf02baa37c")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "kcoreaddons6"
    "kconfig6"
    "ki18n6"
    "kio6"
    "kparts6"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "kcoreaddons6"
    "kconfig6"
    "ki18n6"
    "kio6"
    "kparts6"
    "gettext"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
