#!/bin/bash
# LPM Linux source recipe - Qt 6.12.0
# LPM automatically extracts SOURCE to $SRCROOT/$NAME-$VERSION.
# QDoc may require Clang/LLVM. Do not turn off LinguistTools: qt6-translations builds after this package.
NAME="qt6-tools"
VERSION="6.12.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Qt 6 development, Designer, Assistant and Linguist tools"
URL="https://www.qt.io/"
LICENSE=("GPL-3.0-only" "LGPL-3.0-only")
SOURCE=("https://download.qt.io/archive/qt/6.12/${VERSION}/submodules/qttools-everywhere-src-${VERSION}.tar.xz")
SHA256SUMS=("SKIP")
PATCHES=()

REQUIRES=(
    "qt6-base>=6.12.0"
)

BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "qt6-base>=6.12.0"
    "qt6-declarative>=6.12.0"
    "qt6-svg>=6.12.0"
)

PROVIDES=()
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()


prepare() {
    local src="$SRCROOT/$NAME-$VERSION"
    local builddir="$src/build"
    if [[ ! -f "$src/CMakeLists.txt" ]]; then
        echo "[ERROR] Missing Qt module source: $src/CMakeLists.txt" >&2
        return 1
    fi
    # Always clean Qt's cached private-ABI/configuration metadata.
    rm -rf "$builddir"
}

build() {
    local src="$SRCROOT/$NAME-$VERSION"
    local builddir="$src/build"
    local qtver
    qtver="$(pkg-config --modversion Qt6Core)" || return 1
    if [[ "$qtver" != "$VERSION" ]]; then
        echo "[ERROR] $NAME needs Qt6Core $VERSION; installed $qtver" >&2
        return 1
    fi
    cmake -S "$src" -B "$builddir" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_TESTING=OFF \
        -DQT_BUILD_TESTS=OFF \
        -DQT_BUILD_EXAMPLES=OFF \
        -DQT_BUILD_DOCS=OFF
    cmake --build "$builddir" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    local src="$SRCROOT/$NAME-$VERSION"
    local builddir="$src/build"
    : "${pkgdir:?LPM pkgdir must be set for staging}"
    DESTDIR="$pkgdir" cmake --install "$builddir"
}
