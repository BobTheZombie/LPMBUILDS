#!/bin/bash
# KDE Gear 26.08.3: KIO workers and thumbnail support
NAME="kio-extras"
VERSION="26.08.3"
RELEASE="4"
ARCH="${ARCH:-x86_64}"
SUMMARY="Additional KDE KIO workers, services and thumbnail plugins"
URL="https://invent.kde.org/network/kio-extras"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/release-service/${VERSION}/src/${NAME}-${VERSION}.tar.xz")
SHA256SUMS=("5ff1e1091b162cd02c226880a6af93e6908ab32993b420fbe8fc10718e168780")
PATCHES=()
REQUIRES=("glibc" "qt6-base" "qt6-svg" "kio6" "solid6" "karchive6" "kconfig6" "kcoreaddons6" "ki18n6" "syntax-highlighting6" "kcmutils6" "kdbusaddons6" "plasma-activities" "plasma-activities-stats")
BUILD_REQUIRES=("gcc" "cmake" "ninja" "pkgconf" "extra-cmake-modules" "gettext" "qt6-base" "qt6-svg" "kio6" "solid6" "karchive6" "kconfig6" "kcoreaddons6" "ki18n6" "syntax-highlighting6" "kcmutils6" "kdbusaddons6" "plasma-activities" "plasma-activities-stats")
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=("kio-extras" "KIOExtras")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=("libkexiv2" "gperf")
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    local builddir="$BUILDROOT/${NAME}-build"
    # Don't require optional libproxy or KDE documentation generators.
    cmake -S "$src" -B "$builddir" -G Ninja \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
      -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
      -DBUILD_TESTING=OFF -DBUILD_SHARED_LIBS=ON \
      -DBUILD_DOC=OFF -DBUILD_KCMS=ON -DBUILD_ACTIVITIES=ON \
      -DWITH_LIBPROXY=OFF
    cmake --build "$builddir" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$BUILDROOT/${NAME}-build"
    # Qt 6 in LPM installs plugins under /usr/plugins, not /usr/lib/qt6/plugins.
    for worker in thumbnail.so archive.so sftp.so; do
        test -f "$pkgdir/usr/plugins/kf6/kio/$worker"
    done
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
