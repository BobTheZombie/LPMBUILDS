#!/bin/bash
# LPM Linux KDE app - pin upstream tarball SHA256.
# Source-specific features and full dependencies require chroot validation.
NAME="heaptrack"
VERSION="1.5.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE heap memory allocation profiler"
URL="https://apps.kde.org/heaptrack/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/heaptrack/${VERSION}/heaptrack-${VERSION}.tar.xz")
SHA256SUMS=("a278d9d8f91e8bfb8a1c2f5b73eecab47fd45d0693f5dbea637536413cec2ea5")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "qt6-svg"
    "elfutils"
    "libunwind"
    "zstd"
    "kcoreaddons6"
    "kio6"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "qt6-svg"
    "elfutils"
    "libunwind"
    "zstd"
    "kcoreaddons6"
    "kio6"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
