#!/bin/bash
# LPM Linux KDE app - pin upstream tarball SHA256.
# Source-specific features and full dependencies require chroot validation.
NAME="smb4k"
VERSION="4.0.7"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE Samba shares browser and manager"
URL="https://apps.kde.org/smb4k/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://downloads.sourceforge.net/project/smb4k/${VERSION}/smb4k-${VERSION}.tar.xz")
SHA256SUMS=("1c3809591bb8070f47b97f4c36fc18e49bd041427f0014f35a9050af84c4dc97")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "qt6-declarative"
    "qt6keychain"
    "kconfig6"
    "kcoreaddons6"
    "kio6"
    "solid6"
    "samba"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "qt6-declarative"
    "qt6keychain"
    "kconfig6"
    "kcoreaddons6"
    "kio6"
    "solid6"
    "samba"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
