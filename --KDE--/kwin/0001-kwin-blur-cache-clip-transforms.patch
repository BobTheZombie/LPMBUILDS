+    // KWin / LPM: preserve clipping order while avoiding the same expensive
+    // shape transformation for every damage rectangle. The common one-clip
+    // case retains the allocation-free upstream path.
+    const auto &shapeRects = blurShape.rects();
+    QList<RectF> effectiveShape;
+    effectiveShape.reserve(shapeRects.size());
+    if (deviceRegion != Region::infinite()) {
+        const auto clipRects = deviceRegion.rects();
+        if (clipRects.size() <= 1) {
+            for (const Rect &clipRect : clipRects) {
+                const RectF deviceClipRect = clipRect.translated(-deviceBackgroundRect.topLeft());
+                for (const RectF &shapeRect : shapeRects) {
+                    const RectF deviceShapeRect = shapeRect.translated(-backgroundRect.topLeft()).scaled(viewport.scale()).rounded();
+                    if (const RectF intersected = deviceClipRect.intersected(deviceShapeRect); !intersected.isEmpty()) {
+                        effectiveShape.append(intersected);
+                    }
+                }
+            }
+        } else {
+            QList<RectF> deviceShapeRects;
+            deviceShapeRects.reserve(shapeRects.size());
+            for (const RectF &shapeRect : shapeRects) {
+                deviceShapeRects.append(shapeRect.translated(-backgroundRect.topLeft()).scaled(viewport.scale()).rounded());
+            }
+            for (const Rect &clipRect : clipRects) {
+                const RectF deviceClipRect = clipRect.translated(-deviceBackgroundRect.topLeft());
+                for (const RectF &deviceShapeRect : deviceShapeRects) {
+                    if (const RectF intersected = deviceClipRect.intersected(deviceShapeRect); !intersected.isEmpty()) {
+                        effectiveShape.append(intersected);
+                    }
+                }
+            }
+        }
+    } else {
+        for (const RectF &rect : shapeRects) {
+            effectiveShape.append(rect.translated(-backgroundRect.topLeft()).scaled(viewport.scale()).rounded());
+        }
+    }
     if (effectiveShape.isEmpty()) {
         return;
     }
