#!/bin/bash
# LPM Linux - KDE Plasma 6.8.1 KWin: default debuggable build, optional Ryzen Zen 2 tune.
# Intended to diagnose recurrent kwin_wayland SIGSEGV on LPM / Qt 6.12.
# LPM extracts into $SRCROOT/$NAME-$VERSION, stages via $pkgdir.
# The optimized profile is opt-in. It does NOT claim to fix a compositor crash.

NAME="kwin"
VERSION="6.8.1"
RELEASE="3"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE Plasma 6 KWin Wayland compositor (debuggable build)"
URL="https://invent.kde.org/plasma/kwin"
LICENSE=("SEE-UPSTREAM")
SOURCE=(
    "https://download.kde.org/stable/plasma/${VERSION}/kwin-${VERSION}.tar.xz"
)
# Retained from the supplied LPMBuild. Verify upstream before publication.
SHA256SUMS=("f3d725f81061c1ba97fdef8aeb2101a5c5e03c77f11e9a2abaa1dfed4489d3b6")
PATCHES=()

# Separately versioned build-time profile. Default stays 6.8.1-3
# so an unstable tuned compositor can be reverted.
KWIN_LPM_PROFILE="${LPM_KWIN_PROFILE:-debug}"
case "$KWIN_LPM_PROFILE" in
    debug) ;;
    zen2)
        if [[ "$VERSION" != "6.8.1" || "$ARCH" != "x86_64" ]]; then
            echo "[ERROR] Zen 2 patchset requires KWin 6.8.1 x86_64" >&2
            return 1 2>/dev/null || exit 1
        fi
        RELEASE="4"
        PATCHES=(
            "0001-kwin-blur-cache-clip-transforms.patch"
            "0002-kwin-blur-share-kawase-projection.patch"
        )
        ;;
    *)
        echo "[ERROR] Unknown LPM_KWIN_PROFILE: $KWIN_LPM_PROFILE (debug|zen2)" >&2
        return 1 2>/dev/null || exit 1
        ;;
esac

REQUIRES=(
    "qt6-base" "qt6-declarative" "qt6-5compat" "qt6-svg"
    "qt6-positioning" "qt6-wayland" "qt6-tools"
    "kdecoration" "kwayland" "kglobalaccel6" "kglobalacceld"
    "kconfig6" "kcolorscheme6" "kauth6" "kcoreaddons6"
    "kcrash6" "kdbusaddons6" "kguiaddons6" "ki18n6"
    "kidletime6" "kpackage6" "kservice6" "kwidgetsaddons6"
    "kwindowsystem6" "knotifications6" "kcmutils6"
    "plasma-wayland-protocols>=1.23.0"
    "libdisplay-info>=0.2.0" "libinput>=1.28"
    "libxcvt>=0.1.1" "wayland>=1.26.0"
    "wayland-protocols>=1.49" "libdrm>=2.4.127"
    "mesa" "libxkbcommon" "libxcb" "libudev"
    "knighttime>=6.8.0" "kscreenlocker>=6.8.0"
    "lcms2" "libepoxy" "libcanberra" "libcap"
)
BUILD_REQUIRES=(
    "cmake" "ninja" "pkgconf" "extra-cmake-modules"
    "gcc" "qt6-base" "qt6-declarative" "qt6-5compat"
    "qt6-svg" "qt6-positioning" "qt6-wayland" "qt6-tools"
    "kdecoration" "kwayland" "kglobalaccel6" "kglobalacceld"
    "kconfig6" "kcolorscheme6" "kauth6" "kcoreaddons6"
    "kcrash6" "kdbusaddons6" "kguiaddons6" "ki18n6"
    "kidletime6" "kpackage6" "kservice6" "kwidgetsaddons6"
    "kwindowsystem6" "knotifications6" "kcmutils6"
    "knewstuff6" "kdeclarative6" "krunner6" "kxmlgui6"
    "plasma-wayland-protocols>=1.23.0"
    "libdisplay-info>=0.2.0" "libinput>=1.28"
    "libxcvt>=0.1.1" "wayland>=1.26.0"
    "wayland-protocols>=1.49" "libdrm>=2.4.127"
    "mesa" "libxkbcommon" "libxcb" "libudev"
    "knighttime>=6.8.0" "kscreenlocker>=6.8.0"
    "lcms2" "libepoxy" "libcanberra" "libcap"
)
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=("kwin")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=(
    "breeze" "aurorae" "milou" "libplasma" "kirigami6"
    "plasma-activities" "libqaccessibilityclient-qt6"
    "libei" "pipewire" "hwdata" "xorg-xwayland"
)
SUGGESTS=()

prepare() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    [[ -f "$src/CMakeLists.txt" ]] || {
        echo "[ERROR] Missing KWin source tree: $src" >&2
        return 1
    }
    # Qt6 ABI and previous build options changed; don't reuse CMakeCache.
    rm -rf "$src/build"
}

build() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    local builddir="$src/build"
    local jobs="${LPM_BUILD_JOBS:-$(nproc)}"
    [[ "$jobs" =~ ^[1-9][0-9]*$ ]] || {
        echo "[ERROR] Invalid LPM_BUILD_JOBS: $jobs" >&2
        return 1
    }

    # Recovery baseline and an optional Zen 2 source/compile optimization.
    # Avoid -Ofast/-ffast-math: KWin geometry and HDR need IEEE semantics.
    # No dynamic linker, KWin plugin ABI or global compositor setting changes.
    local build_flags='-O2 -g -DNDEBUG -fno-omit-frame-pointer'
    local ipo='OFF'
    if [[ "$KWIN_LPM_PROFILE" == "zen2" ]]; then
        local compiler="${CXX:-c++}"
        if ! printf 'int main() { return 0; }\n' | "$compiler" -x c++ -fsyntax-only -march=znver2 -mtune=znver2 -; then
            echo '[ERROR] Compiler does not support Zen 2 tuning flags' >&2
            return 1
        fi
        build_flags='-O3 -g -DNDEBUG -fno-omit-frame-pointer -fno-plt -march=znver2 -mtune=znver2'
        ipo='ON'
        echo '[KWin] Zen 2 profile: -O3, full debug info, -fno-plt, LTO'
        echo '[KWin] Build targets Zen 2-class x86_64 CPUs, not portable x86_64'
    fi

    # QT_INSTALL_QML on LPM Qt6 6.12.0 is /usr/qml.
    # ECM respects Qt install paths with KDE_INSTALL_USE_QT_SYS_PATHS=ON.
    # Serialize link steps to cap memory use during GCC LTO.
    cmake -S "$src" -B "$builddir" -G Ninja \
        -DCMAKE_BUILD_TYPE=RelWithDebInfo \
        -DCMAKE_C_FLAGS_RELWITHDEBINFO="$build_flags" \
        -DCMAKE_CXX_FLAGS_RELWITHDEBINFO="$build_flags" \
        -DCMAKE_INTERPROCEDURAL_OPTIMIZATION_RELWITHDEBINFO:BOOL="$ipo" \
        -DCMAKE_JOB_POOLS:STRING='link_pool=1' \
        -DCMAKE_JOB_POOL_LINK:STRING='link_pool' \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DKWIN_BUILD_DECORATIONS=ON \
        -DKWIN_BUILD_KCMS=ON \
        -DKWIN_BUILD_SCREENLOCKER=ON \
        -DKWIN_BUILD_GLOBALSHORTCUTS=ON \
        -DKWIN_BUILD_NOTIFICATIONS=ON \
        -DKWIN_BUILD_X11=ON

    [[ -f "$builddir/build.ninja" ]] || {
        echo '[ERROR] KWin Ninja graph missing' >&2
        return 1
    }
    grep -q '^CMAKE_BUILD_TYPE:STRING=RelWithDebInfo$' "$builddir/CMakeCache.txt" || {
        echo '[ERROR] Debuggable build type was not applied' >&2
        return 1
    }
    if [[ "$KWIN_LPM_PROFILE" == "zen2" ]]; then
        grep -q '^CMAKE_INTERPROCEDURAL_OPTIMIZATION_RELWITHDEBINFO:BOOL=ON
}

staging() {
    set -euxo pipefail
    local builddir="$SRCROOT/$NAME-$VERSION/build"
    [[ -n "${pkgdir:-}" && "$pkgdir" != / ]] || {
        echo '[ERROR] Invalid LPM staging destination' >&2
        return 1
    }
    DESTDIR="$pkgdir" cmake --install "$builddir"

    [[ -f "$pkgdir/usr/lib/cmake/KWin/KWinConfig.cmake" ]] || {
        echo '[ERROR] Missing KWin CMake export' >&2
        return 1
    }
    [[ -x "$pkgdir/usr/bin/kwin_wayland" ]] || {
        echo '[ERROR] Missing staged kwin_wayland' >&2
        return 1
    }
    # readelf checks source debug info BEFORE LPM's archive/stripping phase.
    if command -v readelf >/dev/null 2>&1; then
        if ! readelf -S "$pkgdir/usr/bin/kwin_wayland" | grep -q '\.debug_info'; then
            echo '[WARN] No .debug_info in staged kwin_wayland; inspect debug flags/stripping' >&2
        fi
    fi
    echo "[OK] KWin $VERSION-$RELEASE ($KWIN_LPM_PROFILE) staged; preserve .debug_* sections"
} "$builddir/CMakeCache.txt" || {
            echo '[ERROR] LTO configuration not applied' >&2
            return 1
        }
        grep -q -- '-march=znver2' "$builddir/CMakeCache.txt" || {
            echo '[ERROR] Zen 2 CMake flags not applied' >&2
            return 1
        }
    fi
    cmake --build "$builddir" --parallel "$jobs"
}

staging() {
    set -euxo pipefail
    local builddir="$SRCROOT/$NAME-$VERSION/build"
    [[ -n "${pkgdir:-}" && "$pkgdir" != / ]] || {
        echo '[ERROR] Invalid LPM staging destination' >&2
        return 1
    }
    DESTDIR="$pkgdir" cmake --install "$builddir"

    [[ -f "$pkgdir/usr/lib/cmake/KWin/KWinConfig.cmake" ]] || {
        echo '[ERROR] Missing KWin CMake export' >&2
        return 1
    }
    [[ -x "$pkgdir/usr/bin/kwin_wayland" ]] || {
        echo '[ERROR] Missing staged kwin_wayland' >&2
        return 1
    }
    # readelf checks source debug info BEFORE LPM's archive/stripping phase.
    if command -v readelf >/dev/null 2>&1; then
        if ! readelf -S "$pkgdir/usr/bin/kwin_wayland" | grep -q '\.debug_info'; then
            echo '[WARN] No .debug_info in staged kwin_wayland; inspect debug flags/stripping' >&2
        fi
    fi
    echo '[OK] KWin staged; ensure LPM preserves .debug_* sections in final package'
}