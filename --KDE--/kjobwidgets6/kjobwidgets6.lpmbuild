#!/bin/bash
# LPM Linux: KDE Plasma 6.8.1 package chain
# Generated 2026-10-25; source digests MUST be locked before building.
NAME="kjobwidgets6"
VERSION="6.31.0"
RELEASE="2"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE Frameworks 6: kjobwidgets"
URL="https://kde.org"
LICENSE=("SEE-UPSTREAM")
SOURCE=(
    "https://download.kde.org/stable/frameworks/6.31/kjobwidgets-6.31.0.tar.xz"
)
SHA256SUMS=(
    "SKIP"
)
PATCHES=()
REQUIRES=(
    "qt6-base"
    "kcoreaddons6"
    "kwidgetsaddons6"
    "knotifications6"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "kcoreaddons6"
    "kwidgetsaddons6"
    "knotifications6"
)
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=()
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/$NAME-$VERSION/CMakeLists.txt"
}

build() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    local builddir="$src/build"
    local python_bindings="${LPM_KJOBWIDGETS_PYTHON_BINDINGS:-OFF}"

    case "$python_bindings" in
        ON|OFF) ;;
        *) echo "[ERROR] LPM_KJOBWIDGETS_PYTHON_BINDINGS must be ON or OFF" >&2; return 1 ;;
    esac

    # The Python typesystem imports typesystem_kcoreaddons.xml, unavailable
    # when KF6 CoreAddons Python bindings are disabled. Keep native KF6
    # widgets working; opt back in only after rebuilding the binding chain.
    cmake -S "$src" -B "$builddir" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_PYTHON_BINDINGS="$python_bindings" \
        -DKDE_INSTALL_USE_QT_SYS_PATHS=ON
    cmake --build "$builddir" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    local builddir="$SRCROOT/$NAME-$VERSION/build"
    DESTDIR="$pkgdir" cmake --install "$builddir"
    test -f "$pkgdir/usr/lib/cmake/KF6JobWidgets/KF6JobWidgetsConfig.cmake"
    find "$pkgdir/usr/lib" -maxdepth 1 -name 'libKF6JobWidgets.so*' -print -quit | grep -q .
}
