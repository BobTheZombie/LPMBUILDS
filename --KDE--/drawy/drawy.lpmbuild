#!/bin/bash
# LPM Linux KDE independent app - pinned upstream checksum.
# Validate dependencies and CMake features in LPM before distribution.
NAME="drawy"
VERSION="1.0.2"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE infinite-canvas drawing and whiteboard"
URL="https://apps.kde.org/drawy/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/drawy/${VERSION}/drawy-${VERSION}.tar.xz")
SHA256SUMS=("5ffaddefa967a6dad6f904c87ff85084c9013f5d1a0a0d87665759880d7c6d6f")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "qt6-declarative"
    "qt6-svg"
    "kirigami6"
    "syntax-highlighting6"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "qt6-declarative"
    "qt6-svg"
    "kirigami6"
    "syntax-highlighting6"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
