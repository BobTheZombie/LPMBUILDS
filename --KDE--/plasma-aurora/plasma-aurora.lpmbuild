#!/bin/bash
# LPM Aurora v0.1 — staged, build-time Plasma 6 customization.
NAME="plasma-aurora"
VERSION="0.4.0"
RELEASE="1"
ARCH="any"
SUMMARY="Aurora Glass Plasma 6 style, animated dock and searchable launcher"
URL="https://github.com/BobTheZombie/LPMBUILDS"
LICENSE=("MIT")
SOURCE=()
SHA256SUMS=()
PATCHES=()
REQUIRES=("plasma-workspace" "plasma-desktop" "libplasma")
BUILD_REQUIRES=()
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=("plasma-aurora-style")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=("breeze" "kwin")
SUGGESTS=()

prepare() { :; }
build() { :; }

staging() {
    set -euo pipefail
    test -n "$pkgdir" && test "$pkgdir" != /
    local style="$pkgdir/usr/share/plasma/desktoptheme/org.lpm.aurora"
    local look="$pkgdir/usr/share/plasma/look-and-feel/org.lpm.aurora.desktop"
    local colors="$pkgdir/usr/share/color-schemes/Aurora.colors"
    local applet="$pkgdir/usr/share/plasma/plasmoids/org.lpm.aurora.dock"
    local launcher="$pkgdir/usr/share/plasma/plasmoids/org.lpm.aurora.launcher"
    install -d "$style/widgets" "$style/translucent/widgets" "$style/solid/widgets" "$look/contents/layouts" "$(dirname "$colors")" "$applet/contents/ui" "$applet/contents/config" "$launcher/contents/ui"

    cat > "$style/metadata.json" <<'EOF'
{
  "KPackageStructure": "Plasma/Theme",
  "KPlugin": {
    "Id": "org.lpm.aurora",
    "Name": "Aurora Glass",
    "Description": "Sapphire-violet translucent Plasma panel style for LPM",
    "Category": "Plasma Theme",
    "License": "MIT",
    "Version": "0.4.0",
    "EnabledByDefault": true
  },
  "X-Plasma-API": "6.0"
}
EOF

    # Plasma's FrameSvg engine renders and stretches these nine slices.
    # Gradient tint gives a glass-like surface; live backdrop blur is provided
    # by KWin when enabled, not by a static SVG filter.
    cat > "$style/widgets/panel-background.svg" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<svg xmlns="http://www.w3.org/2000/svg" width="96" height="96" viewBox="0 0 96 96">
  <defs>
    <linearGradient id="glass" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#527ed5" stop-opacity=".48"/>
      <stop offset=".55" stop-color="#503d97" stop-opacity=".53"/>
      <stop offset="1" stop-color="#7545b7" stop-opacity=".60"/>
    </linearGradient>
    <linearGradient id="edge" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#d3eaff" stop-opacity=".74"/>
      <stop offset="1" stop-color="#baacff" stop-opacity=".26"/>
    </linearGradient>
  </defs>
  <path id="topleft" d="M24 0H24V24H0C0 10.75 10.75 0 24 0Z" fill="url(#glass)" stroke="url(#edge)" stroke-width="1"/>
  <rect id="top" x="24" y="0" width="48" height="24" fill="url(#glass)"/>
  <path id="topright" d="M72 0C85.25 0 96 10.75 96 24H72Z" fill="url(#glass)" stroke="url(#edge)" stroke-width="1"/>
  <rect id="left" x="0" y="24" width="24" height="48" fill="url(#glass)"/>
  <rect id="center" x="24" y="24" width="48" height="48" fill="url(#glass)"/>
  <rect id="right" x="72" y="24" width="24" height="48" fill="url(#glass)"/>
  <path id="bottomleft" d="M0 72H24V96C10.75 96 0 85.25 0 72Z" fill="url(#glass)" stroke="url(#edge)" stroke-width="1"/>
  <rect id="bottom" x="24" y="72" width="48" height="24" fill="url(#glass)"/>
  <path id="bottomright" d="M72 72H96C96 85.25 85.25 96 72 96Z" fill="url(#glass)" stroke="url(#edge)" stroke-width="1"/>
  <rect id="hint-top-margin" x="24" y="0" width="1" height="8" fill="white"/>
  <rect id="hint-bottom-margin" x="24" y="88" width="1" height="8" fill="white"/>
  <rect id="hint-left-margin" x="0" y="24" width="8" height="1" fill="white"/>
  <rect id="hint-right-margin" x="88" y="24" width="8" height="1" fill="white"/>
</svg>
EOF

    # Generate an alpha mask from the existing corner geometry. KWin's
    # compositor uses these masks to clip the blurred area to the panel shape.
    python3 - "$style/widgets/panel-background.svg" <<'PY_MASK'
import sys
import xml.etree.ElementTree as ET
ET.register_namespace("", "http://www.w3.org/2000/svg")
path = sys.argv[1]
tree = ET.parse(path)
root = tree.getroot()
names = ("topleft", "top", "topright", "left", "center",
         "right", "bottomleft", "bottom", "bottomright")
by_id = {elem.get("id"): elem for elem in root.iter()}
for name in names:
    if name not in by_id:
        raise SystemExit("Missing panel slice: " + name)
    original = by_id[name]
    copy = ET.SubElement(root, original.tag, dict(original.attrib))
    copy.set("id", "mask-" + name)
    copy.set("fill", "#000000")
    copy.set("fill-opacity", "1")
    copy.set("stroke", "none")
    copy.attrib.pop("stroke-width", None)
tree.write(path, encoding="utf-8", xml_declaration=True)
PY_MASK

    # Plasma 6 honors these preferences when requesting blur from KWin.
    # It does not enable blur globally or bypass accessibility settings.
    cat > "$style/plasmarc" <<'EOF'
[Settings]
FallbackTheme=default

[BlurBehindEffect]
enabled=true

[ContrastEffect]
enabled=false
EOF

    cp "$style/widgets/panel-background.svg" \
        "$style/translucent/widgets/panel-background.svg"

    # When adaptive opacity becomes opaque, preserve legibility.
    sed -e 's/stop-opacity="\.48"/stop-opacity=".96"/g' \
        -e 's/stop-opacity="\.53"/stop-opacity=".96"/g' \
        -e 's/stop-opacity="\.60"/stop-opacity=".96"/g' \
        "$style/widgets/panel-background.svg" > "$style/solid/widgets/panel-background.svg"

    cat > "$colors" <<'EOF'
[General]
Name=Aurora
ColorScheme=Aurora

[Colors:Window]
BackgroundNormal=22,24,46
BackgroundAlternate=32,34,63
ForegroundNormal=236,242,255
ForegroundInactive=160,170,201
ForegroundActive=145,185,255
ForegroundLink=130,175,255
ForegroundVisited=202,158,255
ForegroundNegative=255,115,143
ForegroundNeutral=255,193,110
ForegroundPositive=120,224,184
DecorationFocus=135,165,255
DecorationHover=181,127,255

[Colors:View]
BackgroundNormal=26,28,51
BackgroundAlternate=36,37,67
ForegroundNormal=236,242,255
ForegroundInactive=160,170,201
ForegroundActive=145,185,255
ForegroundLink=130,175,255
ForegroundVisited=202,158,255
ForegroundNegative=255,115,143
ForegroundNeutral=255,193,110
ForegroundPositive=120,224,184
DecorationFocus=135,165,255
DecorationHover=181,127,255

[Colors:Button]
BackgroundNormal=44,46,80
BackgroundAlternate=55,52,93
ForegroundNormal=236,242,255
ForegroundInactive=160,170,201
ForegroundActive=145,185,255
ForegroundLink=130,175,255
ForegroundVisited=202,158,255
ForegroundNegative=255,115,143
ForegroundNeutral=255,193,110
ForegroundPositive=120,224,184
DecorationFocus=135,165,255
DecorationHover=181,127,255

[Colors:Selection]
BackgroundNormal=100,89,187
BackgroundAlternate=84,112,200
ForegroundNormal=255,255,255
ForegroundInactive=230,233,247
ForegroundActive=255,255,255
ForegroundLink=230,234,255
ForegroundVisited=255,223,255
ForegroundNegative=255,200,213
ForegroundNeutral=255,230,198
ForegroundPositive=188,248,222
DecorationFocus=178,171,255
DecorationHover=178,171,255

[Colors:Tooltip]
BackgroundNormal=36,38,68
BackgroundAlternate=48,47,82
ForegroundNormal=236,242,255
ForegroundInactive=160,170,201
ForegroundActive=145,185,255
ForegroundLink=130,175,255
ForegroundVisited=202,158,255
ForegroundNegative=255,115,143
ForegroundNeutral=255,193,110
ForegroundPositive=120,224,184
DecorationFocus=135,165,255
DecorationHover=181,127,255

[WM]
activeBackground=36,38,68
activeForeground=236,242,255
inactiveBackground=27,29,52
inactiveForeground=160,170,201
activeBlend=53,48,97
inactiveBlend=31,32,53
activeFrame=112,105,192
inactiveFrame=59,56,97
EOF

    cat > "$look/metadata.json" <<'EOF'
{
  "KPackageStructure": "Plasma/LookAndFeel",
  "KPlugin": {
    "Id": "org.lpm.aurora.desktop",
    "Name": "Aurora",
    "Description": "LPM Aurora Glass desktop and centered dock",
    "License": "MIT",
    "Version": "0.4.0"
  }
}
EOF

    cat > "$look/contents/defaults" <<'EOF'
[plasmarc][Theme]
name=org.lpm.aurora

[kdeglobals][General]
ColorScheme=Aurora

[kdeglobals][KDE]
widgetStyle=Breeze
EOF

    # Opt-in through Global Theme -> Desktop and window layout.
    # The package never touches user configuration during installation.
    cat > "$look/contents/layouts/org.kde.plasma.desktop-layout.js" <<'EOF'
/* Aurora dock: Plasma 6 scripting API */
var dock = new Panel();
dock.location = "bottom";
dock.alignment = "center";
dock.lengthMode = "fit";
dock.height = Math.round(gridUnit * 3);
dock.hiding = "dodgewindows";
dock.addWidget("org.lpm.aurora.launcher");
dock.addWidget("org.lpm.aurora.dock");
dock.addWidget("org.kde.plasma.systemtray");
dock.addWidget("org.kde.plasma.digitalclock");
EOF

    # Plasma 6.8 task data stays under KWin/TaskManager, no shell polling.
    # Qt Quick scene-graph animations are disabled when reduceMotion is set.
    cat > "$applet/metadata.json" <<'AURORA_APPLET_JSON'
{
  "KPackageStructure": "Plasma/Applet",
  "X-Plasma-API-Minimum-Version": "6.0",
  "KPlugin": {
    "Id": "org.lpm.aurora.dock",
    "Name": "Aurora Animated Dock",
    "Description": "Spring-driven application task dock for LPM Plasma 6",
    "Icon": "preferences-desktop-icons",
    "Category": "Windows and Tasks",
    "License": "MIT",
    "Version": "0.4.0"
  }
}
AURORA_APPLET_JSON

    cat > "$applet/contents/config/main.xml" <<'AURORA_CONFIG_XML'
<?xml version="1.0" encoding="UTF-8"?>
<kcfg xmlns="http://www.kde.org/standards/kcfg/1.0"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://www.kde.org/standards/kcfg/1.0 http://www.kde.org/standards/kcfg/1.0/kcfg.xsd">
  <kcfgfile name=""/>
  <group name="General">
    <entry name="reduceMotion" type="Bool"><default>false</default></entry>
    <entry name="magnification" type="Double"><default>1.38</default></entry>
    <entry name="iconSize" type="Int"><default>42</default></entry>
    <entry name="showGlow" type="Bool"><default>true</default></entry>
  </group>
</kcfg>
AURORA_CONFIG_XML

    cat > "$applet/contents/config/config.qml" <<'AURORA_CONFIG_QML'
import QtQuick
import org.kde.plasma.configuration

ConfigModel {
    ConfigCategory {
        name: i18n("Motion")
        icon: "preferences-desktop-effects"
        source: "configMotion.qml"
    }
}
AURORA_CONFIG_QML

    cat > "$applet/contents/ui/configMotion.qml" <<'AURORA_CONFIG_MOTION'
import QtQuick
import QtQuick.Controls as Controls
import QtQuick.Layouts

Item {
    id: config
    property alias cfg_reduceMotion: noMotion.checked
    property alias cfg_showGlow: glow.checked
    property alias cfg_magnification: scale.value
    property alias cfg_iconSize: iconSize.value

    implicitWidth: 360
    implicitHeight: layout.implicitHeight

    ColumnLayout {
        id: layout
        anchors.fill: parent
        spacing: 14

        Controls.CheckBox {
            id: noMotion
            text: i18n("Reduce motion (disable magnification and 3D tilt)")
        }
        Controls.CheckBox {
            id: glow
            text: i18n("Active and hover glow")
        }
        Controls.Label { text: i18n("Hover magnification") }
        Controls.Slider {
            id: scale
            from: 1
            to: 1.8
            stepSize: 0.05
            Layout.fillWidth: true
        }
        Controls.Label { text: i18n("Icon size") }
        Controls.Slider {
            id: iconSize
            from: 28
            to: 64
            stepSize: 2
            Layout.fillWidth: true
        }
    }
}
AURORA_CONFIG_MOTION

    cat > "$applet/contents/ui/main.qml" <<'AURORA_TASK_QML'
import QtQuick
import QtQuick.Layouts
import org.kde.plasma.plasmoid
import org.kde.plasma.core as PlasmaCore
import org.kde.taskmanager as TaskManager
import org.kde.kirigami as Kirigami

PlasmoidItem {
    id: root
    readonly property int baseIconSize: Math.max(28, Math.min(64, Plasmoid.configuration.iconSize))
    readonly property bool motionOff: Plasmoid.configuration.reduceMotion
    readonly property real peakScale: motionOff ? 1 : Math.max(1, Math.min(1.8, Plasmoid.configuration.magnification))
    readonly property bool glowEnabled: Plasmoid.configuration.showGlow
    property int hoveredIndex: -1
    readonly property int slotSize: baseIconSize + 18

    // Always keep this as a panel applet. The source model owns window
    // activation/launching, never a CLI spawning process.
    preferredRepresentation: fullRepresentation
    backgroundHints: PlasmaCore.Types.NoBackground

    implicitWidth: tasks.count * slotSize + 18
    implicitHeight: slotSize + (motionOff ? 8 : 26)

    TaskManager.TasksModel {
        id: tasks
        sortMode: TaskManager.TasksModel.SortManual
        groupMode: TaskManager.TasksModel.GroupDisabled
        separateLaunchers: false
        launchInPlace: true
        filterByCurrentVirtualDesktop: false
        filterByScreen: false
        // Launchers use KDE's TaskManager URLs; actual task/window entries
        // are supplied and updated by Plasma and KWin.
        launcherList: [
            "applications:org.kde.dolphin.desktop",
            "applications:org.kde.konsole.desktop",
            "applications:org.mozilla.firefox.desktop"
        ]
    }

    fullRepresentation: Item {
        implicitWidth: root.implicitWidth
        implicitHeight: root.implicitHeight

        Row {
            id: strip
            anchors.horizontalCenter: parent.horizontalCenter
            anchors.bottom: parent.bottom
            height: root.slotSize + (root.motionOff ? 8 : 26)
            spacing: 0

            Repeater {
                model: tasks

                delegate: Item {
                    id: tile
                    required property int index
                    required property var model
                    readonly property bool activeTask: Boolean(model.IsActive)
                    readonly property bool attention: Boolean(model.IsDemandingAttention)
                    readonly property real distance: root.hoveredIndex < 0 ? 99 : Math.abs(root.hoveredIndex - index)
                    readonly property real weight: distance === 0 ? 1 : (distance === 1 ? 0.34 : 0)
                    readonly property real targetScale: 1 + (root.peakScale - 1) * weight

                    width: root.slotSize
                    height: strip.height
                    z: mouse.containsMouse ? 100 : (tile.activeTask ? 10 : 0)

                    Item {
                        id: visual
                        width: root.baseIconSize
                        height: root.baseIconSize
                        anchors.horizontalCenter: parent.horizontalCenter
                        anchors.bottom: parent.bottom
                        anchors.bottomMargin: 11

                        transformOrigin: Item.Bottom
                        scale: tile.targetScale
                        y: root.motionOff ? 0 : -Math.round((tile.targetScale - 1) * 18)
                        opacity: 1

                        transform: Rotation {
                            origin.x: visual.width / 2
                            origin.y: visual.height
                            axis { x: 1; y: 0; z: 0 }
                            angle: root.motionOff ? 0 : (mouse.containsMouse ? -9 : 0)
                            Behavior on angle {
                                enabled: !root.motionOff
                                NumberAnimation { duration: 200; easing.type: Easing.OutCubic }
                            }
                        }

                        Behavior on scale {
                            enabled: !root.motionOff
                            SpringAnimation {
                                spring: 4.4
                                damping: 0.32
                                mass: 1.0
                                epsilon: 0.006
                                modulus: 0
                            }
                        }

                        Behavior on y {
                            enabled: !root.motionOff
                            NumberAnimation { duration: 170; easing.type: Easing.OutCubic }
                        }

                        Rectangle {
                            anchors.centerIn: parent
                            width: parent.width * 1.2
                            height: parent.height * 1.2
                            radius: width / 2
                            color: "#806abaff"
                            opacity: root.glowEnabled && (mouse.containsMouse || tile.activeTask) ? 0.24 : 0
                            Behavior on opacity { NumberAnimation { duration: root.motionOff ? 0 : 180 } }
                        }

                        Kirigami.Icon {
                            id: taskIcon
                            anchors.fill: parent
                            source: tile.model.decoration
                            smooth: true
                        }
                    }

                    Rectangle {
                        width: tile.activeTask ? 22 : 5
                        height: 3
                        radius: height / 2
                        anchors.horizontalCenter: parent.horizontalCenter
                        anchors.bottom: parent.bottom
                        anchors.bottomMargin: 3
                        color: tile.attention ? "#ffb974" : "#a5baff"
                        opacity: tile.activeTask || tile.attention ? 1 : 0.25
                        Behavior on width { NumberAnimation { duration: root.motionOff ? 0 : 150 } }
                    }

                    MouseArea {
                        id: mouse
                        anchors.fill: parent
                        hoverEnabled: true
                        acceptedButtons: Qt.LeftButton | Qt.MiddleButton
                        onEntered: root.hoveredIndex = tile.index
                        onExited: { if (root.hoveredIndex === tile.index) root.hoveredIndex = -1 }
                        onClicked: point => {
                            const modelIndex = tasks.makeModelIndex(tile.index);
                            if (point.button === Qt.MiddleButton) {
                                tasks.requestNewInstance(modelIndex);
                            } else {
                                tasks.requestActivate(modelIndex);
                            }
                        }
                    }
                }
            }
        }
    }
}
AURORA_TASK_QML

    # Aurora 0.4 launcher: live KDE KRunner/Kicker model, no shell
    # execution or external process polling. Optional Plasma applet.
    cat > "$launcher/metadata.json" <<'AURORA_LAUNCHER_JSON'
{
  "KPackageStructure": "Plasma/Applet",
  "X-Plasma-API-Minimum-Version": "6.0",
  "KPlugin": {
    "Id": "org.lpm.aurora.launcher",
    "Name": "Aurora Launcher",
    "Description": "Searchable blue-violet launcher powered by KDE KRunner",
    "Icon": "start-here-kde",
    "Category": "Application Launchers",
    "License": "MIT",
    "Version": "0.4.0"
  }
}
AURORA_LAUNCHER_JSON

    cat > "$launcher/contents/ui/main.qml" <<'AURORA_LAUNCHER_QML'
import QtQuick
import QtQuick.Layouts
import QtQuick.Controls as Controls
import org.kde.plasma.plasmoid
import org.kde.plasma.core as PlasmaCore
import org.kde.plasma.private.kicker as Kicker
import org.kde.kirigami as Kirigami

PlasmoidItem {
    id: root
    Plasmoid.icon: "start-here-kde"
    preferredRepresentation: compactRepresentation
    implicitWidth: Kirigami.Units.iconSizes.medium + 12
    implicitHeight: Kirigami.Units.iconSizes.medium + 12

    Kicker.RunnerModel {
        id: searchModel
        appletInterface: root
        mergeResults: true
        query: search.text
    }

    compactRepresentation: MouseArea {
        implicitWidth: root.implicitWidth
        implicitHeight: root.implicitHeight
        hoverEnabled: true
        Accessible.role: Accessible.Button
        Accessible.name: i18n("Open Aurora Launcher")
        onClicked: root.expanded = !root.expanded
        Kirigami.Icon {
            anchors.fill: parent
            anchors.margins: 7
            source: "start-here-kde"
        }
    }

    fullRepresentation: Item {
        implicitWidth: Math.max(370, Kirigami.Units.gridUnit * 23)
        implicitHeight: Math.max(470, Kirigami.Units.gridUnit * 27)

        Rectangle {
            anchors.fill: parent
            radius: 22
            color: "#ed191b38"
            border.width: 1
            border.color: "#829dcced"
        }

        ColumnLayout {
            anchors.fill: parent
            anchors.margins: 18
            spacing: 12

            RowLayout {
                Layout.fillWidth: true
                Kirigami.Icon {
                    source: "start-here-kde"
                    Layout.preferredWidth: 28
                    Layout.preferredHeight: 28
                }
                Controls.Label {
                    text: i18n("Aurora")
                    font.pixelSize: 22
                    font.bold: true
                    color: "#e7eafe"
                }
                Item { Layout.fillWidth: true }
                Controls.ToolButton {
                    text: "×"
                    Accessible.name: i18n("Close launcher")
                    onClicked: root.expanded = false
                }
            }

            Controls.TextField {
                id: search
                Layout.fillWidth: true
                placeholderText: i18n("Search applications, files and actions…")
                selectByMouse: true
                onAccepted: {
                    if (results.count > 0) results.activateCurrent()
                }
                Keys.onEscapePressed: root.expanded = false
            }

            Controls.Label {
                text: search.text.length ? i18n("Results") : i18n("Type to search")
                color: "#aab9ed"
            }

            ListView {
                id: results
                Layout.fillWidth: true
                Layout.fillHeight: true
                clip: true
                model: searchModel
                currentIndex: count > 0 ? 0 : -1
                spacing: 5
                keyNavigationWraps: true

                function activateCurrent() {
                    if (currentIndex < 0) return;
                    // KDE owns the activation; no command string is executed
                    // by the Aurora applet.
                    searchModel.trigger(currentIndex, "", null);
                    root.expanded = false;
                }

                delegate: Rectangle {
                    id: resultItem
                    required property int index
                    required property var model
                    width: results.width
                    height: 54
                    radius: 12
                    color: mouse.containsMouse || ListView.isCurrentItem
                        ? "#775d9cd1" : "#332e3760"
                    border.color: mouse.containsMouse ? "#a3aaff" : "#00000000"
                    border.width: 1

                    RowLayout {
                        anchors.fill: parent
                        anchors.leftMargin: 12
                        anchors.rightMargin: 12
                        spacing: 12
                        Kirigami.Icon {
                            source: resultItem.model.decoration
                            Layout.preferredWidth: 30
                            Layout.preferredHeight: 30
                        }
                        ColumnLayout {
                            Layout.fillWidth: true
                            spacing: 2
                            Controls.Label {
                                text: String(resultItem.model.display || "")
                                color: "#f3f4ff"
                                elide: Text.ElideRight
                                Layout.fillWidth: true
                            }
                            Controls.Label {
                                text: String(resultItem.model.description || "")
                                color: "#aebce1"
                                elide: Text.ElideRight
                                Layout.fillWidth: true
                                font.pixelSize: 11
                                visible: text.length > 0
                            }
                        }
                    }

                    MouseArea {
                        id: mouse
                        anchors.fill: parent
                        hoverEnabled: true
                        onClicked: {
                            results.currentIndex = resultItem.index;
                            results.activateCurrent();
                        }
                    }
                }

                Controls.Label {
                    anchors.centerIn: parent
                    text: i18n("Start typing to find an application")
                    visible: !search.text.length
                    color: "#aebce1"
                }
            }
        }

        Connections {
            target: root
            function onExpandedChanged() {
                if (root.expanded) {
                    search.forceActiveFocus();
                    search.selectAll();
                } else {
                    search.text = "";
                }
            }
        }
    }
}
AURORA_LAUNCHER_QML

    python3 - "$style/metadata.json" "$look/metadata.json" <<'EOF'
import json, sys, xml.etree.ElementTree as ET
for path in sys.argv[1:]:
    with open(path, encoding="utf-8") as f:
        assert json.load(f)["KPlugin"]["Id"]
EOF
    python3 - "$style/widgets/panel-background.svg" <<'EOF'
import sys, xml.etree.ElementTree as ET
root = ET.parse(sys.argv[1]).getroot()
ns = "{http://www.w3.org/2000/svg}"
identifiers = {e.get("id") for e in root.iter()}
assert {"topleft", "top", "topright", "left", "center", "right",
        "bottomleft", "bottom", "bottomright"} <= identifiers
EOF
    # Explicit opt-in KWin blur tuning. No autostart or automatic mutation of
    # user kwinrc, so KDE's upstream settings remain authoritative.
    local helper="$pkgdir/usr/bin/aurora-kwin-effects"
    install -d "$(dirname "$helper")"
    cat > "$helper" <<'EOF'
#!/bin/sh
set -eu
command -v kwriteconfig6 >/dev/null 2>&1 || {
    echo "Missing kwriteconfig6" >&2; exit 1;
}
config_dir="$HOME/.config"
if [ -n "${XDG_CONFIG_HOME:-}" ]; then config_dir="$XDG_CONFIG_HOME"; fi
config="$config_dir/kwinrc"
backup="$config_dir/kwinrc.aurora-before-0.2"
refresh() {
    if command -v qdbus6 >/dev/null 2>&1; then
        qdbus6 org.kde.KWin /KWin reconfigure >/dev/null 2>&1 || true
    fi
}
case "${1:-}" in
apply)
    mkdir -p "$config_dir"
    if [ ! -e "$backup" ]; then
        if [ -e "$config" ]; then cp -p "$config" "$backup"; else : > "$backup"; fi
    fi
    kwriteconfig6 --file kwinrc --group Plugins --key blurEnabled true
    kwriteconfig6 --file kwinrc --group Effect-blur --key BlurStrength 4
    kwriteconfig6 --file kwinrc --group Effect-blur --key NoiseStrength 0
    refresh
    echo "Aurora blur enabled; requires active KWin compositor"
    ;;
status)
    if command -v kreadconfig6 >/dev/null 2>&1; then
        kreadconfig6 --file kwinrc --group Plugins --key blurEnabled
        kreadconfig6 --file kwinrc --group Effect-blur --key BlurStrength
    fi
    ;;
restore)
    echo "Aurora backup: $backup"
    echo "Review it before restoring to avoid overwriting recent changes."
    ;;
*)
    echo "Usage: aurora-kwin-effects {apply|status|restore}" >&2
    exit 2
    ;;
esac
EOF
    chmod 0755 "$helper"

    python3 - "$style/widgets/panel-background.svg" \
        "$style/translucent/widgets/panel-background.svg" \
        "$style/solid/widgets/panel-background.svg" <<'PY_CHECK'
import sys
import xml.etree.ElementTree as ET
parts = ("topleft", "top", "topright", "left", "center",
         "right", "bottomleft", "bottom", "bottomright")
needed = set(parts) | {"mask-" + p for p in parts}
for filename in sys.argv[1:]:
    ids = {node.get("id") for node in ET.parse(filename).getroot().iter()}
    assert needed <= ids, f"invalid FrameSvg masks in {filename}"
PY_CHECK
    test -s "$style/plasmarc"
    test -x "$helper"
    test -s "$applet/metadata.json"
    test -s "$applet/contents/ui/main.qml"
    test -s "$applet/contents/config/main.xml"
    test -s "$launcher/metadata.json"
    test -s "$launcher/contents/ui/main.qml"
    echo "[OK] Aurora 0.4 animated dock and KRunner launcher staged into $pkgdir"
}
