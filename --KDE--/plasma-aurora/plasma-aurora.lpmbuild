#!/bin/bash
# LPM Linux Plasma Aurora v0.3.0 — source-controlled KDE Plasma 6 Global Theme.
# LPM can build this by package name: its Git SOURCE supplies all theme assets,
# even when the recipe itself was fetched into /tmp/lpm-plasma-aurora.lpmbuild.
NAME="plasma-aurora"
VERSION="0.3.0"
RELEASE="2"
ARCH="any"
SUMMARY="Complete Aurora Glass Global Theme, color scheme, icon accents, wallpaper and opt-in performance profiles"
URL="https://github.com/BobTheZombie/LPMBUILDS/tree/main/--KDE--/plasma-aurora"
LICENSE=("MIT")
# Pin a *known* source commit containing the complete 0.3.0 theme assets.
# Supported by LPM's git+URL#commit= parser; alias stages at $SRCROOT/aurora-src.
# Do not use /tmp/lpm-plasma-aurora.lpmbuild's dirname for source resolution.
# Bump the commit and RELEASE together whenever the tracked theme changes.
_AURORA_SOURCE_COMMIT="32d42ce6d6c4b46eea2e92d65e4c15b66eae6382"
SOURCE=(
    "aurora-src::git+https://github.com/BobTheZombie/LPMBUILDS.git#commit=${_AURORA_SOURCE_COMMIT}"
)
# Git's commit object ID fixes the source revision; no tarball checksum applies.
SHA256SUMS=("SKIP")
PATCHES=()
REQUIRES=("plasma-workspace" "plasma-desktop" "libplasma" "breeze" "kwin" "python")
BUILD_REQUIRES=("python" "git")
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=("plasma-aurora-style" "plasma-aurora-profiles")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

# Each LPM build phase runs in a fresh shell; resolve paths inside each phase.
# AURORA_THEME_DIR optionally overrides the default for local development.
_aurora_theme_dir() {
    if [[ -n "${AURORA_THEME_DIR:-}" ]]; then
        printf '%s\n' "$AURORA_THEME_DIR"
    else
        : "${SRCROOT:?LPM must provide SRCROOT to build Plasma Aurora}"
        printf '%s\n' "$SRCROOT/aurora-src/--KDE--/plasma-aurora/theme"
    fi
}

prepare() {
    local src
    src="$(_aurora_theme_dir)"
    test -r "$src/global-theme/org.lpm.aurora.desktop/metadata.json" || {
        echo "[ERROR] Missing Plasma Aurora source assets: $src" >&2
        echo "Expected LPM to fetch SOURCE into $SRCROOT/aurora-src." >&2
        echo "Check the Git checkout above or set AURORA_THEME_DIR for local testing." >&2
        return 1
    }
    test -f "$src/tools/generate_wallpaper.py"
    test -f "$src/tools/validate_stage.py"
    echo "[OK] Plasma Aurora assets found at $src"
}
build() { :; }

staging() {
    set -euo pipefail
    test -n "${pkgdir:-}" && test "$pkgdir" != /
    local src
    src="$(_aurora_theme_dir)"
    local share="$pkgdir/usr/share"
    test -r "$src/global-theme/org.lpm.aurora.desktop/metadata.json"
    install -d "$share/plasma/look-and-feel" "$share/plasma/desktoptheme" \
        "$share/color-schemes" "$share/icons" "$share/wallpapers" "$pkgdir/usr/bin"
    cp -a "$src/global-theme/org.lpm.aurora.desktop" "$share/plasma/look-and-feel/"
    cp -a "$src/plasma-style/org.lpm.aurora" "$share/plasma/desktoptheme/"
    cp -a "$src/icons/PlasmaAurora" "$share/icons/"
    cp -a "$src/wallpapers/PlasmaAurora" "$share/wallpapers/"
    install -m 0644 "$src/color-schemes/Aurora.colors" "$share/color-schemes/Aurora.colors"
    install -m 0755 "$src/scripts/aurora-profile" "$pkgdir/usr/bin/aurora-profile"

    # Ship real PNG wallpaper + preview, generated deterministically at build time.
    python3 "$src/tools/generate_wallpaper.py" \
        "$share/wallpapers/PlasmaAurora/contents/images/2560x1440.png" \
        "$share/wallpapers/PlasmaAurora/contents/screenshot.png" \
        "$share/plasma/look-and-feel/org.lpm.aurora.desktop/contents/previews/preview.png"

    # Verify the exact staged payload, not just the repository source.
    python3 "$src/tools/validate_stage.py" "$pkgdir"
    echo "[OK] Plasma Aurora ${VERSION} fully staged into $pkgdir"
}
