#!/bin/bash
# LPM Linux: KDE Plasma 6.8.1 package chain
# Generated 2026-10-25; source digests MUST be locked before building.
NAME="plasma-workspace"
VERSION="6.8.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE Plasma 6: plasma-workspace"
URL="https://kde.org"
LICENSE=("SEE-UPSTREAM")
SOURCE=(
    "https://download.kde.org/stable/plasma/6.8.1/plasma-workspace-6.8.1.tar.xz"
)
SHA256SUMS=(
    "SKIP"
)
PATCHES=()
REQUIRES=(
    "qt6-base"
    "qt6-declarative"
    "kwin"
    "libplasma"
    "plasma5support"
    "plasma-activities"
    "kactivitymanagerd"
    "kglobalaccel6"
    "kio6"
    "kservice6"
    "krunner6"
    "milou"
    "wayland"
    "wayland-protocols"
    "mesa"
    "libdrm"
    "qt6-positioning"
    "qt6-svg"
    "qt6-shadertools"
    "qt6-wayland"
    "kwayland"
    "plasma-activities-stats"
    "libksysguard"
    "libkscreen"
    "layer-shell-qt"
    "knighttime"
    "dbus"
    "libudev"
    "libcanberra"
    "zlib"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "qt6-declarative"
    "kwin"
    "libplasma"
    "plasma5support"
    "plasma-activities"
    "kactivitymanagerd"
    "kglobalaccel6"
    "kio6"
    "kservice6"
    "krunner6"
    "milou"
    "qt6-positioning"
    "qt6-svg"
    "qt6-shadertools"
    "qt6-wayland"
    "kwayland"
    "plasma-activities-stats"
    "libksysguard"
    "libkscreen"
    "layer-shell-qt"
    "knighttime"
    "plasma-wayland-protocols"
    "dbus"
    "libudev"
    "wayland"
    "libcanberra"
    "zlib"
)
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=()
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=(
    "flatpak"
    "accountsservice"
    "pipewire"
)
SUGGESTS=()

prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/$NAME-$VERSION/CMakeLists.txt"
}

build() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    local builddir="$src/build"
    cmake -S "$src" -B "$builddir" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DINSTALL_SDDM_WAYLAND_SESSION=ON \
        -DBUILD_TESTING=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DKDE_INSTALL_USE_QT_SYS_PATHS=ON
    cmake --build "$builddir" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    local builddir="$SRCROOT/$NAME-$VERSION/build"
    DESTDIR="$pkgdir" cmake --install "$builddir"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
