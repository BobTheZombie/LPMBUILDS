#!/bin/bash
# LPM Linux - KDE independently versioned application
# SHA256 pinned; full dependency closure requires chroot validation.
NAME="glaxnimate"
VERSION="0.6.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE vector animation and Lottie editor"
URL="https://apps.kde.org/glaxnimate/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/glaxnimate/${VERSION}/glaxnimate-${VERSION}.tar.xz")
SHA256SUMS=("4fe5e4d48124d499aab318c932884e3e98da2fd279399c3ba3c6a4d1e07de94a")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "qt6-svg"
    "qt6-declarative"
    "qt6-multimedia"
    "zlib"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "qt6-svg"
    "qt6-declarative"
    "qt6-multimedia"
    "zlib"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
