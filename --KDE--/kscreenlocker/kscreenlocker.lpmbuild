#!/bin/bash
# LPM Linux - KDE Plasma screen locker for KWin Wayland
NAME="kscreenlocker"
VERSION="6.8.1"
RELEASE="2"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE Plasma screen locking library and greeter"
URL="https://invent.kde.org/plasma/kscreenlocker"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/plasma/${VERSION}/kscreenlocker-${VERSION}.tar.xz"
        "kde.pam"
        "https://gitlab.archlinux.org/archlinux/packaging/packages/kscreenlocker/-/raw/main/kde-fingerprint.pam"
        "https://gitlab.archlinux.org/archlinux/packaging/packages/kscreenlocker/-/raw/main/kde-smartcard.pam")
SHA256SUMS=(
    "6662370091a5c78427b6207cab7e47762d3cae75b7646ad68d06f305c1300a45"
    "4e6eb62c1d416cc653dadfe3748c8eb374aa774d6425662d01686b6f211b9800"
    "SKIP" # Upstream Arch fingerprint PAM template: pin before stable release
    "SKIP" # Upstream Arch smartcard PAM template: pin before stable release
)
PATCHES=()
REQUIRES=(
    "glibc" "qt6-base" "qt6-declarative" "pam"
    "kconfig6" "kcoreaddons6" "kcrash6" "kglobalaccel6"
    "ki18n6" "kidletime6" "kio6" "kcmutils6"
    "knotifications6" "kpackage6" "ksvg6" "kwindowsystem6"
    "kxmlgui6" "solid6" "layer-shell-qt" "libkscreen" "libplasma"
)
BUILD_REQUIRES=(
    "cmake" "ninja" "pkgconf" "extra-cmake-modules"
    "qt6-base" "qt6-declarative" "pam"
    "kconfig6" "kcoreaddons6" "kcrash6" "kglobalaccel6"
    "ki18n6" "kidletime6" "kio6" "kcmutils6"
    "knotifications6" "kpackage6" "ksvg6" "kwindowsystem6"
    "kxmlgui6" "solid6" "layer-shell-qt" "libkscreen" "libplasma"
)
PROVIDES=("KScreenLocker")
CONFLICTS=()
OBSOLETES=()
BUILD_OPTIONS=("@--stripping" "@--optimize=2")

prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}

build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    local builddir="$src/build"
    cmake -S "$src" -B "$builddir" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DKDE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DKSCREENLOCKER_PAM_SERVICE=kde
    cmake --build "$builddir" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    local builddir="$SRCROOT/${NAME}-${VERSION}/build"
    test -n "${pkgdir:-}" && test "$pkgdir" != "/"
    DESTDIR="$pkgdir" cmake --install "$builddir"

    install -Dm644 "$SRCROOT/kde.pam" "$pkgdir/usr/lib/pam.d/kde"
    install -Dm644 "$SRCROOT/kde-fingerprint.pam" "$pkgdir/usr/lib/pam.d/kde-fingerprint"
    install -Dm644 "$SRCROOT/kde-smartcard.pam" "$pkgdir/usr/lib/pam.d/kde-smartcard"

    test -f "$pkgdir/usr/lib/cmake/KScreenLocker/KScreenLockerConfig.cmake"
    compgen -G "$pkgdir/usr/lib/libKScreenLocker.so*" >/dev/null
    # KDE_INSTALL_LIBEXECDIR varies by distribution; verify regardless of placement.
    test -n "$(find "$pkgdir/usr" -type f -name kscreenlocker_greet -print -quit)"
    # KScreenLocker needs both greeter and PAM worker at runtime.
    test -n "$(find "$pkgdir/usr" -type f -name kscreenlocker_worker -print -quit)"

    # Check the vendor policy that Linux-PAM will use unless /etc/pam.d/kde
    # overrides it. Never substitute a permissive PAM policy on failure.
    test -f "$pkgdir/usr/lib/pam.d/kde"
    grep -Eq '^[[:space:]]*auth[[:space:]]+include[[:space:]]+system-auth' \
        "$pkgdir/usr/lib/pam.d/kde"
    test -f "$pkgdir/usr/lib/pam.d/kde-fingerprint"
    test -f "$pkgdir/usr/lib/pam.d/kde-smartcard"

}
