#!/bin/bash
# LPM Linux - Optional KWin AT-SPI accessibility client library
NAME="libqaccessibilityclient-qt6"
VERSION="0.6.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Qt 6 client-side AT-SPI accessibility integration library"
URL="https://invent.kde.org/libraries/libqaccessibilityclient"
LICENSE=("LGPL-2.1-or-later")
SOURCE=("https://download.kde.org/Attic/libqaccessibilityclient/libqaccessibilityclient-${VERSION}.tar.xz")
SHA256SUMS=("4c50c448622dc9c5041ed10da7d87b3e4e71ccb49d4831a849211d423c5f5d33")
PATCHES=()
REQUIRES=("glibc" "qt6-base" "at-spi2-core")
BUILD_REQUIRES=("cmake" "ninja" "extra-cmake-modules" "qt6-base")
PROVIDES=("QAccessibilityClient6")
CONFLICTS=()
OBSOLETES=()
BUILD_OPTIONS=("@--stripping" "@--optimize=2")

prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}

build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    local builddir="$src/build"
    cmake -S "$src" -B "$builddir" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DKDE_INSTALL_LIBDIR=lib \
        -DQT_MAJOR_VERSION=6 \
        -DBUILD_TESTING=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DKDE_INSTALL_USE_QT_SYS_PATHS=ON
    cmake --build "$builddir" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    local builddir="$SRCROOT/${NAME}-${VERSION}/build"
    test -n "${pkgdir:-}" && test "$pkgdir" != "/"
    DESTDIR="$pkgdir" cmake --install "$builddir"
    test -f "$pkgdir/usr/lib/cmake/QAccessibilityClient6/QAccessibilityClient6Config.cmake"
    compgen -G "$pkgdir/usr/lib/libqaccessibilityclient-qt6.so*" >/dev/null
}
