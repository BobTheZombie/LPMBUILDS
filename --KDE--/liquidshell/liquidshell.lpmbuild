#!/bin/bash
# LPM Linux - KDE independently versioned application
# SHA256 pinned; full dependency closure requires chroot validation.
NAME="liquidshell"
VERSION="1.10.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Qt6/KDE alternative desktop shell"
URL="https://apps.kde.org/liquidshell/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/liquidshell/liquidshell-${VERSION}.tar.xz")
SHA256SUMS=("4e079293a90c47fc3c862f4aa9472936a4cb8a2c72f16098d234997e86c8364a")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "kconfig6"
    "kcoreaddons6"
    "ki18n6"
    "kio6"
    "solid6"
    "bluez-qt6"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "kconfig6"
    "kcoreaddons6"
    "ki18n6"
    "kio6"
    "solid6"
    "bluez-qt6"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
