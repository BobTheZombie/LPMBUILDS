#!/bin/bash
# LPM Linux: KDE Plasma 6.8.1 package chain
# Generated 2026-10-25; source digests MUST be locked before building.
NAME="kio6"
VERSION="6.31.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE Frameworks 6: kio"
URL="https://kde.org"
LICENSE=("SEE-UPSTREAM")
SOURCE=(
    "https://download.kde.org/stable/frameworks/6.31/kio-6.31.0.tar.xz"
)
SHA256SUMS=(
    "SKIP"
)
PATCHES=()
REQUIRES=(
    "qt6-base"
    "karchive6"
    "kbookmarks6"
    "kcolorscheme6"
    "kcompletion6"
    "kcrash6"
    "kconfig6"
    "kcoreaddons6"
    "kdbusaddons6"
    "kguiaddons6"
    "kiconthemes6"
    "kitemviews6"
    "ki18n6"
    "kservice6"
    "kjobwidgets6"
    "knotifications6"
    "solid6"
    "kwidgetsaddons6"
    "kwindowsystem6"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "karchive6"
    "kbookmarks6"
    "kcolorscheme6"
    "kcompletion6"
    "kconfig6"
    "kcoreaddons6"
    "kcrash6"
    "kdbusaddons6"
    "ki18n6"
    "kguiaddons6"
    "kiconthemes6"
    "kitemviews6"
    "kservice6"
    "kjobwidgets6"
    "knotifications6"
    "solid6"
    "kwidgetsaddons6"
    "kwindowsystem6"
)
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=()
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/$NAME-$VERSION/CMakeLists.txt"
}

build() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    local builddir="$src/build"
    cmake -S "$src" -B "$builddir" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DKDE_INSTALL_USE_QT_SYS_PATHS=ON
    cmake --build "$builddir" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    local builddir="$SRCROOT/$NAME-$VERSION/build"
    DESTDIR="$pkgdir" cmake --install "$builddir"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
