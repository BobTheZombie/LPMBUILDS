#!/bin/bash
# LPM Linux - plasma-sdk 6.8.1
# Verified upstream release archive. LPM normalizes to $SRCROOT/$NAME-$VERSION.
NAME="plasma-sdk"
VERSION="6.8.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Plasma widget and theme authoring and inspection utilities"
URL="https://invent.kde.org/plasma/plasma-sdk"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/plasma/${VERSION}/${NAME}-${VERSION}.tar.xz")
SHA256SUMS=("52f0aaff4b36c7800302fc58e8c1671c88456bcc944b3ab657004e2ca304b895")
PATCHES=()
REQUIRES=("qt6-base" "qt6-declarative" "qt6-svg" "qt6-5compat" "libplasma" "plasma5support" "kdeclarative6" "karchive6" "kcompletion6" "kconfig6" "kcoreaddons6" "kcrash6" "kdbusaddons6" "ki18n6" "kiconthemes6" "kitemmodels6" "kio6" "ktexteditor6" "kwidgetsaddons6" "ksvg6")
BUILD_REQUIRES=("cmake" "ninja" "pkgconf" "extra-cmake-modules" "qt6-base" "qt6-declarative" "qt6-svg" "qt6-5compat" "libplasma" "plasma5support" "kdeclarative6" "karchive6" "kcompletion6" "kconfig6" "kcoreaddons6" "kcrash6" "kdbusaddons6" "ki18n6" "kiconthemes6" "kitemmodels6" "kio6" "ktexteditor6" "kwidgetsaddons6" "ksvg6")
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=()
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    test -f "$src/CMakeLists.txt"
}

build() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    local builddir="$src/build"
    cmake -S "$src" -B "$builddir" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_PREFIX_PATH=/usr \
        -DBUILD_TESTING=OFF \
        -DQT_BUILD_TESTS=OFF \
        -DQT_BUILD_EXAMPLES=OFF \
        -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_SHARED_LIBS=ON
    test -s "$builddir/build.ninja"
    cmake --build "$builddir" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    [[ -n "${pkgdir:-}" && "$pkgdir" != / ]] || return 1
    DESTDIR="$pkgdir" cmake --install "$src/build"
    test -d "$pkgdir/usr"
    test -x "$pkgdir/usr/bin/plasmoidviewer"
}
