#!/bin/bash
# LPM Linux / KDE Gear 26.08.3 - source-verified recipe.
# Build dependency closure remains subject to validation on LPM.
NAME="kbreakout"
VERSION="26.08.3"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE Gear application: kbreakout"
URL="https://apps.kde.org/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/release-service/${VERSION}/src/${NAME}-${VERSION}.tar.xz")
SHA256SUMS=("131e29bb34da1de649451d9702dfa4091c759c9e320b4635d4be19e9fe07df8e")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "kcoreaddons6"
    "kconfig6"
    "ki18n6"
    "kio6"
    "libkdegames"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "qt6-declarative"
    "qt6-svg"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF \
        -DKDE_INSTALL_USE_QT_SYS_PATHS=ON
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
