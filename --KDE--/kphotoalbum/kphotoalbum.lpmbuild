#!/bin/bash
# LPM Linux - independently released KDE application
# Source checksum pinned; runtime/build dependencies need LPM chroot testing.
NAME="kphotoalbum"
VERSION="6.2.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE photo cataloging and tagging"
URL="https://apps.kde.org/kphotoalbum/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/kphotoalbum/${VERSION}/kphotoalbum-${VERSION}.tar.xz")
SHA256SUMS=("c61127347184d18f9541e322c30de4a3202d545b34962e4d0215f3fc1e845d32")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "kcoreaddons6"
    "kconfig6"
    "ki18n6"
    "kio6"
    "exiv2"
    "libjpeg-turbo"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "kcoreaddons6"
    "kconfig6"
    "ki18n6"
    "kio6"
    "exiv2"
    "libjpeg-turbo"
    "gettext"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
