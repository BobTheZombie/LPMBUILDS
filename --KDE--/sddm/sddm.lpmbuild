#!/bin/bash
# LPM Linux: KDE Plasma 6.8.1 package chain
# Generated 2026-10-25; source digests MUST be locked before building.
NAME="sddm"
VERSION="0.21.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Simple Desktop Display Manager with Qt 6 greeter"
URL="https://github.com/sddm/sddm"
LICENSE=("SEE-UPSTREAM")
SOURCE=(
    "https://github.com/sddm/sddm/archive/refs/tags/v0.21.0.tar.gz"
)
SHA256SUMS=(
    "SKIP"
)
PATCHES=()
REQUIRES=(
    "qt6-base"
    "qt6-declarative"
    "qt6-svg"
    "pam"
    "systemd"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "qt6-base"
    "qt6-declarative"
    "qt6-svg"
)
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=()
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/$NAME-$VERSION/CMakeLists.txt"
}

build() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    local builddir="$src/build"
    cmake -S "$src" -B "$builddir" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DCMAKE_INSTALL_SYSCONFDIR=/etc \
        -DSYSTEMD_SYSTEM_UNIT_DIR=/usr/lib/systemd/system \
        -DBUILD_WITH_QT6=ON \
        -DENABLE_WAYLAND=ON
    cmake --build "$builddir" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    local builddir="$SRCROOT/$NAME-$VERSION/build"
    DESTDIR="$pkgdir" cmake --install "$builddir"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
