#!/bin/bash
# KDE Union 6.8.1. CSS plugin intentionally disabled until
# cxx-rust-cssparser+corrosion are in LPM. Core UnionConfig remains installed.
NAME="union"
VERSION="6.8.1"
RELEASE="2"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE Union Qt Quick and Qt Widgets style engine"
URL="https://invent.kde.org/plasma/union"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/plasma/${VERSION}/union-${VERSION}.tar.xz")
SHA256SUMS=("abea413c79fe9a52337a9b8a50ee8fb29be7ed38bd764eb7555d724e99b39f00")
PATCHES=()
REQUIRES=("qt6-base" "qt6-declarative" "qt6-shadertools" "kcoreaddons6" "kguiaddons6" "kconfig6" "kiconthemes6" "kcolorscheme6" "kirigami6" "cxx-rust-cssparser")
BUILD_REQUIRES=("cmake" "ninja" "pkgconf" "extra-cmake-modules" "qt6-base" "qt6-declarative" "qt6-shadertools" "kcoreaddons6" "kguiaddons6" "kconfig6" "kiconthemes6" "kcolorscheme6" "kirigami6" "cxx-rust-cssparser")
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=()
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DKDE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF \
        -DBUILD_EXAMPLES=OFF \
        -DBUILD_TOOLS=OFF \
        -DBUILD_WITH_KDEFRAMEWORKS=ON \
        -DBUILD_PLATFORM_PLASMA=ON \
        -DBUILD_INPUT_CSS=ON \
        -DBUILD_INPUT_PLASMASVG=OFF \
        -DBUILD_OUTPUT_QTQUICK=ON \
        -DBUILD_OUTPUT_KIRIGAMI=ON \
        -DBUILD_OUTPUT_QTWIDGETS=ON
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    local builddir="$SRCROOT/${NAME}-${VERSION}/build"
    DESTDIR="$pkgdir" cmake --install "$builddir"
    test -f "$pkgdir/usr/lib/cmake/Union/UnionConfig.cmake"
}
