#!/bin/bash
# LPM Linux - KDE Plasma PipeWire / org.kde.pipewire QML modules
NAME="kpipewire"
VERSION="6.8.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="PipeWire video stream integration and Qt6 QML plugins for KDE Plasma"
URL="https://invent.kde.org/plasma/kpipewire"
LICENSE=("LGPL-2.1-or-later" "BSD-3-Clause")
SOURCE=("https://download.kde.org/stable/plasma/${VERSION}/${NAME}-${VERSION}.tar.xz")
SHA256SUMS=("e515339491f9551a7d8bde119dd54345b648445d9740d24f371abe5f7d4197dd")
PATCHES=()
REQUIRES=("qt6-base" "qt6-declarative" "pipewire" "ffmpeg" "libdrm")
BUILD_REQUIRES=("cmake" "ninja" "pkgconf" "extra-cmake-modules" "qt6-base" \
                "qt6-declarative" "pipewire" "ffmpeg" "libdrm" "kcoreaddons6" "ki18n6")
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=("org.kde.pipewire-QMLModule")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

_qml_path() {
    local path
    path="$(qtpaths6 --query QT_INSTALL_QML 2>/dev/null)" || return 1
    [[ "$path" == /usr/* ]] || return 1
    printf '%s\n' "$path"
}
prepare() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    test -f "$src/CMakeLists.txt"
    rm -rf "$src/build"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_PREFIX_PATH=/usr \
        -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION" qml_dir
    [[ -n "${pkgdir:-}" && "$pkgdir" != / ]] || return 1
    DESTDIR="$pkgdir" cmake --install "$src/build"
    qml_dir="$(_qml_path)" || { echo '[ERROR] Qt QML path unavailable' >&2; return 1; }
    test -f "$pkgdir$qml_dir/org/kde/pipewire/qmldir" || {
        echo "[ERROR] Missing org.kde.pipewire at $pkgdir$qml_dir" >&2; return 1;
    }
    test -f "$pkgdir/usr/lib/cmake/KPipeWire/KPipeWireConfig.cmake" || {
        echo '[ERROR] KPipeWire CMake export missing' >&2; return 1;
    }
}
