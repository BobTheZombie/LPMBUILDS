#!/bin/bash
# Rust-powered C++ CSS parser used by KDE Union 6.8.1.
# Builds real C++/Rust code via Corrosion; CSS input must remain enabled in Union.
NAME="cxx-rust-cssparser"
VERSION="1.1.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE Union CSS parser with Rust cssparser and C++ bridge"
URL="https://invent.kde.org/libraries/cxx-rust-cssparser"
LICENSE=("BSD-2-Clause" "MIT" "Apache-2.0")
SOURCE=("https://download.kde.org/stable/cxx-rust-cssparser/cxx-rust-cssparser-${VERSION}.tar.xz")
SHA256SUMS=("c88f883f67d132240f7ef5c8b8fe4f743a79c448b98ac88f2be3b68264840358")
PATCHES=()
REQUIRES=("glibc" "gcc-libs")
BUILD_REQUIRES=("cmake" "ninja" "pkgconf" "extra-cmake-modules"
                "rust" "corrosion" "gcc")
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=()
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    test -f "$src/CMakeLists.txt"
    test -f "$src/rust/Cargo.toml"
    command -v rustc
    command -v cargo
}

build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
        -DBUILD_TESTING=OFF \
        -DBUILD_DOCS=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -f "$pkgdir/usr/lib/cmake/cxx-rust-cssparser/cxx-rust-cssparserConfig.cmake"
    test -n "$(find "$pkgdir/usr/lib" -name 'libcxx-rust-cssparser.so*' -print -quit)"
}
