#!/bin/bash
# LPM Linux: KDE QMobipocket6 (Qt6 shared library for MOBI thumbnailing)
NAME="qmobipocket6"
VERSION="26.08.2"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Qt6 library for reading Mobipocket ebooks (KDE thumbnailer dependency)"
URL="https://invent.kde.org/graphics/kdegraphics-mobipocket"
LICENSE=("GPL-2.0-or-later")
SOURCE=("https://download.kde.org/stable/release-service/${VERSION}/src/kdegraphics-mobipocket-${VERSION}.tar.xz")
SHA256SUMS=("771fb6343177cc9b61ab83fda6d32ed3e87b57de0ce2744ce86b00f8488b6300")
PATCHES=()
REQUIRES=("glibc" "gcc-libs" "qt6-base")
BUILD_REQUIRES=("cmake" "ninja" "extra-cmake-modules" "qt6-base")
PROVIDES=("QMobipocket6" "kdegraphics-mobipocket")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
REQUIRES_PYTHON_DEPENDENCIES=()

_qmobipocket_source() {
    local root="${SRCROOT:?SRCROOT not set}" candidate
    for candidate in \
        "$root/kdegraphics-mobipocket-${VERSION}" \
        "$root/qmobipocket6-${VERSION}" \
        "$root"; do
        if [[ -f "$candidate/CMakeLists.txt" && -f "$candidate/lib/mobipocket.cpp" ]]; then
            printf '%s\n' "$candidate"; return 0
        fi
    done
    while IFS= read -r candidate; do
        candidate="${candidate%/lib/mobipocket.cpp}"
        if [[ -f "$candidate/CMakeLists.txt" ]]; then
            printf '%s\n' "$candidate"; return 0
        fi
    done < <(find "$root" -mindepth 2 -maxdepth 5 -type f -path '*/lib/mobipocket.cpp' -print)
    echo "[ERROR] Could not find kdegraphics-mobipocket ${VERSION} sources in $root" >&2
    return 1
}

prepare() {
    set -euo pipefail
    _qmobipocket_source >/dev/null
}

build() {
    set -euxo pipefail
    local src; src="$(_qmobipocket_source)"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DKDE_INSTALL_LIBDIR=lib \
        -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    local src; src="$(_qmobipocket_source)"
    DESTDIR="${pkgdir:?pkgdir not set}" cmake --install "$src/build"
    test -f "$pkgdir/usr/lib/cmake/QMobipocket6/QMobipocket6Config.cmake"
    test -f "$pkgdir/usr/include/QMobipocket6/qmobipocket/mobipocket.h"
    find "$pkgdir/usr/lib" -maxdepth 1 -name 'libQMobipocket6.so*' -print -quit | grep -q .
}
