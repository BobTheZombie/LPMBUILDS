#!/bin/bash
# LPM Linux - independently released KDE application
# Source checksum pinned; runtime/build dependencies need LPM chroot testing.
NAME="krusader"
VERSION="2.9.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE dual-pane file manager"
URL="https://apps.kde.org/krusader/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/krusader/${VERSION}/krusader-${VERSION}.tar.xz")
SHA256SUMS=("c9b79bfade6cc69fe0e341ecef932fcac8afd9fe94e8cbcfbd729feb54394e04")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "karchive6"
    "kbookmarks6"
    "kconfig6"
    "kcoreaddons6"
    "ki18n6"
    "kio6"
    "kparts6"
    "solid6"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "karchive6"
    "kbookmarks6"
    "kconfig6"
    "kcoreaddons6"
    "ki18n6"
    "kio6"
    "kparts6"
    "solid6"
    "gettext"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
