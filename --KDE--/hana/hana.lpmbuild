#!/bin/bash
# LPM Linux KDE independent app - pinned upstream checksum.
# Validate dependencies and CMake features in LPM before distribution.
NAME="hana"
VERSION="1.0.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE video thumbnail generator"
URL="https://apps.kde.org/hana/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/hana/${VERSION}/hana-${VERSION}.tar.xz")
SHA256SUMS=("6d9cdd3a7861e65d04729b411f4d61854e7b1681ddb2948a8a3299f57226cac9")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "qt6-declarative"
    "ffmpeg"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "qt6-declarative"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
