#!/bin/bash
# LPM Linux: KDE Plasma 6.8.1 package chain
# Generated 2026-10-25; source digests MUST be locked before building.
NAME="print-manager"
VERSION="6.8.1"
RELEASE="2"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE Plasma 6: print-manager"
URL="https://kde.org"
LICENSE=("SEE-UPSTREAM")
SOURCE=(
    "https://download.kde.org/stable/plasma/6.8.1/print-manager-6.8.1.tar.xz"
)
SHA256SUMS=(
    "SKIP"
)
PATCHES=()
REQUIRES=(
    "qt6-base"
    "qt6-declarative"
    "kcmutils6"
    "plasma-workspace"
    "cups"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "qt6-declarative"
    "kcmutils6"
    "plasma-workspace"
    "kcoreaddons6"
)
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=()
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/$NAME-$VERSION/CMakeLists.txt"
}

build() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    local builddir="$src/build"
    # KCoreAddons' QML plugin must be visible in Qt Base's import tree.
    local qml_root
    qml_root="$(qtpaths6 --query QT_INSTALL_QML)"
    if [[ ! -f "$qml_root/org/kde/coreaddons/qmldir" ]]; then
        echo "[ERROR] Missing org.kde.coreaddons QML module at $qml_root" >&2
        echo "[ERROR] Rebuild and reinstall kcoreaddons6 release 4 first." >&2
        return 1
    fi
    cmake -S "$src" -B "$builddir" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DKDE_INSTALL_USE_QT_SYS_PATHS=ON
    cmake --build "$builddir" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    local builddir="$SRCROOT/$NAME-$VERSION/build"
    DESTDIR="$pkgdir" cmake --install "$builddir"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
