#!/bin/bash
# LPM Linux - Qt Declarative / QML / Qt Quick 6.12.0
# Qt submodules must match the installed Qt Base and ShaderTools versions.
# Qt Base defines the QML import root (currently /usr/qml on this LPM build).

NAME="qt6-declarative"
VERSION="6.12.0"
BASE="${VERSION%.*}"
RELEASE="4"
ARCH="${ARCH:-x86_64}"

SUMMARY="Qt 6 Declarative, QML, Qt Quick, and Qt Quick Controls"
URL="https://www.qt.io/"
LICENSE=("LGPL-3.0-only AND GPL-3.0-only WITH Qt-GPL-exception-1.0")

SOURCE=(
    "https://download.qt.io/archive/qt/${BASE}/${VERSION}/submodules/qtdeclarative-everywhere-src-${VERSION}.tar.xz"
    "0001-QTBUG-150769-qquickitemview-unrequestedItems.patch"
)
SHA256SUMS=(
    "311f3a2603e1973bb59baef9dfa740a376de713157d4782ee043681e889c9260"
    "c5545001c67a27568da970b2278a71453096ffcff9b9982eb2f05baf19c346b7"
)
PATCHES=("0001-QTBUG-150769-qquickitemview-unrequestedItems.patch")

REQUIRES=(
    "qt6-base"
    "qt6-shadertools"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "patch"
    "python"
    "perl"
    "qt6-base"
    "qt6-shadertools"
)
REQUIRES_PYTHON_DEPENDENCIES=()

PROVIDES=("qtdeclarative")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail

    local src="$SRCROOT/$NAME-$VERSION"
    local upstream="$SRCROOT/qtdeclarative-everywhere-src-$VERSION"

    # LPM normally extracts archives to $SRCROOT/$NAME-$VERSION.
    # Retain compatibility with Qt's upstream source directory name.
    if [[ ! -f "$src/CMakeLists.txt" && -f "$upstream/CMakeLists.txt" ]]; then
        mv "$upstream" "$src"
    fi
    if [[ ! -f "$src/CMakeLists.txt" ]]; then
        echo "[ERROR] Qt Declarative $VERSION source tree missing" >&2
        return 1
    fi

    # Discard stale CMake configurations from earlier Qt builds.
    rm -rf "$src/build" "$src/.lpm-prereq"
}

build() {
    set -euxo pipefail

    local src="$SRCROOT/$NAME-$VERSION"
    local builddir="$src/build"
    local prereq="$src/.lpm-prereq"

    # Confirm that Qt Base and ShaderTools agree on the exact Qt version.
    mkdir -p "$prereq"
    cat > "$prereq/CMakeLists.txt" <<CMAKE
cmake_minimum_required(VERSION 3.22)
project(LPMQtDeclarativePrerequisites LANGUAGES CXX)
find_package(Qt6 ${VERSION} EXACT CONFIG REQUIRED COMPONENTS Core Gui ShaderTools)
if(NOT TARGET Qt6::Gui OR NOT TARGET Qt6::ShaderTools)
    message(FATAL_ERROR "Qt GUI or ShaderTools targets missing; rebuild prerequisites")
endif()
CMAKE

    cmake -S "$prereq" -B "$prereq/build" -G Ninja \
        -DCMAKE_PREFIX_PATH=/usr
    rm -rf "$prereq"

    # Qt Declarative inherits QML's installation directory from Qt Base.
    cmake -S "$src" -B "$builddir" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_PREFIX_PATH=/usr \
        -DQT_BUILD_TESTS=OFF \
        -DQT_BUILD_EXAMPLES=OFF \
        -DBUILD_TESTING=OFF \
        -DBUILD_SHARED_LIBS=ON

    if [[ ! -f "$builddir/build.ninja" ]]; then
        echo "[ERROR] No Ninja build graph generated" >&2
        return 1
    fi
    if ! grep -q 'libQt6Quick\.so' "$builddir/build.ninja"; then
        echo "[ERROR] Qt Quick build targets were not generated" >&2
        echo "[ERROR] Check Qt Base GUI/OpenGL and ShaderTools support" >&2
        return 1
    fi

    cmake --build "$builddir" \
        --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail

    local builddir="$SRCROOT/$NAME-$VERSION/build"
    local component qml_dir staged_qml module

    DESTDIR="$pkgdir" cmake --install "$builddir"

    # Needed by Qt Quick 3D, Qt Quick Timeline, and downstream KDE builds.
    for component in Qml Quick QuickControls2; do
        if [[ ! -f "$pkgdir/usr/lib/cmake/Qt6${component}/Qt6${component}Config.cmake" ]]; then
            echo "[ERROR] Qt6${component} CMake package missing in staging" >&2
            return 1
        fi
    done

    # Ensure actual shared libraries, not merely a populated /usr tree.
    for component in Qml Quick; do
        if ! find "$pkgdir/usr/lib" -maxdepth 1 -type f \
            -name "libQt6${component}.so.*" -print -quit | grep -q .; then
            echo "[ERROR] libQt6${component} shared library missing in staging" >&2
            return 1
        fi
    done

    # LPM's Qt Base currently reports QT_INSTALL_QML=/usr/qml.
    # Never assume Arch's /usr/lib/qt6/qml layout: use the installed Qt Base.
    qml_dir="$(qtpaths6 --query QT_INSTALL_QML)" || {
        echo "[ERROR] Unable to query Qt Base's QML import path" >&2
        return 1
    }
    if [[ "$qml_dir" != /usr/* ]]; then
        echo "[ERROR] Unexpected Qt QML import path: $qml_dir" >&2
        echo "[ERROR] Check the installed qt6-base configuration" >&2
        return 1
    fi
    staged_qml="$pkgdir$qml_dir"
    echo "[INFO] Qt QML import path: $qml_dir"

    # Validate the QML imports Plasma and other QtQuick consumers need.
    for module in \
        QtQml \
        QtQuick \
        QtQuick/Layouts \
        QtQuick/Controls; do
        if [[ ! -f "$staged_qml/$module/qmldir" ]]; then
            echo "[ERROR] QML module missing in staging: $module" >&2
            echo "[ERROR] Expected: $staged_qml/$module/qmldir" >&2
            return 1
        fi
        echo "[OK] QML module: $module"
    done

    echo "[OK] Qt Declarative $VERSION staged with Qt Quick and Quick Controls 2"
}
