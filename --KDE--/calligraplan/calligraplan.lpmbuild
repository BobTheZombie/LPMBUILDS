#!/bin/bash
# LPM Linux - KDE independently versioned application
# SHA256 pinned; full dependency closure requires chroot validation.
NAME="calligraplan"
VERSION="4.0.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE project management and scheduling suite"
URL="https://apps.kde.org/calligraplan/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/calligraplan/calligraplan-${VERSION}.tar.xz")
SHA256SUMS=("9267ea174c04466014343927f73757bb3047dab36a74fc8f38b891e8d8833a39")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "qt6-svg"
    "kconfig6"
    "kcoreaddons6"
    "ki18n6"
    "kio6"
    "karchive6"
    "kcalendarcore6"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "qt6-svg"
    "kconfig6"
    "kcoreaddons6"
    "ki18n6"
    "kio6"
    "karchive6"
    "kcalendarcore6"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
