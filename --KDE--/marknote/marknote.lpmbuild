#!/bin/bash
# LPM Linux - KDE independently versioned application
# SHA256 pinned; full dependency closure requires chroot validation.
NAME="marknote"
VERSION="1.6.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE Markdown notes application"
URL="https://apps.kde.org/marknote/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/marknote/${VERSION}/marknote-${VERSION}.tar.xz")
SHA256SUMS=("d3bb39614e22fd1a8ddd74bcfb4c384cbffe25685ec01116f694e470816284a9")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "qt6-declarative"
    "qt6-svg"
    "kirigami6"
    "kirigami-addons"
    "kconfig6"
    "kcoreaddons6"
    "ki18n6"
    "kmime6"
    "md4c"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "qt6-declarative"
    "qt6-svg"
    "kirigami6"
    "kirigami-addons"
    "kconfig6"
    "kcoreaddons6"
    "ki18n6"
    "kmime6"
    "md4c"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
