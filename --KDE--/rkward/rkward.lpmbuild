#!/bin/bash
# LPM Linux - KDE independently versioned application
# SHA256 pinned; full dependency closure requires chroot validation.
NAME="rkward"
VERSION="0.8.3"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE R statistics graphical interface"
URL="https://apps.kde.org/rkward/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/rkward/${VERSION}/rkward-${VERSION}.tar.gz")
SHA256SUMS=("40d2a6b6ddc77cb226ccd97037350235ca12d3a422f31b1f9ae3c01be427f5e5")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "qt6-declarative"
    "qt6-webengine"
    "kconfig6"
    "kcoreaddons6"
    "ki18n6"
    "kio6"
    "r"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "qt6-declarative"
    "qt6-webengine"
    "kconfig6"
    "kcoreaddons6"
    "ki18n6"
    "kio6"
    "r"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
