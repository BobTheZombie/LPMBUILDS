#!/bin/bash
# LPM Linux KDE independent app - pinned upstream checksum.
# Validate dependencies and CMake features in LPM before distribution.
NAME="kgeotag"
VERSION="2.0.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE GPS geotagging for photo collections"
URL="https://apps.kde.org/kgeotag/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/kgeotag/${VERSION}/kgeotag-${VERSION}.tar.xz")
SHA256SUMS=("888e41d8dafdd88ec89aeb732a9e7f0270c12015322418bf234836a82a151c08")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "kcoreaddons6"
    "kconfig6"
    "kcolorscheme6"
    "ki18n6"
    "kio6"
    "marble"
    "libkexiv2"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "kcoreaddons6"
    "kconfig6"
    "kcolorscheme6"
    "ki18n6"
    "kio6"
    "marble"
    "libkexiv2"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
