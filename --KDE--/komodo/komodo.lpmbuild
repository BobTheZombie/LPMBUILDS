#!/bin/bash
# LPM Linux KDE independent app - pinned upstream checksum.
# Validate dependencies and CMake features in LPM before distribution.
NAME="komodo"
VERSION="1.6.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE todo.txt task manager"
URL="https://apps.kde.org/komodo/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/komodo/${VERSION}/komodo-${VERSION}.tar.xz")
SHA256SUMS=("c7a6321f0faadcf230df361beaac2e8b2e161b1d47d170b2036617581909089a")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "qt6-declarative"
    "kirigami6"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "qt6-declarative"
    "kirigami6"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
