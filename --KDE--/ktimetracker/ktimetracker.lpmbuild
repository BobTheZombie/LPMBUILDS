#!/bin/bash
# LPM Linux KDE independent app - pinned upstream checksum.
# Validate dependencies and CMake features in LPM before distribution.
NAME="ktimetracker"
VERSION="6.0.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE personal time tracking utility"
URL="https://apps.kde.org/ktimetracker/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://invent.kde.org/pim/ktimetracker/-/archive/v${VERSION}/ktimetracker-v${VERSION}.tar.gz")
SHA256SUMS=("93b758df34309d25b2f68d17dda28b3e9221548a318f9547cc475514a468a9bd")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "kcalendarcore6"
    "kconfig6"
    "kcoreaddons6"
    "ki18n6"
    "kio6"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "kcalendarcore6"
    "kconfig6"
    "kcoreaddons6"
    "ki18n6"
    "kio6"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
