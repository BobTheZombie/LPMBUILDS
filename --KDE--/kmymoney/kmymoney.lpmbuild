#!/bin/bash
# LPM Linux - independent KDE application (outside KDE Gear release cadence)
# Source version and SHA256 verified against KDE or distribution release metadata.
# Dependency closure and compilation require LPM chroot validation.
NAME="kmymoney"
VERSION="5.2.2"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE personal finance and accounting application"
URL="https://apps.kde.org/kmymoney/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/kmymoney/${VERSION}/kmymoney-${VERSION}.tar.xz")
SHA256SUMS=("40b6639e6a216100d20248ed74fa154202f9ccdfbc335227cedc1bef8ea5d377")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "qt6-svg"
    "kconfig6"
    "kcoreaddons6"
    "ki18n6"
    "kio6"
    "kxmlgui6"
    "karchive6"
    "gpgme"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "qt6-svg"
    "kconfig6"
    "kcoreaddons6"
    "ki18n6"
    "kio6"
    "kxmlgui6"
    "karchive6"
    "gpgme"
    "gettext"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
