#!/bin/bash
# LPM Linux: SignOn credential storage through KDE Wallet.
NAME="signon-kwallet-extension"
VERSION="26.08.3"
RELEASE="2"
ARCH="${ARCH:-x86_64}"
SUMMARY="KWallet storage extension for the SignOn framework"
URL="https://invent.kde.org/network/signon-kwallet-extension"
LICENSE=("LGPL-2.0-or-later")
SOURCE=("https://download.kde.org/stable/release-service/${VERSION}/src/${NAME}-${VERSION}.tar.xz")
SHA256SUMS=("e80090087eddc7f823ac5647e290288e890bd6d2372aaeaa24ff17cecd0480a9")
PATCHES=()
REQUIRES=("glibc" "qt6-base" "kwallet6" "signond")
BUILD_REQUIRES=("cmake" "ninja" "pkgconf" "extra-cmake-modules" "qt6-base" "kwallet6" "signond")
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=()
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    [[ -f "$src/CMakeLists.txt" ]] || return 1
    rm -rf "$src/build"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    [[ -f /usr/lib/cmake/SignOnQt6/SignOnQt6Config.cmake ]] || {
        echo '[ERROR] SignOnQt6 is missing' >&2; return 1;
    }
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_PREFIX_PATH=/usr \
        -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    [[ -n "${pkgdir:-}" && "$pkgdir" != / ]] || return 1
    DESTDIR="$pkgdir" cmake --install "$src/build"
    [[ -f "$pkgdir/usr/lib/signon/extensions/libkeyring-kwallet.so" ]] || {
        echo '[ERROR] KWallet SignOn extension not staged under /usr/lib/signon/extensions' >&2
        return 1
    }
}
