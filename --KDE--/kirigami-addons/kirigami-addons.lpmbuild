#!/bin/bash
# KDE Kirigami Addons: provides KF6KirigamiAddonsConfig.cmake for Plasma User KCM
NAME="kirigami-addons"
VERSION="1.15.0"
RELEASE="2"
ARCH="${ARCH:-x86_64}"
SUMMARY="Additional KDE Kirigami QML controls and KF6KirigamiAddons CMake config"
URL="https://invent.kde.org/libraries/kirigami-addons"
LICENSE=("GPL-2.0-or-later" "LGPL-2.1-or-later")
SOURCE=("https://download.kde.org/stable/kirigami-addons/${NAME}-${VERSION}.tar.xz")
SHA256SUMS=("82436c7589cdab2e2ee6b2e7d5ab3bedfa049fa7ded5498c01a90a04b9cdbbb3")
PATCHES=()
REQUIRES=("glibc" "gcc-libs" "qt6-base" "qt6-declarative" "qt6-multimedia" "kirigami6" "kcolorscheme6" "kconfig6" "kcoreaddons6" "kcrash6" "kglobalaccel6" "kguiaddons6" "ki18n6" "kiconthemes6" "kitemmodels6" "ksvg6" "sonnet6")
BUILD_REQUIRES=("gcc" "cmake" "ninja" "pkgconf" "extra-cmake-modules" "qt6-base" "qt6-declarative" "qt6-multimedia" "kirigami6" "kcolorscheme6" "kconfig6" "kcoreaddons6" "kcrash6" "kglobalaccel6" "kguiaddons6" "ki18n6" "kiconthemes6" "kitemmodels6" "ksvg6" "sonnet6")
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=("kirigami-addons" "KF6KirigamiAddons")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    local builddir="$BUILDROOT/${NAME}-build"
    cmake -S "$src" -B "$builddir" -G Ninja \
      -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr \
      -DKDE_INSTALL_LIBDIR=lib -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
      -DBUILD_TESTING=OFF -DBUILD_EXAMPLES=OFF
    cmake --build "$builddir" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$BUILDROOT/${NAME}-build"
    test -f "$pkgdir/usr/lib/cmake/KF6KirigamiAddons/KF6KirigamiAddonsConfig.cmake"
    test -n "$(find "$pkgdir/usr" -name qmldir -print -quit)"
}
