#!/bin/bash
# LPM Linux - independent Plasma-login-manager developer preview.
# Source is a fixed, CI-compiled Git revision; DO NOT enable this automatically.
NAME="plasma-login-manager"
VERSION="0.1.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Experimental Wayland-only Plasma 6 display manager for LPM Linux"
URL="https://github.com/BobTheZombie/LPM.Org/tree/plasma-login-manager"
LICENSE=("GPL-2.0-or-later")
PIN="dd5d14fabca1b61c6fc51474b745020ae5d69d6a"
SOURCE=("https://github.com/BobTheZombie/LPM.Org/archive/${PIN}.tar.gz")
# The commit is immutable; add an independently verified SHA-256 before stable release.
SHA256SUMS=("SKIP")
PATCHES=()
REQUIRES=(
    "glibc"
    "gcc-libs"
    "qt6-base"
    "qt6-declarative"
    "qt6-wayland"
    "pam"
    "systemd"
    "kwin"
    "plasma-workspace"
)
BUILD_REQUIRES=(
    "meson"
    "ninja"
    "pkgconf"
    "qt6-base"
    "qt6-declarative"
    "pam"
    "systemd"
)
PROVIDES=("plasma-login-manager-experimental")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=("qt6-svg" "kscreen" "layer-shell-qt")
SUGGESTS=()
prepare() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    test -f "$src/meson.build"
    test -f "$src/src/session.cpp"
    test -f "$src/data/plmd.service"
    rm -rf "$src/build"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    meson setup "$src/build" "$src" \
        --prefix=/usr \
        --libdir=lib \
        --libexecdir=libexec \
        --buildtype=release
    meson compile -C "$src/build" --jobs "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    python3 "$src/tests/test-source-layout.py"
}
staging() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    test -n "${pkgdir:-}" && test "$pkgdir" != /
    DESTDIR="$pkgdir" meson install -C "$src/build"
    test -x "$pkgdir/usr/libexec/plmd"
    test -x "$pkgdir/usr/libexec/plm-session"
    test -x "$pkgdir/usr/libexec/plm-greeter"
    test -f "$pkgdir/usr/share/plm/Main.qml"
    test -f "$pkgdir/usr/lib/systemd/system/plmd.service"
    test -f "$pkgdir/etc/pam.d/plm"
    test -f "$pkgdir/etc/pam.d/plm-greeter"
    # Never disable SDDM or enable an untested display manager in staging.
}
