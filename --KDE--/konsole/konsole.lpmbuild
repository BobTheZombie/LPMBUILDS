#!/bin/bash
# LPM Linux: KDE Plasma 6.8.1 package chain
# Generated 2026-10-25; source digests MUST be locked before building.
NAME="konsole"
VERSION="26.08.3"
RELEASE="2"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE Gear application: konsole"
URL="https://kde.org"
LICENSE=("SEE-UPSTREAM")
SOURCE=(
    "https://download.kde.org/stable/release-service/26.08.3/src/konsole-26.08.3.tar.xz"
)
SHA256SUMS=("3189d1d048300fbe0628eab001b8ea11bfd6fe4fb6c0bbabc7c5aa0461dad430")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "kconfig6"
    "kcoreaddons6"
    "kpty6"
    "kio6"
    "ki18n6"
    "libssh"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "kconfig6"
    "kcoreaddons6"
    "kpty6"
    "kio6"
    "ki18n6"
)
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=()
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/$NAME-$VERSION/CMakeLists.txt"
}

build() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    local builddir="$src/build"
    cmake -S "$src" -B "$builddir" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DKDE_INSTALL_USE_QT_SYS_PATHS=ON
    cmake --build "$builddir" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    local builddir="$SRCROOT/$NAME-$VERSION/build"
    DESTDIR="$pkgdir" cmake --install "$builddir"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
