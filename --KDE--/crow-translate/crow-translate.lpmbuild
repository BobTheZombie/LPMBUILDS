#!/bin/bash
# LPM Linux KDE independent app - pinned upstream checksum.
# Validate dependencies and CMake features in LPM before distribution.
NAME="crow-translate"
VERSION="4.1.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE desktop translator"
URL="https://apps.kde.org/crow-translate/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/crow-translate/${VERSION}/crow-translate-${VERSION}.tar.gz")
SHA256SUMS=("70cab22a089aa976627fb0f04ea2bf2e918a138c36ff0337d4a7709ea5462fa3")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "qt6-multimedia"
    "qt6-svg"
    "kconfig6"
    "kcoreaddons6"
    "ki18n6"
    "kio6"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "qt6-multimedia"
    "qt6-svg"
    "kconfig6"
    "kcoreaddons6"
    "ki18n6"
    "kio6"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
