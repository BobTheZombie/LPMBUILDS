#!/bin/bash
# LPM Linux KDE independent app - pinned upstream checksum.
# Validate dependencies and CMake features in LPM before distribution.
NAME="kookbook"
VERSION="0.3.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE recipe and cookbook manager"
URL="https://apps.kde.org/kookbook/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/kookbook/kookbook-${VERSION}.tar.xz")
SHA256SUMS=("c32c11e4a5a690267dcdeeb2e919829b08f5fa439da1a19da5e40f4a0649694f")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "qt6-declarative"
    "kconfig6"
    "ki18n6"
    "kio6"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "qt6-declarative"
    "kconfig6"
    "ki18n6"
    "kio6"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
