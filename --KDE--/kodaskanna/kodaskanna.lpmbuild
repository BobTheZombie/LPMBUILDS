#!/bin/bash
# LPM Linux KDE app - pin upstream tarball SHA256.
# Source-specific features and full dependencies require chroot validation.
NAME="kodaskanna"
VERSION="0.2.3"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE barcode and QR code scanner (upstream unstable archive)"
URL="https://apps.kde.org/kodaskanna/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/unstable/kodaskanna/${VERSION}/src/kodaskanna-${VERSION}.tar.xz")
SHA256SUMS=("fcc67d03d233ef987d966907746f04641083a87d42d6ce78d06af95ccd8903cd")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "qt6-declarative"
    "qt6-multimedia"
    "kirigami6"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "qt6-declarative"
    "qt6-multimedia"
    "kirigami6"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
