#!/bin/bash
# LPM Linux: KDE Plasma 6.8.1 package chain
# Generated 2026-10-25; source digests MUST be locked before building.
NAME="kinfocenter"
VERSION="6.8.1"
RELEASE="3"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE Plasma 6: kinfocenter"
URL="https://kde.org"
LICENSE=("SEE-UPSTREAM")
SOURCE=(
    "https://download.kde.org/stable/plasma/6.8.1/kinfocenter-6.8.1.tar.xz"
)
SHA256SUMS=(
    "SKIP"
)
PATCHES=()
REQUIRES=(
    "qt6-base"
    "qt6-declarative"
    "qt6-graphs"
    "ksystemstats"
    "libksysguard"
    "kio6"
    "plasma-workspace"
    "wayland-utils" # Supplies wayland-info for the Wayland KCM
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "qt6-declarative"
    "qt6-graphs"
    "ksystemstats"
    "libksysguard"
    "kio6"
    "plasma-workspace"
)
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=()
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=(
    "libva-utils"        # vainfo: VA-API capabilities
    "vulkan-tools"       # vulkaninfo
    "mesa-demos"         # eglinfo and glxinfo
    "pciutils"           # lspci
    "fwupd"              # fwupdmgr
    "clinfo"             # OpenCL hardware information
    "pipewire"           # multimedia daemon information
    "dmidecode"          # DMI/SMBIOS details
    "aha"                # ANSI to HTML conversion
)
SUGGESTS=()

prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/$NAME-$VERSION/CMakeLists.txt"
}

build() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    local builddir="$src/build"
    cmake -S "$src" -B "$builddir" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DKDE_INSTALL_USE_QT_SYS_PATHS=ON
    cmake --build "$builddir" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    local builddir="$SRCROOT/$NAME-$VERSION/build"
    DESTDIR="$pkgdir" cmake --install "$builddir"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
    # Wayland KCM ships inside KInfoCenter itself. Its data provider comes
    # from the separate wayland-utils package (wayland-info).
    if ! find "$pkgdir/usr" -type f -name 'kcm_wayland.so' -print -quit | grep -q .; then
        echo "[ERROR] KInfoCenter Wayland KCM was not staged" >&2
        return 1
    fi
}
