#!/bin/bash
# LPM Linux: KDE Plasma Breeze, Qt6-only (Plasma 6.8.1).
# Source SHA-256: KDE Plasma 6.8.1 official release manifest.

NAME="breeze"
VERSION="6.8.1"
RELEASE="2"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE Plasma 6 Breeze styles, window decorations, cursors and wallpapers"
URL="https://invent.kde.org/plasma/breeze"
LICENSE=("SEE-UPSTREAM")
SOURCE=(
    "https://download.kde.org/stable/plasma/${VERSION}/breeze-${VERSION}.tar.xz"
)
SHA256SUMS=(
    "b40a63cb297faa6d0fb2e5f1275d66f10f868af9327ef4fec6937ef97f4c1924"
)
PATCHES=()

# LPM package identifiers; KF6/KDecoration dependencies reflect Breeze 6.8.1 CMakeLists.txt.
REQUIRES=(
    "qt6-base"
    "qt6-declarative"
    "qt6-svg"
    "kcoreaddons6"
    "kcolorscheme6"
    "kconfig6"
    "kguiaddons6"
    "ki18n6"
    "kiconthemes6"
    "kwindowsystem6"
    "kcmutils6"
    "kdecoration"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "qt6-declarative"
    "qt6-svg"
    "kcoreaddons6"
    "kcolorscheme6"
    "kconfig6"
    "kguiaddons6"
    "ki18n6"
    "kiconthemes6"
    "kwindowsystem6"
    "kcmutils6"
    "kdecoration"
)
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=()
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/$NAME-$VERSION/CMakeLists.txt"
}

build() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    local builddir="$src/build"

    cmake -S "$src" -B "$builddir" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DKDE_INSTALL_LIBDIR=lib \
        -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DBUILD_TESTING=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_QT5=OFF \
        -DBUILD_QT6=ON \
        -DBUILD_CURSOR=ON \
        -DBUILD_WITH_QTQUICK=ON \
        -DWITH_DECORATIONS=ON \
        -DWITH_WALLPAPERS=ON

    cmake --build "$builddir" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    local builddir="$SRCROOT/$NAME-$VERSION/build"
    test -n "${pkgdir:-}" && test "$pkgdir" != "/"

    DESTDIR="$pkgdir" cmake --install "$builddir"

    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
    test -n "$(find "$pkgdir/usr" -name BreezeConfig.cmake -print -quit)"
}