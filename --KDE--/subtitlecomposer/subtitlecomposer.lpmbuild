#!/bin/bash
# LPM Linux - KDE independently versioned application
# SHA256 pinned; full dependency closure requires chroot validation.
NAME="subtitlecomposer"
VERSION="0.8.2"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE subtitle editing and synchronizing suite"
URL="https://apps.kde.org/subtitlecomposer/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/subtitlecomposer/subtitlecomposer-${VERSION}.tar.xz")
SHA256SUMS=("72e9307f0c7669029f27178cee07395b3dae4cef99accc6720e41fa511b40fe5")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "qt6-declarative"
    "qt6-5compat"
    "kconfig6"
    "kcoreaddons6"
    "kio6"
    "ffmpeg"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "qt6-declarative"
    "qt6-5compat"
    "kconfig6"
    "kcoreaddons6"
    "kio6"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
