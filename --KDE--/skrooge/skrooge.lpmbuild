#!/bin/bash
# LPM Linux - KDE independently versioned application
# SHA256 pinned; full dependency closure requires chroot validation.
NAME="skrooge"
VERSION="26.8.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE personal finance management with encrypted database"
URL="https://apps.kde.org/skrooge/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/skrooge/skrooge-${VERSION}.tar.xz")
SHA256SUMS=("2332234f8b67dd95e63ed7caf21042a4d2792729a9a7f1f5cd52c1040550b353")
PATCHES=()
REQUIRES=(
    "qt6-base"
    "qt6-declarative"
    "qt6-svg"
    "qt6-webengine"
    "karchive6"
    "kconfig6"
    "kcoreaddons6"
    "ki18n6"
    "kio6"
    "sqlcipher"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "extra-cmake-modules"
    "qt6-base"
    "qt6-declarative"
    "qt6-svg"
    "qt6-webengine"
    "karchive6"
    "kconfig6"
    "kcoreaddons6"
    "ki18n6"
    "kio6"
    "sqlcipher"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
check() { :; }
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
}
