#!/bin/bash
# LPM Linux - KDE KNightTime (KWin Night Light)
NAME="knighttime"
VERSION="6.8.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE KNightTime library and daemon for dark/light scheduling"
URL="https://invent.kde.org/plasma/knighttime"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/plasma/${VERSION}/knighttime-${VERSION}.tar.xz")
SHA256SUMS=("d6c5d4dac4c7c9bf7811dae79b7b6ad996b7bec9b688c4bfcf01f1ffe5c6047a")
PATCHES=()
REQUIRES=("glibc" "qt6-base" "qt6-positioning" "kconfig6" "kcoreaddons6" "kdbusaddons6" "kholidays6" "ki18n6")
BUILD_REQUIRES=("cmake" "ninja" "extra-cmake-modules" "qt6-base" "qt6-positioning" "kconfig6" "kcoreaddons6" "kdbusaddons6" "kholidays6" "ki18n6")
PROVIDES=("KNightTime")
CONFLICTS=()
OBSOLETES=()
BUILD_OPTIONS=("@--stripping" "@--optimize=2")

prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/CMakeLists.txt"
}

build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    local builddir="$src/build"
    cmake -S "$src" -B "$builddir" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DKDE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DKDE_INSTALL_USE_QT_SYS_PATHS=ON
    cmake --build "$builddir" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    test -n "${pkgdir:-}" && test "$pkgdir" != "/"
    DESTDIR="$pkgdir" cmake --install "$SRCROOT/${NAME}-${VERSION}/build"
    test -f "$pkgdir/usr/lib/cmake/KNightTime/KNightTimeConfig.cmake"
    compgen -G "$pkgdir/usr/lib/libKNightTime.so*" >/dev/null
}
