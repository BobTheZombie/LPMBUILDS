#!/bin/bash
# LPM Linux - CFITSIO FITS scientific image library
NAME="cfitsio"
VERSION="4.7.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Library for reading and writing FITS images and tables"
URL="https://heasarc.gsfc.nasa.gov/fitsio/"
LICENSE=("CFITSIO")
SOURCE=("https://heasarc.gsfc.nasa.gov/FTP/software/fitsio/c/cfitsio-${VERSION}.tar.gz")
SHA256SUMS=("SKIP") # Pin verified NASA upstream release SHA-256 for production
PATCHES=()
REQUIRES=("glibc" "zlib")
BUILD_REQUIRES=("cmake" "ninja" "zlib")
PROVIDES=("CFitsio")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euo pipefail
    test -f "${SRCROOT:?}/cfitsio-${VERSION}/CMakeLists.txt"
}

build() {
    set -euxo pipefail
    local src="${SRCROOT:?}/cfitsio-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_SHARED_LIBS=ON \
        -DUSE_CURL=OFF \
        -DUSE_PTHREADS=ON \
        -DTESTS=OFF \
        -DITERPROGS=OFF \
        -DUTILS=ON \
        -DUSE_BZIP2=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    local src="${SRCROOT:?}/cfitsio-${VERSION}"
    DESTDIR="${pkgdir:?}" cmake --install "$src/build"
    test -f "$pkgdir/usr/include/fitsio.h"
    test -f "$pkgdir/usr/lib/pkgconfig/cfitsio.pc"
    find "$pkgdir/usr/lib" -maxdepth 1 -name 'libcfitsio.so*' -print -quit | grep -q .
}
