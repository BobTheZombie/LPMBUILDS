#!/bin/bash
# LPM build script for scdoc

NAME="scdoc"
VERSION="1.11.3"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Simple man page generator written in C"
URL="https://git.sr.ht/~sircmpwn/scdoc"
LICENSE=("MIT")

SOURCE=(
  "https://git.sr.ht/~sircmpwn/scdoc/archive/${VERSION}.tar.gz"
)

REQUIRES=(
  "glibc"
)

BUILD_REQUIRES=(
  "make"
  "pkgconf"
)

PROVIDES=(
  "scdoc"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  make PREFIX=/usr
}

check() {
  true
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  make PREFIX=/usr DESTDIR="$pkgdir" install

  test -f "$pkgdir/usr/bin/scdoc"

  for f in LICENSE COPYING; do
    if [ -f "$f" ]; then
      install -Dm644 "$f" \
        "$pkgdir/usr/share/licenses/$NAME/$f"
    fi
  done
}