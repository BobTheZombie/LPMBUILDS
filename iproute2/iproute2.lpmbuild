#!/bin/bash
# LPM networking stack, release snapshot 2026-10-16
NAME="iproute2"
VERSION="7.2.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY='IP routing IPv4 IPv6 traffic control and network namespaces'
URL=https://www.kernel.org/pub/linux/utils/net/iproute2/iproute2-7.2.0.tar.xz
LICENSE=(GPL-2.0-or-later)
SOURCE=(https://www.kernel.org/pub/linux/utils/net/iproute2/iproute2-7.2.0.tar.xz)
SHA256SUMS=(
    "4c2fa124c2cf0afd7ca34d1eeacba6ba048a56f6374e2aab93dafbdbd4eea9c0"
)
PATCHES=()
REQUIRES=(glibc libmnl)
BUILD_REQUIRES=(gcc make pkgconf bison flex libmnl)
PROVIDES=(iproute2 ip ss tc)
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
BUILD_OPTIONS=(@--stripping @--optimize=2)

_source() {
    if [ ! -d "$SRCROOT/${NAME}-${VERSION}" ] && [ -d "$SRCROOT/iproute2-7.2.0" ]; then
        mv "$SRCROOT/iproute2-7.2.0" "$SRCROOT/${NAME}-${VERSION}"
    fi
}

_licenses() {
    local f
    for f in COPYING COPYING.LIB LICENSE LICENSE.txt LICENCE README; do
        if [ -f "$f" ]; then
            install -Dm644 "$f" "$pkgdir/usr/share/licenses/$NAME/$(basename "$f")"
        fi
    done
}
_cleanup() {
    if [ -d "$pkgdir/usr/lib" ]; then
        find "$pkgdir/usr/lib" -type f \( -name '*.a' -o -name '*.la' \) -delete
    fi
    rm -f "$pkgdir/usr/share/info/dir"
}

prepare() { set -euxo pipefail; _source; cd "$SRCROOT/${NAME}-${VERSION}"; test -f Makefile; }
build() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    make -j"${LPM_BUILD_JOBS:-$(nproc)}" SBINDIR=/usr/bin LIBDIR=/usr/lib         ARPD=n SUBDIRS="lib ip tc bridge misc netem genl" HAVE_ELF=n
}
staging() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    make DESTDIR="$pkgdir" SBINDIR=/usr/bin LIBDIR=/usr/lib         ARPD=n SUBDIRS="lib ip tc bridge misc netem genl" HAVE_ELF=n install
    test -x "$pkgdir/usr/bin/ip"
    test -x "$pkgdir/usr/bin/ss"
    test -x "$pkgdir/usr/bin/tc"
    _licenses
}





# Final audited source digests
SHA256SUMS=("4c2fa124c2cf0afd7ca34d1eeacba6ba048a56f6374e2aab93dafbdbd4eea9c0")
