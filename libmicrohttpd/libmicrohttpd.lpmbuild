#!/bin/bash
# LPM build script for GNU libmicrohttpd

NAME="libmicrohttpd"
VERSION="1.0.10"
RELEASE="1"
ARCH="${ARCH:-x86_64}"

SUMMARY="Small HTTP server library"
URL="https://www.gnu.org/software/libmicrohttpd/"
LICENSE=("LGPL-2.1-or-later")

SOURCE=(
    "https://ftp.wayne.edu/gnu/libmicrohttpd/libmicrohttpd-${VERSION}.tar.gz"
)

SHA256SUMS=("SKIP")
PATCHES=()

REQUIRES=("glibc" "gnutls")

BUILD_REQUIRES=(
    "gcc"
    "make"
    "pkgconf"
    "gnutls"
)

PROVIDES=(
    "libmicrohttpd"
    "libmicrohttpd.so"
    "libmicrohttpd.so.12"
)

CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

BUILD_OPTIONS=(
    "@--stripping"
    "@--optimize=2"
)

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    test -f configure
    test -f Makefile.in

    if [ -f Makefile ]; then
        make distclean
    fi
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --includedir=/usr/include \
        --enable-shared \
        --disable-static \
        --enable-https \
        --disable-examples

    make -j"$(nproc)"
}

check() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    make -j"$(nproc)" check
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    make DESTDIR="$pkgdir" install

    find "$pkgdir/usr/lib" \
        -type f \
        \( -name '*.a' -o -name '*.la' \) \
        -delete

    rm -f "$pkgdir/usr/share/info/dir"

    test -e "$pkgdir/usr/lib/libmicrohttpd.so"
    test -e "$pkgdir/usr/lib/libmicrohttpd.so.12"
    test -f "$pkgdir/usr/include/microhttpd.h"
    test -s "$pkgdir/usr/lib/pkgconfig/libmicrohttpd.pc"

    local license_file
    for license_file in COPYING COPYING.LESSER; do
        if [ -f "$license_file" ]; then
            install -Dm644 "$license_file" \
                "$pkgdir/usr/share/licenses/$NAME/$license_file"
        fi
    done
}




