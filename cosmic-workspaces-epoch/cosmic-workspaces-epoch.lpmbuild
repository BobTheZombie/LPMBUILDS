#!/bin/bash
# LPM build script for cosmic-workspaces-epoch

NAME="cosmic-workspaces-epoch"
VERSION="1.0.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="COSMIC workspaces implementation for Epoch"
URL="https://github.com/pop-os/cosmic-workspaces-epoch"
LICENSE=("GPL-3.0-or-later")

SOURCE=(
  "git+https://github.com/pop-os/cosmic-workspaces-epoch.git#commit=cb953ea0e6fb45ac8f62f9c52f1347c971388e03"
)

# Runtime deps (baseline; adjust per component as you refine)
REQUIRES=(
  "glibc"
  "wayland"
  "libxkbcommon"
  "libinput"
  "libseat"
  "mesa"
  "dbus"
)

# Build deps
REQUIRES+=(
  "rust"
  "cargo"
  "pkg-config"
  "gcc"
)

PROVIDES=(
  "cosmic-workspaces-epoch"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="cosmic-workspaces-epoch"

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    : "${CARGO_HOME:=$HOME/.cargo}"
    export CARGO_HOME

    cargo build --release --locked
}

check() {
    true
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"
    cargo install --path . --root "${pkgdir}/usr"
 
}




# Final audited source digests
SHA256SUMS=("SKIP")
