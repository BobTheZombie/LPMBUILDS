#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="meson"
VERSION="1.12.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="High productivity build system"
URL="https://github.com/mesonbuild/meson/releases/download/1.12.0/meson-1.12.0.tar.gz"
LICENSE=("Apache-2.0")
SOURCE=("https://github.com/mesonbuild/meson/releases/download/1.12.0/meson-1.12.0.tar.gz")
SHA256SUMS=("88afe0c20e52030218924ac37d0c81c59b4b5f3ae3752c8c6d7470c7d365886c")
PATCHES=()
REQUIRES=("python")
BUILD_REQUIRES=("python" "python-setuptools")
PROVIDES=("meson")
CONFLICTS=()
OBSOLETES=()

_srcdir="meson-1.12.0"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    :
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    python3 -m pip wheel --no-cache-dir --no-build-isolation --no-deps --wheel-dir=dist .
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    python3 -m pip install --root="$pkgdir" --prefix=/usr --ignore-installed --no-deps --no-index --no-compile dist/*.whl

    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
