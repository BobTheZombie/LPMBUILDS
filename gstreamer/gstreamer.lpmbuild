#!/bin/bash
# LPM Linux standalone build recipe for gstreamer 1.28.8
# GStreamer coordinated stable series 1.28.8; Orc is versioned separately.
NAME="gstreamer"
VERSION="1.28.8"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="GStreamer multimedia core libraries, utilities and plugin framework"
URL="https://gstreamer.freedesktop.org/"
LICENSE=("LGPL-2.1-or-later")
SOURCE=("https://gstreamer.freedesktop.org/src/${NAME}/${NAME}-${VERSION}.tar.xz")
SHA256SUMS=("baa8e86985ad6417cc0ad6e7b79ff2884c6779c8b1c7a6240e7121822c86e524")
PATCHES=()
REQUIRES=(
    "glibc"
    "glib2"
    "orc"
)
BUILD_REQUIRES=(
    "meson"
    "ninja"
    "pkgconf"
    "python"
    "bison"
    "flex"
    "gobject-introspection"
)
PROVIDES=("${NAME}")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
BUILD_OPTIONS=("@--stripping" "@--optimize=2")

_gst_srcdir() {
    local candidate
    for candidate in         "$SRCROOT/${NAME}-${VERSION}"         "$SRCROOT/${NAME}"         "$SRCROOT"; do
        if [[ -f "$candidate/meson.build" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    echo "[ERROR] Cannot locate extracted $NAME $VERSION source in $SRCROOT" >&2
    return 1
}

prepare() {
    set -euxo pipefail
    local srcdir
    srcdir="$(_gst_srcdir)"
    rm -rf "$srcdir/build"
}

build() {
    set -euxo pipefail
    local srcdir
    srcdir="$(_gst_srcdir)"
    meson setup "$srcdir/build" "$srcdir" \
    --prefix=/usr \
    --libdir=lib \
    --buildtype=release \
    --wrap-mode=nodownload \
    -Dintrospection=enabled \
    -Dexamples=disabled \
    -Dtests=disabled \
    -Ddoc=disabled \
    -Dtools=enabled \
    -Ddefault_library=shared
    meson compile -C "$srcdir/build" -j "${LPM_BUILD_JOBS:-$(nproc)}"
}

check() {
    # Runtime tests are not run against the packaging host; stage checks follow.
    set -euxo pipefail
    local srcdir
    srcdir="$(_gst_srcdir)"
    test -f "$srcdir/build/build.ninja"
}

staging() {
    set -euxo pipefail
    local srcdir
    srcdir="$(_gst_srcdir)"
    DESTDIR="$pkgdir" meson install -C "$srcdir/build" --no-rebuild
    test -e "$pkgdir/usr/lib/pkgconfig/gstreamer-1.0.pc" || { echo "[ERROR] Missing staged file: /usr/lib/pkgconfig/gstreamer-1.0.pc" >&2; return 1; }
    test -e "$pkgdir/usr/lib/pkgconfig/gstreamer-base-1.0.pc" || { echo "[ERROR] Missing staged file: /usr/lib/pkgconfig/gstreamer-base-1.0.pc" >&2; return 1; }
    test -e "$pkgdir/usr/bin/gst-inspect-1.0" || { echo "[ERROR] Missing staged file: /usr/bin/gst-inspect-1.0" >&2; return 1; }
    test -x "$pkgdir/usr/bin/gst-launch-1.0"

    if [[ -f "$srcdir/COPYING" ]]; then
        install -Dm644 "$srcdir/COPYING" \
            "$pkgdir/usr/share/licenses/$NAME/COPYING"
    fi
    echo "[OK] $NAME $VERSION staged"
}
