#!/bin/bash
# LPM build script for libIDL2

NAME="libidl2"
VERSION="0.8.14"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Library for parsing CORBA IDL files"
URL="https://ftp.gnome.org/pub/gnome/sources/libIDL/"
LICENSE=("LGPL-2.1-or-later")

SOURCE=(
  "https://download.gnome.org/sources/libIDL/0.8/libIDL-${VERSION}.tar.bz2"
)

SHA256SUMS=("SKIP")

REQUIRES=(
  "glib2"
)

BUILD_REQUIRES=(
  "make"
  "pkgconf"
  "glib2"
)

PROVIDES=(
  "libidl2"
  "libIDL-2.so"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --libdir=/usr/lib \
    --disable-static

  make -j"$(nproc)"
}

check() {
  true
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  make DESTDIR="$pkgdir" install

  test -f "$pkgdir/usr/lib/libIDL-2.so"

  for f in COPYING LICENSE; do
    if [ -f "$f" ]; then
      install -Dm644 "$f" \
        "$pkgdir/usr/share/licenses/$NAME/$f"
    fi
  done
}
