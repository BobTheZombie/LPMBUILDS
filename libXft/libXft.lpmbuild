#!/bin/bash
NAME="libXft"
VERSION="2.3.9"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="libXft from X.Org"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=(
  "https://www.x.org/releases/individual/lib/${NAME}-${VERSION}.tar.xz"
)

REQUIRES=(
  "glibc"
  "libXrender"
  "freetype"
  "fontconfig"
)

PROVIDES=("libXft")
CONFLICTS=()
OBSOLETES=("libxft")

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  ./configure --prefix=/usr
  make -j"$(nproc)"
}

check() { true; }

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  DESTDIR="$pkgdir" make install
  [ -f COPYING ] && install -Dm644 COPYING "$pkgdir/usr/share/licenses/$NAME/COPYING"
}




# Final audited source digests
SHA256SUMS=("60a25b78945ed6932635b3bb1899a517d31df7456e69867ffba27f89ff3976f5")
