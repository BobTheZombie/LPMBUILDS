#!/bin/bash
# LPM build script for dbus-broker
# Linux D-Bus message broker (drop-in dbus-daemon replacement)

NAME="dbus-broker"
VERSION="37"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Linux D-Bus message broker"
URL="https://github.com/bus1/dbus-broker"
LICENSE="Apache-2.0"

SOURCE=(
  "https://github.com/bus1/dbus-broker/releases/download/v${VERSION}/dbus-broker-${VERSION}.tar.xz"
)

REQUIRES=(
  "glibc"
  "systemd"
  "libcap"
  "meson"
  "ninja"
  "pkg-config"
  "gcc"
)

PROVIDES=(
  "dbus-broker"
)

CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

_srcdir="${NAME}-${VERSION}"

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"
    mkdir -p build
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    meson setup build \
        --prefix=/usr \
        --sysconfdir=/etc \
        --buildtype=release

    meson compile -C build
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    DESTDIR="$pkgdir" meson install -C build

    # Strip ELF binaries
    if command -v strip >/dev/null 2>&1; then
        find "$pkgdir/usr" -type f -exec sh -c '
            case "$(file -b "$1")" in
              *ELF*executable*|*ELF*shared\ object*)
                  strip --strip-unneeded "$1" 2>/dev/null || true
              ;;
            esac
        ' _ {} \;
    fi
}

