#!/bin/bash
# LPM Linux - qpdf 12.4.2 (PDF manipulation and shared library)
NAME="qpdf"
VERSION="12.4.2"
RELEASE="1"
ARCH="${ARCH:-x86_64}"

SUMMARY="PDF transformation and manipulation library and CLI"
URL="https://qpdf.sourceforge.io/"
LICENSE=("Apache-2.0")
SOURCE=("https://github.com/qpdf/qpdf/releases/download/v${VERSION}/qpdf-${VERSION}.tar.gz")
SHA256SUMS=("8a58af5b6141319287c1883bec8bd1bd545b7567b7fc5e6ce5d25a1c85f36397")
PATCHES=()

REQUIRES=(
    "glibc"
    "gcc-libs"
    "zlib"
    "libjpeg"
    "openssl"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "zlib"
    "libjpeg"
    "openssl"
)

prepare() {
    set -euxo pipefail
    test -f "${SRCROOT:?}/qpdf-${VERSION}/CMakeLists.txt"
}

build() {
    set -euxo pipefail
    local src="${SRCROOT:?}/qpdf-${VERSION}"
    local bld="$src/build"
    cmake -S "$src" -B "$bld" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_STATIC_LIBS=OFF \
        -DBUILD_DOC=OFF \
        -DINSTALL_MANUAL=OFF \
        -DINSTALL_PKGCONFIG=ON \
        -DINSTALL_CMAKE_PACKAGE=ON \
        -DINSTALL_EXAMPLES=OFF \
        -DREQUIRE_CRYPTO_OPENSSL=ON \
        -DDEFAULT_CRYPTO=openssl \
        -DWERROR=OFF
    cmake --build "$bld" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    local src="${SRCROOT:?}/qpdf-${VERSION}"
    DESTDIR="${pkgdir:?}" cmake --install "$src/build"
    test -x "$pkgdir/usr/bin/qpdf"
    test -f "$pkgdir/usr/lib/pkgconfig/libqpdf.pc" || test -f "$pkgdir/usr/lib/pkgconfig/qpdf.pc"
    test -f "$pkgdir/usr/include/qpdf/QPDF.hh"
    find "$pkgdir/usr/lib" -maxdepth 1 -name 'libqpdf.so*' -print -quit | grep -q .
}
