#!/bin/bash
# LPM build script for mtdev

NAME="mtdev"
VERSION="1.1.7"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Multitouch Protocol Translation Library"
URL="https://bitmath.org/code/mtdev/"
LICENSE=("MIT")

SOURCE=(
  "https://bitmath.org/code/mtdev/mtdev-${VERSION}.tar.bz2"
)

REQUIRES=(
  "glibc"
)

BUILD_REQUIRES=(
  "make"
  "pkgconf"
)

PROVIDES=(
  "mtdev"
  "libmtdev.so"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  ./configure \
    --prefix=/usr \
    --libdir=/usr/lib \
    --disable-static

  make -j"$(nproc)"
}

check() {
  true
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  make DESTDIR="$pkgdir" install

  test -f "$pkgdir/usr/lib/libmtdev.so"

  for f in COPYING LICENSE; do
    if [ -f "$f" ]; then
      install -Dm644 "$f" \
        "$pkgdir/usr/share/licenses/$NAME/$f"
    fi
  done
}
