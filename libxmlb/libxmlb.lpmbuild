#!/bin/bash
NAME="libxmlb"
VERSION="0.3.27"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Binary XML metadata storage for AppStream"
URL="https://github.com/hughsie/libxmlb"
LICENSE=("LGPL-2.1-or-later")
SOURCE=("https://github.com/hughsie/libxmlb/releases/download/${VERSION}/libxmlb-${VERSION}.tar.xz")
SHA256SUMS=("63fa0275f7454d77c10e0af37f79dfdb071821caf429a57dbd9598ea3a9defd6")
PATCHES=()
REQUIRES=("glibc" "glib2" "xz" "zstd")
BUILD_REQUIRES=("meson" "ninja" "pkgconf" "glib2" "xz" "zstd" "python")
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=("xmlb")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/meson.build"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    meson setup "$src/build" "$src" \
        --prefix=/usr --libdir=lib --buildtype=release --wrap-mode=nodownload \
        -Dgtkdoc=false -Dintrospection=false -Dtests=false -Dstemmer=false \
        -Dlzma=enabled -Dzstd=enabled
    meson compile -C "$src/build" -j "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    DESTDIR="$pkgdir" meson install -C "$src/build" --no-rebuild
    test -f "$pkgdir/usr/lib/pkgconfig/xmlb.pc"
}
