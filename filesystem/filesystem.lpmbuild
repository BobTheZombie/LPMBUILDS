#!/bin/bash
# LPM build script for RyzenOS filesystem

NAME="filesystem"
VERSION="1.0.0"
RELEASE="6"
ARCH="any"
SUMMARY="Base filesystem layout and system defaults for RyzenOS"
URL="https://gitlab.com/lpm-org/packages"
LICENSE=("GPL-2.0-or-later")

SOURCE=(
  "os-release"
  "issue"
  "motd"
  "nsswitch.conf"
  "shells"
  "profile"
  "filesystem.sysusers"
  "filesystem.tmpfiles"
)

SHA256SUMS=(
  "SKIP"
  "SKIP"
  "SKIP"
  "SKIP"
  "SKIP"
  "SKIP"
  "SKIP"
  "SKIP"
)

REQUIRES=(
  "glibc"
  "systemd"
)

BUILD_REQUIRES=()

PROVIDES=(
  "filesystem"
  "fhs-filesystem"
)

CONFLICTS=()
OBSOLETES=()

prepare() { true; }

build() { true; }

check() { true; }

staging() {
  set -euxo pipefail

  #
  # Root filesystem hierarchy
  #

  install -dm755 "$pkgdir"/{boot,dev,etc,home,media,mnt,opt,proc,run,srv,sys,usr,var}

  install -dm750 "$pkgdir/root"
  install -dm1777 "$pkgdir/tmp"

  #
  # usr-merge compatibility links
  #

  ln -sfn usr/bin "$pkgdir/bin"
  ln -sfn usr/bin "$pkgdir/sbin"
  ln -sfn usr/lib "$pkgdir/lib"
  ln -sfn usr/lib "$pkgdir/lib64"

  #
  # /usr hierarchy
  #

  install -dm755 "$pkgdir"/usr/{bin,lib,include,src,share,local,libexec}

  install -dm755 "$pkgdir"/usr/share/{doc,info,licenses,locale,man,misc,pixmaps,applications,icons,mime,themes,fonts,zoneinfo,factory}

  install -dm755 "$pkgdir"/usr/share/man/{man1,man2,man3,man4,man5,man6,man7,man8}

  #
  # /usr/local hierarchy
  #

  install -dm755 "$pkgdir"/usr/local/{bin,lib,include,src,share,etc}

  install -dm755 "$pkgdir"/usr/local/share/{man,doc,info}

  install -dm755 "$pkgdir"/usr/local/share/man/{man1,man2,man3,man4,man5,man6,man7,man8}

  #
  # /etc hierarchy
  #

  install -dm755 "$pkgdir"/etc/{default,profile.d,skel,sysctl.d,tmpfiles.d,sysusers.d,ld.so.conf.d,modprobe.d,modules-load.d,pam.d,security,ssl}

  install -dm755 \
    "$pkgdir/etc/X11" \
    "$pkgdir/etc/xdg"

  #
  # /var hierarchy
  #

  install -dm755 "$pkgdir"/var/{cache,lib,local,log,opt,spool}

  install -dm1777 "$pkgdir/var/tmp"

  install -dm755 "$pkgdir"/var/lib/{misc,systemd}

  install -dm755 "$pkgdir"/var/spool/{mail,cron}

  install -dm1777 "$pkgdir/var/spool/samba"

  #
  # Runtime compatibility
  #
  # /run is tmpfs at runtime.
  # /run/lock is created by systemd-tmpfiles.
  #

  ln -sfn ../run/lock "$pkgdir/var/lock"

  #
  # OS identity
  #

  install -Dm644 \
    "$SRCROOT/os-release" \
    "$pkgdir/etc/os-release"

  install -dm755 "$pkgdir/usr/lib"

  ln -sfn /etc/os-release \
    "$pkgdir/usr/lib/os-release"

  #
  # Factory defaults
  #
  # These are generic distribution defaults only.
  #
  # Machine-specific files MUST NOT be supplied here:
  #
  #   /etc/fstab
  #   /etc/hostname
  #   /etc/resolv.conf
  #   /etc/machine-id
  #
  # fstab is generated by the installer/bootstrap process.
  # hostname is configured by the installer or hostnamectl.
  # resolv.conf is managed by the networking stack.
  # machine-id is created by systemd-machine-id-setup.
  #

  install -dm755 "$pkgdir/usr/share/factory/etc"

  install -Dm644 \
    "$SRCROOT/issue" \
    "$pkgdir/usr/share/factory/etc/issue"

  install -Dm644 \
    "$SRCROOT/motd" \
    "$pkgdir/usr/share/factory/etc/motd"

  install -Dm644 \
    "$SRCROOT/nsswitch.conf" \
    "$pkgdir/usr/share/factory/etc/nsswitch.conf"

  install -Dm644 \
    "$SRCROOT/shells" \
    "$pkgdir/usr/share/factory/etc/shells"

  install -Dm644 \
    "$SRCROOT/profile" \
    "$pkgdir/usr/share/factory/etc/profile"

  #
  # Default locale profile
  #

  install -dm755 \
    "$pkgdir/usr/share/factory/etc/profile.d"

  cat > "$pkgdir/usr/share/factory/etc/profile.d/locale.sh" <<'EOF'
[ -z "${LANG:-}" ] && export LANG=C.UTF-8
EOF

  chmod 644 \
    "$pkgdir/usr/share/factory/etc/profile.d/locale.sh"

  #
  # Default hosts file
  #

  cat > "$pkgdir/usr/share/factory/etc/hosts" <<'EOF'
127.0.0.1 localhost
::1       localhost
EOF

  chmod 644 \
    "$pkgdir/usr/share/factory/etc/hosts"

  #
  # Dynamic linker configuration
  #

  cat > "$pkgdir/usr/share/factory/etc/ld.so.conf" <<'EOF'
include /etc/ld.so.conf.d/*.conf
EOF

  chmod 644 \
    "$pkgdir/usr/share/factory/etc/ld.so.conf"

  install -dm755 \
    "$pkgdir/usr/share/factory/etc/ld.so.conf.d"

  cat > "$pkgdir/usr/share/factory/etc/ld.so.conf.d/libc.conf" <<'EOF'
/usr/local/lib
/usr/lib
EOF

  chmod 644 \
    "$pkgdir/usr/share/factory/etc/ld.so.conf.d/libc.conf"

  #
  # systemd sysusers/tmpfiles configuration
  #

  install -Dm644 \
    "$SRCROOT/filesystem.sysusers" \
    "$pkgdir/usr/lib/sysusers.d/filesystem.conf"

  install -Dm644 \
    "$SRCROOT/filesystem.tmpfiles" \
    "$pkgdir/usr/lib/tmpfiles.d/filesystem.conf"

  #
  # Preserve otherwise-empty persistent directories
  #

  touch "$pkgdir/etc/skel/.keep"
  touch "$pkgdir/var/lib/misc/.keep"
  touch "$pkgdir/var/log/.keep"

  chmod 644 \
    "$pkgdir/etc/skel/.keep" \
    "$pkgdir/var/lib/misc/.keep" \
    "$pkgdir/var/log/.keep"

  #
  # Package sanity checks
  #

  test -L "$pkgdir/bin"
  test -L "$pkgdir/sbin"
  test -L "$pkgdir/lib"
  test -L "$pkgdir/lib64"

  test -L "$pkgdir/var/lock"

  #
  # Runtime-only paths must not be packaged.
  #

  test ! -e "$pkgdir/run/lock"
  test ! -e "$pkgdir/run/user"
  test ! -e "$pkgdir/var/run"

  #
  # Machine-specific/stateful files must NEVER be owned or supplied
  # by the filesystem package.
  #

  test ! -e "$pkgdir/etc/fstab"
  test ! -e "$pkgdir/usr/share/factory/etc/fstab"

  test ! -e "$pkgdir/etc/hostname"
  test ! -e "$pkgdir/usr/share/factory/etc/hostname"

  test ! -e "$pkgdir/etc/resolv.conf"
  test ! -e "$pkgdir/usr/share/factory/etc/resolv.conf"

  test ! -e "$pkgdir/etc/machine-id"
  test ! -e "$pkgdir/usr/share/factory/etc/machine-id"

  #
  # Ensure the factory directory contains no accidental machine-specific
  # configuration files.
  #

  if find "$pkgdir/usr/share/factory/etc" \
      \( -name fstab \
      -o -name hostname \
      -o -name resolv.conf \
      -o -name machine-id \) \
      -print -quit | grep -q .; then
    echo "ERROR: filesystem package contains machine-specific configuration." >&2
    exit 1
  fi
}
