#!/bin/bash
NAME="ocl-icd"
VERSION="2.3.3"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="OpenCL ICD loader providing libOpenCL.so"
URL="https://github.com/OCL-dev/ocl-icd"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://github.com/OCL-dev/ocl-icd/archive/refs/tags/v2.3.3.tar.gz")
SHA256SUMS=("SKIP") # Must verify upstream archive digest before release
PATCHES=()
REQUIRES=("glibc")
BUILD_REQUIRES=("gcc" "make" "autoconf" "automake" "libtool" "pkgconf" "opencl-headers")
PROVIDES=("ocl-icd" "libOpenCL.so")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/$NAME-$VERSION/configure.ac"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    cd "$src"
        if [[ ! -x ./configure ]]; then autoreconf -fi; fi
        ./configure --prefix=/usr --libdir=/usr/lib
        make -j "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    make -C "$src" install DESTDIR="$pkgdir"
        test -e "$pkgdir/usr/lib/libOpenCL.so"
}
