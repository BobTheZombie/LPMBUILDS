#!/bin/bash
NAME="clinfo"
VERSION="3.0.23.01.25"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="OpenCL device and driver diagnostics"
URL="https://github.com/Oblomov/clinfo"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://github.com/Oblomov/clinfo/archive/refs/tags/3.0.23.01.25.tar.gz")
SHA256SUMS=("SKIP") # Must verify upstream archive digest before release
PATCHES=()
REQUIRES=("glibc" "ocl-icd")
BUILD_REQUIRES=("gcc" "make" "opencl-headers" "ocl-icd")
PROVIDES=("clinfo")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/$NAME-$VERSION/Makefile"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    make -C "$src" -j "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    make -C "$src" install PREFIX=/usr MANDIR=/usr/share/man DESTDIR="$pkgdir"
        test -x "$pkgdir/usr/bin/clinfo"
}
