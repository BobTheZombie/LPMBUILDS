#!/bin/bash
# LPM build script for json-glib
# GLib-based JSON parser/generator; required by geoclue and geocode-glib.

NAME="json-glib"
VERSION="1.10.6"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="GLib JSON manipulation library"
URL="https://gitlab.gnome.org/GNOME/json-glib"
LICENSE=("LGPL-2.1-or-later")

SOURCE=(
  "https://download.gnome.org/sources/json-glib/1.10/json-glib-${VERSION}.tar.xz"
)

REQUIRES=(
  "glibc"
  "glib2"
  "gobject-introspection"
  "gettext"
  "libffi"
  "zlib"
  "meson"
  "ninja"
  "pkgconf"
)

PROVIDES=(
  "json-glib"
  "libjson-glib-1.0.so"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="json-glib-${VERSION}"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  export PKG_CONFIG_PATH="/usr/lib/pkgconfig:/usr/share/pkgconfig:${PKG_CONFIG_PATH:-}"

  rm -rf build

  meson setup build \
    --prefix=/usr \
    --libdir=lib \
    --buildtype=release \
    -Ddefault_library=shared \
    -Dgtk_doc=disabled \
    -Dtests=false \
    -Dintrospection=enabled

  meson compile -C build
}

check() { true; }

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  DESTDIR="$pkgdir" meson install -C build

  for f in COPYING LICENSE; do
    if [ -f "$f" ]; then
      install -Dm644 "$f" "$pkgdir/usr/share/licenses/$NAME/$f"
    fi
  done
}
