#!/bin/bash
# LPM build script for xorg-util-macros

NAME="util-macros"
VERSION="1.20.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="X.Org autoconf macros"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=(
  "https://www.x.org/releases/individual/util/util-macros-${VERSION}.tar.xz"
)

REQUIRES=(
  "glibc"
  "m4"
  "autoconf"
  "automake"
  "pkg-config"
)

PROVIDES=("util-macros" "xorg-util-macros")
CONFLICTS=()
OBSOLETES=()

_srcdir="util-macros-${VERSION}"

prepare() {
    set -euxo pipefail
    cd "$SRCROOT"
    tar xf "util-macros-${VERSION}.tar.xz"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    ./configure --prefix=/usr
    make -j"$(nproc)"
}

check() {
    true
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    DESTDIR="$pkgdir" make install

    # License
    [ -f COPYING ] && install -Dm644 COPYING "$pkgdir/usr/share/licenses/$NAME/COPYING"
}

