#!/bin/bash
NAME="util-macros"
VERSION="1.20.2"
RELEASE="2"
ARCH="any"
SUMMARY="Compatibility dependency on xorg-util-macros"
URL="https://gitlab.com/lpm-org/packages"
LICENSE=("MIT")
SOURCE=()
SHA256SUMS=()
PATCHES=()
REQUIRES=("xorg-util-macros")
BUILD_REQUIRES=()
PROVIDES=("util-macros")
CONFLICTS=()
OBSOLETES=()
prepare() { true; }
build() { true; }
staging() {
    install -dm755 "$pkgdir/usr/share/doc/$NAME"
    printf '%s\n' 'Compatibility dependency: xorg-util-macros owns the payload.' > "$pkgdir/usr/share/doc/$NAME/README"
}




# Final audited source digests
SHA256SUMS=()
