#!/bin/bash
# LPM build script for xrandr

NAME="xrandr"
VERSION="1.5.3"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Primitive command line interface to the RandR extension"
URL="https://xorg.freedesktop.org/"
LICENSE="HPND-sell-variant"

SOURCE=(
  "https://www.x.org/archive//individual/app/${NAME}-${VERSION}.tar.xz"
)

REQUIRES=(
  "glibc"
  "libX11"
  "libXrandr"
  "libXrender"
)

PROVIDES=("xrandr")
CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
    set -euxo pipefail
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    ./configure --prefix=/usr
    make -j"$(nproc)"
}

check() { true; }

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    DESTDIR="$pkgdir" make install
}
