NAME="cmake"
VERSION="4.1.2"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Cross-platform build system generator"
URL="https://cmake.org/"
SOURCE=("https://github.com/Kitware/CMake/releases/download/v${VERSION}/cmake-${VERSION}.tar.gz")
LICENSE=("BSD-3-Clause")

REQUIRES=("glibc" "cppdap" "curl" "expat" "gcc-libs" "jsoncpp" "libarchive" "libuv" "ncurses" "openssl" "rhash" "zlib" "bzip2" "xz")
PROVIDES=("cmake")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/cmake-${VERSION}"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/cmake-${VERSION}"
    cmake -B build -S . \
        -G Ninja \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_USE_SYSTEM_LIBRARIES=ON \
        -DCMAKE_DOC_DIR=/usr/share/doc/cmake
    ninja -C build -j"$(nproc)"
}
staging() {
    set -euxo pipefail
    cd "$SRCROOT/cmake-${VERSION}"
    DESTDIR="$pkgdir" ninja -C build install
}

