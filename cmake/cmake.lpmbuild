NAME="cmake"
VERSION="4.4.4"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Cross-platform build system generator"
URL="https://cmake.org/"
SOURCE=("https://github.com/Kitware/CMake/releases/download/v${VERSION}/cmake-${VERSION}.tar.gz")
LICENSE=("BSD-3-Clause")

REQUIRES=("glibc" "curl" "expat" "gcc-libs" "jsoncpp" "libarchive" "libuv" "ncurses" "rhash" "zlib")
PROVIDES=("cmake")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/cmake-${VERSION}"
    
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/cmake-${VERSION}"
    ./bootstrap --prefix=/usr \
    --mandir=/share/man \
    --docdir=/share/doc/cmake \
    --datadir=/share/cmake \
    --system-libs \
    --no-debugger \
    --parallel=$(/usr/bin/getconf _NPROCESSORS_ONLN)
  make -j6

}
staging() {
    set -euxo pipefail
    cd "$SRCROOT/cmake-${VERSION}"
    make DESTDIR="${pkgdir}" install

}





