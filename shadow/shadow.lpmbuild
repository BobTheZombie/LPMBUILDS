NAME="shadow"
VERSION="4.20.3"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Password and account management tool suite (full PAM version)"
URL="https://github.com/shadow-maint/shadow"
SOURCE=(
  "https://github.com/shadow-maint/shadow/releases/download/${VERSION}/shadow-${VERSION}.tar.xz"
  "0002-Adapt-login.defs-for-PAM-and-util-linux.patch"
  "0003-Add-Arch-Linux-defaults-for-login.defs.patch"
  "shadow.timer"
  "shadow.service"
  "shadow.sysusers"
  "shadow.tmpfiles"
  "useradd.defaults"
)
LICENSE="BSD-3-Clause"

REQUIRES=("glibc" "pam" "libxcrypt" "systemd")
PROVIDES=("shadow")
OBSOLETES=("shadow-bootstrap")

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    test -x configure
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/shadow-$VERSION"

    ./configure --prefix=/usr \
        --sysconfdir=/etc \
        --bindir=/usr/bin \
        --sbindir=/usr/bin \
        --libdir=/usr/lib \
        --mandir=/usr/share/man \
        --enable-man \
        --disable-static \
        --disable-account-tools-setuid \
        --with-yescrypt \
        --without-bcrypt \
        --with-libpam \
        --with-libbsd \
        --with-audit \
        --with-fcaps \
        --with-group-name-max-length=32

    make -j"$(nproc)"
}

_staging_shadow_upstream() {
    set -euxo pipefail
    cd "$SRCROOT/shadow-$VERSION"
    make DESTDIR="$pkgdir" install

    # Default useradd config
    install -vDm600 ../useradd.defaults "$pkgdir/etc/default/useradd"

    # Systemd integration
    install -vDm644 ../shadow.service -t "$pkgdir/usr/lib/systemd/system/"
    install -vDm644 ../shadow.timer -t "$pkgdir/usr/lib/systemd/system/"
    install -vdm755 "$pkgdir/usr/lib/systemd/system/timers.target.wants"
    ln -s ../shadow.timer "$pkgdir/usr/lib/systemd/system/timers.target.wants/shadow.timer"

    # Sysusers + tmpfiles config
    install -vDm644 ../shadow.sysusers "$pkgdir/usr/lib/sysusers.d/shadow.conf"
    install -vDm644 ../shadow.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/shadow.conf"
}



SOURCE=("https://github.com/shadow-maint/shadow/releases/download/4.20.3/shadow-4.20.3.tar.xz" "shadow.timer" "shadow.service" "shadow.sysusers" "shadow.tmpfiles" "useradd.defaults" "shadow-4.20.3-lpm-policy.patch")

PATCHES=("shadow-4.20.3-lpm-policy.patch")
REQUIRES+=("libbsd" "audit" "libcap")
BUILD_REQUIRES=("gcc" "make" "pkgconf" "libbsd" "libmd" "pam" "libxcrypt" "audit" "libcap" "xmlto" "docbook-xsl-nons")
# util-linux/coreutils own replacement programs; preserve shadow's account tools.
staging() {
    set -euxo pipefail
    install -dm755 "$pkgdir/usr/lib/systemd/system"
    _staging_shadow_upstream
    local tool
    if [ -f "$pkgdir/usr/bin/newgrp" ]; then
        cp --remove-destination -p "$pkgdir/usr/bin/newgrp" "$pkgdir/usr/bin/sg"
    fi
    for tool in chfn chsh login newgrp nologin su vipw vigr groups logoutd; do
        rm -f "$pkgdir/usr/bin/$tool" "$pkgdir/usr/sbin/$tool"
        find "$pkgdir/usr/share/man" -type f -name "$tool.[1-8]*" -delete
    done
    rm -f "$pkgdir/etc/pam.d/chfn" "$pkgdir/etc/pam.d/chsh" "$pkgdir/etc/pam.d/login"
    test -x "$pkgdir/usr/bin/passwd"
    test -x "$pkgdir/usr/bin/useradd"
}



