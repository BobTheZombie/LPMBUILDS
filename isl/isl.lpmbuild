NAME="isl"
VERSION="0.26"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Integer Set Library for polyhedral compilation"
URL="https://libisl.sourceforge.io/isl-${VERSION}.tar.xz"
LICENSE="MIT"

REQUIRES=(gmp)
PROVIDES=(isl)
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT"
    tarball="$(basename "$URL")"
    [ -f "$tarball" ] && tar -xf "$tarball"
    mkdir -p "$SRCROOT/isl-${VERSION}/build"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/isl-${VERSION}/build"
    ../configure \
        --prefix=/usr \
        --disable-static \
        --docdir=/usr/share/doc/isl-${VERSION}
    make -j"$(nproc)"
}

install() {
    set -euxo pipefail
    cd "$SRCROOT/isl-${VERSION}/build"
    make DESTDIR="$pkgdir" install
}

