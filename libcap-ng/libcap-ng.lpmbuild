NAME="libcap-ng"
VERSION="0.8.4"
RELEASE="1"
ARCH="x86_64"
SUMMARY="POSIX capabilities library and utilities"
URL="https://people.redhat.com/sgrubb/libcap-ng/"
SOURCE=("https://people.redhat.com/sgrubb/libcap-ng/libcap-ng-0.8.4.tar.gz")
LICENSE=("LGPL-2.1-or-later")

REQUIRES=("glibc")
PROVIDES=("libcap-ng" "libcap-ng.so" "libcap-ng-utils")

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/$NAME-$VERSION"

    # make autotools happy
    touch NEWS
    autoreconf -fiv
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$NAME-$VERSION"

    ./configure \
        --prefix=/usr \
        --disable-static \
        --without-python \
        --without-python3
    make -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$NAME-$VERSION"

    make DESTDIR="$pkgdir" install

    # Ensure soname symlinks are correct
    if [ -f "$pkgdir/usr/lib/libcap-ng.so.0" ]; then
        ln -sf libcap-ng.so.0 "$pkgdir/usr/lib/libcap-ng.so"
    fi
}
