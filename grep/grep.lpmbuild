#!/bin/bash
# LPM build script for GNU grep

NAME="grep"
VERSION="3.12"
RELEASE="1"
ARCH="${ARCH:-x86_64}"

SUMMARY="GNU text searching utilities with PCRE2 support"
URL="https://www.gnu.org/software/grep/"
LICENSE=("GPL-3.0-or-later")

SOURCE=(
    "https://ftp.wayne.edu/gnu/grep/grep-${VERSION}.tar.xz"
)

SHA256SUMS=(
    "2649b27c0e90e632eadcd757be06c6e9a4f48d941de51e7c0f83ff76408a07b9"
)

PATCHES=()

REQUIRES=(
    "glibc"
    "pcre2"
)

BUILD_REQUIRES=(
    "gcc"
    "gettext"
    "make"
    "pcre2"
    "perl"
    "pkgconf"
    "texinfo"
)

PROVIDES=(
    "grep"
    "egrep"
    "fgrep"
)

CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

BUILD_OPTIONS=(
    "@--stripping"
    "@--optimize=2"
)

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    test -x configure
    test -f Makefile.in
    test -f COPYING

    if [ -f Makefile ]; then
        make distclean
    fi
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    ./configure \
        --prefix=/usr \
        --bindir=/usr/bin \
        --libdir=/usr/lib \
        --sysconfdir=/etc \
        --mandir=/usr/share/man \
        --infodir=/usr/share/info \
        --enable-perl-regexp \
        --disable-rpath

    make -j"${LPM_BUILD_JOBS:-$(nproc)}"
}

check() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    test "$(
        printf '%s\n' 'LPM123' |
            ./src/grep -Po '[0-9]+'
    )" = 123

    test "$(
        printf '%s\n' alpha beta |
            ./src/grep -E '^a.+a$'
    )" = alpha

    test "$(
        printf '%s\n' 'a.b' 'axb' |
            ./src/grep -F 'a.b'
    )" = 'a.b'

    LC_ALL=C make check
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    make -j1 DESTDIR="$pkgdir" install

    rm -f "$pkgdir/usr/share/info/dir"

    local program
    for program in grep egrep fgrep; do
        test -x "$pkgdir/usr/bin/$program"
    done

    test -f "$pkgdir/usr/share/man/man1/grep.1"

    install -Dm644 COPYING \
        "$pkgdir/usr/share/licenses/$NAME/COPYING"
}



# Final audited source digests
SHA256SUMS=("2649b27c0e90e632eadcd757be06c6e9a4f48d941de51e7c0f83ff76408a07b9")
