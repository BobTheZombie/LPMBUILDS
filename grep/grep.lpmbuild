#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="grep"
VERSION="3.12"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="GNU grep"
URL="https://ftpmirror.gnu.org/grep/grep-3.12.tar.xz"
LICENSE=("GPL-3.0-or-later")
SOURCE=("https://ftpmirror.gnu.org/grep/grep-3.12.tar.xz")
SHA256SUMS=("2649b27c0e90e632eadcd757be06c6e9a4f48d941de51e7c0f83ff76408a07b9")
PATCHES=()
REQUIRES=("glibc")
BUILD_REQUIRES=("gcc" "make" "pkgconf")
PROVIDES=("grep")
CONFLICTS=()
OBSOLETES=()

_srcdir="grep-3.12"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    :
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    ./configure --prefix=/usr
    make -j"${JOBS:-$(nproc)}"
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    make DESTDIR="$pkgdir" install

    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
