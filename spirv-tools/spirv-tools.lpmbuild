#!/bin/bash
# LPM build script for SPIRV-Tools (SPIR-V assembler/validator/optimizer)

NAME="spirv-tools"
VERSION="1.4.335.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Libraries and utilities for processing SPIR-V modules"
URL="https://github.com/KhronosGroup/SPIRV-Tools"
LICENSE="Apache-2.0"

# Vulkan SDK 1.4.335.0 tag, same as BLFS
SOURCE=(
  "https://github.com/KhronosGroup/SPIRV-Tools/archive/vulkan-sdk-${VERSION}/SPIRV-Tools-vulkan-sdk-${VERSION}.tar.gz"
)

REQUIRES=(
  "glibc"
  "spirv-headers"
  "cmake"
  "gcc-libs"
)

PROVIDES=(
  "spirv-tools"
  "spirv-tools-libs"
)
CONFLICTS=()
OBSOLETES=()

_srcdir="$NAME-${VERSION}"

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"
    mkdir -p build
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    : "${CC:=cc}"
    : "${CXX:=c++}"

    cmake -S . -B build \
        -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_C_COMPILER="$CC" \
        -DCMAKE_CXX_COMPILER="$CXX" \
        -DSPIRV_WERROR=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DSPIRV_TOOLS_BUILD_STATIC=OFF \
        -DSPIRV-Headers_SOURCE_DIR=/usr

    cmake --build build -j"$(nproc)"
}

check() {
    # Tests exist (ninja test) but are optional / heavy for packaging
    true
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    DESTDIR="$pkgdir" cmake --install build

    # License
    if [ -f LICENSE ]; then
        install -Dm644 LICENSE \
            "$pkgdir/usr/share/licenses/$NAME/LICENSE"
    fi

    # Docs
    if [ -f README.md ]; then
        install -Dm644 README.md \
            "$pkgdir/usr/share/doc/$NAME/README.md"
    fi

    # Strip binaries and libs
    if command -v strip >/dev/null 2>&1; then
        find "$pkgdir/usr" -type f -exec sh -c '
            case "$(file -b "$1")" in
              *ELF*executable*|*ELF*shared\ object*) strip --strip-unneeded "$1" 2>/dev/null || true ;;
            esac
        ' _ {} \;
    fi
}

