
#!/bin/bash
# LPM Linux — Flatpak 1.18.4

NAME="flatpak"
VERSION="1.18.4"
RELEASE="2"
ARCH="${ARCH:-x86_64}"
SUMMARY="Flatpak sandbox and application distribution framework"
URL="https://flatpak.org"
LICENSE=("LGPL-2.1-or-later")

SOURCE=(
    "https://github.com/flatpak/flatpak/releases/download/${VERSION}/flatpak-${VERSION}.tar.xz"
)
SHA256SUMS=(
    "b899a7a00c48d2c626cb8ec33fe556720b376c25805d7222430c0fdca4c6ac8d"
)
PATCHES=()

REQUIRES=(
    "glibc" "libxml2" "glib2" "AppStream"
    "ostree" "gpgme" "curl" "libarchive"
    "libseccomp" "libcap" "fuse3" "json-glib"
    "gdk-pixbuf" "bubblewrap" "xdg-dbus-proxy"
    "polkit" "systemd"
)

BUILD_REQUIRES=(
    "meson" "ninja" "pkgconf" "python" "bison"
    "glib2" "AppStream" "ostree" "gpgme" "curl"
    "libarchive" "libseccomp" "libcap" "fuse3"
    "json-glib" "gdk-pixbuf" "libxml2" "bubblewrap"
    "xdg-dbus-proxy" "polkit" "systemd"
)

REQUIRES_PYTHON_DEPENDENCIES=(
    "pyparsing"
)

PROVIDES=("flatpak")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"

    test -f "$src/meson.build"
    test -f "$src/meson_options.txt"
    test -f "$src/subprojects/libglnx/meson.build"

    python3 -c 'import pyparsing'
    test -x /usr/bin/bwrap
    test -x /usr/bin/xdg-dbus-proxy
    test -x /usr/bin/fusermount3
}

build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    local builddir="$BUILDROOT/${NAME}-build"

    meson setup "$builddir" "$src" \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        --wrap-mode=nodownload \
        -Dsystem_bubblewrap=/usr/bin/bwrap \
        -Dsystem_dbus_proxy=/usr/bin/xdg-dbus-proxy \
        -Dsystem_fusermount=/usr/bin/fusermount3 \
        -Dseccomp=enabled \
        -Dsystem_helper=enabled \
        -Dsystemd=enabled \
        -Dsystemdsystemunitdir=lib/systemd/system \
        -Dsystemduserunitdir=lib/systemd/user \
        -Dprivileged_group=wheel \
        -Dselinux_module=disabled \
        -Ddocbook_docs=disabled \
        -Dgtkdoc=disabled \
        -Dgir=disabled \
        -Dman=disabled \
        -Dtests=false \
        -Dinstalled_tests=false \
        -Dwayland_security_context=auto \
        -Dxauth=auto

    meson compile -C "$builddir" \
        -j "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    local builddir="$BUILDROOT/${NAME}-build"

    DESTDIR="$pkgdir" meson install -C "$builddir" --no-rebuild

    test -x "$pkgdir/usr/bin/flatpak"
    test -f "$pkgdir/usr/lib/pkgconfig/flatpak.pc"
    test -f "$pkgdir/usr/lib/systemd/system/flatpak-system-helper.service"
    test -f "$pkgdir/usr/share/dbus-1/system-services/org.freedesktop.Flatpak.SystemHelper.service"
    test -f "$pkgdir/usr/lib/sysusers.d/flatpak.conf"

    find "$pkgdir/usr/lib" -type f -name '*.la' -delete
}
