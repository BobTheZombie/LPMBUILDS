#!/bin/bash
# LPM build script for xcb-util-errors

NAME="xcb-util-errors"
VERSION="1.0.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Human-readable XCB error messages"
URL="https://xcb.freedesktop.org/"
LICENSE="MIT"

SOURCE=(
  "https://xcb.freedesktop.org/dist/xcb-util-errors-${VERSION}.tar.xz"
)

REQUIRES=(
  "glibc"
  "libxcb"
  "make"
  "pkg-config"
  "xorgproto"
)

PROVIDES=(
  "xcb-util-errors"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="xcb-util-errors-${VERSION}"

prepare() {
    set -euxo pipefail
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    : "${CC:=cc}"
    : "${CXX:=c++}"

    ./configure --prefix=/usr
    make
}

check() {
    true
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    make DESTDIR="$pkgdir/" install

    if [ -f ../COPYING ]; then
        install -Dm644 ../COPYING "$pkgdir/usr/share/licenses/$NAME/COPYING"
    fi

    if command -v strip >/dev/null 2>&1; then
        find "$pkgdir/usr" -type f -exec sh -c '
            case "$(file -b "$1")" in
              *ELF*shared\ object*|*ELF*executable*)
                strip --strip-unneeded "$1" 2>/dev/null || true
              ;;
            esac
        ' _ {} \;
    fi
}
