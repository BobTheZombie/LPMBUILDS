#!/bin/bash
NAME="xdg-utils"
VERSION="1.2.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="xdg-utils upstream package"
URL="https://gitlab.freedesktop.org/xdg/xdg-utils/-/archive/v1.2.1/"
LICENSE=("MIT")
SOURCE=("https://gitlab.freedesktop.org/xdg/xdg-utils/-/archive/v1.2.1/xdg-utils-v1.2.1.tar.gz")
SHA256SUMS=("f6b648c064464c2636884c05746e80428110a576f8daacf46ef2e554dcfdae75")
PATCHES=()
REQUIRES=("bash" "coreutils" "dbus" "desktop-file-utils" "file" "gawk" "grep" "sed")
BUILD_REQUIRES=("autoconf" "automake" "docbook-xsl-nons" "make" "xmlto")
PROVIDES=("xdg-utils")
CONFLICTS=()
OBSOLETES=()
BUILD_OPTIONS=("@--stripping" "@--optimize=2")
prepare() { set -euxo pipefail; cd "$SRCROOT/${NAME}-${VERSION}"; }
build() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    if [ ! -x configure ]; then autoreconf -fiv; fi
    ./configure --prefix=/usr --libdir=/usr/lib --sysconfdir=/etc --disable-static 
    make -j"${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    make DESTDIR="$pkgdir" install
    local f
    for f in COPYING COPYING.LIB LICENSE LICENSE.md LICENSE.txt; do
        if [ -f "$f" ]; then install -Dm644 "$f" "$pkgdir/usr/share/licenses/$NAME/$f"; fi
    done
    if [ -d LICENSES ]; then
        install -dm755 "$pkgdir/usr/share/licenses/$NAME"
        cp -a LICENSES/. "$pkgdir/usr/share/licenses/$NAME/"
    fi
}



# Final audited source digests
SHA256SUMS=("f6b648c064464c2636884c05746e80428110a576f8daacf46ef2e554dcfdae75")
