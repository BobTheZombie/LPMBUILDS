NAME="pixman"
VERSION="0.46.4"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Pixel manipulation library"
URL="https://www.pixman.org/"
SOURCE=("https://www.cairographics.org/releases/pixman-${VERSION}.tar.gz")
LICENSE=("MIT")

REQUIRES=("glibc")
PROVIDES=("pixman" "libpixman-1.so")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/pixman-${VERSION}"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/pixman-${VERSION}"

    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        -Dgtk=disabled \
        -Dopenmp=disabled \
        -Dtests=disabled \
        -Dlibpng=disabled

    ninja -C build -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/pixman-${VERSION}"

    DESTDIR="$pkgdir" ninja -C build install

    # Strip binaries and shared libs
    find "$pkgdir/usr/lib" -type f -name "*.so*" -exec strip --strip-unneeded {} + 2>/dev/null || true

    # License and docs
    install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$NAME"
    [ -f README ] && install -Dm644 README -t "$pkgdir/usr/share/doc/$NAME"
}

