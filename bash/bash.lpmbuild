#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="bash"
VERSION="5.3"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="GNU Bourne Again shell"
URL="https://ftpmirror.gnu.org/bash/bash-5.3.tar.gz"
LICENSE="GPL-3.0-or-later"
SOURCE=("https://ftpmirror.gnu.org/bash/bash-5.3.tar.gz" "system.bashrc" "system.bash_logout" "dot.bashrc" "dot.bash_profile" "dot.bash_logout")
SHA256SUMS=("0d5cd86965f869a26cf64f4b71be7b96f90a3ba8b3d74e27e8e9d9d5550f31ba" "563e03eb4b40edfcc778f04efa2b4913bcdc6929c73d2bd4c07e1f799b98721a" "025bccfb374a3edce0ff8154d990689f30976b78f7a932dc9a6fcef81821811e" "959bc596166c9758fdd68836581f6b8f1d6fdb947d580bf24dce607998a077b8" "e149407c2bee17779caec70a7edd3d0000d172e7e4347429b80cb4d55bcec9c2" "4330edf340394d0dae50afb04ac2a621f106fe67fb634ec81c4bfb98be2a1eb5")
PATCHES=()
REQUIRES=("glibc" "ncurses" "readline")
BUILD_REQUIRES=("gcc" "make" "pkgconf")
PROVIDES=("bash" "sh")
CONFLICTS=()
OBSOLETES=()

_srcdir="bash-5.3"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    :
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    ./configure --prefix=/usr --without-bash-malloc --with-installed-readline
    make -j"${JOBS:-$(nproc)}"
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    make DESTDIR="$pkgdir" install
    ln -sf bash "$pkgdir/usr/bin/sh"
    ln -sf bash "$pkgdir/usr/bin/rbash"
    install -Dm644 "$SRCROOT/system.bashrc" "$pkgdir/etc/bash.bashrc"
    install -Dm644 "$SRCROOT/system.bash_logout" "$pkgdir/etc/bash.bash_logout"
    for file in .bashrc .bash_profile .bash_logout; do
        install -Dm644 "$SRCROOT/dot$file" "$pkgdir/etc/skel/$file"
    done
    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
