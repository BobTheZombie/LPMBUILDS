#!/bin/bash
NAME="libXrandr"
VERSION="1.5.4"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="libXrandr from X.Org"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=(
  "https://www.x.org/archive//individual/lib/${NAME}-${VERSION}.tar.xz"
)

REQUIRES=(
  "glibc"
  "libX11"
  "libXrender"
)

PROVIDES=("libXrandr")
CONFLICTS=()
OBSOLETES=("libxrandr")

_srcdir="$NAME-$VERSION"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  ./configure --prefix=/usr
  make -j"$(nproc)"
}

check() { true; }

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  DESTDIR="$pkgdir" make install
  [ -f COPYING ] && install -Dm644 COPYING "$pkgdir/usr/share/licenses/$NAME/COPYING"
}
