#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="iana-etc"
VERSION="20260805"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="IANA protocol and port number assignments"
URL="https://github.com/Mic92/iana-etc/releases/download/20260805/iana-etc-20260805.tar.gz"
LICENSE=("Public-Domain")
SOURCE=("https://github.com/Mic92/iana-etc/releases/download/20260805/iana-etc-20260805.tar.gz")
SHA256SUMS=("29270860664e324107537f32ea476a333ca52d71b59c74bc06ecc3b0fa9cf490")
PATCHES=()
REQUIRES=("glibc")
BUILD_REQUIRES=("gcc" "make" "pkgconf")
PROVIDES=("iana-etc")
CONFLICTS=()
OBSOLETES=()

_srcdir="iana-etc-20260805"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    :
}

build() {
    set -euo pipefail
    :
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    install -Dm644 services "$pkgdir/etc/services"
    install -Dm644 protocols "$pkgdir/etc/protocols"

    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
