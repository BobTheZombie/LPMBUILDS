# LPM build script for libxtst
NAME="libxtst"
VERSION="1.2.6"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="X11 Testing -- Record extension library"
URL="https://www.x.org/"
LICENSE="MIT"
SOURCE=("https://xorg.freedesktop.org/archive/individual/lib/libXtst-${VERSION}.tar.xz")
CHECKSUMS=("f94f0b37c07d80d877f3eda2c2405cc7e62aa9842f6310354aa349e3d66a4fe5")
REQUIRES=("glibc" "libX11" "libXext" "xorgproto")
PROVIDES=("libxtst")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() { set -euxo pipefail; cd "$SRCROOT"; }

build() {
  set -euxo pipefail
  cd "$SRCROOT"
  ./configure --prefix=/usr --sysconfdir=/etc --disable-static
  make -j"$(nproc)"
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT"
  make DESTDIR="$pkgdir" install
}




# Final audited source digests
SHA256SUMS=("f94f0b37c07d80d877f3eda2c2405cc7e62aa9842f6310354aa349e3d66a4fe5")
