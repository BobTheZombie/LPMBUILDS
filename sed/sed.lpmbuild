#!/bin/bash
# LPM build script for GNU sed

NAME="sed"
VERSION="4.10"
RELEASE="1"
ARCH="${ARCH:-x86_64}"

SUMMARY="GNU stream editor"
URL="https://www.gnu.org/software/sed/"
LICENSE=("GPL-3.0-or-later")

SOURCE=(
    "https://ftp.wayne.edu/gnu/sed/sed-${VERSION}.tar.xz"
)

SHA256SUMS=(
    "b8e72182b2ec96a3574e2998c47b7aaa64cc20ce000d8e9ac313cc07cecf28c7"
)

PATCHES=()

REQUIRES=(
    "acl"
    "glibc"
)

BUILD_REQUIRES=(
    "acl"
    "gcc"
    "gettext"
    "make"
)

PROVIDES=("sed")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

BUILD_OPTIONS=(
    "@--stripping"
    "@--optimize=2"
)

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    test -x configure
    test -f Makefile.in
    test -f COPYING

    if [ -f Makefile ]; then
        make distclean
    fi
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    ./configure \
        --prefix=/usr \
        --bindir=/usr/bin \
        --libdir=/usr/lib \
        --sysconfdir=/etc \
        --mandir=/usr/share/man \
        --infodir=/usr/share/info \
        --enable-acl \
        --without-selinux \
        --disable-rpath

    make -j"${LPM_BUILD_JOBS:-$(nproc)}"
}

check() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    test "$(
        printf '%s\n' 'LPM test' |
            ./sed/sed 's/test/passed/'
    )" = 'LPM passed'

    LC_ALL=C make check
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    make -j1 DESTDIR="$pkgdir" install

    rm -f "$pkgdir/usr/share/info/dir"

    test -x "$pkgdir/usr/bin/sed"
    test -f "$pkgdir/usr/share/man/man1/sed.1"

    install -Dm644 COPYING \
        "$pkgdir/usr/share/licenses/$NAME/COPYING"
}



# Final audited source digests
SHA256SUMS=("b8e72182b2ec96a3574e2998c47b7aaa64cc20ce000d8e9ac313cc07cecf28c7")
