#!/bin/bash
# LPM build script for GNU GMP

NAME="gmp"
VERSION="6.3.0"
RELEASE="3"
ARCH="${ARCH:-x86_64}"

SUMMARY="GNU multiple-precision arithmetic library"
URL="https://gmplib.org/"
LICENSE=(
    "GPL-2.0-or-later"
    "LGPL-3.0-or-later"
)

SOURCE=(
    "https://ftp.wayne.edu/gnu/gmp/gmp-${VERSION}.tar.xz"
    "https://gitlab.archlinux.org/archlinux/packaging/packages/gmp/-/raw/main/gmp-gcc-15.patch"
)

SHA256SUMS=(
    "SKIP"
    "SKIP"
)

PATCHES=(
    "gmp-gcc-15.patch"
)

REQUIRES=(
    "glibc"
)

BUILD_REQUIRES=(
    "autoconf"
    "automake"
    "glibc"
    "m4"
    "make"
    "pkgconf"
)

PROVIDES=(
    "gmp"
    "libgmp.so"
    "libgmp.so.10"
    "libgmpxx.so"
    "libgmpxx.so.4"
)

CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

BUILD_OPTIONS=(
    "@--stripping"
    "@--optimize=2"
)

prepare() {
    set -euxo pipefail

    SRCDIR="$SRCROOT/${NAME}-${VERSION}"
    BUILDDIR="$SRCDIR/build"

    test -f "$SRCDIR/configure"
    test -f "$SRCDIR/configure.ac"
    test -f "$SRCDIR/gmp-h.in"
    test -f "$SRCDIR/gmpxx.h"
    test -f "$SRCDIR/COPYINGv2"
    test -f "$SRCDIR/COPYINGv3"
    test -f "$SRCDIR/COPYING.LESSERv3"

    #
    # LPM applies gmp-gcc-15.patch before prepare(). Regenerate the configure
    # script and Libtool support files from the patched Autotools sources.
    #

    cd "$SRCDIR"

    autoreconf \
        --force \
        --install \
        --verbose

    rm -rf "$BUILDDIR"
    mkdir -p "$BUILDDIR"
}

build() {
    set -euxo pipefail

    SRCDIR="$SRCROOT/${NAME}-${VERSION}"
    BUILDDIR="$SRCDIR/build"

    cd "$BUILDDIR"

    ABI=64 \
        ../configure \
            --prefix=/usr \
            --bindir=/usr/bin \
            --libdir=/usr/lib \
            --includedir=/usr/include \
            --datadir=/usr/share \
            --mandir=/usr/share/man \
            --infodir=/usr/share/info \
            --docdir="/usr/share/doc/gmp-${VERSION}" \
            --enable-cxx \
            --enable-fat \
            --enable-shared \
            --disable-static

    test -f "$BUILDDIR/libtool"

    #
    # Optimize shared-library linking and remove unnecessary DT_NEEDED
    # entries.
    #

    sed -i \
        -e 's/ -shared / -Wl,-O1,--as-needed\0/g' \
        "$BUILDDIR/libtool"

    make -j"$(nproc)"
}

check() {
    set -euxo pipefail

    SRCDIR="$SRCROOT/${NAME}-${VERSION}"
    BUILDDIR="$SRCDIR/build"

    #
    # Do not run GMP's complete test suite during bootstrap builds.
    #

    LIBGMP="$(
        find "$BUILDDIR/.libs" \
            -maxdepth 1 \
            -type f \
            -name 'libgmp.so.*' \
            -print \
            -quit
    )"

    LIBGMPXX="$(
        find "$BUILDDIR/cxx/.libs" \
            -maxdepth 1 \
            -type f \
            -name 'libgmpxx.so.*' \
            -print \
            -quit
    )"

    if [ -z "$LIBGMP" ] || [ ! -f "$LIBGMP" ]; then
        echo "[ERROR] Missing build-tree libgmp shared library" >&2
        return 1
    fi

    if [ -z "$LIBGMPXX" ] || [ ! -f "$LIBGMPXX" ]; then
        echo "[ERROR] Missing build-tree libgmpxx shared library" >&2
        return 1
    fi

    GMP_HEADER="$BUILDDIR/.lpm-gmp-header"
    GMP_DYNAMIC="$BUILDDIR/.lpm-gmp-dynamic"
    GMPXX_HEADER="$BUILDDIR/.lpm-gmpxx-header"
    GMPXX_DYNAMIC="$BUILDDIR/.lpm-gmpxx-dynamic"

    readelf -h "$LIBGMP" > "$GMP_HEADER"
    grep -Fq 'ELF64' "$GMP_HEADER"

    readelf -d "$LIBGMP" > "$GMP_DYNAMIC"
    grep -Fq \
        'Library soname: [libgmp.so.10]' \
        "$GMP_DYNAMIC"

    readelf -h "$LIBGMPXX" > "$GMPXX_HEADER"
    grep -Fq 'ELF64' "$GMPXX_HEADER"

    readelf -d "$LIBGMPXX" > "$GMPXX_DYNAMIC"
    grep -Fq \
        'Library soname: [libgmpxx.so.4]' \
        "$GMPXX_DYNAMIC"

    rm -f \
        "$GMP_HEADER" \
        "$GMP_DYNAMIC" \
        "$GMPXX_HEADER" \
        "$GMPXX_DYNAMIC"
}

staging() {
    set -euxo pipefail

    SRCDIR="$SRCROOT/${NAME}-${VERSION}"
    BUILDDIR="$SRCDIR/build"

    make \
        -C "$BUILDDIR" \
        DESTDIR="$pkgdir" \
        install

    #
    # Remove static and Libtool libraries.
    #

    find "$pkgdir/usr/lib" \
        -type f \
        \( -name '*.a' -o -name '*.la' \) \
        -delete

    #
    # Remove the global Info index. It should be generated by an LPM
    # transaction hook.
    #

    rm -f "$pkgdir/usr/share/info/dir"

    #
    # Validate shared-library compatibility names.
    #

    for LIBRARY in \
        libgmp.so \
        libgmp.so.10 \
        libgmpxx.so \
        libgmpxx.so.4
    do
        if [ ! -e "$pkgdir/usr/lib/$LIBRARY" ]; then
            echo "[ERROR] Missing GMP library: /usr/lib/$LIBRARY" >&2
            return 1
        fi
    done

    #
    # Locate the real shared libraries.
    #

    LIBGMP="$(
        find "$pkgdir/usr/lib" \
            -maxdepth 1 \
            -type f \
            -name 'libgmp.so.10.*' \
            -print \
            -quit
    )"

    LIBGMPXX="$(
        find "$pkgdir/usr/lib" \
            -maxdepth 1 \
            -type f \
            -name 'libgmpxx.so.4.*' \
            -print \
            -quit
    )"

    if [ -z "$LIBGMP" ] || [ ! -f "$LIBGMP" ]; then
        echo "[ERROR] Missing real libgmp shared library" >&2
        return 1
    fi

    if [ -z "$LIBGMPXX" ] || [ ! -f "$LIBGMPXX" ]; then
        echo "[ERROR] Missing real libgmpxx shared library" >&2
        return 1
    fi

    #
    # Validate ELF architecture and SONAME metadata.
    #

    GMP_HEADER="$SRCDIR/.lpm-gmp-header"
    GMP_DYNAMIC="$SRCDIR/.lpm-gmp-dynamic"
    GMPXX_HEADER="$SRCDIR/.lpm-gmpxx-header"
    GMPXX_DYNAMIC="$SRCDIR/.lpm-gmpxx-dynamic"

    readelf -h "$LIBGMP" > "$GMP_HEADER"
    grep -Fq 'ELF64' "$GMP_HEADER"

    readelf -d "$LIBGMP" > "$GMP_DYNAMIC"
    grep -Fq \
        'Library soname: [libgmp.so.10]' \
        "$GMP_DYNAMIC"

    readelf -h "$LIBGMPXX" > "$GMPXX_HEADER"
    grep -Fq 'ELF64' "$GMPXX_HEADER"

    readelf -d "$LIBGMPXX" > "$GMPXX_DYNAMIC"
    grep -Fq \
        'Library soname: [libgmpxx.so.4]' \
        "$GMPXX_DYNAMIC"

    rm -f \
        "$GMP_HEADER" \
        "$GMP_DYNAMIC" \
        "$GMPXX_HEADER" \
        "$GMPXX_DYNAMIC"

    #
    # Validate development headers and version macros.
    #

    test -f "$pkgdir/usr/include/gmp.h"
    test -f "$pkgdir/usr/include/gmpxx.h"

    grep -Eq \
        '^#define[[:space:]]+__GNU_MP_VERSION[[:space:]]+6$' \
        "$pkgdir/usr/include/gmp.h"

    grep -Eq \
        '^#define[[:space:]]+__GNU_MP_VERSION_MINOR[[:space:]]+3$' \
        "$pkgdir/usr/include/gmp.h"

    grep -Eq \
        '^#define[[:space:]]+__GNU_MP_VERSION_PATCHLEVEL[[:space:]]+0$' \
        "$pkgdir/usr/include/gmp.h"

    #
    # Validate pkg-config metadata when installed.
    #

    if [ -f "$pkgdir/usr/lib/pkgconfig/gmp.pc" ]; then
        GMP_PC_VERSION="$(
            PKG_CONFIG_PATH= \
            PKG_CONFIG_LIBDIR="$pkgdir/usr/lib/pkgconfig" \
            pkgconf \
                --modversion \
                gmp
        )"

        if [ "$GMP_PC_VERSION" != "$VERSION" ]; then
            echo "[ERROR] Unexpected GMP pkg-config version: $GMP_PC_VERSION" >&2
            return 1
        fi
    fi

    if [ -f "$pkgdir/usr/lib/pkgconfig/gmpxx.pc" ]; then
        GMPXX_PC_VERSION="$(
            PKG_CONFIG_PATH= \
            PKG_CONFIG_LIBDIR="$pkgdir/usr/lib/pkgconfig" \
            pkgconf \
                --modversion \
                gmpxx
        )"

        if [ "$GMPXX_PC_VERSION" != "$VERSION" ]; then
            echo "[ERROR] Unexpected GMP C++ pkg-config version: $GMPXX_PC_VERSION" >&2
            return 1
        fi
    fi

    #
    # Validate documentation without a pipe that can trigger SIGPIPE under
    # pipefail.
    #

    GMP_INFO="$(
        find "$pkgdir/usr/share/info" \
            -maxdepth 1 \
            -type f \
            -name 'gmp.info*' \
            -print \
            -quit
    )"

    if [ -z "$GMP_INFO" ] || [ ! -f "$GMP_INFO" ]; then
        echo "[ERROR] Missing GMP Info documentation" >&2
        return 1
    fi

    #
    # Install licensing information.
    #

    install -Dm644 \
        "$SRCDIR/COPYINGv2" \
        "$pkgdir/usr/share/licenses/$NAME/COPYINGv2"

    install -Dm644 \
        "$SRCDIR/COPYINGv3" \
        "$pkgdir/usr/share/licenses/$NAME/COPYINGv3"

    install -Dm644 \
        "$SRCDIR/COPYING.LESSERv3" \
        "$pkgdir/usr/share/licenses/$NAME/COPYING.LESSERv3"
}




# Final audited source digests
SHA256SUMS=("a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898" "fd0f1b48dbe72413efbd9c45f1ca7013d555f46c578446ce3ba202e3a9b96c6c")
