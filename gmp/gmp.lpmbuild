#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="gmp"
VERSION="6.3.0"
RELEASE="2"
ARCH="${ARCH:-x86_64}"
SUMMARY="GNU multiple precision arithmetic"
URL="https://ftpmirror.gnu.org/gmp/gmp-6.3.0.tar.xz"
LICENSE=("GPL-3.0-or-later")
SOURCE=("https://ftpmirror.gnu.org/gmp/gmp-6.3.0.tar.xz")
SHA256SUMS=("a3c2b80201b89e68616f4ad30bc66aee4927c3ce50e33929ca819d5c43538898")
PATCHES=()
REQUIRES=("glibc")
BUILD_REQUIRES=("gcc" "make" "pkgconf")
PROVIDES=("gmp")
CONFLICTS=()
OBSOLETES=()

_srcdir="gmp-6.3.0"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    sed -i '/long long t1;/,+1s/()/(...)/' configure
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    ./configure --prefix=/usr --enable-cxx --disable-static
    make -j"${JOBS:-$(nproc)}"
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    make DESTDIR="$pkgdir" install

    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
