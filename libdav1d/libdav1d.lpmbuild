# LPM build script for dav1d

NAME="libdav1d"
VERSION="1.5.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Fast AV1 decoder"
URL="https://code.videolan.org/videolan/dav1d"
LICENSE=("BSD-2-Clause")

SOURCE=(
    "https://code.videolan.org/videolan/dav1d/-/archive/${VERSION}/dav1d-${VERSION}.tar.gz"
)

SHA256SUMS=("SKIP")
PATCHES=()

REQUIRES=(
    "glibc"
)

BUILD_REQUIRES=(
    "meson"
    "ninja"
    "pkgconf"
    "nasm"
)

PROVIDES=(
    "libdav1d"
    "dav1d"
    "libdav1d.so"
    "dav1d.pc"
)

CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail

    cd "$SRCROOT/${NAME}-${VERSION}"

    # Out-of-tree Meson build.
    rm -rf "$SRCROOT/dav1d-build"
}

build() {
    set -euxo pipefail

cd "$SRCROOT/${NAME}-${VERSION}"

    meson setup \
        "$SRCROOT/dav1d-build" \
        . \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        --default-library=shared \
        -Denable_tests=false \
        -Denable_examples=false \
        -Denable_tools=true

    meson compile \
        -C "$SRCROOT/dav1d-build" \
        -j"$(nproc)"
}

check() {
    # Tests are disabled for the normal distro build.
    true
}

staging() {
    set -euxo pipefail

cd "$SRCROOT/${NAME}-${VERSION}"

    DESTDIR="$pkgdir" \
        meson install -C "$SRCROOT/dav1d-build"

    #
    # Shared library
    #

    test -n "$(
        find "$pkgdir/usr/lib" \
            -name 'libdav1d.so*' \
            -print -quit
    )"

    #
    # Public API
    #

    test -f "$pkgdir/usr/include/dav1d/dav1d.h"

    #
    # pkg-config metadata
    #
    # FFmpeg's --enable-libdav1d detects dav1d through this.
    #

    test -f "$pkgdir/usr/lib/pkgconfig/dav1d.pc"

    #
    # dav1d CLI decoder
    #

    if [ -e "$pkgdir/usr/bin/dav1d" ]; then
        test -x "$pkgdir/usr/bin/dav1d"
    fi

    #
    # License
    #

    if [ -f COPYING ]; then
        install -Dm644 COPYING \
            "$pkgdir/usr/share/licenses/libdav1d/COPYING"
    fi

    echo "==> libdav1d ${VERSION} staging complete"
}
