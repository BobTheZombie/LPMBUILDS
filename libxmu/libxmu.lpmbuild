# LPM build script for libxmu
NAME="libxmu"
VERSION="1.3.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="X11 miscellaneous utility library"
URL="https://www.x.org/"
LICENSE="MIT"
SOURCE=("https://xorg.freedesktop.org/archive/individual/lib/libXmu-${VERSION}.tar.xz")
CHECKSUMS=("81a99e94c4501e81c427cbaa4a11748b584933e94b7a156830c3621256857bc4")
REQUIRES=("glibc" "libX11" "libXext" "libxt" "xorgproto")
PROVIDES=("libxmu")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() { set -euxo pipefail; cd "$SRCROOT"; }

build() {
  set -euxo pipefail
  cd "$SRCROOT"
  ./configure --prefix=/usr --sysconfdir=/etc --disable-static
  make -j"$(nproc)"
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT"
  make DESTDIR="$pkgdir" install
}




# Final audited source digests
SHA256SUMS=("81a99e94c4501e81c427cbaa4a11748b584933e94b7a156830c3621256857bc4")
