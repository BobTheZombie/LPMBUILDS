#!/bin/bash
# LPM build script for GNU coreutils

NAME="coreutils"
VERSION="9.12"
RELEASE="1"
ARCH="${ARCH:-x86_64}"

SUMMARY="GNU file, shell and text utilities"
URL="https://www.gnu.org/software/coreutils/"
LICENSE=("GPL-3.0-or-later" "GFDL-1.3-or-later")

SOURCE=(
    "https://ftp.gnu.org/gnu/coreutils/coreutils-${VERSION}.tar.xz"
)

SHA256SUMS=(
    "a480198559733e9b3da999e90543ac6f888a2caa544d8d664c5a1f17e528e210"
)

PATCHES=()

REQUIRES=(
    "acl"
    "attr"
    "glibc"
    "gmp"
    "libcap"
    "openssl"
)

BUILD_REQUIRES=(
    "acl"
    "attr"
    "gcc"
    "gettext"
    "gmp"
    "libcap"
    "make"
    "openssl"
    "perl"
    "python"
    "texinfo"
)

PROVIDES=("coreutils")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

BUILD_OPTIONS=(
    "@--stripping"
    "@--optimize=2"
)

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    test -x configure
    test -f Makefile.in
    test -f COPYING

    if [ -f Makefile ]; then
        make distclean
    fi
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    FORCE_UNSAFE_CONFIGURE=1 ./configure \
        --prefix=/usr \
        --bindir=/usr/bin \
        --libdir=/usr/lib \
        --libexecdir=/usr/lib \
        --sysconfdir=/etc \
        --mandir=/usr/share/man \
        --infodir=/usr/share/info \
        --enable-install-program=arch \
        --enable-no-install-program=kill,uptime \
        --enable-acl \
        --enable-xattr \
        --enable-libcap \
        --with-openssl=yes \
        --without-selinux \
        --without-libsmack \
        --without-systemd \
        --without-wtmpdb

    make -j"${LPM_BUILD_JOBS:-$(nproc)}"
}

check() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    # Local smoke tests suitable for a root-run build chroot.
    (
        testdir="$(mktemp -d "$PWD/.lpm-coreutils-test.XXXXXX")"
        trap 'rm -rf -- "$testdir"' EXIT

        ./src/printf '%s\n' "LPM coreutils test" > "$testdir/source"

        ./src/install -m644 \
            "$testdir/source" "$testdir/destination"

        cmp "$testdir/source" "$testdir/destination"

        test "$(./src/stat -c '%a' "$testdir/destination")" = 644

        ./src/ln -s destination "$testdir/link"
        test "$(./src/readlink "$testdir/link")" = destination

        test "$(
            ./src/printf abc | ./src/sha256sum
        )" = \
            "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad  -"
    )
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    make -j1 DESTDIR="$pkgdir" install

    rm -f "$pkgdir/usr/share/info/dir"

    local program
    for program in \
        arch basename cat chmod chown cp cut date dd \
        dirname env head id install ln ls mkdir mktemp \
        mv printf readlink realpath rm sha256sum sort \
        stat tail touch tr uname uniq wc
    do
        test -x "$pkgdir/usr/bin/$program"
    done

    install -Dm644 COPYING \
        "$pkgdir/usr/share/licenses/$NAME/COPYING"
}



# Final audited source digests
SHA256SUMS=("a480198559733e9b3da999e90543ac6f888a2caa544d8d664c5a1f17e528e210")
