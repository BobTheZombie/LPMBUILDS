#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="coreutils"
VERSION="9.11"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="GNU core utilities"
URL="https://ftpmirror.gnu.org/coreutils/coreutils-9.11.tar.xz"
LICENSE=("GPL-3.0-or-later")
SOURCE=("https://ftpmirror.gnu.org/coreutils/coreutils-9.11.tar.xz" "coreutils-9.11-i18n-1.patch")
SHA256SUMS=("394024eda0a5955217ceda9cd1201e65dc8fa3aa29c2951135a49521d57c3cc3" "7c2aecf9ae24b87b019595e382b9f41d2c96de7f95abe95ad8cacc7e2ce1bbcc")
PATCHES=()
REQUIRES=("glibc" "acl" "attr" "gmp" "libcap")
BUILD_REQUIRES=("gcc" "make" "pkgconf")
PROVIDES=("coreutils")
CONFLICTS=()
OBSOLETES=()

_srcdir="coreutils-9.11"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    patch --batch --forward -Np1 -i "$SRCROOT/coreutils-9.11-i18n-1.patch"
    :
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    ./configure --prefix=/usr --enable-no-install-program=kill,uptime --enable-single-binary=symlinks
    make -j"${JOBS:-$(nproc)}"
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    make DESTDIR="$pkgdir" install

    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
