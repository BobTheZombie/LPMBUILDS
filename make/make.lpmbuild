#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="make"
VERSION="4.4.1"
RELEASE="2"
ARCH="${ARCH:-x86_64}"
SUMMARY="GNU Make utility to maintain groups of programs"
URL="https://ftpmirror.gnu.org/make/make-4.4.1.tar.gz"
LICENSE="GPL-3.0-or-later"
SOURCE=("https://ftpmirror.gnu.org/make/make-4.4.1.tar.gz")
SHA256SUMS=("dd16fb1d67bfab79a72f5e8390735c49e3e8e70b4945a15ab1f81ddb78658fb3")
PATCHES=()
REQUIRES=("glibc")
BUILD_REQUIRES=("gcc" "make" "pkgconf")
PROVIDES=("make")
CONFLICTS=()
OBSOLETES=()

_srcdir="make-4.4.1"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    :
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    ./configure --prefix=/usr
    make -j"${JOBS:-$(nproc)}"
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    make DESTDIR="$pkgdir" install

    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
