#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="bc"
VERSION="7.0.3"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Bc"
URL="https://github.com/gavinhoward/bc/releases/download/7.0.3/bc-7.0.3.tar.xz"
LICENSE=("BSD-2-Clause")
SOURCE=("https://github.com/gavinhoward/bc/releases/download/7.0.3/bc-7.0.3.tar.xz")
SHA256SUMS=("91eb74caed0ee6655b669711a4f350c25579778694df248e28363318e03c7fc4")
PATCHES=()
REQUIRES=("glibc")
BUILD_REQUIRES=("gcc" "make" "pkgconf")
PROVIDES=("bc")
CONFLICTS=()
OBSOLETES=()

_srcdir="bc-7.0.3"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    :
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    CC='gcc -std=c99' ./configure --prefix=/usr -G -O3 -r
    make -j"${JOBS:-$(nproc)}"
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    make DESTDIR="$pkgdir" install

    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}

