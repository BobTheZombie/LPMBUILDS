#!/bin/bash
# LPM build script for GNU bc and dc

NAME="bc"
VERSION="1.08.2"
RELEASE="1"
ARCH="${ARCH:-x86_64}"

SUMMARY="Arbitrary-precision calculator languages"
URL="https://www.gnu.org/software/bc/"
LICENSE=("GPL-3.0-or-later" "LGPL-2.1-or-later")

SOURCE=(
    "https://ftp.wayne.edu/gnu/bc/bc-${VERSION}.tar.gz"
)

SHA256SUMS=(
    "ae470fec429775653e042015edc928d07c8c3b2fc59765172a330d3d87785f86"
)

PATCHES=()

REQUIRES=(
    "glibc"
    "ncurses"
    "readline"
)

BUILD_REQUIRES=(
    "bison"
    "flex"
    "gcc"
    "make"
    "ncurses"
    "readline"
    "texinfo"
)

PROVIDES=("bc" "dc")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

BUILD_OPTIONS=(
    "@--stripping"
    "@--optimize=2"
)

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    test -f configure
    test -f COPYING
    test -f COPYING.LIB

    if [ -f Makefile ]; then
        make distclean
    fi
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    ./configure \
        --prefix=/usr \
        --bindir=/usr/bin \
        --mandir=/usr/share/man \
        --infodir=/usr/share/info \
        --with-readline \
        --without-libedit

    make -j"${LPM_BUILD_JOBS:-$(nproc)}"
}

check() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    test "$(printf '6 * 7\n' | ./bc/bc)" = "42"
    test "$(printf 'scale=4; sqrt(2)\n' | ./bc/bc -l)" = "1.4142"
    test "$(printf '6 7 * p\n' | ./dc/dc)" = "42"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    make -j1 DESTDIR="$pkgdir" install

    rm -f "$pkgdir/usr/share/info/dir"

    test -x "$pkgdir/usr/bin/bc"
    test -x "$pkgdir/usr/bin/dc"
    test -f "$pkgdir/usr/share/man/man1/bc.1"
    test -f "$pkgdir/usr/share/man/man1/dc.1"

    install -Dm644 COPYING \
        "$pkgdir/usr/share/licenses/$NAME/COPYING"

    install -Dm644 COPYING.LIB \
        "$pkgdir/usr/share/licenses/$NAME/COPYING.LIB"
}




# Final audited source digests
SHA256SUMS=("ae470fec429775653e042015edc928d07c8c3b2fc59765172a330d3d87785f86")
