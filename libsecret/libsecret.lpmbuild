#!/bin/bash

NAME="libsecret"
VERSION="0.21.4"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Secret storage library"
URL="https://gitlab.gnome.org/GNOME/libsecret"
LICENSE=("LGPL-2.1-or-later")

SOURCE=(
  "https://download.gnome.org/sources/libsecret/0.21/libsecret-${VERSION}.tar.xz"
)

SHA256SUMS=("SKIP")

REQUIRES=(
  "glib2"
  "libgcrypt"
  "dbus"
)

BUILD_REQUIRES=(
  "meson"
  "ninja"
  "pkgconf"
  "gettext"
  "gobject-introspection"
  "vala"
)

PROVIDES=("libsecret" "libsecret-1.so")

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  rm -rf build
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  meson setup build \
    --prefix=/usr \
    --libdir=lib \
    --buildtype=release \
    -Dgtk_doc=false \
    -Dmanpage=false

  meson compile -C build
}

check() { true; }

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  DESTDIR="$pkgdir" meson install -C build
}
