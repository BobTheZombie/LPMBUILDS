#!/bin/bash
# libsecret backend used by KWallet's kwalletd D-Bus Secret Service integration.
NAME="libsecret"
VERSION="0.21.8.2"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="GObject library for the Secret Service API"
URL="https://gnome.pages.gitlab.gnome.org/libsecret/"
LICENSE=("LGPL-2.1-or-later")
SOURCE=("https://download.gnome.org/sources/libsecret/0.21/libsecret-${VERSION}.tar.xz")
SHA256SUMS=("142948339c5b971d8f6a8c7099521f6fd319b6fe73d2694b4e6d3310ed28b6e6")
PATCHES=()
REQUIRES=("glibc" "glib2" "libgcrypt")
BUILD_REQUIRES=("gcc" "meson" "ninja" "pkgconf" "glib2" "libgcrypt" "gettext" "gobject-introspection")
PROVIDES=("libsecret" "libsecret-1.so")
CONFLICTS=()
OBSOLETES=()
BUILD_OPTIONS=("@--stripping" "@--optimize=2")

_secret_srcdir() {
    local d
    for d in "$SRCROOT/${NAME}-${VERSION}" "$SRCROOT"; do
        if [[ -f "$d/meson.build" ]] && grep -q "project('libsecret'" "$d/meson.build"; then
            printf '%s\n' "$d"
            return 0
        fi
    done
    echo "[ERROR] libsecret-${VERSION} source not found in SRCROOT=$SRCROOT" >&2
    return 1
}

prepare() {
    set -euxo pipefail
    local src
    src="$(_secret_srcdir)"
    rm -rf "$src/build"
}

build() {
    set -euxo pipefail
    local src
    src="$(_secret_srcdir)"
    meson setup "$src/build" "$src" \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        --wrap-mode=nodownload \
        -Dcrypto=libgcrypt \
        -Dintrospection=true \
        -Dvapi=false \
        -Dgtk_doc=false \
        -Dmanpage=false \
        -Dpam=false \
        -Dtpm2=false \
        -Dtest_setup=disabled \
        -Dbash_completion=disabled
    meson compile -C "$src/build" -j "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    local src
    src="$(_secret_srcdir)"
    meson install -C "$src/build" --no-rebuild --destdir "$pkgdir"
    test -e "$pkgdir/usr/lib/libsecret-1.so"
    test -f "$pkgdir/usr/lib/pkgconfig/libsecret-1.pc"
    if [[ -f "$src/COPYING" ]]; then
        install -Dm644 "$src/COPYING" "$pkgdir/usr/share/licenses/$NAME/COPYING"
    fi
}
