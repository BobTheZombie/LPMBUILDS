#!/bin/bash
# ISO 3166/639/4217/15924 datasets used by Plasma clock translations
NAME="iso-codes"
VERSION="4.20.1"
RELEASE="2"
ARCH="noarch"
SUMMARY="Data for countries, languages, scripts and currency ISO standards"
URL="https://salsa.debian.org/iso-codes-team/iso-codes"
LICENSE=("LGPL-2.1-or-later")
SOURCE=("https://salsa.debian.org/iso-codes-team/iso-codes/-/archive/v${VERSION}/iso-codes-v${VERSION}.tar.gz")
SHA256SUMS=("2d7d9f6084ab9ce6c534ce71a3dd5144b6e474f3c97616459a88f73f44a64bff")
PATCHES=()
REQUIRES=()
BUILD_REQUIRES=("meson" "ninja" "pkgconf" "python" "gettext")
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=("iso-codes" "IsoCodes")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/meson.build"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    local builddir="$BUILDROOT/${NAME}-build"
    meson setup "$builddir" "$src" --prefix=/usr --buildtype=release --wrap-mode=nodownload
    meson compile -C "$builddir" -j "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" meson install -C "$BUILDROOT/${NAME}-build" --no-rebuild
    test -d "$pkgdir/usr/share/iso-codes"
    test -n "$(find "$pkgdir/usr/share/iso-codes" -type f -print -quit)"
}
