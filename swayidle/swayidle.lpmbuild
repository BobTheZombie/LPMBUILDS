#!/bin/bash
# LPM build script for swayidle

NAME="swayidle"
VERSION="1.8.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Idle management daemon for Wayland compositors"
URL="https://github.com/swaywm/swayidle"
LICENSE=("MIT")

SOURCE=(
  "https://github.com/swaywm/swayidle/releases/download/${VERSION}/swayidle-${VERSION}.tar.gz"
)

REQUIRES=(
  "glibc"
  "wayland"
  "systemd"
)

BUILD_REQUIRES=(
  "meson"
  "ninja"
  "pkgconf"
  "wayland-protocols"
  "scdoc"
)

PROVIDES=(
  "swayidle"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  rm -rf build

  meson setup build \
    --prefix=/usr \
    --libdir=lib \
    --buildtype=release

  meson compile -C build
}

check() {
  true
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  DESTDIR="$pkgdir" meson install -C build

  test -f "$pkgdir/usr/bin/swayidle"

  for f in LICENSE COPYING; do
    if [ -f "$f" ]; then
      install -Dm644 "$f" \
        "$pkgdir/usr/share/licenses/$NAME/$f"
    fi
  done
}