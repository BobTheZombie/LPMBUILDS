#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="attr"
VERSION="2.6.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Extended attribute support library"
URL="https://download.savannah.gnu.org/releases/attr/attr-2.6.0.tar.gz"
LICENSE="LGPL-2.1-or-later"
SOURCE=("https://download.savannah.gnu.org/releases/attr/attr-2.6.0.tar.gz")
SHA256SUMS=("d42fa374513180bb48cb11a46696f488240e5124ff1e6ad88b0abff706985612")
PATCHES=()
REQUIRES=("glibc")
BUILD_REQUIRES=("gcc" "make" "pkgconf")
PROVIDES=("attr")
CONFLICTS=()
OBSOLETES=()

_srcdir="attr-2.6.0"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    :
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    ./configure --prefix=/usr --libdir=/usr/lib --disable-static
    make -j"${JOBS:-$(nproc)}"
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    make DESTDIR="$pkgdir" install

    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
