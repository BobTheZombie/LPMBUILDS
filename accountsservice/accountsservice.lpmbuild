#!/bin/bash
NAME="accountsservice"
VERSION="26.27.3"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="accountsservice upstream package"
URL="https://gitlab.freedesktop.org/accountsservice/accountsservice/-/archive/4e254d9624cc48224c9920b9509df0b144f7be0c/"
LICENSE=("GPL-3.0-or-later")
SOURCE=("https://gitlab.freedesktop.org/accountsservice/accountsservice/-/archive/4e254d9624cc48224c9920b9509df0b144f7be0c/accountsservice-4e254d9624cc48224c9920b9509df0b144f7be0c.tar.gz")
SHA256SUMS=("2e3fc9e87eafc7c63e48ef3692af62e287790f373314bac1f5bb0981df5c0195")
PATCHES=()
REQUIRES=("gcc-libs" "glib2" "glibc" "json-c" "libxcrypt" "polkit" "shadow" "systemd")
BUILD_REQUIRES=("docbook-xsl-nons" "gobject-introspection" "meson" "ninja" "pkgconf" "vala" "xmlto")
PROVIDES=("accountsservice")
CONFLICTS=()
OBSOLETES=()
BUILD_OPTIONS=("@--stripping" "@--optimize=2")
prepare() { set -euxo pipefail; cd "$SRCROOT/${NAME}-${VERSION}"; }
build() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    meson setup build --prefix=/usr --libdir=lib --buildtype=release --wrap-mode=nodownload -Dadmin_group=wheel -Dgtk_doc=false -Ddocbook=false
    meson compile -C build -j "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    meson install -C build --no-rebuild --destdir "$pkgdir"
    local f
    for f in COPYING COPYING.LIB LICENSE LICENSE.md LICENSE.txt; do
        if [ -f "$f" ]; then install -Dm644 "$f" "$pkgdir/usr/share/licenses/$NAME/$f"; fi
    done
    if [ -d LICENSES ]; then
        install -dm755 "$pkgdir/usr/share/licenses/$NAME"
        cp -a LICENSES/. "$pkgdir/usr/share/licenses/$NAME/"
    fi
}




# Final audited source digests
SHA256SUMS=("2e3fc9e87eafc7c63e48ef3692af62e287790f373314bac1f5bb0981df5c0195")
