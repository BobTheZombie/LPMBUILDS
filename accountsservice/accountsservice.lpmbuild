
#!/bin/bash
# LPM Linux — AccountsService 26.27.3

NAME="accountsservice"
VERSION="26.27.3"
RELEASE="2"
ARCH="${ARCH:-x86_64}"
SUMMARY="D-Bus service and library for querying and managing user accounts"
URL="https://gitlab.freedesktop.org/accountsservice/accountsservice"
LICENSE=("GPL-3.0-or-later")

SOURCE=(
    "https://gitlab.freedesktop.org/accountsservice/accountsservice/-/archive/${VERSION}/accountsservice-${VERSION}.tar.bz2"
    "accounts-daemon-restart.hook"
)
SHA256SUMS=(
    "77e26080fd644df3e339fef561bb77f901e43557dc73e620afb6c10789b9a9e8"
)
PATCHES=()

REQUIRES=(
    "glibc" "glib2" "json-c" "polkit" "libxcrypt"
    "dbus" "systemd" "shadow"
)

BUILD_REQUIRES=(
    "gcc" "meson" "ninja" "pkgconf" "python"
    "glib2" "json-c" "polkit" "systemd" "libxcrypt"
    "gobject-introspection" "gettext"
)

REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=("accountsservice")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail

    local src="$SRCROOT/${NAME}-${VERSION}"

    test -f "$src/meson.build"
    test -f "$src/meson_options.txt"
}

build() {
    set -euxo pipefail

    local src="$SRCROOT/${NAME}-${VERSION}"
    local builddir="$BUILDROOT/accountsservice-build"

    meson setup "$builddir" "$src" \
        --prefix=/usr \
        --libdir=lib \
        --libexecdir=libexec \
        --buildtype=release \
        --wrap-mode=nodownload \
        -Dadmin_group=wheel \
        -Delogind=false \
        -Dsystemdsystemunitdir=/usr/lib/systemd/system \
        -Dintrospection=true \
        -Dvapi=false \
        -Dgtk_doc=false \
        -Ddocbook=false

    meson compile -C "$builddir" \
        -j "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail

    local builddir="$BUILDROOT/accountsservice-build"

    DESTDIR="$pkgdir" meson install -C "$builddir" --no-rebuild

    install -Dt "$pkgdir/usr/share/liblpm/hooks" -m644 *.hook
    install -d "$pkgdir/usr/share/accountsservice/interfaces"

    test -n "$(find "$pkgdir/usr" \
        -type f -name 'accounts-daemon' -print -quit)"

    test -n "$(find "$pkgdir/usr/lib" \
        -name 'libaccountsservice.so*' -print -quit)"

    test -f \
        "$pkgdir/usr/share/dbus-1/system-services/org.freedesktop.Accounts.service"

    find "$pkgdir/usr/lib" -type f -name '*.la' -delete
}
