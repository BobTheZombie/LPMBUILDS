NAME="wireless_tools"
VERSION="30.pre9"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Legacy tools for wireless networking (iwconfig, iwlist)"
URL="https://hewlettpackard.github.io/wireless-tools/"
LICENSE=("GPL-2.0-or-later")

SOURCE=("https://hewlettpackard.github.io/wireless-tools/$NAME.$VERSION.tar.gz")

REQUIRES=("glibc")

prepare() {
  cd "$SRCROOT/wireless_tools-$VERSION"
}

build() {
  cd "$SRCROOT/wireless_tools-$VERSION"
  make -j$(nproc) CC="gcc" CFLAGS="$CFLAGS"
}

staging() {
  cd "$SRCROOT/wireless_tools-$VERSION"
  install -Dm755 iwconfig "$pkgdir/usr/bin/iwconfig"
  install -Dm755 iwlist "$pkgdir/usr/bin/iwlist"
  install -Dm755 ifrename "$pkgdir/usr/bin/ifrename"
  install -Dm755 iwevent "$pkgdir/usr/bin/iwevent"
  install -Dm644 COPYING "$pkgdir/usr/share/licenses/wireless-tools/LICENSE"
  mkdir -p "$pkgdir/usr/share/man/man8"
  install -m644 iwconfig.8 iwlist.8 iwevent.8 ifrename.8 "$pkgdir/usr/share/man/man8/"
}

