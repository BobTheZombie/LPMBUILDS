#!/bin/bash
# LPM build script for setxkbmap

NAME="setxkbmap"
VERSION="1.3.5"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Set keyboard using the X Keyboard Extension"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=("https://www.x.org/releases/individual/app/${NAME}-${VERSION}.tar.xz")

REQUIRES=(
  "glibc"
  "libX11"
  "libxkbfile"
)

PROVIDES=("setxkbmap")
CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  ./configure --prefix=/usr
  make -j"$(nproc)"
}

check() { true; }

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  DESTDIR="$pkgdir" make install
}




# Final audited source digests
SHA256SUMS=("360193cecc93f906d8383a8fb5c1f3a7eed35e6ced0e118a64ee56ae13c88cac")
