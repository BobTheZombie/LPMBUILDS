#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="kmod"
VERSION="34.2"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Linux kernel module handling"
URL="https://www.kernel.org/pub/linux/utils/kernel/kmod/kmod-34.2.tar.xz"
LICENSE="LGPL-2.1-or-later"
SOURCE=("https://www.kernel.org/pub/linux/utils/kernel/kmod/kmod-34.2.tar.xz")
SHA256SUMS=("5a5d5073070cc7e0c7a7a3c6ec2a0e1780850c8b47b3e3892226b93ffcb9cb54")
PATCHES=()
REQUIRES=("glibc" "openssl" "xz" "zstd")
BUILD_REQUIRES=("gcc" "make" "pkgconf" "meson" "ninja" "python")
PROVIDES=("kmod")
CONFLICTS=()
OBSOLETES=()

_srcdir="kmod-34.2"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    :
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    meson setup build --prefix=/usr --libdir=lib --buildtype=release --wrap-mode=nofallback -Dmanpages=false
    meson compile -C build
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    DESTDIR="$pkgdir" meson install -C build
    install -dm755 "$pkgdir/usr/bin"
    for tool in insmod lsmod rmmod depmod modprobe modinfo; do
        ln -sf kmod "$pkgdir/usr/bin/$tool"
    done
    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
