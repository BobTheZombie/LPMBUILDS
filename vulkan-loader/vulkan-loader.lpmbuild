# LPM build script for vulkan-loader
NAME="vulkan-loader"
VERSION="1.4.335.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Vulkan ICD loader"
URL="https://github.com/KhronosGroup/Vulkan-Loader"
LICENSE="Apache-2.0"
SOURCE=("git+https://github.com/KhronosGroup/Vulkan-Loader#tag=vulkan-sdk-$VERSION")
REQUIRES=("glibc" "libX11" "libxcb" "libxrandr" "vulkan-headers")
PROVIDES=("vulkan-loader" "vulkan-icd-loader")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

_srcdir="Vulkan-Loader"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  cmake -B build -S . -DCMAKE_BUILD_TYPE=Release -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_WSI_XLIB_SUPPORT=ON -DBUILD_WSI_WAYLAND_SUPPORT=ON
  cmake --build build -- -j"$(nproc)"
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  DESTDIR="$pkgdir" cmake --install build
}

# Immutable source references resolved during audit.
SOURCE=("git+https://github.com/KhronosGroup/Vulkan-Loader#commit=057ca1e5f2b61bbb3942e3a7464d488d5bde4a3c")




# Final audited source digests
SHA256SUMS=("SKIP")
