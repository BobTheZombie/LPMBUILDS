#!/bin/bash
# LPM build script for font-misc-misc

NAME="font-misc-misc"
VERSION="1.1.3"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Miscellaneous bitmap fonts for X.Org"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=(
  "https://www.x.org/archive//individual/font/font-misc-misc-${VERSION}.tar.xz"
)

REQUIRES=(
  "glibc"
  "font-util"
  "encodings"
)

PROVIDES=("font-misc-misc")
CONFLICTS=()
OBSOLETES=()

_srcdir="font-misc-misc-${VERSION}"

prepare() {
    set -euxo pipefail
    cd "$SRCROOT"
    tar xf "font-misc-misc-${VERSION}.tar.xz"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    ./configure --prefix=/usr
    make -j"$(nproc)"
}

check() {
    true
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    DESTDIR="$pkgdir" make install

    if [ -f COPYING ]; then
        install -Dm644 COPYING "$pkgdir/usr/share/licenses/$NAME/COPYING"
    fi
}
