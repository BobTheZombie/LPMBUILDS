NAME="libnsl"
VERSION="2.0.1"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Public client interface library for NIS"
URL="https://github.com/thkukuk/libnsl"
SOURCE=("https://github.com/thkukuk/libnsl/archive/refs/tags/v${VERSION}.tar.gz")
LICENSE="LGPL-2.1-or-later"

REQUIRES=("glibc" "libtirpc")
PROVIDES=("libnsl" "libnsl.so")

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/$NAME-$VERSION"
    autoreconf -fiv
}

build() {
    cd "$SRCROOT/$NAME-$VERSION"
    ./configure --prefix=/usr --disable-static
    make -j"$(nproc)"
}

staging() {
    cd "$SRCROOT/$NAME-$VERSION"
    make DESTDIR="$pkgdir" install
}

