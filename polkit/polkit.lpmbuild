NAME="polkit"
VERSION="126"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Policy framework for controlling system-wide privileges"
URL="https://www.freedesktop.org/wiki/Software/polkit/"
SOURCE=("https://github.com/polkit-org/polkit/archive/refs/tags/${VERSION}.tar.gz"
        "0001-meson-Support-explicit-GID.patch"
        "0002-meson-Detect-Arch-Linux-and-set-the-UID-and-GID.patch")
        
LICENSE=("LGPL-2.1-or-later")

REQUIRES=("glibc" "expat" "glib" "dbus" "pam" "libffi" "systemd")
PROVIDES=("polkit" "libpolkit-agent-1.so" "libpolkit-gobject-1.so")
CONFLICTS=()
OBSOLETES=()

install=polkit.install

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/polkit-${VERSION}"
    
    #patch -Np1 $SRCROOT/0001-meson-Support-explicit-GID.patch
    #patch -Np1 $SRCROOT/0002-meson-Detect-Arch-Linux-and-set-the-UID-and-GID.patch

}

build() {
    set -euxo pipefail
    cd "$SRCROOT/polkit-${VERSION}"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --sysconfdir=/etc \
        -Dman=false
    ninja -C build -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/polkit-${VERSION}"
    DESTDIR="$pkgdir" ninja -C build install
}

