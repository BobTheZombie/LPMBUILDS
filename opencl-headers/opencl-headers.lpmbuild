#!/bin/bash
NAME="opencl-headers"
VERSION="2025.07.22"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="OpenCL C/C++ API headers"
URL="https://github.com/KhronosGroup/OpenCL-Headers"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://github.com/KhronosGroup/OpenCL-Headers/archive/refs/tags/v2025.07.22.tar.gz")
SHA256SUMS=("SKIP") # Must verify upstream archive digest before release
PATCHES=()
REQUIRES=()
BUILD_REQUIRES=("cmake" "ninja")
PROVIDES=("opencl-headers")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/$NAME-$VERSION/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    cmake -S "$src" -B "$src/build" -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DBUILD_TESTING=OFF
        cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    DESTDIR="$pkgdir" cmake --install "$src/build"
        test -f "$pkgdir/usr/include/CL/cl.h"
}
