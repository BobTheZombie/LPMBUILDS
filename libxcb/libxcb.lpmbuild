# LPM build script for libxcb
NAME="libxcb"
VERSION="1.17.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="X11 client-side library"
URL="https://xcb.freedesktop.org/"
LICENSE="MIT"
SOURCE=("https://xorg.freedesktop.org/archive/individual/lib/libxcb-${VERSION}.tar.xz")
CHECKSUMS=("599ebf9996710fea71622e6e184f3a8ad5b43d0e5fa8c4e407123c88a59a6d55")
REQUIRES=("glibc" "libXau" "libXdmcp" "xorgproto")
PROVIDES=("libxcb")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() { 
  set -euxo pipefail
  cd "$SRCROOT/$NAME-$VERSION"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$NAME-$VERSION"
  ./configure --prefix=/usr --sysconfdir=/etc --disable-static --enable-xkb
  make -j"$(nproc)"
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$NAME-$VERSION"
  make DESTDIR="$pkgdir" install
}




# Final audited source digests
SHA256SUMS=("599ebf9996710fea71622e6e184f3a8ad5b43d0e5fa8c4e407123c88a59a6d55")
