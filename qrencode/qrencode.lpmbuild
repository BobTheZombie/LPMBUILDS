#!/bin/bash
# LPM Linux - QRencode library and command-line utility
# Required by KDE Frameworks Prison6 for QR Code generation.

NAME="qrencode"
VERSION="4.1.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Fast and compact QR Code encoding library and utility"
URL="https://fukuchi.org/works/qrencode/"
LICENSE=("LGPL-2.1-or-later")
SOURCE=("https://github.com/fukuchi/libqrencode/archive/v${VERSION}/libqrencode-${VERSION}.tar.gz")
SHA256SUMS=("5385bc1b8c2f20f3b91d258bf8ccc8cf62023935df2d2676b5b67049f31a049c")
PATCHES=()

REQUIRES=("glibc" "libpng")
BUILD_REQUIRES=("cmake" "gcc" "ninja" "libpng" "pkgconf")
PROVIDES=("libqrencode.so")
CONFLICTS=()
OBSOLETES=()
BUILD_OPTIONS=("@--stripping" "@--optimize=2")

prepare() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    test -f "$src/CMakeLists.txt"
    # Upstream's CMake minimum is 3.1.0; CMake 4.x rejects minima < 3.5.
    # Align it to the CMake 4.x policy compatibility floor.
    sed -i 's/cmake_minimum_required(VERSION 3.1.0)/cmake_minimum_required(VERSION 3.10)/' "$src/CMakeLists.txt"
}

build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    cmake -S "$src" -B "$src/build" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_C_STANDARD=11 \
        -DCMAKE_C_STANDARD_REQUIRED=ON \
        -DBUILD_SHARED_LIBS=ON \
        -DWITH_TOOLS=ON \
        -DWITH_TESTS=OFF \
        -DWITHOUT_PNG=OFF
    cmake --build "$src/build" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    test -n "${pkgdir:-}" && test "$pkgdir" != "/"
    DESTDIR="$pkgdir" cmake --install "$src/build" --prefix /usr
    test -f "$pkgdir/usr/include/qrencode.h"
    test -f "$pkgdir/usr/lib/pkgconfig/libqrencode.pc"
    compgen -G "$pkgdir/usr/lib/libqrencode.so*" >/dev/null
    test -x "$pkgdir/usr/bin/qrencode"
    for file in COPYING COPYING.LIB LICENSE; do
        if test -f "$src/$file"; then
            install -Dm644 "$src/$file" "$pkgdir/usr/share/licenses/$NAME/$file"
        fi
    done
}
