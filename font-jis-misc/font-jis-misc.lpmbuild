#!/bin/bash
# LPM build script for font-jis-misc

NAME="font-jis-misc"
VERSION="1.0.4"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Miscellaneous JIS bitmap fonts for X.Org"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=(
  "https://www.x.org/releases/individual/font/font-jis-misc-${VERSION}.tar.xz"
)

REQUIRES=(
  "glibc"
  "font-util"
  "encodings"
)

PROVIDES=("font-jis-misc")
CONFLICTS=()
OBSOLETES=()

_srcdir="font-jis-misc-${VERSION}"

prepare() {
    set -euxo pipefail
    cd "$SRCROOT"
    tar xf "font-jis-misc-${VERSION}.tar.xz"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    ./configure --prefix=/usr
    make -j"$(nproc)"
}

check() {
    true
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    DESTDIR="$pkgdir" make install

    if [ -f COPYING ]; then
        install -Dm644 COPYING "$pkgdir/usr/share/licenses/$NAME/COPYING"
    fi
}




# Final audited source digests
SHA256SUMS=("78d1eff6c471f7aa6802a26d62cccf51d8e5185586406d9b6e1ee691b0bffad0")
