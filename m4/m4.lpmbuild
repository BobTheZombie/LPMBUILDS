NAME="m4"
VERSION="1.4.21"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Macro processor"
URL="https://www.gnu.org/software/m4/"
SOURCE=(
   "https://ftp.wayne.edu/gnu/m4/m4-${VERSION}.tar.xz"
)
LICENSE="GPL-3.0-or-later"

REQUIRES=(
  'glibc'
)
PROVIDES=(m4)
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/$NAME-$VERSION"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$NAME-$VERSION"
  ./configure --prefix=/usr
  make -j"$(nproc)"
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$NAME-$VERSION"
  make DESTDIR="$pkgdir" install
}





# Final audited source digests
SHA256SUMS=("f25c6ab51548a73a75558742fb031e0625d6485fe5f9155949d6486a2408ab66")
