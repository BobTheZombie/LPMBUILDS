#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="m4"
VERSION="1.4.21"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Macro processor"
URL="https://ftpmirror.gnu.org/m4/m4-1.4.21.tar.xz"
LICENSE="GPL-3.0-or-later"
SOURCE=("https://ftpmirror.gnu.org/m4/m4-1.4.21.tar.xz")
SHA256SUMS=("f25c6ab51548a73a75558742fb031e0625d6485fe5f9155949d6486a2408ab66")
PATCHES=()
REQUIRES=("glibc")
BUILD_REQUIRES=("gcc" "make" "pkgconf")
PROVIDES=("m4")
CONFLICTS=()
OBSOLETES=()

_srcdir="m4-1.4.21"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    :
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    ./configure --prefix=/usr
    make -j"${JOBS:-$(nproc)}"
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    make DESTDIR="$pkgdir" install

    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
