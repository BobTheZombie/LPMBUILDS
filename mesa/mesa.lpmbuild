# LPM build script for mesa
NAME="mesa"
VERSION="25.3.6"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Open-source implementation of the OpenGL and Vulkan graphics APIs"
URL="https://www.mesa3d.org/"
LICENSE="MIT"
SOURCE=("https://archive.mesa3d.org/mesa-${VERSION}.tar.xz")
CHECKSUMS=("59217efeac3b64e7ced958324b9db7494f1e0741aeb22d780276514cc1b8f206")

REQUIRES=(
     "glibc" 
     "glslang" 
     "libdrm" 
     "wayland" 
     "wayland-protocols" 
     "libX11" 
     "libXext" 
     "libxcb" 
     "libXdamage" 
     "libXfixes" 
     "expat" 
     "llvm" 
     "vulkan-loader" 
     "bindgen" 
     "libclc" 
     "spirv-llvm-translator" 
     "libva" 
     "libglvnd"
)

BUILD_REQUIRES=(
    "meson"
    "ninja"
    "python"
)

REQUIRES_PYTHON_DEPENDENCIES=(
    "PyYAML"
)

PROVIDES=("mesa")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=("vulkan-loader" "libva")
SUGGESTS=()

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$NAME-$VERSION"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$NAME-$VERSION"
  meson setup build \
  --prefix=/usr \
  --buildtype=release \
  --libdir=lib \
  -Dstrip=true \
  -Db_lto=true -Db_lto_mode=thin \
  -Dplatforms=wayland,x11 \
  -Dglx=dri \
  -Dglvnd=enabled \
  -Degl=enabled \
  -Dgallium-drivers=radeonsi \
  -Dvulkan-drivers=amd \
  -Dmesa-clc=enabled \
  -Dshared-llvm=enabled \
  -Dvideo-codecs=all \
  -Dgallium-va=enabled \
  -Dvulkan-layers=anti-lag,overlay,screenshot,device-select
  ninja -C build
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$NAME-$VERSION"
  DESTDIR="$pkgdir" ninja -C build install
}




