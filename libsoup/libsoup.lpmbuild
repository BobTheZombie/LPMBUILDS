
#!/bin/bash
# LPM Linux — libsoup3 3.8.1

NAME="libsoup3"
VERSION="3.8.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="HTTP/2 client and server library for GLib (libsoup 3)"
URL="https://libsoup.gnome.org/"
LICENSE=("LGPL-2.0-or-later")

SOURCE=(
    "https://download.gnome.org/sources/libsoup/${VERSION%.*}/libsoup-${VERSION}.tar.xz"
)
SHA256SUMS=(
    "5013dcef9136f6f861e6529fca578af50c1f52a39219027fb5aff652d1371a04"
)
PATCHES=()

REQUIRES=(
    "glibc" "glib2" "nghttp2" "libpsl" "sqlite"
    "zlib" "brotli" "zstd"
)

BUILD_REQUIRES=(
    "gcc" "meson" "ninja" "pkgconf" "python"
    "glib2" "nghttp2" "libpsl" "sqlite"
    "zlib" "brotli" "zstd" "gobject-introspection"
)

REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=("libsoup3" "libsoup-3.0" "libsoup-3.0.so")
CONFLICTS=("libsoup")
OBSOLETES=()
RECOMMENDS=("glib-networking")
SUGGESTS=()

prepare() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    test -f "$src/meson.build"
    test -f "$src/meson_options.txt"
}

build() {
    set -euxo pipefail

    local src="$SRCROOT/${NAME}-${VERSION}"
    local builddir="$BUILDROOT/${NAME}-build"

    meson setup "$builddir" "$src" \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        --wrap-mode=nodownload \
        -Dintrospection=enabled \
        -Dvapi=disabled \
        -Ddocs=disabled \
        -Dtests=false \
        -Dinstalled_tests=false \
        -Ddoc_tests=false \
        -Dgssapi=disabled \
        -Dntlm=disabled \
        -Dbrotli=enabled \
        -Dzstd=enabled \
        -Dsysprof=disabled \
        -Dpkcs11_tests=disabled \
        -Dautobahn=disabled \
        -Dtls_check=false

    meson compile -C "$builddir" \
        -j "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail

    local builddir="$BUILDROOT/${NAME}-build"

    DESTDIR="$pkgdir" meson install -C "$builddir" --no-rebuild

    test -f "$pkgdir/usr/lib/pkgconfig/libsoup-3.0.pc"

    test -n "$(find "$pkgdir/usr/lib" \
        -maxdepth 1 -name 'libsoup-3.0.so*' -print -quit)"

    test -f "$pkgdir/usr/lib/girepository-1.0/Soup-3.0.typelib"
    test -f "$pkgdir/usr/share/gir-1.0/Soup-3.0.gir"
}
