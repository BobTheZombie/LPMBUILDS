#!/bin/bash
# LPM build script for iceauth

NAME="iceauth"
VERSION="1.0.11"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="ICE authority file utility"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=("https://www.x.org/releases/individual/app/${NAME}-${VERSION}.tar.xz")

REQUIRES=(
  "glibc"
  "libX11"
  "libICE"
)

PROVIDES=("iceauth")
CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  ./configure --prefix=/usr
  make -j"$(nproc)"
}

check() { true; }

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  DESTDIR="$pkgdir" make install
}




# Final audited source digests
SHA256SUMS=("9d633cf0d4d1d98e3ef02d18660372958b60a67016e8a72cd04093a8d8f8d4e9")
