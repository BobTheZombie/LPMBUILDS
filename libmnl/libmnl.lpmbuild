#!/bin/bash
NAME="libmnl"
VERSION="1.0.5"
RELEASE="2"
ARCH="${ARCH:-x86_64}"
SUMMARY="Minimal userspace Netlink library"
URL="https://www.netfilter.org/projects/libmnl/"
LICENSE=("LGPL-2.1-or-later")
SOURCE=("https://www.netfilter.org/projects/libmnl/files/libmnl-1.0.5.tar.bz2")
SHA256SUMS=("274b9b919ef3152bfb3da3a13c950dd60d6e2bcd54230ffeca298d03b40d0525")
REQUIRES=("glibc")
BUILD_REQUIRES=("gcc" "make")
PROVIDES=("libmnl" "libmnl.so")
prepare() { cd "$SRCROOT/libmnl-$VERSION"; }
build() {
    set -euo pipefail
    cd "$SRCROOT/libmnl-$VERSION"
    ./configure --prefix=/usr --disable-static
    make -j"${JOBS:-$(nproc)}"
}
staging() {
    set -euo pipefail
    cd "$SRCROOT/libmnl-$VERSION"
    make DESTDIR="$pkgdir" install
}
