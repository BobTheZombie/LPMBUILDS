#!/bin/bash
# LPM networking stack, release snapshot 2026-10-16
NAME="libmnl"
VERSION="1.0.5"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY='Minimal netlink library'
URL=https://www.netfilter.org/projects/libmnl/files/libmnl-1.0.5.tar.bz2
LICENSE=(LGPL-2.1-or-later)
SOURCE=(https://www.netfilter.org/projects/libmnl/files/libmnl-1.0.5.tar.bz2)
SHA256SUMS=(
    "274b9b919ef3152bfb3da3a13c950dd60d6e2bcd54230ffeca298d03b40d0525"
)
PATCHES=()
REQUIRES=(glibc)
BUILD_REQUIRES=(gcc make pkgconf glibc)
PROVIDES=(libmnl libmnl.so)
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
BUILD_OPTIONS=(@--stripping @--optimize=2)

_source() {
    if [ ! -d "$SRCROOT/${NAME}-${VERSION}" ] && [ -d "$SRCROOT/libmnl-1.0.5" ]; then
        mv "$SRCROOT/libmnl-1.0.5" "$SRCROOT/${NAME}-${VERSION}"
    fi
}

_licenses() {
    local f
    for f in COPYING COPYING.LIB LICENSE LICENSE.txt LICENCE README; do
        if [ -f "$f" ]; then
            install -Dm644 "$f" "$pkgdir/usr/share/licenses/$NAME/$(basename "$f")"
        fi
    done
}
_cleanup() {
    if [ -d "$pkgdir/usr/lib" ]; then
        find "$pkgdir/usr/lib" -type f \( -name '*.a' -o -name '*.la' \) -delete
    fi
    rm -f "$pkgdir/usr/share/info/dir"
}

prepare() {
    set -euxo pipefail
    _source
    cd "$SRCROOT/${NAME}-${VERSION}"
    if [ -f Makefile ]; then make distclean; fi
    :
    test -x configure
}
build() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    ./configure --prefix=/usr --libdir=/usr/lib --sbindir=/usr/bin \
        --sysconfdir=/etc --localstatedir=/var --disable-static
    make -j"${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    make -j1 DESTDIR="$pkgdir" install
    _cleanup
    :
    _licenses
}





# Final audited source digests
SHA256SUMS=("274b9b919ef3152bfb3da3a13c950dd60d6e2bcd54230ffeca298d03b40d0525")
