#!/bin/bash
# LPM build script for xinput

NAME="xinput"
VERSION="1.6.4"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Runtime configuration and test tool for XInput devices"
URL="https://xorg.freedesktop.org/"
LICENSE="MIT"

SOURCE=(
  "https://www.x.org/archive//individual/app/${NAME}-${VERSION}.tar.xz"
)

REQUIRES=(
  "glibc"
  "libX11"
  "libXi"
  "libXinerama"
)

PROVIDES=("xinput")
CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
    set -euxo pipefail
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    ./configure --prefix=/usr
    make -j"$(nproc)"
}

check() { true; }

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    DESTDIR="$pkgdir" make install
}
