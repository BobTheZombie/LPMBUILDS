#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="linux-headers"
VERSION="7.1.8"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Header files for the Linux kernel"
URL="https://www.kernel.org/pub/linux/kernel/v7.x/linux-7.1.8.tar.xz"
LICENSE="GPL-2.0-or-later"
SOURCE=("https://www.kernel.org/pub/linux/kernel/v7.x/linux-7.1.8.tar.xz")
SHA256SUMS=("ff01dcb449279d5b4cfccdb01fee639cf5ff1803f1749a77844dd33915422c49")
PATCHES=()
REQUIRES=()
BUILD_REQUIRES=("gcc" "make" "pkgconf")
PROVIDES=("linux-headers")
CONFLICTS=()
OBSOLETES=()

_srcdir="linux-7.1.8"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    :
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    make mrproper
    make headers
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    find usr/include -type f ! -name "*.h" -delete
    install -dm755 "$pkgdir/usr/include"
    cp -a usr/include/. "$pkgdir/usr/include/"

    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
