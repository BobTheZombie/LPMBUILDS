#!/bin/bash
# LPM build script for budgie-desktop (Budgie 10.x / 10.10 series)
# Notes:
# - These are "git+" lpmbuilds (Arch-style) so you are not blocked by the lack of stable 10.10 tarball releases.
# - If you want to pin to a specific tag/commit, change SOURCE to e.g.:
#     SOURCE=("git+https://github.com/BuddiesOfBudgie/budgie-desktop.git#tag=10.10-preview.1")
#   or:
#     SOURCE=("git+https://github.com/BuddiesOfBudgie/budgie-desktop.git#commit=<sha>")
# - If your LPM git fetcher uses a different fragment syntax, adjust accordingly.
#

NAME="budgie-desktop"
VERSION="10.10"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Budgie Desktop (10.x series)"
URL="https://github.com/BuddiesOfBudgie/budgie-desktop"
LICENSE=("GPL-2.0-only")

SOURCE=(
  "git+https://github.com/BuddiesOfBudgie/budgie-desktop.git"
)

REQUIRES=(
  "gdm" # for best experience 
  "glibc"
  "glib2"
  "gtk3"
  "gdk-pixbuf2"
  "pango"
  "cairo"
  "atk"
  "at-spi2-atk"
  "at-spi2-core"
  "grim"
  "libgtop"
  "libnotify"
  "libxkbcommon"
  "libX11"
  "libXi"
  "libXrandr"
  "libXrender"
  "libXtst"
  "libxcb"
  "libICE"
  "libSM"
  "libcanberra"
  "libxfce4windowing"
  "mutter"
  "pulseaudio"
  "systemd"
  "dbus"
  "docbook-xsl"
  "gsettings-desktop-schemas"
  "startup-notification"
  "libpeas"
  "gammastep"
  "gee"
  "gnome-desktop"
  "gnome-settings-daemon"
  "iso-codes"
  "mesa-demos"
  "scdoc"
  "slurp"
  "swaybg"
  "swayidle"
  "swaylock"
  "wlopm"
)

PROVIDES=("budgie-desktop" "budgie-panel" "budgie-wm")
CONFLICTS=()
OBSOLETES=()

_srcdir="budgie-desktop"

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"
    mkdir -p build
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    : "${CC:=cc}"
    : "${CXX:=c++}"

    meson setup build \
      --prefix=/usr \
      --libdir=lib \
      --buildtype=release \
      -Ddefault_library=shared \
      -Dwith-gtk-doc=false 

    ninja -C build
}

check() {
    true
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"
    DESTDIR="$pkgdir" ninja -C build install

    # Licenses (best-effort)
    if [ -f COPYING ]; then
      install -Dm644 COPYING "$pkgdir/usr/share/licenses/$NAME/COPYING"
    elif [ -f LICENSE ]; then
      install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$NAME/LICENSE"
    fi

    # Strip
    if command -v strip >/dev/null 2>&1; then
      find "$pkgdir/usr" -type f -exec sh -c '
        case "$(file -b "$1")" in
          *ELF*executable*|*ELF*shared\ object*) strip --strip-unneeded "$1" 2>/dev/null || true ;;
        esac
      ' _ {} \;
    fi
}
