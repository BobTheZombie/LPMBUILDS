NAME="alsa-lib"
VERSION="1.2.12"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Advanced Linux Sound Architecture (ALSA) core library"
URL="https://www.alsa-project.org/"
SOURCE=("https://www.alsa-project.org/files/pub/lib/alsa-lib-${VERSION}.tar.bz2")
LICENSE=("LGPL-2.1-or-later")

REQUIRES=("glibc")
PROVIDES=("alsa-lib" "libasound.so")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/alsa-lib-${VERSION}"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/alsa-lib-${VERSION}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --libdir=/usr/lib \
        --disable-static \
        --enable-shared \
        --enable-symbolic-functions \
        --with-pcm-plugins=all

    make -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/alsa-lib-${VERSION}"

    make DESTDIR="$pkgdir" install

    # Documentation
    install -Dm644 COPYING "$pkgdir/usr/share/licenses/$NAME/COPYING"
    [ -f README ] && install -Dm644 README "$pkgdir/usr/share/doc/$NAME/README"

    # Strip binaries & shared objects
    find "$pkgdir/usr/lib" -type f -name "*.so*" -exec sh -c '
        file -b "$1" | grep -q "ELF" && strip --strip-unneeded "$1" || true
    ' _ {} \; 2>/dev/null || true
}

