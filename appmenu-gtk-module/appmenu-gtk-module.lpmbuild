#!/bin/bash
# Build only the GTK3 appmenu module subproject (not the Vala Panel applets).
# Pinned Git commit: 2026-10-30.
NAME="appmenu-gtk-module"
VERSION="25.04"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="GTK3 global menu bridge for KDE Plasma application menu"
URL="https://github.com/rilian-la-te/vala-panel-appmenu"
LICENSE=("LGPL-3.0-or-later")
SOURCE=("https://github.com/rilian-la-te/vala-panel-appmenu/archive/637cfdb7b317e4f6b98d02324cd4a447856109bd.tar.gz")
# Archive is pinned to the above Git commit; verify/pin archive checksum.
SHA256SUMS=("SKIP")
PATCHES=()
REQUIRES=("glibc" "glib2" "gtk2" "gtk3" "dconf")
BUILD_REQUIRES=("gcc" "meson" "ninja" "pkgconf" "glib2" "gtk2" "gtk3" "dconf")
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=("appmenu-gtk-module" "AppMenuGtkModule")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/subprojects/appmenu-gtk-module/meson.build"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}/subprojects/appmenu-gtk-module"
    local builddir="$BUILDROOT/${NAME}-build"
    # KDE FindAppMenuGtkModule requires BOTH the GTK2 and GTK3 modules.
    meson setup "$builddir" "$src" \
      --prefix=/usr --libdir=lib --buildtype=release --wrap-mode=nodownload \
      -Dgtk=2,3 -Dtests=false -Dgtk_doc=false -Dwayland=false
    meson compile -C "$builddir" -j "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" meson install -C "$BUILDROOT/${NAME}-build" --no-rebuild
    test -f "$pkgdir/usr/lib/gtk-2.0/modules/libappmenu-gtk-module.so"
    test -f "$pkgdir/usr/lib/gtk-3.0/modules/libappmenu-gtk-module.so"
    test -n "$(find "$pkgdir/usr/share/glib-2.0/schemas" -type f -name '*appmenu*' -print -quit)"
}
