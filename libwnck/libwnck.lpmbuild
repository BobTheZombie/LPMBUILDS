#!/bin/bash
# LPM build script for libwnck

NAME="libwnck"
VERSION="43.3"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Library to manage windows and workspaces"
URL="https://gitlab.gnome.org/GNOME/libwnck"
LICENSE=("LGPL-2.0-or-later")

SOURCE=(
  "https://download.gnome.org/sources/libwnck/43/libwnck-${VERSION}.tar.xz"
)

REQUIRES=(
  "glibc"
  "glib2"
  "gtk3"
  "libX11"
  "startup-notification"
)

BUILD_REQUIRES=(
  "meson"
  "ninja"
  "pkgconf"
  "gettext"
  "gobject-introspection"
)

PROVIDES=(
  "libwnck"
  "libwnck-3.0"
  "libwnck-3.so"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  rm -rf build

  meson setup build \
    --prefix=/usr \
    --libdir=lib \
    --buildtype=release \
    -Ddefault_library=shared \
    -Dintrospection=enabled \
    -Dgtk_doc=false

  meson compile -C build
}

check() {
  true
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  DESTDIR="$pkgdir" meson install -C build

  test -f "$pkgdir/usr/lib/pkgconfig/libwnck-3.0.pc"
  test -f "$pkgdir/usr/lib/libwnck-3.so"

  for f in COPYING LICENSE; do
    if [ -f "$f" ]; then
      install -Dm644 "$f" "$pkgdir/usr/share/licenses/$NAME/$f"
    fi
  done
}
