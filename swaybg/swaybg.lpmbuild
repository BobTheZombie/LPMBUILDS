#!/bin/bash
# LPM build script for swaybg

NAME="swaybg"
VERSION="1.2.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Wallpaper utility for Wayland compositors"
URL="https://github.com/swaywm/swaybg"
LICENSE=("MIT")

SOURCE=(
  "https://github.com/swaywm/swaybg/releases/download/v${VERSION}/swaybg-${VERSION}.tar.gz"
)

REQUIRES=(
  "glibc"
  "cairo"
  "gdk-pixbuf2"
  "wayland"
)

BUILD_REQUIRES=(
  "meson"
  "ninja"
  "pkgconf"
  "wayland-protocols"
  "scdoc"
)

PROVIDES=(
  "swaybg"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  rm -rf build

  meson setup build \
    --prefix=/usr \
    --libdir=lib \
    --buildtype=release

  meson compile -C build
}

check() {
  true
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  DESTDIR="$pkgdir" meson install -C build

  test -f "$pkgdir/usr/bin/swaybg"

  for f in LICENSE COPYING; do
    if [ -f "$f" ]; then
      install -Dm644 "$f" \
        "$pkgdir/usr/share/licenses/$NAME/$f"
    fi
  done
}