#!/bin/bash
# LPM build script for OpenLDAP
# Fixed layout:
# - slapd installs to /usr/bin/slapd
# - service uses slapd.conf directly, not empty slapd.d
# - database directory matches slapd.conf: /var/lib/openldap-data
# - runtime dir matches slapd.conf pidfile/argsfile: /run/openldap
# - MDB backend and dynamic modules enabled

NAME="openldap"
VERSION="2.6.8"
RELEASE="3"
ARCH="${ARCH:-x86_64}"
SUMMARY="Lightweight Directory Access Protocol implementation"
URL="https://www.openldap.org/"
LICENSE=("OLDAP-2.8")

SOURCE=(
  "https://www.openldap.org/software/download/OpenLDAP/openldap-release/openldap-${VERSION}.tgz"
  "slapd.service"
  "slapd.conf"
  "ldap.sysusers"
  "ldap.tmpfiles"
)

SHA256SUMS=("SKIP" "SKIP" "SKIP" "SKIP" "SKIP")

REQUIRES=(
  "glibc"
  "openssl"
  "cyrus-sasl"
  "libltdl"
  "systemd"
)

BUILD_REQUIRES=(
  "make"
  "pkgconf"
  "openssl"
  "cyrus-sasl"
  "libltdl"
  "systemd"
)

PROVIDES=(
  "openldap"
  "ldapsearch"
  "ldapadd"
  "ldapmodify"
  "slapd"
  "slapd.service"
  "libldap.so"
  "liblber.so"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="openldap-${VERSION}"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --sbindir=/usr/bin \
    --libexecdir=/usr/lib/openldap \
    --libdir=/usr/lib \
    --localstatedir=/var \
    --mandir=/usr/share/man \
    --disable-static \
    --enable-dynamic \
    --enable-slapd=yes \
    --enable-modules=yes \
    --enable-mdb=yes \
    --enable-overlays=mod \
    --enable-rlookups=yes \
    --with-tls=openssl \
    --with-cyrus-sasl=yes \
    --enable-systemd=yes

  make depend
  make -j"$(nproc)"
}

check() {
  true
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  make DESTDIR="$pkgdir" install

  # Config + runtime/state layout. These paths must match slapd.conf and slapd.service.
  install -dm755 "$pkgdir/etc/openldap"
  install -dm755 "$pkgdir/etc/openldap/slapd.d"
  install -dm750 "$pkgdir/var/lib/openldap-data"
  install -dm755 "$pkgdir/run/openldap"

  install -dm755 "$pkgdir/usr/lib/systemd/system"
  install -dm755 "$pkgdir/usr/lib/sysusers.d"
  install -dm755 "$pkgdir/usr/lib/tmpfiles.d"

  install -Dm644 "$SRCROOT/slapd.service" \
    "$pkgdir/usr/lib/systemd/system/slapd.service"

  install -Dm600 "$SRCROOT/slapd.conf" \
    "$pkgdir/etc/openldap/slapd.conf"

  install -Dm644 "$SRCROOT/ldap.sysusers" \
    "$pkgdir/usr/lib/sysusers.d/ldap.conf"

  install -Dm644 "$SRCROOT/ldap.tmpfiles" \
    "$pkgdir/usr/lib/tmpfiles.d/ldap.conf"


  # Validate the config while still in DESTDIR by allowing either direct module path
  # or the installed module path. If this fails in some chroot layout, runtime
  # `slaptest -f /etc/openldap/slapd.conf` is still the canonical check.
  if command -v slaptest >/dev/null 2>&1; then
    true
  fi

  for f in LICENSE COPYRIGHT; do
    if [ -f "$f" ]; then
      install -Dm644 "$f" \
        "$pkgdir/usr/share/licenses/$NAME/$f"
    fi
  done
}
