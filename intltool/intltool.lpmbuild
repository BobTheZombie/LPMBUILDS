#!/bin/bash

NAME="intltool"
VERSION="0.51.0"
RELEASE="1"
ARCH="any"
SUMMARY="Utility scripts for internationalization in GNOME"
URL="https://launchpad.net/intltool"
LICENSE=("GPL-2.0-or-later")

SOURCE=(
  "https://launchpad.net/intltool/trunk/${VERSION}/+download/intltool-${VERSION}.tar.gz"
)

SHA256SUMS=("SKIP")

REQUIRES=(
  "perl"
  "gettext"
  "perl-XML-Parser"
)

BUILD_REQUIRES=(
  "perl"
  "gettext"
)

PROVIDES=(
  "intltool"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  ./configure \
    --prefix=/usr

  make
}

check() { true; }

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  make DESTDIR="$pkgdir" install

  test -x "$pkgdir/usr/bin/intltool-update"
}




# Final audited source digests
SHA256SUMS=("67c74d94196b153b774ab9f89b2fa6c6ba79352407037c8c14d5aeb334e959cd")
