#!/bin/bash
# lpmbuild script for gtk-doc

NAME="gtk-doc"
VERSION="1.34.0"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Documentation generator for GObject-based libraries"
URL="https://gitlab.gnome.org/GNOME/gtk-doc"
LICENSE=("GPL-2.0-or-later")

SOURCE=(
  "https://download.gnome.org/sources/gtk-doc/1.34/gtk-doc-${VERSION}.tar.xz"
)

REQUIRES=(
  "python" 
  "glib2"
  "libxml2"
  "libxslt"
  "docbook-xml"
  "docbook-xsl"
  "itstool"
  "glibc"
  "meson"
  "ninja"
  "pkgconf"
)

REQUIRES_PYTHON_DEPENDENCIES=(
  "python-pygments"
)

SUGGESTS=()
PROVIDES=("gtk-doc")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    _srcdir="${NAME}-${VERSION}"
    cd "$SRCROOT/$_srcdir"
}

build() {
    set -euxo pipefail
    _srcdir="${NAME}-${VERSION}"
    cd "$SRCROOT/$_srcdir"

    meson setup build \
        --prefix=/usr \
        --buildtype=release \
        -Dtests=false \
        -Dyelp_manual=false

    meson compile -C build
}

check() {
    set -euxo pipefail
    _srcdir="${NAME}-${VERSION}"
    cd "$SRCROOT/$_srcdir"
}

staging() {
    set -euxo pipefail
    _srcdir="${NAME}-${VERSION}"
    cd "$SRCROOT/$_srcdir"

    meson install -C build --destdir "$pkgdir"

    if [ -f COPYING ]; then
        install -Dm644 COPYING "$pkgdir/usr/share/licenses/${NAME}/COPYING"
    fi

    if [ -f LICENSE ]; then
        install -Dm644 LICENSE "$pkgdir/usr/share/licenses/${NAME}/LICENSE"
    fi
}
