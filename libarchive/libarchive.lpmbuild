NAME="libarchive"
VERSION="3.8.1"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Multi-format archive and compression library"
URL="https://www.libarchive.org/"
SOURCE=("https://www.libarchive.org/downloads/libarchive-${VERSION}.tar.xz")
LICENSE=("BSD-2-Clause")

REQUIRES=(
  "acl"
  "glibc" 
  "zlib" 
  "bzip2" 
  "libxml2"
  "lz4"
  "openssl"
  "xz" 
  "zstd"
  )
  
PROVIDES=("libarchive" "libarchive.so")

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/$NAME-$VERSION"
    autoreconf -fiv
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$NAME-$VERSION"
    ./configure --prefix=/usr --libdir=/usr/lib --disable-static --without-nettle
    make -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$NAME-$VERSION"
    make DESTDIR="$pkgdir" install
}

