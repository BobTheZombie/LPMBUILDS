#!/bin/bash
# LPM build script for font-adobe-utopia-type1

NAME="font-adobe-utopia-type1"
VERSION="1.0.5"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Adobe Utopia Type1 fonts for X.Org"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=(
  "https://www.x.org/archive//individual/font/font-adobe-utopia-type1-${VERSION}.tar.xz"
)

REQUIRES=(
  "glibc"
  "font-util"
  "encodings"
)

PROVIDES=("font-adobe-utopia-type1")
CONFLICTS=()
OBSOLETES=()

_srcdir="font-adobe-utopia-type1-${VERSION}"

prepare() {
    set -euxo pipefail
    cd "$SRCROOT"
    tar xf "font-adobe-utopia-type1-${VERSION}.tar.xz"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    ./configure --prefix=/usr
    make -j"$(nproc)"
}

check() {
    true
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    DESTDIR="$pkgdir" make install

    if [ -f COPYING ]; then
        install -Dm644 COPYING "$pkgdir/usr/share/licenses/$NAME/COPYING"
    fi
}




