#!/bin/bash
# LPM build script for Lua 5.1 (Lua51)
# Provides: lua5.1 interpreter + shared liblua5.1

NAME="lua51"
VERSION="5.1.5"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Lua 5.1 language interpreter and runtime library"
URL="https://www.lua.org/"
LICENSE=("MIT")

SOURCE=(
  "https://www.lua.org/ftp/lua-${VERSION}.tar.gz"
  "cve-2014-5461.patch"
  "lua-arch.patch"
  "lua-5.1-cflags.diff"
)

REQUIRES=(
  "glibc"
  "readline"
  "ncurses"
)

PROVIDES=(
  "lua51"
  "lua5.1"
  "lua"
  "lua51-bin"
  "liblua5.1.so.0"
  "liblua5.1.so"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  patch -p1 -i "$SRCROOT/cve-2014-5461.patch"
  patch -p1 -i "$SRCROOT/lua-arch.patch"
  patch -p1 -i "$SRCROOT/lua-5.1-cflags.diff"

  # Fix pkg-config metadata and include path
  sed -e 's:llua:llua5.1:' -e 's:/include:/include/lua5.1:' -i etc/lua.pc

  # Slot the binaries and library names in src/Makefile
  sed -r \
    -e '/^LUA_(SO|A|T)=/ s/lua/lua5.1/' \
    -e '/^LUAC_T=/ s/luac/luac5.1/' \
    -i src/Makefile
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  PIC_CFLAGS="${CFLAGS:--O2} -fPIC -DLUA_USE_LINUX"
  PIC_LDFLAGS="${LDFLAGS:-}"

  # Clean to avoid non-PIC leftovers
  make clean || true

  make linux \
    MYCFLAGS="$PIC_CFLAGS" \
    CFLAGS="$PIC_CFLAGS" \
    MYLDFLAGS="$PIC_LDFLAGS" \
    LDFLAGS="$PIC_LDFLAGS"
}

check() {
  true
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  make \
    TO_BIN='lua5.1 luac5.1' \
    TO_LIB="liblua5.1.so liblua5.1.so.5.1 liblua5.1.so.$VERSION" \
    INSTALL_DATA='cp -d' \
    INSTALL_TOP="$pkgdir/usr" \
    INSTALL_INC="$pkgdir/usr/include/lua5.1" \
    INSTALL_MAN="$pkgdir/usr/share/man/man1" \
    install

  # pkg-config: make lua5.1.pc the canonical name, keep aliases
  install -Dm644 etc/lua.pc "$pkgdir/usr/lib/pkgconfig/lua5.1.pc"
  ln -sf lua5.1.pc "$pkgdir/usr/lib/pkgconfig/lua51.pc"
  ln -sf lua5.1.pc "$pkgdir/usr/lib/pkgconfig/lua-5.1.pc"

  install -d "$pkgdir/usr/share/doc/$NAME"
  install -m644 doc/*.{gif,png,css,html} "$pkgdir/usr/share/doc/$NAME"
  install -Dm644 COPYRIGHT "$pkgdir/usr/share/licenses/$NAME/COPYRIGHT"

  # Compatibility symlinks expected by some consumers
  ln -sf liblua5.1.so "$pkgdir/usr/lib/liblua.so.5.1"
  ln -sf liblua5.1.so "$pkgdir/usr/lib/liblua.so.$VERSION"

  # Manpage slotting (guarded)
  cd "$pkgdir/usr/share/man/man1"
  [ -f lua.1 ]  && mv -f lua.1  lua5.1.1
  [ -f luac.1 ] && mv -f luac.1 luac5.1.1
}

