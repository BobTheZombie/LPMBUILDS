#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="libffi"
VERSION="3.8.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Foreign Function Interface library"
URL="https://github.com/libffi/libffi/releases/download/v3.8.0/libffi-3.8.0.tar.gz"
LICENSE=("MIT")
SOURCE=("https://github.com/libffi/libffi/releases/download/v3.8.0/libffi-3.8.0.tar.gz")
SHA256SUMS=("7da3e2d9a171eb0a038f592ecad3ff2bb2550f3496d87b3b29ad0cf4430c0db4")
PATCHES=()
REQUIRES=("glibc")
BUILD_REQUIRES=("gcc" "make" "pkgconf")
PROVIDES=("libffi")
CONFLICTS=()
OBSOLETES=()

_srcdir="libffi-3.8.0"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    :
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    ./configure --prefix=/usr --disable-static
    make -j"${JOBS:-$(nproc)}"
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    make DESTDIR="$pkgdir" install

    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
