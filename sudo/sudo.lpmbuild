NAME="sudo"
VERSION="1.9.17p2"
RELEASE="2"
ARCH="x86_64"
SUMMARY="sudo - execute a command as another user"
URL="https://www.sudo.ws/"
SOURCE=("https://www.sudo.ws/dist/sudo-${VERSION}.tar.gz"
        "sudo.pam")
LICENSE=("ISC")

# runtime deps
REQUIRES=("glibc" "openssl" "pam" "openldap" "zlib")
PROVIDES=("sudo" "sudoers" "sudoers.so")
CONFLICTS=()
OBSOLETES=()

BUILD_REQUIRES=("gcc" "make" "pkgconf" "openssl" "pam" "openldap" "zlib")
install=$NAME.install

# OpenSSL 1.1+ (and modern compatible libraries) hide ASN1_STRING internals.
# Sudo 1.9.17p2 accesses that field directly in the iolog SAN IP matcher.
prepare() {
    set -euxo pipefail
    local src="$SRCROOT/sudo-$VERSION"
    local file="$src/lib/iolog/hostcheck.c"
    test -f "$file"

    if grep -Fq 'current_name->d.iPAddress->length' "$file"; then
        sed -i 's/current_name->d\.iPAddress->length/ASN1_STRING_length(current_name->d.iPAddress)/g' "$file"
    fi

    if grep -Fq 'current_name->d.iPAddress->length' "$file"; then
        echo "[ERROR] Failed to patch OpenSSL ASN.1 SAN length access" >&2
        return 1
    fi

    grep -Fq 'ASN1_STRING_length(current_name->d.iPAddress)' "$file"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/sudo-${VERSION}"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --sbindir=/usr/bin \
        --libexecdir=/usr/lib \
        --with-rundir=/run/sudo \
        --with-vardir=/var/db/sudo \
        --with-logfac=auth \
        --enable-tmpfiles.d \
        --with-pam \
        --with-sssd \
        --with-ldap \
        --with-ldap-conf-file=/etc/openldap/ldap.conf \
        --with-env-editor \
        --with-passprompt="[sudo] password for %p: " \
        --with-secure-path-value=/usr/local/sbin:/usr/local/bin:/usr/bin \
        --with-all-insults
    make -j"${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/sudo-${VERSION}"

    make DESTDIR="$pkgdir" install

    # Remove sudoers.dist; not needed since LPM manages updates to sudoers
    rm -f "$pkgdir/etc/sudoers.dist"

    # Remove /run/sudo directory; we create it using systemd-tmpfiles
    if [[ -d "$pkgdir/run/sudo" ]]; then rmdir "$pkgdir/run/sudo"; fi
    if [[ -d "$pkgdir/run" ]]; then rmdir "$pkgdir/run" 2>/dev/null || true; fi

    install -Dm644 "$SRCROOT/sudo.pam" "$pkgdir/etc/pam.d/sudo"
    
    # --- Critical!: set correct permissions and ownership on sudo binary ---
    chown root:root "$pkgdir/usr/bin/sudo"
    chmod 4755 "$pkgdir/usr/bin/sudo"

    # Ensure sudoers file permissions are safe
    chmod 0440 "$pkgdir/etc/sudoers" || true
    chown root:root "$pkgdir/etc/sudoers" || true
    
    test "$(stat -c '%a:%u:%g' "$pkgdir/usr/bin/sudo")" = "4755:0:0"
}





