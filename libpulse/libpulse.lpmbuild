#!/bin/bash
# LPM source recipe - staged installation only; review build features before use.
NAME="libpulse"
VERSION="17.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="PulseAudio client libraries (without the sound server)"
URL="https://www.freedesktop.org/wiki/Software/PulseAudio/"
LICENSE=("LGPL-2.1-or-later")
SOURCE=("https://www.freedesktop.org/software/pulseaudio/releases/pulseaudio-${VERSION}.tar.xz")
SHA256SUMS=("SKIP")
PATCHES=()
REQUIRES=(
    "glib2"
    "dbus"
    "libsndfile"
)
BUILD_REQUIRES=(
    "meson"
    "ninja"
    "pkgconf"
    "gcc"
)
PROVIDES=("libpulse")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

_srcdir() {
    local d="$SRCROOT/pulseaudio-${VERSION}"
    test -d "$d" || { printf 'Expected source directory not found: %s\n' "$d" >&2; return 1; }
    printf '%s\n' "$d"
}

prepare() {
    set -euo pipefail
    test -d "$(_srcdir)"
}

build() {
    set -euo pipefail
    local src
    src="$(_srcdir)"
    meson setup "$src/build-lpm" "$src" --prefix=/usr --libdir=lib --buildtype=release \
        -D daemon=false -D client=true -D doxygen=false -D man=false -D tests=false -D database=simple -D bluez5=disabled
    ninja -C "$src/build-lpm"
}

staging() {
    set -euo pipefail
    local src
    src="$(_srcdir)"
    DESTDIR="$pkgdir" ninja -C "$src/build-lpm" install
    test -e "$pkgdir/usr/lib/libpulse.so"
}
