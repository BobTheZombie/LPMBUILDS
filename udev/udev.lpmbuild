#!/bin/bash
NAME="udev"
VERSION="261.2"
RELEASE="1"
ARCH="any"
SUMMARY="Compatibility dependency for systemd"
URL="https://www.linuxfromscratch.org/lfs/view/13.1-systemd/"
LICENSE=("MIT")
SOURCE=()
SHA256SUMS=()
REQUIRES=("systemd")
BUILD_REQUIRES=()
PROVIDES=("udev")
prepare() { :; }
build() { :; }
staging() {
    install -dm755 "$pkgdir/usr/share/doc/udev"
    printf '%s\n' 'The implementation is supplied by systemd.' > "$pkgdir/usr/share/doc/udev/README"
}
