#!/bin/bash
# LPM build script for xlsclients

NAME="xlsclients"
VERSION="1.1.6"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="List client applications running on a display"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=("https://www.x.org/archive//individual/app/${NAME}-${VERSION}.tar.xz")

REQUIRES=(
  "glibc"
  "libX11"
  "libXmu"
)

PROVIDES=("xlsclients")
CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  ./configure --prefix=/usr
  make -j"$(nproc)"
}

check() { true; }

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  DESTDIR="$pkgdir" make install
}




# Final audited source digests
SHA256SUMS=("909810a3fdbd01d84747907f2c0cc32ee732e77afc88cb310abb9d155b2a0807")
