#!/bin/bash
NAME="libXext"
VERSION="1.3.6"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="libXext from X.Org"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=(
  "https://www.x.org/archive/individual/lib/libXext-${VERSION}.tar.xz"
)

REQUIRES=(
  "glibc"
  "libX11"
)

PROVIDES=("libXext")
CONFLICTS=()
OBSOLETES=("libxext")

_srcdir="$NAME-$VERSION"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  ./configure --prefix=/usr
  make -j"$(nproc)"
}

check() { true; }

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  DESTDIR="$pkgdir" make install
  [ -f COPYING ] && install -Dm644 COPYING "$pkgdir/usr/share/licenses/$NAME/COPYING"
}
