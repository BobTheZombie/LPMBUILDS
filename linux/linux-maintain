#!/usr/bin/env python3
"""LPM kernel initramfs and systemd-boot maintenance."""
import argparse
import configparser
import fcntl
import os
from pathlib import Path
import re
import shutil
import subprocess
import sys
import tempfile

MARKER = '# Generated by LPM linux package; do not edit.\n'
VERSION = re.compile(r'[A-Za-z0-9][A-Za-z0-9._+-]*\Z')


def log(message):
    print('[lpm:linux] ' + message, flush=True)


def run(command):
    log('Running: ' + ' '.join(map(str, command)))
    subprocess.run(list(map(str, command)), check=True)


def atomic_write(destination, source=None, text=None):
    destination.parent.mkdir(parents=True, exist_ok=True)
    if destination.is_symlink():
        raise RuntimeError(f'Refusing symlink destination: {destination}')
    fd, name = tempfile.mkstemp(prefix='.lpm-linux-', dir=destination.parent)
    temporary = Path(name)
    try:
        with os.fdopen(fd, 'wb') as output:
            if source is not None:
                with source.open('rb') as incoming:
                    shutil.copyfileobj(incoming, output, 1024 * 1024)
            else:
                output.write(text.encode())
            os.fchmod(output.fileno(), 0o644)
            output.flush()
            os.fsync(output.fileno())
        os.replace(temporary, destination)
    finally:
        temporary.unlink(missing_ok=True)


def targets(arguments):
    values = list(arguments)
    values.extend(os.environ.get('LPM_TARGETS', '').splitlines())
    filename = os.environ.get('LPM_TARGETS_FILE')
    if filename:
        values.extend(Path(filename).read_text().splitlines())
    versions = set()
    for value in values:
        match = re.fullmatch(r'/?usr/lib/modules/([^/]+)/vmlinuz', value.strip())
        if match and VERSION.fullmatch(match[1]):
            versions.add(match[1])
    return versions


def kernels(root):
    result = {}
    for image in (root/'usr/lib/modules').glob('*/vmlinuz'):
        version = image.parent.name
        if not VERSION.fullmatch(version):
            raise RuntimeError('Invalid kernel release: ' + version)
        pkgbase = image.parent/'pkgbase'
        if pkgbase.is_file() and pkgbase.read_text().strip() == 'linux':
            result[version] = image
    return result


def initramfs(root, versions):
    installed = kernels(root)
    requested = versions or set(installed)
    for version in sorted(requested):
        image = installed.get(version)
        if image is None:
            if (root/'usr/lib/modules'/version/'vmlinuz').exists() or not re.fullmatch(r'.+-lpm[0-9]+', version):
                continue
            # Removal of an older linux package: only delete its named initrd.
            (root/'boot'/f'initrd-{version}.img').unlink(missing_ok=True)
            continue
        run(['depmod', '-a', version])
        output = root/'boot'/f'initrd-{version}.img'
        output.parent.mkdir(parents=True, exist_ok=True)
        fd, name = tempfile.mkstemp(prefix='.lpm-initrd-', dir=output.parent)
        os.close(fd)
        temporary = Path(name)
        try:
            run(['mkinitcpio', '-c', root/'usr/lib/lpm/linux/mkinitcpio.conf',
                 '-k', version, '-g', temporary])
            if temporary.stat().st_size == 0:
                raise RuntimeError('mkinitcpio produced an empty initramfs')
            os.chmod(temporary, 0o600)
            os.replace(temporary, output)
        finally:
            temporary.unlink(missing_ok=True)


def contained(esp, relative):
    path = esp/relative
    if not path.resolve().is_relative_to(esp.resolve()):
        raise RuntimeError(f'Path escapes ESP: {path}')
    return path


def update_boot(root, config, install=False):
    if not config.getboolean('boot', 'enabled', fallback=False):
        if install:
            raise RuntimeError('Enable [boot] in /etc/lpm/linux.conf first')
        log('ESP updates disabled; configure /etc/lpm/linux.conf to enable')
        return
    section = config['boot']
    esp = Path(section.get('esp', '/boot/efi'))
    if not esp.is_absolute() or not os.path.ismount(esp):
        if install:
            raise RuntimeError(f'ESP is not mounted: {esp}')
        log(f'ESP is not mounted at {esp}; skipping boot-file updates')
        return
    cmdline_path = Path(section.get('cmdline', '/etc/kernel/cmdline'))
    if not cmdline_path.is_absolute():
        raise RuntimeError('cmdline path must be absolute')
    cmdline = cmdline_path.read_text().strip()
    if not cmdline or '\n' in cmdline or '\r' in cmdline or 'CHANGE-ME' in cmdline:
        raise RuntimeError('Configure one valid command line in /etc/kernel/cmdline')
    command = ['bootctl', '--esp-path='+str(esp), '--no-variables']
    if not install and subprocess.run(command+['is-installed'], check=False).returncode:
        log('systemd-boot is not installed; use --install-bootloader explicitly')
        return

    installed = kernels(root)
    # Validate every payload before changing any existing boot entry.
    for version in installed:
        if not (root/'boot'/f'initrd-{version}.img').is_file():
            raise RuntimeError(f'Missing initramfs for {version}; run --initramfs first')
        entry = contained(esp, f'loader/entries/lpm-linux-{version}.conf')
        if entry.exists() and not entry.read_text().startswith(MARKER):
            raise RuntimeError(f'Refusing to overwrite an unmanaged entry: {entry}')

    for version, image in sorted(installed.items()):
        directory = f'lpm-kernels/{version}'
        atomic_write(contained(esp, directory+'/vmlinuz'), source=image)
        atomic_write(contained(esp, directory+'/initrd.img'),
                     source=root/'boot'/f'initrd-{version}.img')
        text = (MARKER + f'title LPM Linux ({version})\nversion {version}\n'
                f'linux /{directory}/vmlinuz\ninitrd /{directory}/initrd.img\n'
                f'options {cmdline}\n')
        atomic_write(contained(esp, f'loader/entries/lpm-linux-{version}.conf'), text=text)

    # Remove entries only for removed kernels and only when our ownership marker matches.
    for entry in (esp/'loader/entries').glob('lpm-linux-*.conf'):
        version = entry.name[len('lpm-linux-'):-len('.conf')]
        if VERSION.fullmatch(version) and version not in installed and entry.read_text().startswith(MARKER):
            contained(esp, str(entry.relative_to(esp))).unlink()
            directory = contained(esp, f'lpm-kernels/{version}')
            for filename in ['vmlinuz', 'initrd.img']:
                contained(esp, f'lpm-kernels/{version}/{filename}').unlink(missing_ok=True)
            if directory.is_dir() and not any(directory.iterdir()):
                directory.rmdir()
    # Do not replace an administrator's loader policy/default.
    loader = contained(esp, 'loader/loader.conf')
    if not loader.exists() and installed:
        atomic_write(loader, text='default lpm-linux-*\ntimeout 5\neditor no\n')
    run(command+['install' if install else 'update'])
    log(f'Updated {len(installed)} kernel entries on {esp}')


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--initramfs', action='store_true')
    parser.add_argument('--boot', action='store_true')
    parser.add_argument('--install-bootloader', action='store_true')
    parser.add_argument('targets', nargs='*')
    args = parser.parse_args(argv)
    if not (args.initramfs or args.boot or args.install_bootloader):
        parser.error('choose --initramfs, --boot, or --install-bootloader')
    root = Path(os.environ.get('LPM_ROOT', '/')).resolve()
    if root != Path('/'):
        log('Alternate-root transaction; run maintenance inside the target chroot')
        return 0
    lockpath = root/'var/lib/lpm/linux-maintain.lock'
    lockpath.parent.mkdir(parents=True, exist_ok=True)
    with lockpath.open('a') as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        if args.initramfs:
            initramfs(root, targets(args.targets))
        if args.boot or args.install_bootloader:
            config = configparser.ConfigParser(interpolation=None)
            config.read(root/'etc/lpm/linux.conf')
            update_boot(root, config, args.install_bootloader)
    return 0


if __name__ == '__main__':
    try:
        raise SystemExit(main())
    except (OSError, RuntimeError, ValueError, configparser.Error, subprocess.CalledProcessError) as error:
        log('ERROR: ' + str(error))
        raise SystemExit(1)
