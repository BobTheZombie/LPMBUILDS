NAME="gettext"
VERSION="1.0"
RELEASE="1"
ARCH="x86_64"
SUMMARY="GNU internationalization and localization library"
URL="https://www.gnu.org/software/gettext/"
SOURCE=("https://ftp.wayne.edu/gnu/gettext/gettext-${VERSION}.tar.xz")
LICENSE=("GPL-3.0-or-later" "LGPL-2.1-or-later")

REQUIRES=("acl" "attr" "bash" "gcc-libs" "glibc" "libunistring" "libxml2" "ncurses" "gdbm")
PROVIDES=("gettext" "libintl")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/gettext-${VERSION}"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/gettext-${VERSION}"
      ./configure \
    --prefix=/usr \
    --libexecdir=/usr/lib \
    --libdir=/lib    \
    --enable-csharp \
    --enable-nls \
    --with-xz \
    --without-included-gettext \
    --without-included-libunistring
  sed -e 's/ -shared / -Wl,-O1,--as-needed\0/g' \
      -i gettext-{tools,runtime,runtime/libasprintf}/libtool
    make -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/gettext-${VERSION}"
    make DESTDIR="$pkgdir" install
}





