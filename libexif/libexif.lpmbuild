#!/bin/bash
# LPM Linux - libexif 0.6.26 (secure EXIF metadata parser)
NAME="libexif"
VERSION="0.6.26"
RELEASE="1"
ARCH="${ARCH:-x86_64}"

SUMMARY="Library for parsing, editing, and writing EXIF metadata"
URL="https://libexif.github.io/"
LICENSE=("LGPL-2.1-or-later")
SOURCE=("https://github.com/libexif/libexif/releases/download/v${VERSION}/libexif-${VERSION}.tar.bz2")
SHA256SUMS=("0830ed253fceeb60444fb309598bc8a9491d3007dc054aad3a50a347c5597c57")
PATCHES=()

REQUIRES=("glibc")
BUILD_REQUIRES=(
    "gcc"
    "make"
    "pkgconf"
)

prepare() {
    set -euxo pipefail
    test -f "${SRCROOT:?}/libexif-${VERSION}/configure"
}

build() {
    set -euxo pipefail
    local src="${SRCROOT:?}/libexif-${VERSION}"
    cd "$src"
    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --disable-static \
        --with-doc-dir="/usr/share/doc/libexif-${VERSION}"
    make --jobs="${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    local src="${SRCROOT:?}/libexif-${VERSION}"
    make -C "$src" DESTDIR="${pkgdir:?}" install
    find "$pkgdir/usr/lib" -maxdepth 1 -name '*.la' -delete
    test -f "$pkgdir/usr/lib/pkgconfig/libexif.pc"
    test -f "$pkgdir/usr/include/libexif/exif-data.h"
    find "$pkgdir/usr/lib" -maxdepth 1 -name 'libexif.so*' -print -quit | grep -q .
}
