#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="util-linux"
VERSION="2.42.2"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Miscellaneous system utilities for Linux"
URL="https://www.kernel.org/pub/linux/utils/util-linux/v2.42/util-linux-2.42.2.tar.xz"
LICENSE=("GPL-2.0-or-later" "LGPL-2.1-or-later" "BSD-2-Clause" "BSD-3-Clause" "BSD-4-Clause-UC")
SOURCE=("https://www.kernel.org/pub/linux/utils/util-linux/v2.42/util-linux-2.42.2.tar.xz" "common.pam" "login.pam" "remote.pam" "runuser.pam" "su.pam" "util-linux.sysusers" "60-rfkill.rules" "rfkill-unblock_.service" "rfkill-block_.service")
SHA256SUMS=("03a05d3adf9602ef128f2da05b84b3205ce60c351e5737c0370f74000679ce8a" "57e057758944f4557762c6def939410c04ca5803cbdd2bfa2153ce47ffe7a4af" "ee917d55042f78b8bb03f5467e5233e3e2ddc2fe01e302bc53b218003fe22275" "8bfbee453618ba44d60ba7fb00eced6c62edebfc592f2e75dede08e769ed8931" "48d6fba767631e3dd3620cf02a71a74c5d65a525d4c4ce4b5a0b7d9f41ebfea1" "3f54249ac2db44945d6d12ec728dcd0d69af0735787a8b078eacd2c67e38155b" "4a0b3dd8aa6d34dd29e1d153f396cacf908b0d64f7218276cbcab684587c0a0a" "7423aaaa09fee7f47baa83df9ea6fef525ff9aec395c8cbd9fe848ceb2643f37" "8ccec10a22523f6b9d55e0d6cbf91905a39881446710aa083e935e8073323376" "a22e0a037e702170c7d88460cc9c9c2ab1d3e5c54a6985cd4a164ea7beff1b36")
PATCHES=()
REQUIRES=("glibc" "pam" "ncurses" "zlib" "util-linux-libs")
BUILD_REQUIRES=("gcc" "make" "pkgconf")
PROVIDES=("util-linux")
CONFLICTS=()
OBSOLETES=()

_srcdir="util-linux-2.42.2"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    :
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    ./configure --prefix=/usr --bindir=/usr/bin --sbindir=/usr/bin --libdir=/usr/lib --sysconfdir=/etc --runstatedir=/run --disable-static --disable-chfn-chsh --disable-newgrp --disable-vipw --disable-nologin --disable-pylibmount --without-python --disable-makeinstall-chown --with-systemd
    make -j"${JOBS:-$(nproc)}"
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    make DESTDIR="$pkgdir" install
    for tool in login remote su su-l runuser runuser-l; do
        _pam=${tool%-l}
        install -Dm644 "$SRCROOT/$_pam.pam" "$pkgdir/etc/pam.d/$tool"
    done
    install -Dm644 "$SRCROOT/util-linux.sysusers" "$pkgdir/usr/lib/sysusers.d/util-linux.conf"
    install -Dm644 "$SRCROOT/60-rfkill.rules" "$pkgdir/usr/lib/udev/rules.d/60-rfkill.rules"
    # Libraries are split from the same source/version as the tools.
    _split="$BUILDROOT/util-linux-libs"
    install -dm755 "$_split/usr/lib"
    mv "$pkgdir"/usr/lib/lib*.so* "$_split/usr/lib/"
    for dir in usr/include usr/lib/pkgconfig usr/share/man/man3; do
        if [ -d "$pkgdir/$dir" ]; then
            install -dm755 "$_split/$(dirname "$dir")"
            mv "$pkgdir/$dir" "$_split/$dir"
        fi
    done
    "$LPM_SPLIT_PACKAGE" --stagedir "$_split" --name util-linux-libs \
        --summary "util-linux runtime and development libraries" \
        --provides util-linux-libs --provides libblkid --provides libmount \
        --provides libuuid --provides libfdisk --provides libsmartcols --requires glibc

    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
