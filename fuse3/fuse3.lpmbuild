#!/bin/bash
# libfuse 3.18.3, prerequisite for kio-fuse; does NOT replace FUSE2.
NAME="fuse3"
VERSION="3.18.3"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="FUSE 3 userspace filesystem library and mount helpers"
URL="https://github.com/libfuse/libfuse"
LICENSE=("LGPL-2.1-or-later" "GPL-2.0-or-later")
SOURCE=("https://github.com/libfuse/libfuse/archive/refs/tags/fuse-${VERSION}.tar.gz")
# Pin this GitHub archive checksum after validating the downloaded bytes.
SHA256SUMS=("SKIP")
PATCHES=()
REQUIRES=("glibc")
BUILD_REQUIRES=("gcc" "meson" "ninja" "pkgconf" "python")
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=("fuse3" "libfuse3")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/meson.build"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    local builddir="$BUILDROOT/${NAME}-build"
    meson setup "$builddir" "$src" \
      --prefix=/usr --libdir=lib --buildtype=release --wrap-mode=nodownload \
      -Dtests=false -Dexamples=false -Dutils=true \
      -Dinitscriptdir= -Duseroot=false -Denable-io-uring=false
    meson compile -C "$builddir" -j "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    DESTDIR="$pkgdir" meson install -C "$BUILDROOT/${NAME}-build" --no-rebuild
    test -f "$pkgdir/usr/lib/pkgconfig/fuse3.pc"
    test -n "$(find "$pkgdir/usr/lib" -maxdepth 1 -name 'libfuse3.so*' -print -quit)"
}
