#!/bin/bash
# LPM build script for GTK 3

NAME="gtk3"
VERSION="3.24.43" 
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="GIMP Toolkit v3 for creating graphical user interfaces"
URL="https://gitlab.gnome.org/GNOME/gtk"
LICENSE=("LGPL-2.1-or-later")

SOURCE=(
  "https://download.gnome.org/sources/gtk+/3.24/gtk+-${VERSION}.tar.xz"
)

REQUIRES=(
  "glib2"
  "pango"
  "cairo"
  "gdk-pixbuf2"
  "atk"
  "at-spi2-atk"
  "at-spi2-core"
  "libepoxy"
  "wayland"
  "wayland-protocols"
  "libxkbcommon"
  "libXinerama"
  "libXrandr"
  "libXi"
  "libXext"
  "meson"
  "ninja"
  "pkg-config"
  "gcc"
)

PROVIDES=("gtk3" "libgtk-3.so")

CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    meson setup build \
    --prefix=/usr \
    --libdir=lib \
    --buildtype=release \
    -Dbroadway_backend=false \
    -Dwayland_backend=true \
    -Dintrospection=true \
    -Dgtk_doc=false \
    -Dman=false

    meson compile -C build
}

check() {
    true
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    DESTDIR="$pkgdir" meson install -C build

    if command -v strip >/dev/null 2>&1; then
        find "$pkgdir/usr" -type f -exec sh -c '
            case "$(file -b "$1")" in
              *ELF*executable*|*ELF*shared\ object*)
                  strip --strip-unneeded "$1" 2>/dev/null || true
              ;;
            esac
        ' _ {} \;
    fi
}




