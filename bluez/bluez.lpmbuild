#!/bin/bash
NAME="bluez"
VERSION="5.87"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="bluez upstream package"
URL="https://www.kernel.org/pub/linux/bluetooth/"
LICENSE=("GPL-2.0-or-later" "LGPL-2.1-or-later")
SOURCE=("https://www.kernel.org/pub/linux/bluetooth/bluez-5.87.tar.xz")
SHA256SUMS=("26bdcf2cebd7310c6f598850606b037ef0c515fe6608ebc54d22c50c4c32b35f")
PATCHES=()
REQUIRES=("alsa-lib" "dbus" "glib2" "glibc" "json-c" "libcups" "libical" "libusb" "readline" "systemd")
BUILD_REQUIRES=("alsa-lib" "dbus" "gcc" "glib2" "json-c" "libcups" "libical" "libusb" "make" "pkgconf" "readline" "systemd")
PROVIDES=("bluez")
CONFLICTS=()
OBSOLETES=()
BUILD_OPTIONS=("@--stripping" "@--optimize=2")
prepare() { set -euxo pipefail; cd "$SRCROOT/${NAME}-${VERSION}"; }
build() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    if [ ! -x configure ]; then autoreconf -fiv; fi
    ./configure --prefix=/usr --libdir=/usr/lib --sysconfdir=/etc --disable-static --enable-library --enable-experimental --enable-midi --enable-hid2hci --enable-obex --enable-cups
    make -j"${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    make DESTDIR="$pkgdir" install
    local f
    for f in COPYING COPYING.LIB LICENSE LICENSE.md LICENSE.txt; do
        if [ -f "$f" ]; then install -Dm644 "$f" "$pkgdir/usr/share/licenses/$NAME/$f"; fi
    done
    if [ -d LICENSES ]; then
        install -dm755 "$pkgdir/usr/share/licenses/$NAME"
        cp -a LICENSES/. "$pkgdir/usr/share/licenses/$NAME/"
    fi
}




# Final audited source digests
SHA256SUMS=("26bdcf2cebd7310c6f598850606b037ef0c515fe6608ebc54d22c50c4c32b35f")
