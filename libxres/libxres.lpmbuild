# LPM build script for libxres
NAME="libxres"
VERSION="1.2.3"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="X11 Resource usage library"
URL="https://www.x.org/"
LICENSE="MIT"
SOURCE=("https://xorg.freedesktop.org/archive/individual/lib/libXres-${VERSION}.tar.xz")
CHECKSUMS=("d2de8f5401d6c86a8992791654547eb8def585dfdc0c08cc16e24ef6aeeb69dc")
REQUIRES=("glibc" "libX11" "xorgproto")
PROVIDES=("libxres")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() { set -euxo pipefail; cd "$SRCROOT"; }

build() {
  set -euxo pipefail
  cd "$SRCROOT"
  ./configure --prefix=/usr --sysconfdir=/etc --disable-static
  make -j"$(nproc)"
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT"
  make DESTDIR="$pkgdir" install
}




# Final audited source digests
SHA256SUMS=("d2de8f5401d6c86a8992791654547eb8def585dfdc0c08cc16e24ef6aeeb69dc")
