#!/bin/bash
# LPM build script for pop-launcher

NAME="pop-launcher"
VERSION="1.2.7"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Launcher backend used by COSMIC"
URL="https://github.com/pop-os/pop-launcher"
LICENSE=("GPL-3.0-or-later")

SOURCE=(
  "git+https://github.com/BobTheZombie/pop-launcher.git"
)

REQUIRES=(
  "glibc"
  "wayland"
  "libxkbcommon"
  "libinput"
  "libseat"
  "mesa"
  "dbus"
)

REQUIRES+=(
  "rust"
  "cargo"
  "pkg-config"
  "gcc"
)

PROVIDES=("pop-launcher")
CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}"

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  just build-release
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  just rootdir="${pkgdir}" prefix=/usr install
}
