#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="ninja"
VERSION="1.13.2"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Small build system with a focus on speed"
URL="https://github.com/ninja-build/ninja/archive/v1.13.2/ninja-1.13.2.tar.gz"
LICENSE=("Apache-2.0")
SOURCE=("https://github.com/ninja-build/ninja/archive/v1.13.2/ninja-1.13.2.tar.gz")
SHA256SUMS=("974d6b2f4eeefa25625d34da3cb36bdcebe7fbce40f4c16ac0835fd1c0cbae17")
PATCHES=()
REQUIRES=("glibc" "gcc-libs")
BUILD_REQUIRES=("gcc" "make" "pkgconf")
PROVIDES=("ninja")
CONFLICTS=()
OBSOLETES=()

_srcdir="ninja-1.13.2"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    :
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    python3 configure.py --bootstrap
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    install -Dm755 ninja "$pkgdir/usr/bin/ninja"
    install -Dm644 misc/bash-completion "$pkgdir/usr/share/bash-completion/completions/ninja"
    install -Dm644 misc/zsh-completion "$pkgdir/usr/share/zsh/site-functions/_ninja"

    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
