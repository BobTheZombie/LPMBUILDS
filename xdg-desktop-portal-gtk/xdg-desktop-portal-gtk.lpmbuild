#!/bin/bash
# LPM build script for xdg-desktop-portal-gtk

NAME="xdg-desktop-portal-gtk"
VERSION="1.15.3"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="GTK-based XDG desktop portal backend"
URL="https://github.com/flatpak/xdg-desktop-portal-gtk"
LICENSE=("MIT")  # adjust to real license

SOURCE=("https://github.com/flatpak/xdg-desktop-portal-gtk/releases/download/1.15.3/xdg-desktop-portal-gtk-1.15.3.tar.xz")

REQUIRES=(
  "glibc"
  "dbus"
)

REQUIRES+=(
  "meson"
  "ninja"
  "pkg-config"
  "gcc"
)

PROVIDES=(
  "xdg-desktop-portal-gtk"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="xdg-desktop-portal-gtk-${VERSION}"

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release

    meson compile -C build
}

check() {
    true
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    DESTDIR="$pkgdir" meson install -C build

    # Strip ELF files
    if command -v strip >/dev/null 2>&1; then
        find "$pkgdir/usr" -type f -exec sh -c '
            case "$(file -b "$1")" in
              *ELF*executable*|*ELF*shared\ object*)
                  strip --strip-unneeded "$1" 2>/dev/null || true
              ;;
            esac
        ' _ {} \;
    fi
}

