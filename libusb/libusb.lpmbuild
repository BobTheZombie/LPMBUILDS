#!/bin/bash
# LPM build script for libusb (1.0)
# Userspace USB programming library (needed by upower)

NAME="libusb"
VERSION="1.0.27"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Userspace USB programming library"
URL="https://libusb.info/"
LICENSE=("LGPL-2.1-or-later")

SOURCE=(
  "https://github.com/libusb/libusb/releases/download/v${VERSION}/libusb-${VERSION}.tar.bz2"
)

REQUIRES=(
  "glibc"
  "systemd"   # udev support
)

PROVIDES=(
  "libusb"
  "libusb-1.0"
  "libusb-1.0.so"
  "libusb-1.0.pc"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="libusb-${VERSION}"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  ./configure         --prefix=/usr         --libdir=/usr/lib         --disable-static         --enable-udev

  make -j"$(nproc)"
}

check() { true; }

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  make DESTDIR="$pkgdir" install

  # License
  for f in COPYING LICENSE; do
    if [ -f "$f" ]; then
      install -Dm644 "$f" "$pkgdir/usr/share/licenses/$NAME/$f"
    fi
  done

  # Strip (best-effort)
  if command -v strip >/dev/null 2>&1; then
    find "$pkgdir/usr" -type f -exec sh -c '
      case "$(file -b "$1")" in
        *ELF*shared\ object*|*ELF*executable*) strip --strip-unneeded "$1" 2>/dev/null || true ;;
      esac
    ' _ {} \;
  fi
}
