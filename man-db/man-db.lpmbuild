NAME="man-db"
VERSION="2.13.0"
RELEASE="1"
ARCH="x86_64"
SUMMARY="A utility for reading man pages"
URL="https://man-db.nongnu.org/"
SOURCE=("https://download.savannah.gnu.org/releases/man-db/man-db-${VERSION}.tar.xz")
LICENSE=("GPL-2.0-or-later")

REQUIRES=("glibc" "gdbm" "groff" "less")
PROVIDES=("man-db" "man")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/man-db-${VERSION}"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/man-db-${VERSION}"
    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --sysconfdir=/etc \
        --disable-setuid \
        --with-systemdtmpfilesdir=/usr/lib/tmpfiles.d
    make -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/man-db-${VERSION}"
    make DESTDIR="$pkgdir" install
}





# Final audited source digests
SHA256SUMS=("SKIP")
