#!/bin/bash
# LPM build script for libostree
# Git-like content-addressed filesystem for operating system binaries

NAME="libostree"
VERSION="2024.9"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Git-like content-addressed filesystem for OS binaries"
URL="https://github.com/ostreedev/ostree"
LICENSE=("LGPL-2.1-or-later")

SOURCE=(
  "git+https://github.com/ostreedev/ostree#tag=v$VERSION"
  "git+https://github.com/mendsley/bsdiff"
  "git+https://gitlab.gnome.org/GNOME/libglnx.git"

)

REQUIRES=(
  "glibc"
  "glib2"
  "libarchive"
  "libsoup"
  "libcurl"
  "libselinux"
  "libcap"
  "openssl"
  "zlib"
  "xz"
  "systemd"
  "attr"
  "e2fsprogs"
  "brotli"

  # Build deps
  "pkg-config"
  "gcc"
  "make"
  "autoconf"
  "automake"
  "libtool"
  "gettext"
)

PROVIDES=(
  "libostree"
  "libostree.so"
)

CONFLICTS=()
OBSOLETES=()

# IMPORTANT: for git+ sources, the checkout dir is typically the repo name
_srcdir="ostree"

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    # If upstream uses submodules, this is safe even when none exist
    git submodule init 
    git submodule set-url bsdiff "$SRCROOT/bsdiff"
    git submodule set-url libglnx "$SRCROOT/libglnx"
    git -c protocol.file.allow=always submodule update
    
    NOCONFIGURE=1 ./autogen.sh
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"


    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --sysconfdir=/etc \
        --localstatedir=/var \
        --disable-static \
        --enable-shared \
        --disable-gtk-doc \
        --disable-man \
        --disable-installed-tests \
        --with-curl \
        --without-gpgme \
        --with-grub2-mkconfig-path=/usr/bin/grub-mkconfig \
        --with-mkinitcpio \
        --with-modern-grub \
        --with-openssl

    sed -i -e 's/ -shared / -Wl,-O1,--as-needed\0/g' libtool
    make -j"$(nproc)"
}

check() {
    true
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    make DESTDIR="$pkgdir" install


    # Strip ELF binaries/libs
    if command -v strip >/dev/null 2>&1; then
        find "$pkgdir/usr" -type f -exec sh -c '
            case "$(file -b "$1")" in
              *ELF*shared\ object*|*ELF*executable*)
                  strip --strip-unneeded "$1" 2>/dev/null || true
              ;;
            esac
        ' _ {} \;
    fi
}

