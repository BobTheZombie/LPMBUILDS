#!/bin/bash
# LPM build script for xkill

NAME="xkill"
VERSION="1.0.7"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Kill a client by its X resource"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=("https://www.x.org/archive//individual/app/${NAME}-${VERSION}.tar.xz")

REQUIRES=(
  "glibc"
  "libX11"
)

PROVIDES=("xkill")
CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  ./configure --prefix=/usr
  make -j"$(nproc)"
}

check() { true; }

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  DESTDIR="$pkgdir" make install
}




# Final audited source digests
SHA256SUMS=("5ff264bc4eebc0459255a92036dc8dc84b6d48caef8509f88a783beaadea750b")
