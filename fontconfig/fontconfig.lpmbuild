NAME="fontconfig"
VERSION="2.15.0"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Font discovery and configuration library"
URL="https://www.freedesktop.org/wiki/Software/fontconfig/"
SOURCE=("https://www.freedesktop.org/software/fontconfig/release/fontconfig-${VERSION}.tar.xz")
LICENSE=("MIT")

REQUIRES=("glibc" "expat" "freetype")
PROVIDES=("fontconfig" "libfontconfig.so")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/fontconfig-${VERSION}"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/fontconfig-${VERSION}"
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --disable-static
    make -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/fontconfig-${VERSION}"
    make DESTDIR="$pkgdir" install
}

