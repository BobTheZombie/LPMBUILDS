#!/bin/bash
# LPM source recipe - staged installation only; review build features before use.
NAME="modemmanager"
VERSION="1.24.2"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Mobile broadband modem management daemon and libmm-glib"
URL="https://gitlab.freedesktop.org/mobile-broadband/ModemManager"
LICENSE=("GPL-2.0-or-later")
SOURCE=("https://gitlab.freedesktop.org/mobile-broadband/ModemManager/-/archive/${VERSION}/ModemManager-${VERSION}.tar.gz")
SHA256SUMS=("SKIP")
PATCHES=()
REQUIRES=(
    "glib2"
    "libgudev"
    "libxslt"
    "dbus"
    "mbim-glib"
    "qmi-glib"
)
BUILD_REQUIRES=(
    "meson"
    "ninja"
    "pkgconf"
    "gcc"
    "mbim-glib"
    "qmi-glib"
)
PROVIDES=("modemmanager")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

_srcdir() {
    local d="$SRCROOT/${NAME}-${VERSION}"
    test -d "$d" || { printf 'Expected source directory not found: %s\n' "$d" >&2; return 1; }
    printf '%s\n' "$d"
}

prepare() {
    set -euo pipefail
    test -d "$(_srcdir)"
}

build() {
    set -euo pipefail
    local src
    src="$(_srcdir)"
    meson setup "$src/build-lpm" "$src" --prefix=/usr --libdir=lib --buildtype=release \
        -D bash_completion=false -D qrtr=false
    ninja -C "$src/build-lpm"
}

staging() {
    set -euo pipefail
    local src
    src="$(_srcdir)"
    DESTDIR="$pkgdir" ninja -C "$src/build-lpm" install
    test -e "$pkgdir/usr/bin/mmcli"
}
