NAME="libpng"
VERSION="1.6.43"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Portable Network Graphics (PNG) image format library"
URL="http://www.libpng.org/pub/png/libpng.html"
SOURCE=("https://download.sourceforge.net/libpng/libpng-${VERSION}.tar.xz")
LICENSE=("libpng-2.0")

REQUIRES=("glibc" "zlib")
PROVIDES=("libpng" "libpng.so")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/libpng-${VERSION}"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/libpng-${VERSION}"

    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --enable-shared \
        --disable-static \
        --disable-silent-rules

    make -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/libpng-${VERSION}"

    make DESTDIR="$pkgdir" install

    # Strip binaries to reduce size
    find "$pkgdir/usr/bin" -type f -executable -exec strip --strip-unneeded {} + || true
    find "$pkgdir/usr/lib" -name "*.so*" -type f -exec strip --strip-unneeded {} + || true
}

