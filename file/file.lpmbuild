#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="file"
VERSION="5.48"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="File type identification"
URL="https://astron.com/pub/file/file-5.48.tar.gz"
LICENSE=("BSD-2-Clause")
SOURCE=("https://astron.com/pub/file/file-5.48.tar.gz")
SHA256SUMS=("ed14656883b23a364b4057c05595d93252da9bc473d30106519519d0da141283")
PATCHES=()
REQUIRES=("glibc")
BUILD_REQUIRES=("gcc" "make" "pkgconf")
PROVIDES=("file")
CONFLICTS=()
OBSOLETES=()

_srcdir="file-5.48"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    :
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    ./configure --prefix=/usr
    make -j"${JOBS:-$(nproc)}"
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    make DESTDIR="$pkgdir" install

    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
