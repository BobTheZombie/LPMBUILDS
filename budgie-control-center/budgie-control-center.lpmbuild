#!/bin/bash
# LPM build script for budgie-control-center
# Notes:
# - These are "git+" lpmbuilds (Arch-style) so you are not blocked by the lack of stable 10.10 tarball releases.
# - If you want to pin to a specific tag/commit, change SOURCE to e.g.:
#     SOURCE=("git+https://github.com/BuddiesOfBudgie/budgie-desktop.git#tag=10.10-preview.1")
#   or:
#     SOURCE=("git+https://github.com/BuddiesOfBudgie/budgie-desktop.git#commit=<sha>")
# - If your LPM git fetcher uses a different fragment syntax, adjust accordingly.
#

NAME="budgie-control-center"
VERSION="10.10"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Budgie control center (GNOME Control Center fork for Budgie 10 series)"
URL="https://github.com/BuddiesOfBudgie/budgie-control-center"
LICENSE=("GPL-2.0-or-later")

SOURCE=(
  "git+https://github.com/BuddiesOfBudgie/budgie-control-center.git"
)

REQUIRES=(
  "glibc"
  "glib2"
  "gsound"
  "gtk3"
  "gsettings-desktop-schemas"
  "libX11"
  "libXi"
  "libXrandr"
  "libXext"
  "libXcursor"
  "libxkbcommon"
  "dbus"
  "systemd"
  "colord"
  "colord-gtk"
  "gnome-settings-daemon"
  "smbclient"
)

PROVIDES=("budgie-control-center")
CONFLICTS=()
OBSOLETES=()

_srcdir="budgie-control-center"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  mkdir -p build
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  meson setup build \
    --prefix=/usr \
    --libdir=lib \
    --buildtype=release \
    -Ddefault_library=shared \
    -Ddocumentation=false

  ninja -C build
}

check() { true; }

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  DESTDIR="$pkgdir" ninja -C build install

  if [ -f COPYING ]; then
    install -Dm644 COPYING "$pkgdir/usr/share/licenses/$NAME/COPYING"
  fi
}
