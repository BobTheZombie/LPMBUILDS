#!/bin/bash
# LPM networking stack, release snapshot 2026-10-16
NAME="libndp"
VERSION="1.9"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY='IPv6 Neighbor Discovery library'
URL=https://github.com/jpirko/libndp/archive/refs/tags/v1.9.tar.gz
LICENSE=(LGPL-2.1-or-later)
SOURCE=(https://github.com/jpirko/libndp/archive/refs/tags/v1.9.tar.gz)
SHA256SUMS=(
    "e564f5914a6b1b799c3afa64c258824a801c1b79a29e2fe6525b682249c65261"
)
PATCHES=()
REQUIRES=(glibc)
BUILD_REQUIRES=(gcc make pkgconf glibc autoconf automake libtool)
PROVIDES=(libndp libndp.so)
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
BUILD_OPTIONS=(@--stripping @--optimize=2)

_source() {
    if [ ! -d "$SRCROOT/${NAME}-${VERSION}" ] && [ -d "$SRCROOT/libndp-1.9" ]; then
        mv "$SRCROOT/libndp-1.9" "$SRCROOT/${NAME}-${VERSION}"
    fi
}

_licenses() {
    local f
    for f in COPYING COPYING.LIB LICENSE LICENSE.txt LICENCE README; do
        if [ -f "$f" ]; then
            install -Dm644 "$f" "$pkgdir/usr/share/licenses/$NAME/$(basename "$f")"
        fi
    done
}
_cleanup() {
    if [ -d "$pkgdir/usr/lib" ]; then
        find "$pkgdir/usr/lib" -type f \( -name '*.a' -o -name '*.la' \) -delete
    fi
    rm -f "$pkgdir/usr/share/info/dir"
}

prepare() {
    set -euxo pipefail
    _source
    cd "$SRCROOT/${NAME}-${VERSION}"
    if [ -f Makefile ]; then make distclean; fi
    if [ ! -f configure ]; then autoreconf -vif; fi
    test -x configure
}
build() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    ./configure --prefix=/usr --libdir=/usr/lib --sbindir=/usr/bin \
        --sysconfdir=/etc --localstatedir=/var --disable-static
    make -j"${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    make -j1 DESTDIR="$pkgdir" install
    _cleanup
    :
    _licenses
}





# Final audited source digests
SHA256SUMS=("e564f5914a6b1b799c3afa64c258824a801c1b79a29e2fe6525b682249c65261")
