#!/bin/bash
# LPM build script for gsound

NAME="gsound"
VERSION="1.0.3"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Small library for playing system sounds"
URL="https://gitlab.gnome.org/GNOME/gsound"
LICENSE=("LGPL-2.1-or-later")

SOURCE=(
  "https://download.gnome.org/sources/gsound/1.0/gsound-${VERSION}.tar.xz"
)

SHA256SUMS=("SKIP")

REQUIRES=(
  "glib2"
  "libcanberra"
)

BUILD_REQUIRES=(
  "meson"
  "ninja"
  "pkgconf"
  "glib2"
  "gobject-introspection"
  "libcanberra"
)

PROVIDES=(
  "gsound"
  "libgsound.so"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  rm -rf build
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  meson setup build \
    --prefix=/usr \
    --libdir=lib \
    --buildtype=release \
    -Ddefault_library=shared \
    -Dintrospection=true \
    -Dgtk_doc=false

  meson compile -C build
}

check() {
  true
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  DESTDIR="$pkgdir" meson install -C build

  test -f "$pkgdir/usr/lib/libgsound.so"

  for f in COPYING LICENSE; do
    if [ -f "$f" ]; then
      install -Dm644 "$f" \
        "$pkgdir/usr/share/licenses/$NAME/$f"
    fi
  done
}
