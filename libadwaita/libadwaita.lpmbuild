#!/bin/bash
# LPM build script for libadwaita

NAME="libadwaita"
VERSION="1.6.4"   # adjust to the exact upstream version
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Building blocks for modern GNOME applications using GTK 4"
URL="https://gitlab.gnome.org/GNOME/libadwaita"
LICENSE=("LGPL-2.1-or-later")

SOURCE=(
  "https://download.gnome.org/sources/libadwaita/1.6/libadwaita-${VERSION}.tar.xz"
)

REQUIRES=(
  "glib2"
  "gtk4"
  "pango"
  "cairo"
  "gdk-pixbuf2"
  "meson"
  "ninja"
  "pkg-config"
  "gcc"
)

PROVIDES=("libadwaita" "libadwaita-1.so")

CONFLICTS=()
OBSOLETES=()

_srcdir="libadwaita-${VERSION}"

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        -Dexamples=false \
        -Dtests=false

    meson compile -C build
}

check() {
    true
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    DESTDIR="$pkgdir" meson install -C build

    if command -v strip >/dev/null 2>&1; then
        find "$pkgdir/usr" -type f -exec sh -c '
            case "$(file -b "$1")" in
              *ELF*executable*|*ELF*shared\ object*)
                  strip --strip-unneeded "$1" 2>/dev/null || true
              ;;
            esac
        ' _ {} \;
    fi
}
