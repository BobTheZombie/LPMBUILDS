NAME="groff"
VERSION="1.24.2"
RELEASE="1"
ARCH="x86_64"
SUMMARY="GNU troff typesetting system"
URL="https://www.gnu.org/software/groff/"
SOURCE=("https://ftp.wayne.edu/gnu/groff/groff-${VERSION}.tar.gz")
LICENSE=("GPL-3.0-or-later")

REQUIRES=("glibc" "perl")
PROVIDES=("groff" "troff")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/groff-${VERSION}"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/groff-${VERSION}"
    ./configure --prefix=/usr --libdir=/usr/lib
    make -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/groff-${VERSION}"
    make DESTDIR="$pkgdir" install
}





# Final audited source digests
SHA256SUMS=("f9c1efd5bebbe37fc6e1063db7473ce8df1e3e0be4ff0f43ce04fce57e9c5dd9")
