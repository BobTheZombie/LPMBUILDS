#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="groff"
VERSION="1.24.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="GNU troff typesetting system"
URL="https://ftpmirror.gnu.org/groff/groff-1.24.1.tar.gz"
LICENSE=("GPL-3.0-or-later")
SOURCE=("https://ftpmirror.gnu.org/groff/groff-1.24.1.tar.gz")
SHA256SUMS=("74e2819795b6aff431aeac983d63a9c8968eeaba2a2eba7df8ba4c7b41e7cfd8")
PATCHES=()
REQUIRES=("glibc" "gcc-libs" "perl")
BUILD_REQUIRES=("gcc" "make" "pkgconf")
PROVIDES=("groff")
CONFLICTS=()
OBSOLETES=()

_srcdir="groff-1.24.1"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    :
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    ./configure --prefix=/usr --without-x
    make -j"${JOBS:-$(nproc)}"
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    make DESTDIR="$pkgdir" install

    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
