NAME="kbd"
VERSION="2.10.0"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Keytable utilities for Linux console"
URL="https://kbd-project.org/"
SOURCE=("https://www.kernel.org/pub/linux/utils/kbd/kbd-${VERSION}.tar.xz")
LICENSE=("GPL-2.0-or-later")

REQUIRES=("glibc" "pam")
PROVIDES=("kbd" "loadkeys" "setfont")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/kbd-${VERSION}"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/kbd-${VERSION}"
    ./configure --prefix=/usr --libdir=/usr/lib --disable-vlock
    make -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/kbd-${VERSION}"
    make DESTDIR="$pkgdir" install
}





# Final audited source digests
SHA256SUMS=("6e5ca4f8d76ee9e3a8db700b667f13e12aac9933828a64e1aaad93d26be9b479")
