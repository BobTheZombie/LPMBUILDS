#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="xz"
VERSION="5.8.3"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="XZ compression utilities"
URL="https://github.com//tukaani-project/xz/releases/download/v5.8.3/xz-5.8.3.tar.xz"
LICENSE="GPL-2.0-or-later AND LGPL-2.1-or-later AND 0BSD"
SOURCE=("https://github.com//tukaani-project/xz/releases/download/v5.8.3/xz-5.8.3.tar.xz")
SHA256SUMS=("fff1ffcf2b0da84d308a14de513a1aa23d4e9aa3464d17e64b9714bfdd0bbfb6")
PATCHES=()
REQUIRES=("glibc")
BUILD_REQUIRES=("gcc" "make" "pkgconf")
PROVIDES=("xz")
CONFLICTS=()
OBSOLETES=()

_srcdir="xz-5.8.3"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    :
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    ./configure --prefix=/usr --disable-static
    make -j"${JOBS:-$(nproc)}"
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    make DESTDIR="$pkgdir" install

    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
