#!/bin/bash
# LPM build script for xmessage

NAME="xmessage"
VERSION="1.0.7"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Display a message or query in a window"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=("https://www.x.org/archive//individual/app/${NAME}-${VERSION}.tar.xz")

REQUIRES=(
  "glibc"
  "libX11"
  "libXaw"
  "libXt"
)

PROVIDES=("xmessage")
CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  ./configure --prefix=/usr
  make -j"$(nproc)"
}

check() { true; }

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  DESTDIR="$pkgdir" make install
}
