#!/bin/bash
# LPM Linux - XDG user directory lookup and creation utilities
NAME="xdg-user-dirs"
VERSION="0.20"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="XDG user directories helper, provides xdg-user-dir executable"
URL="https://gitlab.freedesktop.org/xdg/xdg-user-dirs"
LICENSE=("GPL-2.0-or-later")
SOURCE=("https://user-dirs.freedesktop.org/releases/${NAME}-${VERSION}.tar.xz")
SHA256SUMS=("b8e34286278f4fef3e1bfe9685c395ccc0eb50c14d3a2fb4953dd00fbfd3af39")
PATCHES=()
REQUIRES=("glibc" "glib2")
BUILD_REQUIRES=("meson" "ninja" "pkgconf" "glib2" "gettext")
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=("xdg-user-dir")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    test -f "$src/meson.build"
    rm -rf "$src/build"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    meson setup "$src/build" "$src" \
        --prefix=/usr --libdir=lib --buildtype=release -Ddocs=false
    meson compile -C "$src/build" -j "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    [[ -n "${pkgdir:-}" && "$pkgdir" != / ]] || return 1
    DESTDIR="$pkgdir" meson install -C "$src/build" --no-rebuild
    test -x "$pkgdir/usr/bin/xdg-user-dir"
    test -x "$pkgdir/usr/bin/xdg-user-dirs-update"
    # Do not execute xdg-user-dirs-update as root during staging.
}
