#!/bin/bash
# LPM networking stack, release snapshot 2026-10-16
NAME="libnftnl"
VERSION="1.3.2"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY='Netfilter nftables netlink library'
URL=https://www.netfilter.org/projects/libnftnl/files/libnftnl-1.3.2.tar.xz
LICENSE=(GPL-2.0-or-later)
SOURCE=(https://www.netfilter.org/projects/libnftnl/files/libnftnl-1.3.2.tar.xz)
SHA256SUMS=(
    "c97abc3409f8fa396b4462b2bb7f147a3a47a4ddc97cfa0b2f18890c9cfde8b0"
)
PATCHES=()
REQUIRES=(glibc libmnl)
BUILD_REQUIRES=(gcc make pkgconf glibc libmnl)
PROVIDES=(libnftnl libnftnl.so)
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
BUILD_OPTIONS=(@--stripping @--optimize=2)

_source() {
    if [ ! -d "$SRCROOT/${NAME}-${VERSION}" ] && [ -d "$SRCROOT/libnftnl-1.3.2" ]; then
        mv "$SRCROOT/libnftnl-1.3.2" "$SRCROOT/${NAME}-${VERSION}"
    fi
}

_licenses() {
    local f
    for f in COPYING COPYING.LIB LICENSE LICENSE.txt LICENCE README; do
        if [ -f "$f" ]; then
            install -Dm644 "$f" "$pkgdir/usr/share/licenses/$NAME/$(basename "$f")"
        fi
    done
}
_cleanup() {
    if [ -d "$pkgdir/usr/lib" ]; then
        find "$pkgdir/usr/lib" -type f \( -name '*.a' -o -name '*.la' \) -delete
    fi
    rm -f "$pkgdir/usr/share/info/dir"
}

prepare() {
    set -euxo pipefail
    _source
    cd "$SRCROOT/${NAME}-${VERSION}"
    if [ -f Makefile ]; then make distclean; fi
    :
    test -x configure
}
build() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    ./configure --prefix=/usr --libdir=/usr/lib --sbindir=/usr/bin \
        --sysconfdir=/etc --localstatedir=/var --disable-static
    make -j"${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    make -j1 DESTDIR="$pkgdir" install
    _cleanup
    :
    _licenses
}





# Final audited source digests
SHA256SUMS=("c97abc3409f8fa396b4462b2bb7f147a3a47a4ddc97cfa0b2f18890c9cfde8b0")
