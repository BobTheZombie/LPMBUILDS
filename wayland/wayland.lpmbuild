#!/bin/bash
# LPM Linux: Wayland core libraries, scanner and protocol XML.
# Consistent /usr/lib layout for Qt6 and KDE Plasma 6.8.1.
NAME="wayland"
VERSION="1.26.0"
RELEASE="2"
ARCH="${ARCH:-x86_64}"
SUMMARY="Wayland protocol libraries, scanner and core protocol definitions"
URL="https://wayland.freedesktop.org/"
LICENSE=("MIT")
SOURCE=(
    "https://gitlab.freedesktop.org/wayland/wayland/-/releases/${VERSION}/downloads/wayland-${VERSION}.tar.xz"
)
# Official Wayland 1.26.0 SHA-256 from the 2026-07-16 release announcement.
# The previous digest 82892487... was for Wayland 1.24.0.
SHA256SUMS=(
    "64176eaa46e4969903e286f8e5ef8331affc17fdf03ac9b58381d2b23162b7a3"
)
PATCHES=()
REQUIRES=(
    "glibc"
    "expat"
    "libffi"
    "libxml2"
)
BUILD_REQUIRES=(
    "meson"
    "ninja"
    "pkgconf"
    "python"
    "glibc"
    "expat"
    "libffi"
    "libxml2"
)
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=()
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=("wayland-protocols")
SUGGESTS=()

prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/meson.build"
    test -f "$SRCROOT/${NAME}-${VERSION}/protocol/wayland.xml"
}

build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    local builddir="$src/build"

    # Force /usr/lib: an implicit Meson libdir can resolve to /usr/lib64.
    meson setup "$builddir" "$src" \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        --backend=ninja \
        --wrap-mode=nodownload \
        -Dlibraries=true \
        -Dscanner=true \
        -Dtests=false \
        -Ddocumentation=false \
        -Ddtd_validation=true

    meson compile -C "$builddir" -j "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    local builddir="$SRCROOT/${NAME}-${VERSION}/build"
    test -n "${pkgdir:-}" && test "$pkgdir" != "/"

    DESTDIR="$pkgdir" meson install -C "$builddir" --no-rebuild

    # Validate the real library files, SONAME links and linker symlinks.
    local lib
    for lib in client server cursor; do
        test -e "$pkgdir/usr/lib/libwayland-${lib}.so"
        test -e "$pkgdir/usr/lib/libwayland-${lib}.so.0"
        test -f "$pkgdir/usr/lib/pkgconfig/wayland-${lib}.pc"
    done
    test -e "$pkgdir/usr/lib/libwayland-egl.so"
    test -e "$pkgdir/usr/lib/libwayland-egl.so.1"
    test -f "$pkgdir/usr/lib/pkgconfig/wayland-egl.pc"

    # Ensure the Wayland scanner and protocol XML aren't silently omitted.
    test -x "$pkgdir/usr/bin/wayland-scanner"
    test -f "$pkgdir/usr/lib/pkgconfig/wayland-scanner.pc"
    test -f "$pkgdir/usr/share/wayland/wayland.xml"
    test -f "$pkgdir/usr/share/wayland/wayland.dtd"

    # Do not ship conflicting /usr/lib64 copies in this build.
    test ! -e "$pkgdir/usr/lib64/libwayland-client.so.0"
    test ! -e "$pkgdir/usr/lib64/libwayland-cursor.so.0"

    # Preserve upstream license text.
    local src="$SRCROOT/${NAME}-${VERSION}"
    if [ -f "$src/COPYING" ]; then
        install -Dm644 "$src/COPYING" "$pkgdir/usr/share/licenses/$NAME/COPYING"
    fi
}