#!/bin/bash
# LPM build script for libxfce4util

NAME="libxfce4util"
VERSION="4.20.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Basic utility library for the Xfce desktop environment"
URL="https://gitlab.xfce.org/xfce/libxfce4util"
LICENSE=("LGPL-2.0-or-later")

SOURCE=(
  "https://archive.xfce.org/src/xfce/libxfce4util/4.20/libxfce4util-${VERSION}.tar.bz2"
)

REQUIRES=(
  "glibc"
  "glib2"
)

BUILD_REQUIRES=(
  "meson"
  "ninja"
  "pkgconf"
  "gettext"
  "gobject-introspection"
  "vala"
)

PROVIDES=(
  "libxfce4util"
  "libxfce4util-1.0"
  "libxfce4util.so"
  "xfce4-kiosk-query"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  rm -rf build

  meson setup build \
    --prefix=/usr \
    --libdir=lib \
    --buildtype=release \
    -Ddefault_library=shared \
    -Dintrospection=true

  meson compile -C build
}

check() {
  true
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  DESTDIR="$pkgdir" meson install -C build

  test -f "$pkgdir/usr/lib/pkgconfig/libxfce4util-1.0.pc"
  test -f "$pkgdir/usr/lib/libxfce4util.so"

  for f in COPYING LICENSE; do
    if [ -f "$f" ]; then
      install -Dm644 "$f" "$pkgdir/usr/share/licenses/$NAME/$f"
    fi
  done
}