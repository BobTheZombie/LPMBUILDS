#!/bin/bash
# LPM build script for GNU Awk

NAME="gawk"
VERSION="5.4.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"

SUMMARY="GNU pattern scanning and text processing language"
URL="https://www.gnu.org/software/gawk/"
LICENSE=(
    "GPL-3.0-or-later"
    "GFDL-1.3-or-later"
)

SOURCE=(
    "https://ftp.gnu.org/gnu/gawk/gawk-${VERSION}.tar.xz"
)

SHA256SUMS=(
    "07f6f7342b7febe4313fc2c2542ad93d64fe20ad8717200109f105a826f5fd37"
)

PATCHES=()

REQUIRES=(
    "glibc"
    "gmp"
    "mpfr"
    "readline"
)

BUILD_REQUIRES=(
    "gcc"
    "gettext"
    "gmp"
    "make"
    "mpfr"
    "readline"
)

PROVIDES=(
    "awk"
    "gawk"
)

CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

BUILD_OPTIONS=(
    "@--stripping"
    "@--optimize=2"
)

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    test -x configure
    test -f Makefile.in
    test -f COPYING

    if [ -f Makefile ]; then
        make distclean
    fi
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    ./configure \
        --prefix=/usr \
        --bindir=/usr/bin \
        --libdir=/usr/lib \
        --libexecdir=/usr/lib \
        --sysconfdir=/etc \
        --mandir=/usr/share/man \
        --infodir=/usr/share/info \
        --with-readline=/usr \
        --with-mpfr=/usr \
        --disable-pma \
        --disable-rpath

    make -j"${LPM_BUILD_JOBS:-$(nproc)}"
}

check() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    ./gawk 'BEGIN { exit(6 * 7 != 42) }'
    ./gawk -M 'BEGIN { exit(2^100 + 1 == 2^100) }'

    make check
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    make -j1 DESTDIR="$pkgdir" install

    ln -sfn gawk "$pkgdir/usr/bin/awk"

    rm -f \
        "$pkgdir/usr/share/info/dir" \
        "$pkgdir/usr/bin/gawk-${VERSION}"

    find "$pkgdir/usr/lib" \
        -type f \
        \( -name '*.a' -o -name '*.la' \) \
        -delete

    test -x "$pkgdir/usr/bin/gawk"
    test -x "$pkgdir/usr/bin/awk"
    test "$(readlink "$pkgdir/usr/bin/awk")" = gawk
    test -f "$pkgdir/usr/share/man/man1/gawk.1"

    install -Dm644 COPYING \
        "$pkgdir/usr/share/licenses/$NAME/COPYING"
}




# Final audited source digests
SHA256SUMS=("07f6f7342b7febe4313fc2c2542ad93d64fe20ad8717200109f105a826f5fd37")
