#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="gawk"
VERSION="5.4.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="GNU awk"
URL="https://ftpmirror.gnu.org/gawk/gawk-5.4.1.tar.xz"
LICENSE=("GPL-3.0-or-later")
SOURCE=("https://ftpmirror.gnu.org/gawk/gawk-5.4.1.tar.xz")
SHA256SUMS=("07f6f7342b7febe4313fc2c2542ad93d64fe20ad8717200109f105a826f5fd37")
PATCHES=()
REQUIRES=("glibc")
BUILD_REQUIRES=("gcc" "make" "pkgconf")
PROVIDES=("gawk")
CONFLICTS=()
OBSOLETES=()

_srcdir="gawk-5.4.1"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    sed -i 's/extras//' Makefile.in
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    ./configure --prefix=/usr
    make -j"${JOBS:-$(nproc)}"
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    make DESTDIR="$pkgdir" install
    ln -sf gawk "$pkgdir/usr/bin/awk"
    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
