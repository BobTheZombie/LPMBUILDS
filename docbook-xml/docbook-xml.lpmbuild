#!/bin/bash
# LPM build script for docbook-xml 4.2

NAME="docbook-xml"
VERSION="4.2"
RELEASE="1"
ARCH="any"
SUMMARY="DocBook XML DTD ${VERSION}"
URL="https://docbook.org/xml/"
LICENSE=("MIT")

SOURCE=(
  "https://archive.docbook.org/xml/${VERSION}/docbook-xml-${VERSION}.zip"
)

SHA256SUMS=("SKIP")

REQUIRES=(
  "libxml2"
)

BUILD_REQUIRES=(
  "unzip"
)

PROVIDES=(
  "docbook-xml"
  "docbook-xml-dtd"
  "docbook-xml-${VERSION}"
)

CONFLICTS=()
OBSOLETES=()

prepare() {
  set -euxo pipefail
  cd "$SRCROOT"

  rm -rf "${NAME}-${VERSION}"
  mkdir -p "${NAME}-${VERSION}"

  unzip -q -o "docbook-xml-${VERSION}.zip" -d "${NAME}-${VERSION}"
}
build() { true; }
check() { true; }

staging() {
  set -euxo pipefail

  local top="$SRCROOT/${NAME}-${VERSION}"

  local dtdir="/usr/share/xml/docbook/xml-dtd-${VERSION}"

  install -dm755 "$pkgdir${dtdir}"
  cp -a "$top"/. "$pkgdir${dtdir}/"

  install -dm755 "$pkgdir/etc/xml"

  cat > "$pkgdir/etc/xml/catalog" <<EOF
<?xml version="1.0"?>
<!DOCTYPE catalog PUBLIC "-//OASIS//DTD Entity Resolution XML Catalog V1.0//EN"
 "http://www.oasis-open.org/committees/entity/release/1.0/catalog.dtd">
<catalog xmlns="urn:oasis:names:tc:entity:xmlns:xml:catalog">
  <rewriteSystem systemIdStartString="http://www.oasis-open.org/docbook/xml/${VERSION}/" rewritePrefix="/usr/share/xml/docbook/xml-dtd-${VERSION}/"/>
  <rewriteURI uriStartString="http://www.oasis-open.org/docbook/xml/${VERSION}/" rewritePrefix="/usr/share/xml/docbook/xml-dtd-${VERSION}/"/>
  <system systemId="http://www.oasis-open.org/docbook/xml/${VERSION}/docbookx.dtd" uri="/usr/share/xml/docbook/xml-dtd-${VERSION}/docbookx.dtd"/>
  <uri name="http://www.oasis-open.org/docbook/xml/${VERSION}/docbookx.dtd" uri="/usr/share/xml/docbook/xml-dtd-${VERSION}/docbookx.dtd"/>
</catalog>
EOF

  test -f "$pkgdir/usr/share/xml/docbook/xml-dtd-${VERSION}/docbookx.dtd"
}
