NAME="libtool"
VERSION="2.6.2"
RELEASE="1"
ARCH="x86_64"
SUMMARY="GNU libtool, a generic library support script"
URL="https://www.gnu.org/software/libtool/"
SOURCE=("https://ftp.wayne.edu/gnu/libtool/libtool-${VERSION}.tar.xz")
LICENSE=("GPL-2.0-or-later")

REQUIRES=("bash" "tar" "glibc" "autoconf" "automake")
PROVIDES=("libtool" "libltdl")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/libtool-${VERSION}"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/libtool-${VERSION}"
    ./configure --prefix=/usr --libdir=/usr/lib --disable-static
    make -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/libtool-${VERSION}"
    make DESTDIR="$pkgdir" install
}





