_register_docbook_catalog() {
    local catalog="/usr/share/xml/docbook/xsl-stylesheets-nons-1.79.2/catalog.xml"

    test -s "$catalog"
    install -dm755 /etc/xml

    if [ ! -e /etc/xml/catalog ]; then
        xmlcatalog --noout --create /etc/xml/catalog
    fi

    # Replace this package's registration without removing other catalogs.
    xmlcatalog --noout --del "$catalog" /etc/xml/catalog || true

    xmlcatalog --noout \
        --add nextCatalog "" "$catalog" \
        /etc/xml/catalog
}

post_install() {
    _register_docbook_catalog
}
