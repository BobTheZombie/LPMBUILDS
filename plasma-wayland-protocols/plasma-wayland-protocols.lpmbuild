#!/bin/bash
# LPM build script for plasma-wayland-protocols

NAME="plasma-wayland-protocols"
VERSION="1.21.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Plasma-specific Wayland protocol XML files"
URL="https://invent.kde.org/libraries/plasma-wayland-protocols"
LICENSE=("LGPL-2.1-or-later")

SOURCE=(
  "https://download.kde.org/stable/plasma-wayland-protocols//plasma-wayland-protocols-${VERSION}.tar.xz"
)

SHA256SUMS=("SKIP")

REQUIRES=(
  "wayland-protocols"
)

BUILD_REQUIRES=(
  "cmake"
  "ninja"
  "extra-cmake-modules"
)

PROVIDES=(
  "plasma-wayland-protocols"
  "PlasmaWaylandProtocols"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  rm -rf build
  mkdir -p build
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir/build"

  cmake .. -G Ninja \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBDIR=lib \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_TESTING=OFF

  ninja
}

check() {
  true
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir/build"

  DESTDIR="$pkgdir" ninja install

  test -f "$pkgdir/usr/share/ECM/find-modules/FindPlasmaWaylandProtocols.cmake" || \
  test -f "$pkgdir/usr/share/cmake/PlasmaWaylandProtocols/PlasmaWaylandProtocolsConfig.cmake" || \
  test -d "$pkgdir/usr/share/plasma-wayland-protocols"

  for f in LICENSES/* LICENSE* COPYING*; do
    if [ -f "$SRCROOT/$_srcdir/$f" ]; then
      install -Dm644 "$SRCROOT/$_srcdir/$f" \
        "$pkgdir/usr/share/licenses/$NAME/$(basename "$f")"
    fi
  done
}