#!/bin/bash
# LPM Linux recipe - Leptonica image-processing library
NAME="leptonica"
VERSION="1.87.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"

SUMMARY="Image processing and analysis library used by Tesseract OCR"
URL="https://github.com/DanBloomberg/leptonica"
LICENSE=("BSD-2-Clause")

SOURCE=("https://github.com/DanBloomberg/leptonica/archive/refs/tags/${VERSION}.tar.gz")
# Replace SKIP with the SHA-256 of the exact upstream tarball when available.
SHA256SUMS=("SKIP")
PATCHES=()

REQUIRES=(
    "glibc"
    "zlib"
    "libpng"
    "libjpeg"
    "libtiff"
)
BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "zlib"
    "libpng"
    "libjpeg"
    "libtiff"
)
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=("lept")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail
    test -f "${SRCROOT:?}/leptonica-${VERSION}/CMakeLists.txt"
}

build() {
    set -euxo pipefail
    local src="${SRCROOT:?}/leptonica-${VERSION}"
    local builddir="$src/build"

    cmake -S "$src" -B "$builddir" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_INSTALL_INCLUDEDIR=include \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_PROG=OFF \
        -DSW_BUILD=OFF \
        -DSTRICT_CONF=ON \
        -DENABLE_ZLIB=ON \
        -DENABLE_PNG=ON \
        -DENABLE_JPEG=ON \
        -DENABLE_TIFF=ON \
        -DENABLE_GIF=OFF \
        -DENABLE_WEBP=OFF \
        -DENABLE_OPENJPEG=OFF

    cmake --build "$builddir" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    local src="${SRCROOT:?}/leptonica-${VERSION}"
    DESTDIR="${pkgdir:?}" cmake --install "$src/build"

    # Leptonica >= 1.87 uses libleptonica.so, not liblept.so.
    test -f "$pkgdir/usr/lib/pkgconfig/lept.pc"
    test -f "$pkgdir/usr/lib/cmake/leptonica/LeptonicaConfig.cmake"
    test -f "$pkgdir/usr/include/leptonica/allheaders.h"
    find "$pkgdir/usr/lib" -maxdepth 1 -name 'libleptonica.so*' -print -quit | grep -q .
}
