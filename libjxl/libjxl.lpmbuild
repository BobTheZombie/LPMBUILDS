#!/bin/bash
# LPM Linux - JPEG XL reference encoder/decoder and libraries
# Uses the shared system Highway, Brotli, Little CMS and PNG libraries.
# LPM extracts sources into $SRCROOT/$NAME-$VERSION.

NAME="libjxl"
VERSION="0.12.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="JPEG XL image codec libraries and command-line tools"
URL="https://github.com/libjxl/libjxl"
LICENSE=("BSD-3-Clause")

SOURCE=(
    "https://github.com/libjxl/libjxl/archive/refs/tags/v${VERSION}.tar.gz"
)
SHA256SUMS=(
    "03e9be69a30be4011f559da75328b6d7cea8ad921fabfbd551ce10bf45cdc992"
)
PATCHES=()

REQUIRES=(
    "glibc"
    "gcc-libs"
    "brotli"
    "highway"
    "lcms2"
    "libpng"
    "libjpeg-turbo"
    "giflib"
    "zlib"
)

BUILD_REQUIRES=(
    "cmake"
    "ninja"
    "pkgconf"
    "gcc"
    "brotli"
    "highway"
    "lcms2"
    "libpng"
    "libjpeg-turbo"
    "giflib"
    "zlib"
)

REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=("jpegxl" "jpeg-xl")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=("gdk-pixbuf2")

prepare() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    test -f "$src/CMakeLists.txt"
    test -f "$src/third_party/CMakeLists.txt"
}

build() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    local builddir="$src/build"

    # Avoid reusing a CMake cache from a different dependency configuration.
    if [[ -d "$builddir" ]]; then
        rm -rf -- "$builddir"
    fi

    cmake -S "$src" -B "$builddir" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_TESTING=OFF \
        -DJPEGXL_ENABLE_TOOLS=ON \
        -DJPEGXL_ENABLE_DEVTOOLS=OFF \
        -DJPEGXL_ENABLE_BENCHMARK=OFF \
        -DJPEGXL_ENABLE_EXAMPLES=OFF \
        -DJPEGXL_ENABLE_DOXYGEN=OFF \
        -DJPEGXL_ENABLE_MANPAGES=OFF \
        -DJPEGXL_ENABLE_JNI=OFF \
        -DJPEGXL_ENABLE_SJPEG=OFF \
        -DJPEGXL_ENABLE_OPENEXR=OFF \
        -DJPEGXL_ENABLE_SKCMS=OFF \
        -DJPEGXL_ENABLE_VIEWERS=OFF \
        -DJPEGXL_ENABLE_PLUGINS=OFF \
        -DJPEGXL_ENABLE_TCMALLOC=OFF \
        -DJPEGXL_BUNDLE_LIBPNG=OFF \
        -DJPEGXL_FORCE_SYSTEM_BROTLI=ON \
        -DJPEGXL_FORCE_SYSTEM_LCMS2=ON \
        -DJPEGXL_FORCE_SYSTEM_HWY=ON \
        -DJPEGXL_ENABLE_TRANSCODE_JPEG=ON \
        -DJPEGXL_ENABLE_BOXES=ON

    cmake --build "$builddir" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}

check() {
    set -euxo pipefail
    local builddir="$SRCROOT/$NAME-$VERSION/build"
    test -f "$builddir/CMakeCache.txt"
    # Full codec tests need upstream's optional googletest dependency.
}

staging() {
    set -euxo pipefail
    local builddir="$SRCROOT/$NAME-$VERSION/build"

    DESTDIR="$pkgdir" cmake --install "$builddir"

    test -x "$pkgdir/usr/bin/cjxl"
    test -x "$pkgdir/usr/bin/djxl"
    test -d "$pkgdir/usr/include/jxl"
    test -n "$(find "$pkgdir/usr/lib" -maxdepth 1 -name 'libjxl.so*' -print -quit)"
    test -n "$(find "$pkgdir/usr/lib" -maxdepth 1 -name 'libjxl_threads.so*' -print -quit)"

    # LPM's shared-library package should not ship bundled static archives.
    find "$pkgdir/usr/lib" -type f -name '*.a' -delete
}
