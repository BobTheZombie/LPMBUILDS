#!/bin/bash
# KDE Plasma Workspace 6.8.1 for LPM Linux.
# GitLab lpm-org/packages is authoritative; GitHub Actions audits NAME/PROVIDES.
NAME="plasma-workspace"
VERSION="6.8.1"
RELEASE="3"
ARCH="${ARCH:-x86_64}"
SUMMARY="KDE Plasma workspace and Wayland session"
URL="https://kde.org/plasma-desktop/"
LICENSE=("SEE-UPSTREAM")
SOURCE=("https://download.kde.org/stable/plasma/${VERSION}/plasma-workspace-${VERSION}.tar.xz")
SHA256SUMS=("e2abb7e5b5fc8d59fe369d3ab4ea776e10684af0fb1a8a3275e9df64eff97d20")
PATCHES=()
REQUIRES=(
    "glibc" "dbus" "libudev" "wayland" "zlib"
    "qt6-base" "qt6-declarative" "qt6-location" "qt6-positioning"
    "qt6-svg" "qt6-shadertools" "qt6-wayland"
    "kwin" "libplasma" "plasma5support"
    "plasma-activities" "plasma-activities-stats" "kactivitymanagerd"
    "kglobalaccel6" "kio6" "kservice6" "krunner6"
    "kwayland" "libksysguard" "libkscreen" "layer-shell-qt"
    "knighttime" "union" "kscreenlocker"
    "qcoro" "libqalculate" "libcanberra"
    "networkmanager-qt" "polkit-qt6"
)
BUILD_REQUIRES=(
    "cmake" "ninja" "pkgconf" "extra-cmake-modules" "python"
    "qt6-base" "qt6-declarative" "qt6-location" "qt6-positioning"
    "qt6-svg" "qt6-shadertools" "qt6-wayland"
    "qcoro" "libplasma" "plasma-activities" "plasma-activities-stats"
    "kwayland" "libksysguard" "libkscreen" "layer-shell-qt"
    "knighttime" "union" "kwin" "kscreenlocker"
    "plasma-wayland-protocols" "dbus" "libudev" "wayland" "wayland-protocols"
    "libqalculate" "libcanberra" "zlib" "icu"
    "networkmanager-qt" "polkit-qt6" "pipewire"
    "karchive6" "kauth6" "kcoreaddons6" "kcrash6" "kdbusaddons6"
    "kdeclarative6" "kglobalaccel6" "kguiaddons6" "kholidays6"
    "ki18n6" "kiconthemes6" "kidletime6" "kitemmodels6"
    "kcmutils6" "kded6" "kio6" "knewstuff6" "knotifications6"
    "kpackage6" "kparts6" "prison6" "krunner6"
    "kstatusnotifieritem6" "ksvg6" "ktexteditor6" "ktextwidgets6"
    "kwallet6" "kcolorscheme6"
    "libice" "libsm" "libx11" "libxau" "libxcursor"
    "libxfixes" "libxft" "libxrender" "libxtst" "libxcb"
    "xcb-util" "xcb-util-cursor" "xcb-util-image"
)
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=("plasma-workspace")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=("flatpak" "accountsservice" "pipewire" "milou"
            "plasma-nm" "plasma-pa" "kirigami6" "kirigami-addons"
            "xdg-desktop-portal" "xdg-desktop-portal-kde"
            "baloo6" "kio-extras" "kio-fuse" "appstream")
SUGGESTS=("packagekit" "packagekit-qt6")
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/$NAME-$VERSION/CMakeLists.txt"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    local builddir="$src/build"
    cmake -S "$src" -B "$builddir" -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DKDE_INSTALL_LIBDIR=lib \
        -DBUILD_TESTING=OFF \
        -DBUILD_SHARED_LIBS=ON \
        -DKDE_INSTALL_USE_QT_SYS_PATHS=ON \
        -DWITH_X11=ON \
        -DWITH_X11_SESSION=OFF \
        -DBUILD_GEOTIMEZONED=ON \
        -DBUILD_CAMERAINDICATOR=ON \
        -DGLIBC_LOCALE_GEN=ON \
        -DGLIBC_LOCALE_PREGENERATED=OFF \
        -DUBUNTU_PACKAGEKIT=OFF \
        -DPACKAGEKIT_OFFLINE_UPDATES=OFF \
        -DINSTALL_SDDM_WAYLAND_SESSION=ON
    cmake --build "$builddir" --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    local builddir="$SRCROOT/$NAME-$VERSION/build"
    DESTDIR="$pkgdir" cmake --install "$builddir"
    test -d "$pkgdir/usr"
    test -n "$(find "$pkgdir/usr" -mindepth 1 -print -quit)"
    test -f "$pkgdir/usr/lib/sddm/sddm.conf.d/plasma-wayland.conf"
}
