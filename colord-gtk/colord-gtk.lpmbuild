#!/bin/bash
# LPM build script for colord-gtk

NAME="colord-gtk"
VERSION="0.3.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="GTK helper library for colord"
URL="https://www.freedesktop.org/software/colord/"
LICENSE=("LGPL-2.1-or-later")

SOURCE=(
  "git+https://github.com/hughsie/colord-gtk#tag=$VERSION"
)

SHA256SUMS=("SKIP")

REQUIRES=(
  "glibc"
  "glib2"
  "gtk3"
  "colord"
)

BUILD_REQUIRES=(
  "meson"
  "ninja"
  "pkgconf"
  "vala"
  "gobject-introspection"
  "gtk3"
  "colord"
)

PROVIDES=(
  "colord-gtk"
  "libcolord-gtk.so"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}"

prepare() {
  set -euxo pipefail

  cd "$SRCROOT/$_srcdir"

  rm -rf build
}

build() {
  set -euxo pipefail

  cd "$SRCROOT/$_srcdir"

  meson setup build \
    --prefix=/usr \
    --libdir=lib \
    --buildtype=release \
    -Ddefault_library=shared \
    -Dintrospection=true \
    -Dvapi=true

  meson compile -C build
}

check() {
  true
}

staging() {
  set -euxo pipefail

  cd "$SRCROOT/$_srcdir"

  DESTDIR="$pkgdir" meson install -C build

  test -f "$pkgdir/usr/lib/libcolord-gtk.so"

  for f in COPYING LICENSE; do
    if [ -f "$f" ]; then
      install -Dm644 "$f" \
        "$pkgdir/usr/share/licenses/$NAME/$f"
    fi
  done
}
