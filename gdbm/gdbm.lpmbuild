NAME="gdbm"
VERSION="1.26"
RELEASE="1"
ARCH="x86_64"
SUMMARY="GNU dbm key/value database library"
URL="https://www.gnu.org.ua/software/gdbm/"
SOURCE=("https://ftp.wayne.edu/gnu/gdbm//gdbm-${VERSION}.tar.gz")
LICENSE="GPL-3.0-or-later"

REQUIRES=("glibc" "readline" "ncurses")
PROVIDES=("gdbm" "libgdbm.so")

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/$NAME-$VERSION"
}

build() {
    cd "$SRCROOT/$NAME-$VERSION"
    ./configure --prefix=/usr --disable-static --enable-libgdbm-compat
    make -j"$(nproc)"
}

staging() {
    cd "$SRCROOT/$NAME-$VERSION"
    make DESTDIR="$pkgdir" install
}





# Final audited source digests
SHA256SUMS=("6a24504a14de4a744103dcb936be976df6fbe88ccff26065e54c1c47946f4a5e")
