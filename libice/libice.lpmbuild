# LPM build script for libice
NAME="libice"
VERSION="1.1.2"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="X11 Inter-Client Exchange library"
URL="https://www.x.org/"
LICENSE="MIT"
SOURCE=("https://xorg.freedesktop.org/archive/individual/lib/libICE-${VERSION}.tar.xz")
CHECKSUMS=("974e4ed414225eb3c716985df9709f4da8d22a67a2890066bc6dfc89ad298625")
REQUIRES=("glibc" "xorgproto")
PROVIDES=("libice")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() { set -euxo pipefail; cd "$SRCROOT"; }

build() {
  set -euxo pipefail
  cd "$SRCROOT"
  ./configure --prefix=/usr --sysconfdir=/etc --disable-static
  make -j"$(nproc)"
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT"
  make DESTDIR="$pkgdir" install
}




# Final audited source digests
SHA256SUMS=("974e4ed414225eb3c716985df9709f4da8d22a67a2890066bc6dfc89ad298625")
