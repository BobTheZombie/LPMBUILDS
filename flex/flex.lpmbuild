NAME="flex"
VERSION="2.6.4"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Fast lexical analyzer generator"
URL="https://github.com/westes/flex"
SOURCE=("https://github.com/westes/flex/releases/download/v${VERSION}/flex-${VERSION}.tar.gz")
LICENSE=("BSD-2-Clause")

REQUIRES=("m4")
PROVIDES=("flex" "lex")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/flex-${VERSION}"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/flex-${VERSION}"
    ./configure --prefix=/usr --libdir=/usr/lib
    make -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/flex-${VERSION}"
    make install DESTDIR="$pkgdir"
    ln -sf flex "$pkgdir/usr/bin/lex"
}





# Final audited source digests
SHA256SUMS=("e87aae032bf07c26f85ac0ed3250998c37621d95f8bd748b31f15b33c45ee995")
