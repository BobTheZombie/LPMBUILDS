NAME="nano"
VERSION="8.2"
RELEASE="1"
ARCH="x86_64"
SUMMARY="GNU nano text editor"
URL="https://www.nano-editor.org/"
SOURCE=("https://www.nano-editor.org/dist/v${VERSION%.*}/nano-${VERSION}.tar.xz")
LICENSE=("GPL-3.0-or-later")

REQUIRES=("glibc" "ncurses")
PROVIDES=("nano")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/nano-${VERSION}"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/nano-${VERSION}"
    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --enable-utf8
    make -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/nano-${VERSION}"
    make DESTDIR="$pkgdir" install
}

