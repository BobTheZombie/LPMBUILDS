#!/bin/bash
# LPM build script for geoclue (GeoClue 2)

NAME="geoclue"
VERSION="2.8.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Modular geoinformation service built on D-Bus (GeoClue)"
URL="https://gitlab.freedesktop.org/geoclue/geoclue"
LICENSE=("GPL-2.0-or-later" "LGPL-2.1-or-later")

SOURCE=(
  "geoclue-${VERSION}.tar.gz::https://gitlab.freedesktop.org/geoclue/geoclue/-/archive/${VERSION}/geoclue-${VERSION}.tar.gz"
)

REQUIRES=(
  "glibc"
  "glib2"
  "dbus"
  "polkit"
  "json-glib"
  "libsoup"
  "libnotify"
  "systemd"
  "avahi"
)

PROVIDES=(
  "geoclue"
  "geoclue2"
)

CONFLICTS=("geoclue2")
OBSOLETES=("geoclue2")

_srcdir="geoclue-${VERSION}"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  rm -rf build

  meson setup build         --prefix=/usr         --libdir=lib         --buildtype=release         -Ddefault_library=shared      -Dvapi=false

  meson compile -C build
}

check() { true; }

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  DESTDIR="$pkgdir" meson install -C build

  for f in COPYING LICENSE; do
    if [ -f "$f" ]; then
      install -Dm644 "$f" "$pkgdir/usr/share/licenses/$NAME/$f"
    fi
  done
}
