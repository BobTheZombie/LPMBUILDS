# LPM build script for libxrandr
NAME="libxrandr"
VERSION="1.5.5"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="X11 RandR extension library"
URL="https://www.x.org/"
LICENSE="MIT"
SOURCE=("https://xorg.freedesktop.org/archive/individual/lib/libXrandr-${VERSION}.tar.xz")
CHECKSUMS=("72b922c2e765434e9e9f0960148070bd4504b288263e2868a4ccce1b7cf2767a")
REQUIRES=("glibc" "libX11" "libXext" "libXrender" "xorgproto")
PROVIDES=("libxrandr")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() { set -euxo pipefail
  cd "$SRCROOT/$NAME-$VERSION"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$NAME-$VERSION"
  ./configure --prefix=/usr --sysconfdir=/etc --disable-static
  make -j"$(nproc)"
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$NAME-$VERSION"
  make DESTDIR="$pkgdir" install
}




# Final audited source digests
SHA256SUMS=("72b922c2e765434e9e9f0960148070bd4504b288263e2868a4ccce1b7cf2767a")
