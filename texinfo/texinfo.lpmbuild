NAME="texinfo"
VERSION="7.3"
RELEASE="1"
ARCH="x86_64"
SUMMARY="GNU documentation system"
URL="https://www.wayne.edu/gnu/texinfo/"
SOURCE=("https://ftp.wayne.edu/gnu/texinfo/texinfo-${VERSION}.tar.xz"
        "texinfo-install.hook"
        "texinfo-remove.hook")
        
LICENSE=("GPL-3.0-or-later")

REQUIRES=("perl" "pigz" "bash" "ncurses")
PROVIDES=("texinfo" "info" "makeinfo")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/texinfo-${VERSION}"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/texinfo-${VERSION}"
    ./configure --prefix=/usr --libdir=/usr/lib
    make -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/texinfo-${VERSION}"
    make DESTDIR="$pkgdir" install
    
    install -dm755 "$pkgdir"/usr/share/liblpm/hooks/
    install -m644 $SRCROOT/texinfo-install.hook "$pkgdir"/usr/share/liblpm/hooks/
    install -m644 $SRCROOT/texinfo-remove.hook "$pkgdir"/usr/share/liblpm/hooks/

}





