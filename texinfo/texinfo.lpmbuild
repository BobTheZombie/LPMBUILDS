#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="texinfo"
VERSION="7.3"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="GNU documentation system"
URL="https://ftpmirror.gnu.org/texinfo/texinfo-7.3.tar.xz"
LICENSE=("GPL-3.0-or-later")
SOURCE=("https://ftpmirror.gnu.org/texinfo/texinfo-7.3.tar.xz")
SHA256SUMS=("51f74eb0f51cfa9873b85264dfdd5d46e8957ec95b88f0fb762f63d9e164c72e")
PATCHES=()
REQUIRES=("glibc" "perl" "ncurses")
BUILD_REQUIRES=("gcc" "make" "pkgconf")
PROVIDES=("texinfo")
CONFLICTS=()
OBSOLETES=()

_srcdir="texinfo-7.3"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    :
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    ./configure --prefix=/usr
    make -j"${JOBS:-$(nproc)}"
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    make DESTDIR="$pkgdir" install

    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
