NAME="curl"
VERSION="8.23.0"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Command-line tool for transferring data with URLs"
URL="https://curl.se/"
SOURCE=("https://curl.se/download/curl-${VERSION}.tar.xz")
LICENSE=("curl")

REQUIRES=("glibc" "openssl" "zlib" "libidn2" "ca-certificates")
PROVIDES=("curl" "libcurl")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/curl-${VERSION}"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/curl-${VERSION}"
    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --with-ssl \
        --enable-ipv6 \
        --enable-unix-sockets
    make -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/curl-${VERSION}"
    make DESTDIR="$pkgdir" install
}





# Final audited source digests
SHA256SUMS=("8dadd7d2536a314f982ad05a651b713f426bf7d02cc2c76cffb9796f2218e6c5")
