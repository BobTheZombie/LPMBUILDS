NAME="curl"
VERSION="8.9.1"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Command-line tool for transferring data with URLs"
URL="https://curl.se/"
SOURCE=("https://curl.se/download/curl-${VERSION}.tar.xz")
LICENSE=("curl")

REQUIRES=("glibc" "openssl" "zlib" "nghttp2" "libidn2" "ca-certificates")
PROVIDES=("curl" "libcurl")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/curl-${VERSION}"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/curl-${VERSION}"
    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --with-ssl \
        --enable-ipv6 \
        --enable-unix-sockets \
        --with-nghttp2
    make -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/curl-${VERSION}"
    make DESTDIR="$pkgdir" install
}

