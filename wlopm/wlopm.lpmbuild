#!/bin/bash
# LPM build script for wlopm

NAME="wlopm"
VERSION="1.0.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Wayland output power management utility"
URL="https://git.sr.ht/~leon_plickat/wlopm"
LICENSE=("GPL-3.0-or-later")

SOURCE=(
  "https://git.sr.ht/~leon_plickat/wlopm/archive/v${VERSION}.tar.gz"
)

REQUIRES=(
  "glibc"
  "wayland"
)

BUILD_REQUIRES=(
  "meson"
  "ninja"
  "pkgconf"
  "wayland-protocols"
)

PROVIDES=(
  "wlopm"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  make
}

check() {
  true
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  install -dm755 "$pkgdir/usr/share/bash-completion/completions"
  make DESTDIR="$pkgdir/" PREFIX='/usr' install
  install -Dm644 LICENSE -t "$pkgdir/usr/share/licenses/$NAME"
  install -Dm644 README -t "$pkgdir/usr/share/doc/$NAME"
}



# Final audited source digests
SHA256SUMS=("15f31bbd855131943397dded3a26003f2f5056e4c6a1a93d35ff7697b3f1e439")
