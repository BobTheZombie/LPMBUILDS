#!/bin/bash
# LPM build script for libassuan

NAME="libassuan"
VERSION="3.0.2"
RELEASE="1"
ARCH="${ARCH:-x86_64}"

SUMMARY="IPC library used by GnuPG"
URL="https://gnupg.org/software/libassuan/"
LICENSE=("LGPL-2.1-or-later" "GPL-3.0-or-later")

SOURCE=(
    "https://www.gnupg.org/ftp/gcrypt/libassuan/libassuan-${VERSION}.tar.bz2"
)

SHA256SUMS=("SKIP")
PATCHES=()

REQUIRES=("glibc" "libgpg-error")
BUILD_REQUIRES=("gcc" "make" "pkgconf" "libgpg-error")

PROVIDES=(
    "libassuan"
    "libassuan.so"
    "libassuan.so.9"
)

CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

BUILD_OPTIONS=("@--stripping" "@--optimize=2")

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    test -f configure
    test -f Makefile.in
    test -f COPYING
    test -f COPYING.LIB

    if [ -f Makefile ]; then
        make distclean
    fi
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --includedir=/usr/include \
        --datadir=/usr/share \
        --infodir=/usr/share/info \
        --enable-shared \
        --disable-static

    make -j"$(nproc)"
}

check() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    make -j"$(nproc)" check
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    make DESTDIR="$pkgdir" install

    find "$pkgdir/usr/lib" \
        -type f \
        \( -name '*.a' -o -name '*.la' \) \
        -delete

    rm -f "$pkgdir/usr/share/info/dir"

    test -e "$pkgdir/usr/lib/libassuan.so"
    test -e "$pkgdir/usr/lib/libassuan.so.9"
    test -f "$pkgdir/usr/include/assuan.h"
    test -s "$pkgdir/usr/lib/pkgconfig/libassuan.pc"

    install -Dm644 COPYING \
        "$pkgdir/usr/share/licenses/$NAME/COPYING"

    install -Dm644 COPYING.LIB \
        "$pkgdir/usr/share/licenses/$NAME/COPYING.LIB"
}




# Final audited source digests
SHA256SUMS=("d2931cdad266e633510f9970e1a2f346055e351bb19f9b78912475b8074c36f6")
