#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="dbus"
VERSION="1.16.2"
RELEASE="2"
ARCH="${ARCH:-x86_64}"
SUMMARY="Message bus system (reference implementation)"
URL="https://dbus.freedesktop.org/releases/dbus/dbus-1.16.2.tar.xz"
LICENSE=("AFL-2.1" "GPL-2.0-or-later")
SOURCE=("https://dbus.freedesktop.org/releases/dbus/dbus-1.16.2.tar.xz")
SHA256SUMS=("0ba2a1a4b16afe7bceb2c07e9ce99a8c2c3508e5dec290dbb643384bd6beb7e2")
PATCHES=()
REQUIRES=("glibc" "expat")
BUILD_REQUIRES=("gcc" "make" "pkgconf" "meson" "ninja" "python")
PROVIDES=("dbus")
CONFLICTS=()
OBSOLETES=()

_srcdir="dbus-1.16.2"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    :
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    meson setup build --prefix=/usr --libdir=lib --buildtype=release --wrap-mode=nofallback -Dsystemd=enabled -Ddbus_user=dbus
    meson compile -C build
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    DESTDIR="$pkgdir" meson install -C build
    install -dm755 "$pkgdir/var/lib/dbus"
    ln -sf /etc/machine-id "$pkgdir/var/lib/dbus/machine-id"
    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
