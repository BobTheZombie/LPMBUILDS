# Merge into a kernel configuration; not a complete .config.
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_INET=y
CONFIG_IPV6=y
CONFIG_PACKET=y
CONFIG_NETDEVICES=y
CONFIG_NET_NS=y
CONFIG_NETLINK_DIAG=m
CONFIG_TUN=m
CONFIG_BRIDGE=m
CONFIG_VLAN_8021Q=m
CONFIG_CFG80211=m
CONFIG_CFG80211_USE_KERNEL_REGDB_KEYS=y
CONFIG_MAC80211=m
CONFIG_RFKILL=y
CONFIG_FW_LOADER=y
CONFIG_NF_TABLES=m
CONFIG_NF_TABLES_INET=y
CONFIG_NF_CONNTRACK=m
CONFIG_NF_NAT=m
CONFIG_NFT_CT=m
CONFIG_NFT_MASQ=m
CONFIG_NFT_NAT=m
# Also select the actual Ethernet/Wi-Fi driver for your hardware.
