NAME="wasi-libc"
VERSION="0+659+2e6fb9d8"
RELEASE="2"
ARCH="${ARCH:-x86_64}"

SUMMARY="WASI libc implementation for WebAssembly"
URL="https://github.com/WebAssembly/wasi-libc"
LICENSE=(
    "Apache-2.0 WITH LLVM-exception"
    "Apache-2.0"
    "MIT"
)

SOURCE=(
    "https://github.com/WebAssembly/wasi-libc/archive/2e6fb9d8ee0cdf9e431fbcabe8af3115de000a13.tar.gz"
)

SHA256SUMS=("SKIP")
PATCHES=()

REQUIRES=(
    "wasi-compiler-rt"
)

BUILD_REQUIRES=(
    "clang"
    "cmake"
    "llvm"
    "ninja"
    "wasi-compiler-rt"
)

PROVIDES=(
    "wasi-libc"
)

CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail

    SRCDIR="$SRCROOT/${NAME}-${VERSION}"

    test -f "$SRCDIR/CMakeLists.txt"

    rm -rf \
        "$SRCROOT/${NAME}-${VERSION}-build-wasm32-wasi" \
        "$SRCROOT/${NAME}-${VERSION}-build-wasm32-wasip1"
}

build() {
    set -euxo pipefail

    SRCDIR="$SRCROOT/${NAME}-${VERSION}"
    RESOURCE_DIR="$(clang --print-resource-dir)"

    test -d "$RESOURCE_DIR/lib"

    TARGETS=(
        "wasm32-wasi"
        "wasm32-wasip1"
    )

    for TARGET in "${TARGETS[@]}"; do
        BUILDDIR="$SRCROOT/${NAME}-${VERSION}-build-${TARGET}"
        RESOURCE_TARGET="${TARGET/wasm32/wasm32-unknown}"

        BUILTINS_CANDIDATES=(
            "$RESOURCE_DIR/lib/$RESOURCE_TARGET/libclang_rt.builtins.a"
            "$RESOURCE_DIR/lib/wasm32-unknown-wasip1/libclang_rt.builtins.a"
            "$RESOURCE_DIR/lib/wasi/libclang_rt.builtins-wasm32.a"
            "$RESOURCE_DIR/lib/libclang_rt.builtins-wasm32.a"
        )

        BUILTINS_LIB=""

        for CANDIDATE in "${BUILTINS_CANDIDATES[@]}"; do
            if [ -f "$CANDIDATE" ]; then
                BUILTINS_LIB="$CANDIDATE"
                break
            fi
        done

        if [ -z "$BUILTINS_LIB" ]; then
            echo "No compiler-rt builtins found for $TARGET" >&2
            echo "Clang resource directory: $RESOURCE_DIR" >&2

            find "$RESOURCE_DIR/lib" \
                -type f \
                -name '*builtins*.a' \
                -print >&2

            return 1
        fi

        echo "[wasi-libc] target=$TARGET"
        echo "[wasi-libc] builtins=$BUILTINS_LIB"

        env \
            CFLAGS= \
            CXXFLAGS= \
            CPPFLAGS= \
            LDFLAGS= \
            cmake \
                -S "$SRCDIR" \
                -B "$BUILDDIR" \
                -G Ninja \
                -DCMAKE_BUILD_TYPE=Release \
                -DCMAKE_INSTALL_PREFIX=/usr/share/wasi-sysroot \
                -DCMAKE_SYSROOT=/usr/share/wasi-sysroot \
                -DCMAKE_SYSTEM_NAME=WASI \
                -DCMAKE_SYSTEM_PROCESSOR=wasm32 \
                -DCMAKE_SYSTEM_VERSION=1 \
                -DCMAKE_C_COMPILER=/usr/bin/clang \
                -DCMAKE_ASM_COMPILER=/usr/bin/clang \
                -DCMAKE_C_COMPILER_WORKS=ON \
                -DCMAKE_TRY_COMPILE_TARGET_TYPE=STATIC_LIBRARY \
                -DCMAKE_AR=/usr/bin/llvm-ar \
                -DCMAKE_NM=/usr/bin/llvm-nm \
                -DCMAKE_RANLIB=/usr/bin/llvm-ranlib \
                -DCMAKE_C_LINKER_DEPFILE_SUPPORTED=OFF \
                -DCMAKE_C_FLAGS="-O2 -Wno-deprecated -fno-exceptions" \
                -DCMAKE_ASM_FLAGS="-O2 -Wno-deprecated -fno-exceptions" \
                -DTARGET_TRIPLE="$TARGET" \
                -DBUILTINS_LIB="$BUILTINS_LIB"

        env \
            CFLAGS= \
            CXXFLAGS= \
            CPPFLAGS= \
            LDFLAGS= \
            cmake --build "$BUILDDIR" \
                -j"$(nproc)"
    done
}

check() {
    true
}

staging() {
    set -euxo pipefail

    TARGETS=(
        "wasm32-wasi"
        "wasm32-wasip1"
    )

    for TARGET in "${TARGETS[@]}"; do
        BUILDDIR="$SRCROOT/${NAME}-${VERSION}-build-${TARGET}"

        env \
            DESTDIR="$pkgdir" \
            cmake --install "$BUILDDIR"
    done

    SYSROOT="$pkgdir/usr/share/wasi-sysroot"

    test -d "$SYSROOT/include"
    test -f "$SYSROOT/lib/wasm32-wasi/libc.a"
    test -f "$SYSROOT/lib/wasm32-wasip1/libc.a"

    if command -v hardlink >/dev/null 2>&1; then
        hardlink -c "$SYSROOT"
    fi

    install -d "$pkgdir/usr/share/licenses/$NAME"

    find "$SRCROOT/${NAME}-${VERSION}" \
        -maxdepth 1 \
        -type f \
        -name 'LICENSE*' \
        -exec install -m644 -t \
            "$pkgdir/usr/share/licenses/$NAME" {} +
}
