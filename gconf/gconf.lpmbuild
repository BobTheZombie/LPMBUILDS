#!/bin/bash
# LPM build script for GConf

NAME="gconf"
VERSION="3.2.6"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Legacy GNOME configuration database system"
URL="https://gitlab.gnome.org/Archive/gconf"
LICENSE=("LGPL-2.1-or-later")

SOURCE=(
  "https://download.gnome.org/sources/GConf/3.2/GConf-${VERSION}.tar.xz"
)

SHA256SUMS=("SKIP")

REQUIRES=(
  "glibc"
  "glib2"
  "dbus"
  "dbus-glib"
  "libxml2"
  "polkit"
  "orbit2"
)

BUILD_REQUIRES=(
  "make"
  "pkgconf"
  "intltool"
  "gettext"
  "glib2"
  "dbus"
  "dbus-glib"
  "libxml2"
  "polkit"
  "orbit2"
)

PROVIDES=(
  "gconf"
  "GConf"
  "libgconf-2.so"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="GConf-${VERSION}"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  ./configure \
    --prefix=/usr \
    --sysconfdir=/etc \
    --libdir=/usr/lib \
    --libexecdir=/usr/lib/GConf \
    --localstatedir=/var \
    --disable-static \
    --disable-orbit \
    --disable-gtk-doc

  make -j"$(nproc)"
}

check() {
  true
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  make DESTDIR="$pkgdir" install

  test -f "$pkgdir/usr/lib/libgconf-2.so"

  for f in COPYING LICENSE; do
    if [ -f "$f" ]; then
      install -Dm644 "$f" \
        "$pkgdir/usr/share/licenses/$NAME/$f"
    fi
  done
}
