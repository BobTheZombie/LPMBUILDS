#!/bin/bash
# LPM Linux full KDE Plasma 6.8.1 meta-package
# Based on the generated 158-recipe Plasma 6.8.1 source chain (2026-10-25).
# Every declared REQUIRES is resolved and built by LPM if not installed.
# The program discover is optional until a working PackageKit backend exists.
NAME="plasma6-full"
VERSION="6.8.1"
RELEASE="1"
ARCH="any"
SUMMARY="Complete KDE Plasma 6 desktop, Qt 6, Frameworks 6, and KDE applications"
URL="https://kde.org/plasma-desktop/"
LICENSE="NONE"
SOURCE=()
SHA256SUMS=()
PATCHES=()

