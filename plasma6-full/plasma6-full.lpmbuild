    "purpose6"
    "qqc2-desktop-style6"
    "solid6"
    "sonnet6"
    "syndication6"
    "syntax-highlighting6"
    "threadweaver6"

    # Qt / Plasma supporting infrastructure
    "AppStream"
    "packagekit"
