#!/bin/bash
# LPM Linux full KDE Plasma 6.8.1 desktop meta-package
# Qt 6.12.0 / KDE Frameworks 6.31.0 / Plasma 6.8.1 / Gear 26.08.2
# Meta-package: all required packages are resolved by LPM.
# No Qt WebEngine or KAccounts/SignOn stack is required.

NAME="plasma6-full"
VERSION="6.8.1"
RELEASE="3"
ARCH="any"
SUMMARY="Complete KDE Plasma 6 Wayland desktop, Qt 6, Frameworks 6, and KDE applications"
URL="https://kde.org/plasma-desktop/"
LICENSE="NONE"
SOURCE=()
SHA256SUMS=()
PATCHES=()

REQUIRES=(
    # Qt 6.12.0 modules
    "qt6-5compat"
    "qt6-base"
    "qt6-connectivity"
    "qt6-declarative"
    "qt6-graphs"
