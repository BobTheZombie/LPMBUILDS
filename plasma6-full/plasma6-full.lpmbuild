BUILD_REQUIRES=()
REQUIRES_PYTHON_DEPENDENCIES=()

PROVIDES=(
    "plasma6-desktop-full"
    "kde-plasma-full"
)
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=(
    "plasma-setup"    # optional first-run setup
    "kup"             # optional backup scheduler
    "krdp"            # optional remote desktop server
    "plasma-sdk"      # optional widget/theme development
)

# Pure meta-package: no files are staged.
prepare() { :; }
build() { :; }
staging() { :; }