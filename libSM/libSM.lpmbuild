#!/bin/bash
NAME="libSM"
VERSION="1.2.4"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="libSM from X.Org"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=(
   "https://www.x.org/releases/individual/lib/${NAME}-${VERSION}.tar.xz"
)

REQUIRES=(
  "glibc"
  "libICE"
)

PROVIDES=("libSM")
CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  ./configure --prefix=/usr
  make -j"$(nproc)"
}

check() { true; }

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  DESTDIR="$pkgdir" make install
  [ -f COPYING ] && install -Dm644 COPYING "$pkgdir/usr/share/licenses/$NAME/COPYING"
}
