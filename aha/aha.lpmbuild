#!/bin/bash
# LPM Linux diagnostics for KDE KInfoCenter
NAME="aha"
VERSION="0.5.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="ANSI to HTML conversion utility"
URL="https://github.com/theZiz/aha"
LICENSE=("LGPL-2.0-or-later")
SOURCE=("https://github.com/theZiz/aha/archive/refs/tags/0.5.1.tar.gz")
SHA256SUMS=("SKIP")
PATCHES=()
REQUIRES=("glibc")
BUILD_REQUIRES=("gcc" "make")
PROVIDES=("aha")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/$NAME-$VERSION/Makefile"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    make -C "$src" -j "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    make -C "$src" install PREFIX=/usr DESTDIR="$pkgdir"
        test -x "$pkgdir/usr/bin/aha"
}
