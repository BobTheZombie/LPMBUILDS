#!/bin/bash

NAME="mozilla-nss"
VERSION="3.130"
RELEASE="4"
ARCH="${ARCH:-x86_64}"
SUMMARY="Mozilla Network Security Services (NSS)"
URL="https://firefox-source-docs.mozilla.org/security/nss/"
LICENSE=("MPL-2.0")

SOURCE=(
    "https://archive.mozilla.org/pub/security/nss/releases/NSS_${VERSION//./_}_RTM/src/nss-${VERSION}.tar.gz"
)
SHA256SUMS=("afab9f82c78bfa3e7e8b4a61ac31922675c58203f67ff385a2714df7fe9bd5c5")
PATCHES=()

REQUIRES=(
    "glibc"
    "mozilla-nspr>=4.39"
    "p11-kit"
    "sqlite"
    "zlib"
)
BUILD_REQUIRES=(
    "gcc"
    "mozilla-nspr>=4.39"
    "ninja"
    "perl"
    "pkgconf"
    "python"
    "sqlite"
    "zlib"
)

# LPM resolves this using its Python dependency handler.
REQUIRES_PYTHON_DEPENDENCIES=("gyp-next")

PROVIDES=(
    "mozilla-nss"
    "nss"
    "libfreebl3.so"
    "libfreeblpriv3.so"
    "libnss3.so"
    "libnsssysinit.so"
    "libnssutil3.so"
    "libsmime3.so"
    "libsoftokn3.so"
    "libssl3.so"
)
CONFLICTS=()
OBSOLETES=()

# IMPORTANT: LPM must NOT strip/alter *.so after NSS generates their *.chk
# integrity files. Configure a no-strip policy for this package in LPM.

nss_srcdir() {
    local path
    for path in "$SRCROOT/${NAME}-${VERSION}" "$SRCROOT/nss-${VERSION}"; do
        if [ -f "$path/nss/build.sh" ]; then
            printf '%s\n' "$path"
            return 0
        fi
    done
    echo "[ERROR] Cannot find NSS sources under $SRCROOT" >&2
    return 1
}

prepare() {
    set -euxo pipefail
    local src
    src="$(nss_srcdir)"

    test -f "$src/nss/lib/nss/nss.h"
    test -f "$src/nss/pkg/pkg-config/nss.pc.in"
    test -f "$src/nss/pkg/pkg-config/nss-config.in"
    command -v gyp
    command -v ninja
    pkg-config --atleast-version=4.39 nspr
    pkg-config --exists sqlite3 zlib

    # Backport Mozilla Bug 2070738 (fixed upstream in NSS 3.131).
    # NSS 3.130's build.sh tries to read a local nspr.pc even when
    # --system-nspr was selected. sed exits 2 when that file is absent;
    # build.sh uses set -e, so it fails AFTER a successful Ninja build.
    # Read NSPR's version from the installed pkg-config metadata instead.
    python3 - "$src/nss/build.sh" <<'PY'
from pathlib import Path
import sys

path = Path(sys.argv[1])
source = path.read_text()
old = '''    nspr_version=$(sed -n 's/^Version: *//p' \\
        "$obj_dir/lib/pkgconfig/nspr.pc" 2>/dev/null)
    : "${nspr_version:=4.32}"'''
new = '''    if [ "$no_local_nspr" = 1 ]; then
        nspr_version=$(pkg-config --modversion nspr) || return 1
    else
        nspr_version=$(sed -n 's/^Version: *//p' \\
            "$obj_dir/lib/pkgconfig/nspr.pc") || return 1
    fi
    [ -n "$nspr_version" ] || return 1'''

if old in source:
    path.write_text(source.replace(old, new, 1))
    print('[OK] Applied NSS 3.130 system-NSPR fix (Bug 2070738)')
elif new in source:
    print('[OK] NSS system-NSPR fix already applied')
else:
    raise SystemExit('[ERROR] Unexpected NSS build.sh layout; refusing unsafe patch')
PY

    # Prevent old output from satisfying artifact validation.
    rm -rf "$src/dist" "$src/nss/out"
}

build() {
    set -euxo pipefail
    local src dist lib bin
    src="$(nss_srcdir)"
    dist="$src/dist/Release"
    cd "$src/nss"

    export CFLAGS="${CFLAGS:-}"
    export CXXFLAGS="${CXXFLAGS:-}"
    export LDFLAGS="${LDFLAGS:-}"
    CFLAGS="${CFLAGS//-m32/}"
    CXXFLAGS="${CXXFLAGS//-m32/}"
    LDFLAGS="${LDFLAGS//-m32/}"

    # Do NOT ignore exit 2. With the upstream bug fixed, nonzero is an error.
    ./build.sh \
        --disable-tests \
        --enable-libpkix \
        --opt \
        --system-nspr \
        --system-sqlite \
        -j "${LPM_BUILD_JOBS:-6}"

    for lib in \
        libfreebl3.so libfreeblpriv3.so libnss3.so \
        libnsssysinit.so libnssutil3.so libsmime3.so \
        libsoftokn3.so libssl3.so; do
        test -f "$dist/lib/$lib" || {
            echo "[ERROR] Missing NSS library: $lib" >&2
            return 1
        }
    done
    for bin in certutil modutil pk12util; do
        test -x "$dist/bin/$bin" || {
            echo "[ERROR] Missing NSS utility: $bin" >&2
            return 1
        }
    done
    test -f "$src/dist/public/nss/nss.h"
    test -f "$dist/lib/pkgconfig/nss.pc"
}

staging() {
    set -euxo pipefail
    local src nssdir dist nsprver vmajor vminor vpatch f
    src="$(nss_srcdir)"
    nssdir="$src/nss"
    dist="$src/dist/Release"
    nsprver="$(pkg-config --modversion nspr)"

    pkg-config --atleast-version=4.39 nspr
    test -e /usr/lib/pkcs11/p11-kit-trust.so || {
        echo '[ERROR] Missing p11-kit trust module: /usr/lib/pkcs11/p11-kit-trust.so' >&2
        return 1
    }

    install -dm755 \
        "$pkgdir/usr/lib" \
        "$pkgdir/usr/lib/pkgconfig" \
        "$pkgdir/usr/include/nss" \
        "$pkgdir/usr/bin"

    # Keep the NSS integrity checksum files alongside the corresponding libs.
    while IFS= read -r -d '' f; do
        case "$f" in
            *.so)  install -m755 "$f" "$pkgdir/usr/lib/" ;;
            *.chk) install -m644 "$f" "$pkgdir/usr/lib/" ;;
        esac
    done < <(find "$dist/lib" -maxdepth 1 -type f \
        \( -name '*.so' -o -name '*.chk' \) -print0)

    while IFS= read -r -d '' f; do
        install -m644 "$f" "$pkgdir/usr/include/nss/"
    done < <(find "$src/dist/public/nss" -maxdepth 1 -type f -name '*.h' -print0)

    for f in \
        addbuiltin atob btoa certutil cmsutil crlutil derdump \
        modutil nss-policy-check ocspclnt oidcalc p7content \
        p7env p7sign p7verify pk12util pp shlibsign signtool \
        signver ssltap; do
        if [ -x "$dist/bin/$f" ]; then
            install -m755 "$dist/bin/$f" "$pkgdir/usr/bin/$f"
        fi
    done

    # System-prefix-correct NSS development metadata.
    sed \
        -e 's|%prefix%|/usr|g' \
        -e 's|%exec_prefix%|${prefix}|g' \
        -e 's|%libdir%|${exec_prefix}/lib|g' \
        -e 's|%includedir%|${prefix}/include/nss|g' \
        -e "s|%NSPR_VERSION%|$nsprver|g" \
        -e "s|%NSS_VERSION%|$VERSION|g" \
        "$nssdir/pkg/pkg-config/nss.pc.in" \
        > "$pkgdir/usr/lib/pkgconfig/nss.pc"
    ln -s nss.pc "$pkgdir/usr/lib/pkgconfig/mozilla-nss.pc"

    vmajor="$(awk '$2=="NSS_VMAJOR" {print $3;exit}' "$nssdir/lib/nss/nss.h")"
    vminor="$(awk '$2=="NSS_VMINOR" {print $3;exit}' "$nssdir/lib/nss/nss.h")"
    vpatch="$(awk '$2=="NSS_VPATCH" {print $3;exit}' "$nssdir/lib/nss/nss.h")"
    test -n "$vmajor" && test -n "$vminor" && test -n "$vpatch"

    sed \
        -e 's|@prefix@|/usr|g' \
        -e "s|@MOD_MAJOR_VERSION@|$vmajor|g" \
        -e "s|@MOD_MINOR_VERSION@|$vminor|g" \
        -e "s|@MOD_PATCH_VERSION@|$vpatch|g" \
        "$nssdir/pkg/pkg-config/nss-config.in" \
        > "$pkgdir/usr/bin/nss-config"
    chmod 755 "$pkgdir/usr/bin/nss-config"

    # Use the system trust store, as supplied by p11-kit.
    rm -f "$pkgdir/usr/lib/libnssckbi.so"
    ln -s pkcs11/p11-kit-trust.so "$pkgdir/usr/lib/libnssckbi.so"

    for f in \
        libfreebl3.so libfreeblpriv3.so libnss3.so \
        libnsssysinit.so libnssutil3.so libsmime3.so \
        libsoftokn3.so libssl3.so; do
        test -f "$pkgdir/usr/lib/$f"
    done
    test -f "$pkgdir/usr/include/nss/nss.h"
    test -f "$pkgdir/usr/lib/pkgconfig/nss.pc"
    test -x "$pkgdir/usr/bin/certutil"
    test -x "$pkgdir/usr/bin/modutil"
    test -x "$pkgdir/usr/bin/pk12util"
    test -x "$pkgdir/usr/bin/nss-config"
    test -L "$pkgdir/usr/lib/libnssckbi.so"

    if [ -f "$nssdir/COPYING" ]; then
        install -Dm644 "$nssdir/COPYING" \
            "$pkgdir/usr/share/licenses/$NAME/COPYING"
    fi
}