#!/bin/bash

NAME="mozilla-nss"
VERSION="3.130"
RELEASE="2"
ARCH="${ARCH:-x86_64}"

SUMMARY="Network Security Services"
URL="https://firefox-source-docs.mozilla.org/security/nss/"
LICENSE=("MPL-2.0")

SOURCE=(
    "https://archive.mozilla.org/pub/security/nss/releases/NSS_${VERSION//./_}_RTM/src/nss-${VERSION}.tar.gz"
)

SHA256SUMS=("SKIP")
PATCHES=()

REQUIRES=(
    "glibc"
    "mozilla-nspr"
    "p11-kit"
    "sqlite"
    "zlib"
)

BUILD_REQUIRES=(
    "gcc"
    "mozilla-nspr"
    "ninja"
    "perl"
    "pkgconf"
    "python"
    "sqlite"
    "zlib"
)

PROVIDES=(
    "mozilla-nss"
    "nss"
    "libfreebl3.so"
    "libfreeblpriv3.so"
    "libnss3.so"
    "libnsssysinit.so"
    "libnssutil3.so"
    "libsmime3.so"
    "libsoftokn3.so"
    "libssl3.so"
)

CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail

    SRCDIR="$SRCROOT/${NAME}-${VERSION}"
    NSSDIR="$SRCDIR/nss"

    test -f "$NSSDIR/build.sh"
    test -f "$NSSDIR/lib/nss/nss.h"
    test -f "$NSSDIR/pkg/pkg-config/nss.pc.in"
    test -f "$NSSDIR/pkg/pkg-config/nss-config.in"

    rm -rf "$SRCDIR/dist"
    rm -rf "$NSSDIR/out"
}

build() {
    set -euxo pipefail

    SRCDIR="$SRCROOT/${NAME}-${VERSION}"
    NSSDIR="$SRCDIR/nss"
    DISTDIR="$SRCDIR/dist/Release"

    cd "$NSSDIR"

    CFLAGS="${CFLAGS:-}"
    CXXFLAGS="${CXXFLAGS:-}"
    LDFLAGS="${LDFLAGS:-}"

    CFLAGS="${CFLAGS//-m32/}"
    CXXFLAGS="${CXXFLAGS//-m32/}"
    LDFLAGS="${LDFLAGS//-m32/}"

    export CFLAGS
    export CXXFLAGS
    export LDFLAGS

    #
    # NSS 3.130's build.sh may return 2 after Ninja has completed.
    # Accept that status only if the required output is complete.
    #

    set +e

    ./build.sh \
        --disable-tests \
        --enable-libpkix \
        --opt \
        --system-nspr \
        --system-sqlite

    BUILD_STATUS=$?

    set -e

    case "$BUILD_STATUS" in
        0)
            ;;
        2)
            echo "[WARN] NSS build.sh returned 2; validating artifacts"
            ;;
        *)
            echo "[ERROR] NSS build.sh failed with status $BUILD_STATUS"
            return "$BUILD_STATUS"
            ;;
    esac

    test -d "$DISTDIR/lib" || {
        echo "[ERROR] Missing NSS library directory: $DISTDIR/lib"
        return 1
    }

    test -d "$DISTDIR/bin" || {
        echo "[ERROR] Missing NSS binary directory: $DISTDIR/bin"
        return 1
    }

    test -d "$SRCDIR/dist/public/nss" || {
        echo "[ERROR] Missing NSS public headers"
        return 1
    }

    #
    # libnssdbm3.so is intentionally absent. Modern NSS uses SQLite.
    #

    for library in \
        libfreebl3.so \
        libfreeblpriv3.so \
        libnss3.so \
        libnsssysinit.so \
        libnssutil3.so \
        libsmime3.so \
        libsoftokn3.so \
        libssl3.so
    do
        if [ ! -f "$DISTDIR/lib/$library" ]; then
            echo "[ERROR] Missing NSS library: $library"
            return 1
        fi
    done

    for binary in \
        certutil \
        modutil \
        pk12util
    do
        if [ ! -x "$DISTDIR/bin/$binary" ]; then
            echo "[ERROR] Missing NSS utility: $binary"
            return 1
        fi
    done

    test -f "$SRCDIR/dist/public/nss/nss.h" || {
        echo "[ERROR] Missing NSS public header: nss.h"
        return 1
    }

    echo "[OK] NSS build payload validated"
}

check() {
    true
}

staging() {
    set -euxo pipefail

    SRCDIR="$SRCROOT/${NAME}-${VERSION}"
    NSSDIR="$SRCDIR/nss"
    DISTDIR="$SRCDIR/dist/Release"

    libdir="/usr/lib"
    includedir="/usr/include/nss"

    nsprver="$(pkg-config --modversion nspr)"

    #
    # NSS 3.130 requires NSPR 4.39 or newer.
    #

    if [ "$(printf '%s\n' "4.39" "$nsprver" | sort -V | head -n1)" != "4.39" ]; then
        echo "[ERROR] NSS $VERSION requires NSPR 4.39 or newer"
        echo "[ERROR] Installed NSPR version: $nsprver"
        return 1
    fi

    install -dm755 \
        "$pkgdir$libdir" \
        "$pkgdir$includedir" \
        "$pkgdir/usr/bin" \
        "$pkgdir/usr/lib/pkgconfig"

    #
    # Install every generated shared library, including NSS loader modules.
    #

    mapfile -t nsslibs < <(
        find "$DISTDIR/lib" \
            -maxdepth 1 \
            -type f \
            -name '*.so' \
            -print
    )

    test "${#nsslibs[@]}" -gt 0

    for library in "${nsslibs[@]}"; do
        install -m755 "$library" "$pkgdir$libdir/"
    done

    #
    # Install all public NSS headers.
    #

    mapfile -t nssheaders < <(
        find "$SRCDIR/dist/public/nss" \
            -maxdepth 1 \
            -type f \
            -name '*.h' \
            -print
    )

    test "${#nssheaders[@]}" -gt 0

    for header in "${nssheaders[@]}"; do
        install -m644 "$header" "$pkgdir$includedir/"
    done

    #
    # Install available command-line utilities.
    #

    for binary in \
        addbuiltin \
        atob \
        btoa \
        certutil \
        cmsutil \
        crlutil \
        derdump \
        modutil \
        nss-policy-check \
        ocspclnt \
        oidcalc \
        p7content \
        p7env \
        p7sign \
        p7verify \
        pk12util \
        pp \
        shlibsign \
        signtool \
        signver \
        ssltap
    do
        if [ -x "$DISTDIR/bin/$binary" ]; then
            install -m755 \
                "$DISTDIR/bin/$binary" \
                "$pkgdir/usr/bin/$binary"
        fi
    done

    #
    # Generate pkg-config metadata.
    #

    sed "$NSSDIR/pkg/pkg-config/nss.pc.in" \
        -e 's,%prefix%,/usr,g' \
        -e 's,%exec_prefix%,${prefix},g' \
        -e "s,%libdir%,$libdir,g" \
        -e "s,%includedir%,$includedir,g" \
        -e "s,%NSPR_VERSION%,$nsprver,g" \
        -e "s,%NSS_VERSION%,$VERSION,g" \
        > "$pkgdir/usr/lib/pkgconfig/nss.pc"

    ln -s nss.pc \
        "$pkgdir/usr/lib/pkgconfig/mozilla-nss.pc"

    #
    # Generate nss-config from the packaged NSS version.
    #

    vmajor="$(
        awk '$2 == "NSS_VMAJOR" { print $3; exit }' \
            "$NSSDIR/lib/nss/nss.h"
    )"

    vminor="$(
        awk '$2 == "NSS_VMINOR" { print $3; exit }' \
            "$NSSDIR/lib/nss/nss.h"
    )"

    vpatch="$(
        awk '$2 == "NSS_VPATCH" { print $3; exit }' \
            "$NSSDIR/lib/nss/nss.h"
    )"

    test -n "$vmajor"
    test -n "$vminor"
    test -n "$vpatch"

    sed "$NSSDIR/pkg/pkg-config/nss-config.in" \
        -e 's,@prefix@,/usr,g' \
        -e 's,@exec_prefix@,/usr,g' \
        -e "s,@libdir@,$libdir,g" \
        -e "s,@includedir@,$includedir,g" \
        -e "s,@MOD_MAJOR_VERSION@,$vmajor,g" \
        -e "s,@MOD_MINOR_VERSION@,$vminor,g" \
        -e "s,@MOD_PATCH_VERSION@,$vpatch,g" \
        > "$pkgdir/usr/bin/nss-config"

    chmod 755 "$pkgdir/usr/bin/nss-config"

    #
    # Use p11-kit's system trust store.
    #

    rm -f "$pkgdir$libdir/libnssckbi.so"

    ln -s pkcs11/p11-kit-trust.so \
        "$pkgdir$libdir/libnssckbi.so"

    #
    # Validate exactly the runtime files this package promises.
    #

    for library in \
        libfreebl3.so \
        libfreeblpriv3.so \
        libnss3.so \
        libnsssysinit.so \
        libnssutil3.so \
        libsmime3.so \
        libsoftokn3.so \
        libssl3.so
    do
        test -f "$pkgdir/usr/lib/$library" || {
            echo "[ERROR] Library was not staged: $library"
            return 1
        }
    done

    test -L "$pkgdir/usr/lib/libnssckbi.so"
    test -f "$pkgdir/usr/include/nss/nss.h"
    test -f "$pkgdir/usr/lib/pkgconfig/nss.pc"
    test -L "$pkgdir/usr/lib/pkgconfig/mozilla-nss.pc"
    test -x "$pkgdir/usr/bin/nss-config"
    test -x "$pkgdir/usr/bin/certutil"
    test -x "$pkgdir/usr/bin/modutil"
    test -x "$pkgdir/usr/bin/pk12util"

    if [ -f "$NSSDIR/COPYING" ]; then
        install -Dm644 \
            "$NSSDIR/COPYING" \
            "$pkgdir/usr/share/licenses/$NAME/COPYING"
    fi
}
