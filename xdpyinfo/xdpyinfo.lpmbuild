#!/bin/bash
# LPM build script for xdpyinfo

NAME="xdpyinfo"
VERSION="1.4.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Display information utility for X"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=("https://www.x.org/archive//individual/app/${NAME}-${VERSION}.tar.xz")

REQUIRES=(
    "glibc"
    "libX11"
    "libXext"
    "libXtst"
    "libxcb"
)

BUILD_REQUIRES=(
    "gcc"
    "make"
    "pkgconf"
    "xorg-util-macros"
    "xorgproto"
    "libX11"
    "libXext"
    "libXtst"
    "libxcb"
)

PROVIDES=("xdpyinfo")
CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  ./configure --prefix=/usr
  make -j"$(nproc)"
}

check() { true; }

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  DESTDIR="$pkgdir" make install
}




# Final audited source digests
SHA256SUMS=("dc1de6e6e091ed46c4837b0ae9811e8182f7be0d2af638cab3e530ff081a48b6")
