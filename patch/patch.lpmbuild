NAME="patch"
VERSION="2.8"
RELEASE="1"
ARCH="x86_64"
SUMMARY="GNU patch utility"
URL="https://www.gnu.org/software/patch/"
SOURCE=("https://ftp.wayne.edu/gnu/patch/patch-${VERSION}.tar.xz")
LICENSE=("GPL-3.0-or-later")

REQUIRES=("glibc")
PROVIDES=("patch")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/patch-${VERSION}"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/patch-${VERSION}"
    ./configure --prefix=/usr --libdir=/usr/lib
    make -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/patch-${VERSION}"
    make DESTDIR="$pkgdir" install
}





# Final audited source digests
SHA256SUMS=("f87cee69eec2b4fcbf60a396b030ad6aa3415f192aa5f7ee84cad5e11f7f5ae3")
