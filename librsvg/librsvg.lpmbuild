#!/bin/bash
NAME="librsvg"
VERSION="2.62.3"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="librsvg upstream package"
URL="https://download.gnome.org/sources/librsvg/2.62/"
LICENSE=("LGPL-2.1-or-later")
SOURCE=("https://download.gnome.org/sources/librsvg/2.62/librsvg-2.62.3.tar.xz")
SHA256SUMS=("7eb449b2722a768021356f66dfee3202c229b54ed4e6a70ce40c090e97ff16f2")
PATCHES=()
REQUIRES=("cairo" "gcc-libs" "gdk-pixbuf2" "glib2" "libxml2" "pango")
BUILD_REQUIRES=("cargo-c" "gobject-introspection" "meson" "ninja" "pkgconf" "rust" "vala")
PROVIDES=("librsvg")
CONFLICTS=()
OBSOLETES=()
BUILD_OPTIONS=("@--stripping" "@--optimize=2")
prepare() { set -euxo pipefail; cd "$SRCROOT/${NAME}-${VERSION}"; }
build() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    meson setup build --prefix=/usr --libdir=lib --buildtype=release --wrap-mode=nodownload -Ddocumentation=false -Dtests=false -Dpixbuf-loader=enabled
    meson compile -C build -j "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    meson install -C build --no-rebuild --destdir "$pkgdir"
    local f
    for f in COPYING COPYING.LIB LICENSE LICENSE.md LICENSE.txt; do
        if [ -f "$f" ]; then install -Dm644 "$f" "$pkgdir/usr/share/licenses/$NAME/$f"; fi
    done
    if [ -d LICENSES ]; then
        install -dm755 "$pkgdir/usr/share/licenses/$NAME"
        cp -a LICENSES/. "$pkgdir/usr/share/licenses/$NAME/"
    fi
}




# Final audited source digests
SHA256SUMS=("7eb449b2722a768021356f66dfee3202c229b54ed4e6a70ce40c090e97ff16f2")
