#!/bin/bash
# LPM build script for Xorg Evdev input driver (xf86-input-evdev)

NAME="xf86-input-evdev"
VERSION="2.10.6"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="X.Org Evdev input driver"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=(
  "https://xorg.freedesktop.org/archive/individual/driver/xf86-input-evdev-${VERSION}.tar.bz2"
)

REQUIRES=(
  "glibc"
  "xorg-server"
  "xorgproto"
  "libevdev"
  "libX11"
  "libXfixes"
  "pkg-config"
  "util-macros"
  "autoconf"
  "automake"
  "libtool"
  "make"
)

PROVIDES=(
  "xf86-input-evdev"
  "xorg-evdev-driver"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="xf86-input-evdev-${VERSION}"

prepare() {
    set -euxo pipefail
    cd "$SRCROOT"
    tar xf "xf86-input-evdev-${VERSION}.tar.bz2"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    ./configure         --prefix=/usr         --libdir=/usr/lib         --with-xorg-module-dir=/usr/lib/xorg/modules

    make -j"$(nproc)"
}

check() {
    true
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    DESTDIR="$pkgdir" make install

    if [ -f COPYING ]; then
        install -Dm644 COPYING "$pkgdir/usr/share/licenses/$NAME/COPYING"
    fi

    if command -v strip >/dev/null 2>&1; then
        find "$pkgdir/usr/lib/xorg/modules" -type f -exec sh -c '
            case "$(file -b "$1")" in
              *ELF*shared\ object*)
                  strip --strip-unneeded "$1" 2>/dev/null || true
              ;;
            esac
        ' _ {} \;
    fi
}
