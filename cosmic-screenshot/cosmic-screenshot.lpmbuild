#!/bin/bash
# LPM build script for cosmic-screenshot

NAME="cosmic-screenshot"
VERSION="1.0.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="COSMIC screenshot tool"
URL="https://github.com/pop-os/cosmic-screenshot"
LICENSE=("GPL-3.0-or-later")

SOURCE=(
  "git+https://github.com/pop-os/cosmic-screenshot.git"
)

# Runtime deps (baseline; adjust per component as you refine)
REQUIRES=(
  "glibc"
  "wayland"
  "libxkbcommon"
  "libinput"
  "libseat"
  "mesa"
  "dbus"
)

# Build deps
REQUIRES+=(
  "rust"
  "cargo"
  "pkg-config"
  "gcc"
)

PROVIDES=(
  "cosmic-screenshot"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="cosmic-screenshot"

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    : "${CARGO_HOME:=$HOME/.cargo}"
    export CARGO_HOME

    cargo build --release --locked
}

check() {
    true
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    # Install main binary; most COSMIC crates use repo name as binary name.
    if [ -f "target/release/cosmic-screenshot" ]; then
        install -Dm755 "target/release/cosmic-screenshot" "$pkgdir/usr/bin/cosmic-screenshot"
    fi

    # Icons, schemas, portals, etc. should be wired in per-component later.

    # Strip
    if command -v strip >/dev/null 2>&1; then
        find "$pkgdir/usr/bin" -type f -exec sh -c '
            case "$(file -b "$1")" in
              *ELF*executable*)
                  strip --strip-unneeded "$1" 2>/dev/null || true
              ;;
            esac
        ' _ {} \;
    fi
}
