#!/bin/bash
NAME="libmd"
VERSION="1.1.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="libmd upstream package"
URL="https://archive.hadrons.org/software/libmd/"
LICENSE=("BSD-3-Clause" "ISC" "MIT")
SOURCE=("https://archive.hadrons.org/software/libmd/libmd-1.1.0.tar.xz")
SHA256SUMS=("1bd6aa42275313af3141c7cf2e5b964e8b1fd488025caf2f971f43b00776b332")
PATCHES=()
REQUIRES=("glibc")
BUILD_REQUIRES=("gcc" "glibc" "make" "pkgconf")
PROVIDES=("libmd")
CONFLICTS=()
OBSOLETES=()
BUILD_OPTIONS=("@--stripping" "@--optimize=2")
prepare() { set -euxo pipefail; cd "$SRCROOT/${NAME}-${VERSION}"; }
build() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    if [ ! -x configure ]; then autoreconf -fiv; fi
    ./configure --prefix=/usr --libdir=/usr/lib --sysconfdir=/etc --disable-static 
    make -j"${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    make DESTDIR="$pkgdir" install
    local f
    for f in COPYING COPYING.LIB LICENSE LICENSE.md LICENSE.txt; do
        if [ -f "$f" ]; then install -Dm644 "$f" "$pkgdir/usr/share/licenses/$NAME/$f"; fi
    done
    if [ -d LICENSES ]; then
        install -dm755 "$pkgdir/usr/share/licenses/$NAME"
        cp -a LICENSES/. "$pkgdir/usr/share/licenses/$NAME/"
    fi
}



# Final audited source digests
SHA256SUMS=("1bd6aa42275313af3141c7cf2e5b964e8b1fd488025caf2f971f43b00776b332")
