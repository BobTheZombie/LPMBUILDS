# LPM build script for libpciaccess
NAME="libpciaccess"
VERSION="0.18.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="X11 PCI access library"
URL="https://gitlab.freedesktop.org/xorg/lib/libpciacces"
LICENSE=""
SOURCE=(https://xorg.freedesktop.org/releases/individual/lib/${NAME}-${VERSION}.tar.xz)
SHA256SUMS=()
REQUIRES=("glibc" "zlib" "xorg-util-macros" "meson")
PROVIDES=("libpciaccess")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
  set -euxo pipefail
  cd "$SRCROOT"
  mkdir build
}

build() {
  set -euxo pipefail
  meson "$NAME"-$VERSION build
  ninja -C build

}

staging() {
  set -euxo pipefail
  DESTDIR="$pkgdir" ninja -C build install
}
