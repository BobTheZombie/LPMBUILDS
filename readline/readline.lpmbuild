#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="readline"
VERSION="8.3"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Line editing library"
URL="https://ftpmirror.gnu.org/readline/readline-8.3.tar.gz"
LICENSE=("GPL-3.0-or-later")
SOURCE=("https://ftpmirror.gnu.org/readline/readline-8.3.tar.gz")
SHA256SUMS=("fe5383204467828cd495ee8d1d3c037a7eba1389c22bc6a041f627976f9061cc")
PATCHES=()
REQUIRES=("glibc" "ncurses")
BUILD_REQUIRES=("gcc" "make" "pkgconf")
PROVIDES=("readline")
CONFLICTS=()
OBSOLETES=()

_srcdir="readline-8.3"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    # Arch FS#14366: do not embed a build-time RPATH.
    sed -i 's|-Wl,-rpath,$(libdir) ||g' support/shobj-conf
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    ./configure --prefix=/usr --disable-static
    make -j"${JOBS:-$(nproc)}"
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    make DESTDIR="$pkgdir" install

    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
