#!/bin/bash
# LPM build script for libsepol
# SELinux policy library (required by libselinux)

NAME="libsepol"
VERSION="3.6"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="SELinux binary policy manipulation library"
URL="https://github.com/SELinuxProject/selinux"
LICENSE=("LGPL-2.1-or-later")

SOURCE=(
  "https://github.com/SELinuxProject/selinux/releases/download/${VERSION}/selinux-${VERSION}.tar.gz"
)

REQUIRES=(
  "glibc"
  "gcc"
  "make"
)

PROVIDES=(
  "libsepol"
  "libsepol.so"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    make -C libsepol -j"$(nproc)" \
        PREFIX=/usr \
        LIBDIR=/usr/lib \
        SHLIBDIR=/usr/lib \
        RANLIB=ranlib
}

check() {
    true
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    make -C libsepol \
        DESTDIR="$pkgdir" \
        PREFIX=/usr \
        LIBDIR=/usr/lib \
        SHLIBDIR=/usr/lib \
        install


    # Strip libs
    if command -v strip >/dev/null 2>&1; then
        find "$pkgdir/usr/lib" -type f -name "*.so*" -exec strip --strip-unneeded {} \; || true
    fi
}

