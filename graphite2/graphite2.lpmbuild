NAME="graphite2"
VERSION="1.3.14"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Font rendering engine for complex scripts"
URL="https://graphite.sil.org/"
SOURCE=("https://github.com/silnrsi/graphite/releases/download/1.3.14/graphite2-${VERSION}.tgz"
)

LICENSE=("LGPL-2.1-or-later" "GPL-2.0-or-later")

REQUIRES=("glibc")
PROVIDES=("graphite2" "libgraphite2.so")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/graphite2-${VERSION}"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/graphite2-${VERSION}"

    cmake -B build -S . \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_STATIC_LIBS=OFF \
        -DCMAKE_POLICY_VERSION_MINIMUM=3.5 \
        -DCMAKE_SKIP_INSTALL_RPATH=ON \
        -DGRAPHITE2_COMPARE_RENDERER=OFF \
        -DINSTALL_PKGCONFIG=ON \
        -DGRAPHITE2_VM_TYPE=direct
        
    cmake --build build -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/graphite2-${VERSION}"
    DESTDIR="$pkgdir" cmake --install build

    # Strip shared libs if present
    find "$pkgdir/usr/lib" -type f -name "*.so*" -exec strip --strip-unneeded {} + 2>/dev/null || true

    # Install license/documentation
    install -Dm644 COPYING -t "$pkgdir/usr/share/licenses/$NAME"
    [ -f README.md ] && install -Dm644 README.md -t "$pkgdir/usr/share/doc/$NAME"
}

