#!/bin/bash
# LPM Linux diagnostics for KDE KInfoCenter
NAME="dmidecode"
VERSION="3.7"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="SMBIOS firmware and hardware details"
URL="https://www.nongnu.org/dmidecode/"
LICENSE=("GPL-2.0-or-later")
SOURCE=("https://download.savannah.gnu.org/releases/dmidecode/dmidecode-3.7.tar.xz")
SHA256SUMS=("SKIP")
PATCHES=()
REQUIRES=("glibc")
BUILD_REQUIRES=("gcc" "make")
PROVIDES=("dmidecode")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/$NAME-$VERSION/Makefile"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    make -C "$src" -j "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    local src="$SRCROOT/$NAME-$VERSION"
    make -C "$src" install prefix=/usr DESTDIR="$pkgdir"
        test -x "$pkgdir/usr/sbin/dmidecode" || test -x "$pkgdir/usr/bin/dmidecode"
}
