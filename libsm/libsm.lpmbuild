# LPM build script for libsm
NAME="libsm"
VERSION="1.2.6"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="X11 Session Management library"
URL="https://www.x.org/"
LICENSE="MIT"
SOURCE=("https://xorg.freedesktop.org/archive/individual/lib/libSM-${VERSION}.tar.xz")
CHECKSUMS=("be7c0abdb15cbfd29ac62573c1c82e877f9d4047ad15321e7ea97d1e43d835be")
REQUIRES=("glibc" "libice" "xorgproto")
PROVIDES=("libsm")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() { set -euxo pipefail; cd "$SRCROOT"; }

build() {
  set -euxo pipefail
  cd "$SRCROOT"
  ./configure --prefix=/usr --sysconfdir=/etc --disable-static
  make -j"$(nproc)"
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT"
  make DESTDIR="$pkgdir" install
}




# Final audited source digests
SHA256SUMS=("be7c0abdb15cbfd29ac62573c1c82e877f9d4047ad15321e7ea97d1e43d835be")
