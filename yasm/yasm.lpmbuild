#!/bin/bash
# LPM build script for Yasm 1.3.0
# GCC 15+ defaults to C23, while Yasm 1.3.0 uses 'false'/'true'
# as enum identifiers. Compile this legacy source with GNU C17.

NAME="yasm"
VERSION="1.3.0"
RELEASE="2"
ARCH="${ARCH:-x86_64}"

SUMMARY="Modular assembler supporting the x86 and AMD64 instruction sets"
URL="https://yasm.tortall.net/"
LICENSE=("BSD-2-Clause" "BSD-3-Clause" "Artistic-1.0" "GPL-2.0-or-later" "LGPL-2.0-or-later")

SOURCE=(
    "https://www.tortall.net/projects/yasm/releases/yasm-${VERSION}.tar.gz"
)

SHA256SUMS=(
    "3dce6601b495f5b3d45b59f7d2492a340ee7e84b5beca17e48f862502bd5603f"
)
PATCHES=()

REQUIRES=(
    "glibc"
)

BUILD_REQUIRES=(
    "make"
)

PROVIDES=(
    "yasm"
)

CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail

    local srcdir="$SRCROOT/yasm-${VERSION}"
    test -x "$srcdir/configure"

    # Clean out-of-tree build avoids stale compiler flags/configuration.
    rm -rf "$SRCROOT/yasm-build"
    mkdir -p "$SRCROOT/yasm-build"
}

build() {
    set -euxo pipefail

    local srcdir="$SRCROOT/yasm-${VERSION}"
    cd "$SRCROOT/yasm-build"

    # Append to existing LPM CPU tuning flags; last -std option wins.
    CFLAGS="${CFLAGS:-} -std=gnu17" \
        "$srcdir/configure" \
        --prefix=/usr \
        --bindir=/usr/bin \
        --libdir=/usr/lib \
        --includedir=/usr/include \
        --mandir=/usr/share/man

    make -j"$(nproc)"
}

check() {
    set -euxo pipefail

    cd "$SRCROOT/yasm-build"
    test -x ./yasm
    ./yasm --version

    # The original recipe treated the old upstream suite as non-fatal.
    # Run it serially and report any failure instead of hiding it entirely.
    if ! make -j1 check; then
        echo "[WARN] Yasm upstream test suite failed; assembler version check passed" >&2
    fi
}

staging() {
    set -euxo pipefail

    cd "$SRCROOT/yasm-build"
    make DESTDIR="$pkgdir" install

    test -x "$pkgdir/usr/bin/yasm"
    if [ -e "$pkgdir/usr/bin/vsyasm" ]; then
        test -x "$pkgdir/usr/bin/vsyasm"
    fi

    if [ -d "$pkgdir/usr/lib" ]; then
        find "$pkgdir/usr/lib" -type f -name '*.la' -delete
    fi

    if [ -f "$SRCROOT/yasm-${VERSION}/COPYING" ]; then
        install -Dm644 \
            "$SRCROOT/yasm-${VERSION}/COPYING" \
            "$pkgdir/usr/share/licenses/yasm/COPYING"
    fi

    echo "==> yasm ${VERSION} staging complete"
}