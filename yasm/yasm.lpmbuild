# LPM build script for Yasm

NAME="yasm"
VERSION="1.3.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"

SUMMARY="Modular assembler supporting the x86 and AMD64 instruction sets"
URL="https://yasm.tortall.net/"
LICENSE=("BSD-2-Clause" "BSD-3-Clause" "Artistic-1.0" "GPL-2.0-or-later" "LGPL-2.0-or-later")

SOURCE=(
    "https://www.tortall.net/projects/yasm/releases/yasm-${VERSION}.tar.gz"
)

SHA256SUMS=("SKIP")
PATCHES=()

REQUIRES=(
    "glibc"
)

BUILD_REQUIRES=(
    "make"
)

PROVIDES=(
    "yasm"
)

CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail

    cd "$SRCROOT/yasm-${VERSION}"

    # Use an out-of-tree build.
    rm -rf "$SRCROOT/yasm-build"
    mkdir -p "$SRCROOT/yasm-build"
}

build() {
    set -euxo pipefail

    cd "$SRCROOT/yasm-build"

    "$SRCROOT/yasm-${VERSION}/configure" \
        --prefix=/usr \
        --bindir=/usr/bin \
        --libdir=/usr/lib \
        --includedir=/usr/include \
        --mandir=/usr/share/man

    make -j"$(nproc)"
}

check() {
    set -euxo pipefail

    cd "$SRCROOT/yasm-build"

    make check || true
}

staging() {
    set -euxo pipefail

    cd "$SRCROOT/yasm-build"

    make DESTDIR="$pkgdir" install

    #
    # Main assembler
    #

    test -x "$pkgdir/usr/bin/yasm"

    #
    # Yasm also provides vsyasm.
    #

    if [ -e "$pkgdir/usr/bin/vsyasm" ]; then
        test -x "$pkgdir/usr/bin/vsyasm"
    fi

    #
    # Development files
    #

    if [ -d "$pkgdir/usr/include" ]; then
        find "$pkgdir/usr/include" -type f -print
    fi

    #
    # Remove libtool archives.
    #

    find "$pkgdir/usr/lib" \
        -type f \
        -name '*.la' \
        -delete 2>/dev/null || true

    #
    # License
    #

    if [ -f "$SRCROOT/yasm-${VERSION}/COPYING" ]; then
        install -Dm644 \
            "$SRCROOT/yasm-${VERSION}/COPYING" \
            "$pkgdir/usr/share/licenses/yasm/COPYING"
    fi

    echo "==> yasm ${VERSION} staging complete"
}
