#!/bin/bash
# LPM networking stack, release snapshot 2026-10-16
NAME="networkmanager"
VERSION="1.58.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY='NetworkManager Ethernet Wi-Fi DHCP IPv4 IPv6 and nmcli'
URL=https://gitlab.freedesktop.org/NetworkManager/NetworkManager/-/releases/1.58.1/downloads/NetworkManager-1.58.1.tar.xz
LICENSE=(GPL-2.0-or-later)
SOURCE=(https://gitlab.freedesktop.org/NetworkManager/NetworkManager/-/releases/1.58.1/downloads/NetworkManager-1.58.1.tar.xz)
SHA256SUMS=(
    "262864cfd198123d3e5dbe91937441b97ee9059d6d712e1a5bfbb1c54668d14d"
)
PATCHES=()
REQUIRES=(glibc glib2 systemd dbus libndp gnutls readline polkit audit wpa_supplicant iproute2 dnsmasq nftables ca-certificates)
BUILD_REQUIRES=(gcc meson ninja pkgconf gettext python gobject-introspection glib2 systemd dbus libndp gnutls readline polkit audit curl)
PROVIDES=(networkmanager NetworkManager libnm.so)
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
BUILD_OPTIONS=(@--stripping @--optimize=2)

_source() {
    if [ ! -d "$SRCROOT/${NAME}-${VERSION}" ] && [ -d "$SRCROOT/NetworkManager-1.58.1" ]; then
        mv "$SRCROOT/NetworkManager-1.58.1" "$SRCROOT/${NAME}-${VERSION}"
    fi
}

_licenses() {
    local f
    for f in COPYING COPYING.LIB LICENSE LICENSE.txt LICENCE README; do
        if [ -f "$f" ]; then
            install -Dm644 "$f" "$pkgdir/usr/share/licenses/$NAME/$(basename "$f")"
        fi
    done
}
_cleanup() {
    if [ -d "$pkgdir/usr/lib" ]; then
        find "$pkgdir/usr/lib" -type f \( -name '*.a' -o -name '*.la' \) -delete
    fi
    rm -f "$pkgdir/usr/share/info/dir"
}

prepare() { set -euxo pipefail; _source; cd "$SRCROOT/${NAME}-${VERSION}"; rm -rf _build; }
build() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    meson setup _build --prefix=/usr --sbindir=bin --libdir=lib \
        --libexecdir=lib/NetworkManager --sysconfdir=/etc --localstatedir=/var \
        --buildtype=release --wrap-mode=nodownload \
        -Dsystemdsystemunitdir=/usr/lib/systemd/system -Dudev_dir=/usr/lib/udev \
        -Ddbus_conf_dir=/usr/share/dbus-1/system.d -Druntime_dir=/run \
        -Dkernel_firmware_dir=/usr/lib/firmware -Dsession_tracking=systemd \
        -Dsuspend_resume=systemd -Dpolkit=true -Dselinux=false -Dlibaudit=yes \
        -Dcrypto=gnutls -Dwifi=true -Diwd=false -Dppp=false -Dmodem_manager=false \
        -Dovs=false -Dteamdctl=false -Dnbft=false -Dclat=false -Debpf=false \
        -Dnmcli=true -Dnmtui=false -Dnm_cloud_setup=false -Dreadline=libreadline \
        -Dconfig_dhcp_default=internal -Dconfig_wifi_backend_default=wpa_supplicant \
        -Dconfig_dns_rc_manager_default=file -Dconfig_logging_backend_default=journal \
        -Ddnsmasq=/usr/bin/dnsmasq -Dnft=/usr/bin/nft -Dmodprobe=/usr/bin/modprobe \
        -Dlibpsl=false -Dintrospection=true -Dvapi=false -Dqt=false \
        -Ddocs=false -Dman=false -Dtests=no -Dfirewalld_zone=false -Dmore_logging=false
    meson compile -C _build -j "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    meson install -C _build --no-rebuild --destdir "$pkgdir"
    test -x "$pkgdir/usr/bin/NetworkManager"
    test -x "$pkgdir/usr/bin/nmcli"
    test -f "$pkgdir/usr/lib/systemd/system/NetworkManager.service"
    test -s "$pkgdir/usr/lib/pkgconfig/libnm.pc"
    _cleanup
    _licenses
}


PROVIDES+=("libnm" "libnm.so.0")




# Final audited source digests
SHA256SUMS=("262864cfd198123d3e5dbe91937441b97ee9059d6d712e1a5bfbb1c54668d14d")
