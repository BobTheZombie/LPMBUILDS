#!/bin/bash
NAME="libxkbfile"
VERSION="1.1.3"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="libxkbfile from X.Org"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=(
  "https://www.x.org/releases/individual/lib/libxkbfile-1.1.3.tar.xz"
)

REQUIRES=(
  "glibc"
  "libX11"
)

PROVIDES=("libxkbfile")
CONFLICTS=()
OBSOLETES=()

_srcdir="libxkbfile-1.1.3"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT"
  tar xf "libxkbfile-1.1.3.tar.xz"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  ./configure --prefix=/usr
  make -j"$(nproc)"
}

check() { true; }

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  DESTDIR="$pkgdir" make install
  [ -f COPYING ] && install -Dm644 COPYING "$pkgdir/usr/share/licenses/$NAME/COPYING"
}
