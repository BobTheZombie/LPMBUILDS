#!/bin/bash
# LPM build script for libxkbfile

NAME="libxkbfile"
VERSION="1.2.0"
RELEASE="2"
ARCH="${ARCH:-x86_64}"

SUMMARY="X.Org keyboard configuration file library"
URL="https://www.x.org/"
LICENSE=("MIT")

SOURCE=(
    "https://www.x.org/releases/individual/lib/libxkbfile-${VERSION}.tar.xz"
)

SHA256SUMS=(
    "7f71884e5faf56fb0e823f3848599cf9b5a9afce51c90982baeb64f635233ebf"
)

PATCHES=()

REQUIRES=(
    "glibc"
    "libX11"
)

BUILD_REQUIRES=(
    "gcc"
    "meson"
    "ninja"
    "pkgconf"
    "libX11"
    "xorgproto"
)

PROVIDES=(
    "libxkbfile"
    "libxkbfile.so"
    "libxkbfile.so.1"
)

CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

BUILD_OPTIONS=(
    "@--stripping"
    "@--optimize=2"
)

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    test -f meson.build
    test -f COPYING
    rm -rf build
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        --wrap-mode=nodownload \
        -Ddefault_library=shared

    meson compile -C build \
        -j "${LPM_BUILD_JOBS:-$(nproc)}"
}

check() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    meson test -C build --no-rebuild --print-errorlogs
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    meson install -C build \
        --no-rebuild \
        --destdir "$pkgdir"

    test -e "$pkgdir/usr/lib/libxkbfile.so"
    test -e "$pkgdir/usr/lib/libxkbfile.so.1"
    test -s "$pkgdir/usr/lib/pkgconfig/xkbfile.pc"
    test -f "$pkgdir/usr/include/X11/extensions/XKBfile.h"

    install -Dm644 COPYING \
        "$pkgdir/usr/share/licenses/$NAME/COPYING"
}