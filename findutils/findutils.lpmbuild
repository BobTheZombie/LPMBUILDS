#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="findutils"
VERSION="4.11.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="GNU find, xargs, locate"
URL="https://ftpmirror.gnu.org/findutils/findutils-4.11.0.tar.xz"
LICENSE=("GPL-3.0-or-later")
SOURCE=("https://ftpmirror.gnu.org/findutils/findutils-4.11.0.tar.xz")
SHA256SUMS=("bfd19cb06cc71f3352d567e90284d8cdac02ac89774bbeadf0b533b0c11432fd")
PATCHES=()
REQUIRES=("glibc")
BUILD_REQUIRES=("gcc" "make" "pkgconf")
PROVIDES=("findutils")
CONFLICTS=()
OBSOLETES=()

_srcdir="findutils-4.11.0"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    :
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    ./configure --prefix=/usr
    make -j"${JOBS:-$(nproc)}"
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    make DESTDIR="$pkgdir" install

    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
