#!/bin/bash
NAME="libyuv"
VERSION="0.0.20261020"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="YUV conversion and scaling library"
URL="https://chromium.googlesource.com/libyuv/libyuv/"
LICENSE=("BSD-3-Clause")
SOURCE=("${NAME}-${VERSION}::git+https://chromium.googlesource.com/libyuv/libyuv#commit=64ddbbcddebb945be8c37253978d28af1033b5be")
SHA256SUMS=("SKIP")
PATCHES=()
REQUIRES=("glibc" "gcc-libs" "libjpeg")
BUILD_REQUIRES=("git" "cmake" "ninja" "gcc" "libjpeg")
PROVIDES=("libyuv" "libyuv.so")
CONFLICTS=()
OBSOLETES=()
prepare() { set -euxo pipefail; cd "$SRCROOT/${NAME}-${VERSION}"; test -f CMakeLists.txt; }
build() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    cmake -S . -B build -G Ninja -DCMAKE_INSTALL_PREFIX=/usr -DCMAKE_INSTALL_LIBDIR=lib -DCMAKE_BUILD_TYPE=Release
    cmake --build build --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    DESTDIR="$pkgdir" cmake --install build
    find "$pkgdir/usr/lib" -type f -name '*.a' -delete
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$NAME/LICENSE"
}




# Final audited source digests
SHA256SUMS=("SKIP")
