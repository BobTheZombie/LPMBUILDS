NAME="dconf"
VERSION="0.49.0"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Simple key-based configuration storage system"
URL="https://wiki.gnome.org/Projects/dconf"
SOURCE=("git+https://gitlab.gnome.org/GNOME/dconf.git#tag=$VERSION"
        "dconf-update.hook"
        "dconf-update.script"
        "dconf.install"
)

LICENSE=("LGPL-2.1-or-later")

REQUIRES=("bash"
          "gcc-libs"
          "bash-completion"
          "glib2" 
          "dbus"
          "meson"
          "python"
          "systemd"
)
          
PROVIDES=("dconf" "dconf-service" "libdconf.so")
CONFLICTS=()
OBSOLETES=()

install=dconf.install

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/dconf"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/dconf"
    meson setup build \
        --prefix=/usr \
        --libdir=lib \
        -Dgtk_doc=false \
        -Dvapi=false \
        -Dman=false
    ninja -C build -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/dconf"
    DESTDIR="$pkgdir" ninja -C build install

    # Ensure runtime dirs
    install -d "$pkgdir/etc/dconf/db"
    install -d "$pkgdir/etc/dconf/profile"

    # Default profile (system-wide + user)
    cat > "$pkgdir/etc/dconf/profile/user" <<'EOF'
user-db:user
system-db:local
EOF

install -Dm644 $SRCROOT/dconf-update.hook -t "$pkgdir/usr/share/liblpm/hooks"
install -D $SRCROOT/dconf-update.script "$pkgdir/usr/libexec/lpm/hooks/dconf-update"

# Prevent removal of /etc/dconf/db/ when other
# packages installing files there get uninstalled
install -Dm644 /dev/null "$pkgdir/etc/dconf/db/.placeholder"

}

