#!/bin/bash

NAME="re2"
VERSION="2025-11-05"
RELEASE="1"
ARCH="${ARCH:-x86_64}"

SUMMARY="RE2: fast, safe regular expression library"
URL="https://github.com/google/re2"
LICENSE=("BSD-3-Clause")

SOURCE=(
    "${NAME}-${VERSION}::git+https://github.com/google/re2.git#tag=${VERSION}"
)
SHA256SUMS=()
PATCHES=()

REQUIRES=(
    "glibc"
    "abseil-cpp"
)
BUILD_REQUIRES=(
    "abseil-cpp"
    "cmake"
    "gcc"
    "ninja"
    "pkgconf"
)
PROVIDES=(
    "re2"
    "libre2.so"
)
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    test -f CMakeLists.txt
    test -f re2/re2.h
    rm -rf build
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    # Use LPM's installed Abseil, not a bundled replacement.
    test -f /usr/lib/cmake/absl/abslConfig.cmake

    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DCMAKE_INSTALL_LIBDIR=lib \
        -DCMAKE_CXX_STANDARD=17 \
        -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
        -DBUILD_SHARED_LIBS=ON \
        -DRE2_INSTALL=ON \
        -DRE2_USE_ICU=OFF \
        -DRE2_BUILD_TESTING=OFF \
        -DRE2_TEST=OFF \
        -DRE2_BENCHMARK=OFF \
        -DCMAKE_PREFIX_PATH=/usr

    cmake --build build --parallel "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    DESTDIR="$pkgdir" cmake --install build

    test -f "$pkgdir/usr/include/re2/re2.h"
    test -f "$pkgdir/usr/lib/cmake/re2/re2Config.cmake"
    test -f "$pkgdir/usr/lib/pkgconfig/re2.pc"
    compgen -G "$pkgdir/usr/lib/libre2.so*" > /dev/null

    if [ -f LICENSE ]; then
        install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$NAME/LICENSE"
    fi
}
