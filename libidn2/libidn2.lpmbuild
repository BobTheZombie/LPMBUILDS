NAME="libidn2"
VERSION="2.3.8"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Internationalized Domain Names (IDNA2008) library"
URL="https://www.gnu.org/software/libidn/"
SOURCE=("https://ftp.wayne.edu/gnu/libidn/libidn2-${VERSION}.tar.gz")
LICENSE=("GPL-2.0-or-later" "LGPL-3.0-or-later")

REQUIRES=("glibc" "libunistring")
PROVIDES=("libidn2")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/libidn2-${VERSION}"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/libidn2-${VERSION}"
    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --disable-static
    make -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/libidn2-${VERSION}"
    make DESTDIR="$pkgdir" install
}





