#!/bin/bash
# LPM build script for font-util

NAME="font-util"
VERSION="1.4.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="X.Org font utilities (bdftruncate, ucs2any)"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=(
  "https://www.x.org/releases/individual/font/font-util-${VERSION}.tar.xz"
)

REQUIRES=(
  "glibc"
  "util-macros"
  "pkg-config"
  "autoconf"
  "automake"
  "libtool"
  "make"
)

PROVIDES=("font-util")
CONFLICTS=()
OBSOLETES=()

_srcdir="font-util-${VERSION}"

prepare() {
    set -euxo pipefail
    cd "$SRCROOT"
    tar xf "font-util-${VERSION}.tar.xz"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    ./configure --prefix=/usr
    make -j"$(nproc)"
}

check() {
    true
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    DESTDIR="$pkgdir" make install

    if [ -f COPYING ]; then
        install -Dm644 COPYING "$pkgdir/usr/share/licenses/$NAME/COPYING"
    fi
}
