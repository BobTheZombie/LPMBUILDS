#!/bin/bash
# LPM build script for lpm-filesystem

NAME="lpm-filesystem"
VERSION="1.0.0"
RELEASE="3"
ARCH="any"
SUMMARY="Filesystem layout and system integration for LPM"
URL="https://gitlab.com/lpm-org/packages"
LICENSE=("MIT")

SOURCE=(
  "lpm.sysusers"
  "lpm.tmpfiles"
  "lpm.conf"
  "official.repo"
  "README.md"
)

SHA256SUMS=("SKIP" "SKIP" "SKIP" "SKIP" "SKIP")

REQUIRES=()

BUILD_REQUIRES=()

PROVIDES=(
  "lpm-filesystem"
  "lpm-base-layout"
  "filesystem"
  "fhs-filesystem"
)

CONFLICTS=()
OBSOLETES=("filesystem")

prepare() { true; }
build() { true; }
check() { true; }

staging() {
  set -euxo pipefail

  install -dm755 "$pkgdir"/{boot,dev,etc,home,media,mnt,opt,proc,run,srv,sys,usr,var}
  install -dm755 "$pkgdir/usr"/{bin,lib,libexec,include,src,share,local}
  install -dm755 "$pkgdir/etc"/{skel,profile.d,ld.so.conf.d}
  install -dm750 "$pkgdir/root"
  install -dm1777 "$pkgdir/tmp" "$pkgdir/var/tmp"
  ln -sfn usr/bin "$pkgdir/bin"
  ln -sfn usr/bin "$pkgdir/sbin"
  ln -sfn usr/lib "$pkgdir/lib"
  ln -sfn usr/lib "$pkgdir/lib64"
  ln -sfn bin "$pkgdir/usr/sbin"
  ln -sfn ../run/lock "$pkgdir/var/lock"
  ln -sfn ../run "$pkgdir/var/run"


  install -dm755 "$pkgdir/etc/lpm"
  install -dm755 "$pkgdir/etc/lpm/repos.d"
  install -dm755 "$pkgdir/etc/lpm/hooks.d"
  install -dm755 "$pkgdir/etc/lpm/makeflags.d"

  install -dm755 "$pkgdir/var/lib/lpm"
  install -dm755 "$pkgdir/var/lib/lpm/db"
  install -dm755 "$pkgdir/var/lib/lpm/local"
  install -dm755 "$pkgdir/var/lib/lpm/sync"
  install -dm755 "$pkgdir/var/lib/lpm/transactions"
  install -dm755 "$pkgdir/var/lib/lpm/locks"

  install -dm775 "$pkgdir/var/cache/lpm"
  install -dm775 "$pkgdir/var/cache/lpm/sources"
  install -dm775 "$pkgdir/var/cache/lpm/packages"
  install -dm775 "$pkgdir/var/cache/lpm/lpmbuilds"
  install -dm775 "$pkgdir/var/cache/lpm/build"
  install -dm775 "$pkgdir/var/cache/lpm/logs"

  install -dm755 "$pkgdir/var/log/lpm"

  install -dm755 "$pkgdir/usr/share/lpm"
  install -dm755 "$pkgdir/usr/share/lpm/hooks"
  install -dm755 "$pkgdir/usr/share/lpm/templates"
  install -dm755 "$pkgdir/usr/share/lpm/scripts"
  install -dm755 "$pkgdir/usr/share/lpm/licenses"

  install -dm1777 "$pkgdir/tmp/lpm-build"


  install -Dm644 "$SRCROOT/official.repo" "$pkgdir/etc/lpm/repos.d/official.repo"
  install -Dm644 "$SRCROOT/README.md" "$pkgdir/usr/share/doc/lpm-filesystem/README.md"

  touch "$pkgdir/var/lib/lpm/db/.keep"
  touch "$pkgdir/var/lib/lpm/local/.keep"
  touch "$pkgdir/var/lib/lpm/sync/.keep"
  touch "$pkgdir/var/lib/lpm/transactions/.keep"
  touch "$pkgdir/var/cache/lpm/sources/.keep"
  touch "$pkgdir/var/cache/lpm/packages/.keep"
  touch "$pkgdir/var/cache/lpm/lpmbuilds/.keep"
  touch "$pkgdir/var/log/lpm/.keep"

  test -d "$pkgdir/var/lib/lpm/db"
  test -d "$pkgdir/var/cache/lpm/sources"

  install -Dm644 "$SRCROOT/os-release" "$pkgdir/usr/lib/os-release"
  ln -sfn ../usr/lib/os-release "$pkgdir/etc/os-release"
  local file
  for file in issue motd nsswitch.conf shells profile; do
    install -Dm644 "$SRCROOT/$file" "$pkgdir/usr/share/factory/etc/$file"
  done

  # Defaults for installers and first-boot provisioning. Never overwrite
  # /etc/{hostname,locale.conf,vconsole.conf} from a package transaction.
  # systemd-vconsole-setup reads /etc/vconsole.conf on the booted system.
  cat > "$pkgdir/usr/share/factory/etc/vconsole.conf" <<'EOF'
# LPM Linux default US virtual-console keyboard
KEYMAP=us
# Leave FONT unset: use the kernel's built-in console font unless
# an installed kbd console font has explicitly been selected.
EOF

  cat > "$pkgdir/usr/share/factory/etc/locale.conf" <<'EOF'
# LPM Linux UTF-8 fallback locale (no locale-gen required).
LANG=C.UTF-8
EOF

  for file in issue motd vconsole.conf locale.conf; do
    test -s "$pkgdir/usr/share/factory/etc/$file"
  done
  test ! -e "$pkgdir/etc/hostname"
  test ! -e "$pkgdir/etc/vconsole.conf"
  test ! -e "$pkgdir/etc/locale.conf"
}
SOURCE+=("os-release" "issue" "motd" "nsswitch.conf" "shells" "profile")




