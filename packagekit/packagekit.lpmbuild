#!/bin/bash
# PackageKit provides DBus API/specs required by PackageKitQt6.
# Backend is deliberately dummy, not an LPM package-management backend.
NAME="packagekit"
VERSION="1.4.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="PackageKit D-Bus package service and interface specifications (dummy backend)"
URL="https://github.com/PackageKit/PackageKit"
LICENSE=("LGPL-2.1-or-later")
SOURCE=("https://www.freedesktop.org/software/PackageKit/releases/PackageKit-${VERSION}.tar.xz")
SHA256SUMS=("09164faec92ad38dcec248339f7fc83c7a74e484e0a4105ebce3a3a41b172364")
PATCHES=()
REQUIRES=("glibc" "glib2" "sqlite" "polkit" "jansson" "systemd")
BUILD_REQUIRES=("meson" "ninja" "pkgconf" "gcc" "glib2" "sqlite" "polkit"
                "jansson" "gettext" "systemd")
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=()
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()
prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/meson.build"
}
build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    meson setup "$src/build" "$src" \
        --prefix=/usr --libdir=lib --buildtype=release --wrap-mode=nodownload \
        -Dpackaging_backend=dummy \
        -Dsystemd=true -Doffline_update=true -Delogind=false \
        -Ddaemon_tests=false -Dgobject_introspection=false \
        -Dgstreamer_plugin=false -Dgtk_module=false \
        -Dpython_backend=false -Dcron=false \
        -Dbash_command_not_found=false -Dman_pages=false
    meson compile -C "$src/build" -j "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    DESTDIR="$pkgdir" meson install -C "$src/build" --no-rebuild
    test -f "$pkgdir/usr/share/dbus-1/interfaces/org.freedesktop.PackageKit.xml"
    test -f "$pkgdir/usr/share/dbus-1/interfaces/org.freedesktop.PackageKit.Transaction.xml"
}
