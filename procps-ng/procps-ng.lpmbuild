NAME="procps-ng"
VERSION="4.0.7"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Utilities for monitoring processes and system resources"
URL="https://gitlab.com/procps-ng/procps"
SOURCE=("https://sourceforge.net/projects/procps-ng/files/Production/procps-ng-${VERSION}.tar.xz")
LICENSE=("GPL-2.0-or-later" "LGPL-2.1-or-later")

REQUIRES=("glibc" "ncurses" "systemd")
PROVIDES=("procps-ng" "ps" "top" "vmstat" "free")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/procps-ng-${VERSION}"
    autoreconf -fi
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/procps-ng-${VERSION}"
    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --disable-static \
        --with-systemd \
        LIBS="-lsystemd"
    make -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/procps-ng-${VERSION}"
    make DESTDIR="$pkgdir" install
}





