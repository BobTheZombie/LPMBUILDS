#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="procps-ng"
VERSION="4.0.7"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Utilities for monitoring processes and system resources"
URL="https://sourceforge.net/projects/procps-ng/files/Production/procps-ng-4.0.7.tar.xz"
LICENSE=("GPL-2.0-or-later" "LGPL-2.1-or-later")
SOURCE=("https://sourceforge.net/projects/procps-ng/files/Production/procps-ng-4.0.7.tar.xz")
SHA256SUMS=("9d2021f47a4501c667862c9942a92d1953694b21d11bcd1702e83eb594e3d67d")
PATCHES=()
REQUIRES=("glibc" "ncurses" "systemd")
BUILD_REQUIRES=("gcc" "make" "pkgconf")
PROVIDES=("procps-ng")
CONFLICTS=()
OBSOLETES=()

_srcdir="procps-ng-4.0.7"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    :
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    ./configure --prefix=/usr --disable-static --disable-kill --enable-watch8bit --with-systemd
    make -j"${JOBS:-$(nproc)}"
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    make DESTDIR="$pkgdir" install

    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
