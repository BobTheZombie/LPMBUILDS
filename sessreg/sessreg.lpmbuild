#!/bin/bash
# LPM build script for sessreg

NAME="sessreg"
VERSION="1.1.4"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Manage utmp/wtmp entries for non-init clients"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=("https://www.x.org/releases/individual/app/${NAME}-${VERSION}.tar.xz")

REQUIRES=("glibc")

PROVIDES=("sessreg")
CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  ./configure --prefix=/usr
  make -j"$(nproc)"
}

check() { true; }

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  DESTDIR="$pkgdir" make install
}
