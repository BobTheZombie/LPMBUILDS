#!/bin/bash
NAME="libfontenc"
VERSION="1.1.8"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="libfontenc from X.Org"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=(
  "https://www.x.org/releases/individual/lib/libfontenc-1.1.8.tar.xz"
)

REQUIRES=(
  "glibc"
  "zlib"
)

PROVIDES=("libfontenc")
CONFLICTS=()
OBSOLETES=()

_srcdir="libfontenc-1.1.8"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT"
  tar xf "libfontenc-1.1.8.tar.xz"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  ./configure --prefix=/usr
  make -j"$(nproc)"
}

check() { true; }

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  DESTDIR="$pkgdir" make install
  [ -f COPYING ] && install -Dm644 COPYING "$pkgdir/usr/share/licenses/$NAME/COPYING"
}
