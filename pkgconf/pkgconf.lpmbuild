#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="pkgconf"
VERSION="3.0.5"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Package compiler and linker metadata toolkit"
URL="https://distfiles.ariadne.space/pkgconf/pkgconf-3.0.5.tar.xz"
LICENSE=("GPL-3.0-or-later")
SOURCE=("https://distfiles.ariadne.space/pkgconf/pkgconf-3.0.5.tar.xz")
SHA256SUMS=("3acd3a8a3cce65a8d620321855d92fb602e026cbe8e13ee36bdec58483b59ace")
PATCHES=()
REQUIRES=("glibc")
BUILD_REQUIRES=("gcc" "make" "pkgconf")
PROVIDES=("pkgconf" "pkg-config")
CONFLICTS=()
OBSOLETES=()

_srcdir="pkgconf-3.0.5"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    :
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    ./configure --prefix=/usr
    make -j"${JOBS:-$(nproc)}"
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    make DESTDIR="$pkgdir" install
    ln -sf pkgconf "$pkgdir/usr/bin/pkg-config"
    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
