#!/bin/bash
# LPM build script for qt6-declarative

NAME="qt6-declarative"
VERSION="6.7.2"
RELEASE="2"
ARCH="${ARCH:-x86_64}"
SUMMARY="Qt 6 QML and Quick modules"
URL="https://www.qt.io/"
LICENSE=("GPL-3.0-only" "LGPL-3.0-only" "GPL-2.0-only")

SOURCE=(
  "https://download.qt.io/archive/qt/6.7/${VERSION}/submodules/qtdeclarative-everywhere-src-${VERSION}.tar.xz"
)

SHA256SUMS=("SKIP")

BUILD_REQUIRES=(
  "qt6-base"
  "cmake"
  "ninja"
  "perl"
  "python"
  "pkgconf"
  "mesa"
  "wayland"
  "libxkbcommon"
)

REQUIRES=(
  "qt6-base"
  "glibc"
  "mesa"
  "wayland"
  "libxkbcommon"
)

PROVIDES=(
  "qt6-declarative"
  "Qt6Qml"
  "Qt6Quick"
  "Qt6QmlIntegration"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  rm -rf build
  mkdir -p build
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir/build"

  qt-configure-module .. -- \
  -DCMAKE_BUILD_TYPE=Release \
  -DBUILD_SHARED_LIBS=ON \
  -DQT_BUILD_EXAMPLES=OFF \
  -DQT_BUILD_TESTS=OFF

  ninja
}

check() {
  true
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir/build"

  DESTDIR="$pkgdir" ninja install

  for f in LICENSES/* LICENSE*; do
    if [ -f "$SRCROOT/$_srcdir/$f" ]; then
      install -Dm644 "$SRCROOT/$_srcdir/$f" \
        "$pkgdir/usr/share/licenses/$NAME/$(basename "$f")"
    fi
  done
}