# LPM Linux source build: appstream
NAME="appstream"
VERSION="1.2.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Application metadata, appstreamcli and library"
URL="https://www.freedesktop.org/software/appstream"
LICENSE=("LGPL-2.1-or-later")
SOURCE=("https://www.freedesktop.org/software/appstream/releases/AppStream-1.2.1.tar.xz")
SHA256SUMS=("SKIP")
PATCHES=()
BUILD_REQUIRES=("meson" "ninja" "pkgconf" "glib2" "curl" "libfyaml" "libxmlb" "libxml2" "libxslt" "itstool")
REQUIRES=("glib2" "curl" "libfyaml" "libxmlb" "libxml2")
PROVIDES=("appstream")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
  set -euo pipefail
  cd "$SRCROOT"
  :
}

build() {
  set -euo pipefail
  cd "$SRCROOT"
  meson setup build --prefix=/usr --libdir=lib --buildtype=release --wrap-mode=nodownload \
    -Ddocs=false -Dapidocs=false -Dstemming=false
  ninja -C build -j "${LPM_BUILD_JOBS:-6}"
}

staging() {
  set -euo pipefail
  cd "$SRCROOT"
  DESTDIR="$pkgdir" ninja -C build install
}
