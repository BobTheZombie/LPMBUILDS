#!/bin/bash
# LPM build script for grim

NAME="grim"
VERSION="1.4.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Grab images from a Wayland compositor"
URL="https://sr.ht/~emersion/grim/"
LICENSE=("MIT")

SOURCE=(
  "https://git.sr.ht/~emersion/grim/archive/v${VERSION}.tar.gz"
)

REQUIRES=(
  "glibc"
  "cairo"
  "libjpeg-turbo"
  "libpng"
  "pixman"
  "wayland"
)

BUILD_REQUIRES=(
  "meson"
  "ninja"
  "pkgconf"
  "wayland-protocols"
  "scdoc"
)

PROVIDES=(
  "grim"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  rm -rf build

  meson setup build \
    --prefix=/usr \
    --libdir=lib \
    --buildtype=release

  meson compile -C build
}

check() {
  true
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  DESTDIR="$pkgdir" meson install -C build

  test -f "$pkgdir/usr/bin/grim"

  for f in LICENSE COPYING; do
    if [ -f "$f" ]; then
      install -Dm644 "$f" \
        "$pkgdir/usr/share/licenses/$NAME/$f"
    fi
  done
}



# Final audited source digests
SHA256SUMS=("5ed8e70fcd83a7e203e92d34dbb82a1342d3f13ad98a6b0310cc97e1a9342ded")
