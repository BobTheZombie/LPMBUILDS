NAME="libgpg-error"
VERSION="1.61"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Common error codes and descriptions used by GnuPG components"
URL="https://www.gnupg.org/software/libgpg-error/"
SOURCE=("https://www.gnupg.org/ftp/gcrypt/libgpg-error/libgpg-error-${VERSION}.tar.bz2")
LICENSE=("LGPL-2.1-or-later" "GPL-2.0-or-later")

REQUIRES=("glibc")
PROVIDES=("libgpg-error" "libgpg-error.so")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/libgpg-error-${VERSION}"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/libgpg-error-${VERSION}"
    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --disable-static
    make -j"$(nproc)"
}

check() {
    set -euxo pipefail
    cd "$SRCROOT/libgpg-error-${VERSION}"
    make check || true
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/libgpg-error-${VERSION}"
    make DESTDIR="$pkgdir" install
}





# Final audited source digests
SHA256SUMS=("7a85413f2bc354f4f8aa832b718af122e48965e9e0eb9012ee659c13c6385c93")
