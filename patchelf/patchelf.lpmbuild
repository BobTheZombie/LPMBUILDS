#!/bin/bash
# LPM build script for patchelf

NAME="patchelf"
VERSION="0.19.2"
RELEASE="1"
ARCH="${ARCH:-x86_64}"

SUMMARY="Modify dynamic linker and RPATH settings of ELF binaries"
URL="https://github.com/NixOS/patchelf"
LICENSE=("GPL-3.0-or-later")

SOURCE=(
    "https://github.com/NixOS/patchelf/releases/download/${VERSION}/patchelf-${VERSION}.tar.gz"
)

SHA256SUMS=(
    "78cb26bda2b89fababfe189c2f6507240340f1aa45dec2eb49a39473a50ceea1"
)

PATCHES=()

REQUIRES=(
    "gcc-libs"
    "glibc"
)

BUILD_REQUIRES=(
    "binutils"
    "gcc"
    "make"
)

PROVIDES=("patchelf")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

BUILD_OPTIONS=(
    "@--stripping"
    "@--optimize=2"
)

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    test -x configure
    test -f src/patchelf.cc
    test -f COPYING

    if [ -f Makefile ]; then
        make distclean
    fi
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    ./configure \
        --prefix=/usr \
        --bindir=/usr/bin \
        --mandir=/usr/share/man \
        --docdir="/usr/share/doc/${NAME}"

    make -j"${LPM_BUILD_JOBS:-$(nproc)}"
}

check() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    make -j"${LPM_BUILD_JOBS:-$(nproc)}" check
    ./src/patchelf --version
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"

    make -j1 DESTDIR="$pkgdir" install

    test -x "$pkgdir/usr/bin/patchelf"
    test -f "$pkgdir/usr/share/man/man1/patchelf.1"

    "$pkgdir/usr/bin/patchelf" --version \
        > .lpm-patchelf-version

    grep -Fxq "patchelf ${VERSION}" .lpm-patchelf-version
    rm -f .lpm-patchelf-version

    install -Dm644 COPYING \
        "$pkgdir/usr/share/licenses/$NAME/COPYING"
}




# Final audited source digests
SHA256SUMS=("78cb26bda2b89fababfe189c2f6507240340f1aa45dec2eb49a39473a50ceea1")
