# LPM build script for libxt
NAME="libxt"
VERSION="1.3.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="X11 toolkit intrinsics library"
URL="https://www.x.org/"
LICENSE="MIT"
SOURCE=("https://xorg.freedesktop.org/archive/individual/lib/libXt-${VERSION}.tar.xz")
CHECKSUMS=("e0a774b33324f4d4c05b199ea45050f87206586d81655f8bef4dba434d931288")
REQUIRES=("glibc" "libice" "libsm" "libX11" "xorgproto")
PROVIDES=("libxt")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() { set -euxo pipefail; cd "$SRCROOT"; }

build() {
  set -euxo pipefail
  cd "$SRCROOT"
  ./configure --prefix=/usr --sysconfdir=/etc --disable-static
  make -j"$(nproc)"
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT"
  make DESTDIR="$pkgdir" install
}




# Final audited source digests
SHA256SUMS=("e0a774b33324f4d4c05b199ea45050f87206586d81655f8bef4dba434d931288")
