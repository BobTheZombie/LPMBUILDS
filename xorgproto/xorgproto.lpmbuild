# LPM build script for xorgproto
NAME="xorgproto"
VERSION="2025.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Combined X.Org X11 Protocol headers"
URL="https://www.x.org/"
LICENSE="MIT"
SOURCE=("https://xorg.freedesktop.org/archive/individual/proto/xorgproto-${VERSION}.tar.xz")
CHECKSUMS=("56898c716c0578df8a2d828c9c3e5c528277705c0484381a81960fe1a67668e8")
REQUIRES=("glibc" "util-macros")
PROVIDES=("xorgproto")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$NAME-$VERSION"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$NAME-$VERSION"
  ./configure --prefix=/usr
  make -j"$(nproc)"
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$NAME-$VERSION"
  make DESTDIR="$pkgdir" install
}




# Final audited source digests
SHA256SUMS=("56898c716c0578df8a2d828c9c3e5c528277705c0484381a81960fe1a67668e8")
