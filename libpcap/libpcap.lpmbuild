#!/bin/bash
# LPM Linux: libpcap for KSysGuard per-application network accounting.
NAME="libpcap"
VERSION="1.10.7"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Low-level packet capture library and headers"
URL="https://www.tcpdump.org/"
LICENSE=("BSD-3-Clause")
SOURCE=("https://www.tcpdump.org/release/libpcap-${VERSION}.tar.gz")
SHA256SUMS=("0b394ac90dbc0a9838ff97468e05c9c9a3e873dec2514cd58db65d859d296e31")
PATCHES=()
REQUIRES=("glibc" "libnl")
BUILD_REQUIRES=("gcc" "make" "pkgconf" "libnl")
REQUIRES_PYTHON_DEPENDENCIES=()
PROVIDES=("libpcap.so")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euxo pipefail
    test -x "$SRCROOT/${NAME}-${VERSION}/configure"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    ./configure --prefix=/usr --libdir=/usr/lib
    # Upstream's install target otherwise installs the static archive too.
    sed -i '/INSTALL_DATA.*libpcap\.a\|RANLIB.*libpcap\.a/ s/^/#/' Makefile
    make -j "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    make DESTDIR="$pkgdir" install
    test -f "$pkgdir/usr/include/pcap.h"
    test -e "$pkgdir/usr/lib/libpcap.so"
    test -x "$pkgdir/usr/bin/pcap-config"
}
