#!/bin/bash
# LPM build script for budgie-desktop-view
# Notes:
# - These are "git+" lpmbuilds (Arch-style) so you are not blocked by the lack of stable 10.10 tarball releases.
# - If you want to pin to a specific tag/commit, change SOURCE to e.g.:
#     SOURCE=("git+https://github.com/BuddiesOfBudgie/budgie-desktop.git#tag=10.10-preview.1")
#   or:
#     SOURCE=("git+https://github.com/BuddiesOfBudgie/budgie-desktop.git#commit=<sha>")
# - If your LPM git fetcher uses a different fragment syntax, adjust accordingly.
#

NAME="budgie-desktop-view"
VERSION="10.10"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Budgie Desktop View (desktop icons implementation)"
URL="https://github.com/BuddiesOfBudgie/budgie-desktop-view"
LICENSE=("Apache-2.0")

SOURCE=(
  "git+https://github.com/BuddiesOfBudgie/budgie-desktop-view.git"
)

REQUIRES=(
  "glibc"
  "glib2"
  "gtk3"
  "gdk-pixbuf2"
  "pango"
  "cairo"
  "libX11"
  "libxcb"
  "libxkbcommon"
)

PROVIDES=("budgie-desktop-view")
CONFLICTS=()
OBSOLETES=()

_srcdir="budgie-desktop-view"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  mkdir -p build
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  : "${CC:=cc}"
  : "${CXX:=c++}"

  meson setup build \
    --prefix=/usr \
    --libdir=lib \
    --buildtype=release \
    -Ddefault_library=shared
  ninja -C build
}

check() { true; }

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  DESTDIR="$pkgdir" ninja -C build install

  if [ -f LICENSE ]; then
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$NAME/LICENSE"
  fi

  if command -v strip >/dev/null 2>&1; then
    find "$pkgdir/usr" -type f -exec sh -c '
      case "$(file -b "$1")" in
        *ELF*executable*|*ELF*shared\ object*) strip --strip-unneeded "$1" 2>/dev/null || true ;;
      esac
    ' _ {} \;
  fi
}
