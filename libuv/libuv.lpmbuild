NAME="libuv"
VERSION="1.53.0"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Multi-platform support library with a focus on asynchronous I/O"
URL="https://libuv.org/"
SOURCE=("https://dist.libuv.org/dist/v${VERSION}/libuv-v${VERSION}.tar.gz")
LICENSE=("MIT")

REQUIRES=("glibc" "gcc-libs" "autoconf" "automake" "libtool" "m4")
PROVIDES=("libuv" "libuv.so")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/libuv-$VERSION"
    
    # Disable tests that fail on build.a.o (but pass locally)
    sed -e '/udp_multicast_join/d' \
        -e '/tcp_connect6_link_local/d' \
        -i test/test-list.h

    ./autogen.sh
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/libuv-$VERSION"
    ./configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --disable-static
    make -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/libuv-$VERSION"
    make DESTDIR="$pkgdir" install
}





# Final audited source digests
SHA256SUMS=("cb0d6dd2128d5a95bd242c6cc982a24fe608fa93da57b6b4ec763b0018c53e64")
