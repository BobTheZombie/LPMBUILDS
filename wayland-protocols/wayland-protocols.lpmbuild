#!/bin/bash
# LPM Linux - Wayland Protocols 1.49 (required by KWin 6.8.1)
NAME="wayland-protocols"
VERSION="1.49"
RELEASE="1"
ARCH="noarch"
SUMMARY="Stable and staging Wayland protocol XML definitions"
URL="https://gitlab.freedesktop.org/wayland/wayland-protocols"
LICENSE=("MIT")
SOURCE=("https://gitlab.freedesktop.org/wayland/wayland-protocols/-/releases/${VERSION}/downloads/wayland-protocols-${VERSION}.tar.xz")
SHA256SUMS=("ec4c8f74942d6dff7ace8b4ce4764f0ef9ff618a935d974ea77edee2ad240b14")
PATCHES=()
REQUIRES=()
BUILD_REQUIRES=("meson" "ninja" "pkgconf")
PROVIDES=()
CONFLICTS=()
OBSOLETES=()
BUILD_OPTIONS=()

prepare() {
    set -euxo pipefail
    test -f "$SRCROOT/${NAME}-${VERSION}/meson.build"
}

build() {
    set -euxo pipefail
    local src="$SRCROOT/${NAME}-${VERSION}"
    local builddir="$src/build"
    meson setup "$builddir" "$src" \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        --wrap-mode=nodownload \
        -Dtests=false
    meson compile -C "$builddir" -j "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    local builddir="$SRCROOT/${NAME}-${VERSION}/build"
    test -n "${pkgdir:-}" && test "$pkgdir" != "/"
    meson install -C "$builddir" --no-rebuild --destdir "$pkgdir"
    test -f "$pkgdir/usr/lib/pkgconfig/wayland-protocols.pc" || \
        test -f "$pkgdir/usr/share/pkgconfig/wayland-protocols.pc"
    test -f "$pkgdir/usr/share/wayland-protocols/stable/xdg-shell/xdg-shell.xml"
    test -f "$pkgdir/usr/share/wayland-protocols/staging/color-management/color-management-v1.xml"
}
