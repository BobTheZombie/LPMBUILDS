# LPM build script for libogg
NAME="libogg"
VERSION="1.3.6"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Ogg bitstream library"
URL="https://xiph.org/ogg/"
LICENSE="BSD"
SOURCE=("https://downloads.xiph.org/releases/ogg/libogg-${VERSION}.tar.xz")
CHECKSUMS=("5c8253428e181840cd20d41f3ca16557a9cc04bad4a3d04cce84808677fa1061")
REQUIRES=("glibc")
PROVIDES=("libogg")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() { 
  set -euxo pipefail
  cd "$SRCROOT/${NAME}-${VERSION}"
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/${NAME}-${VERSION}"
  ./configure --prefix=/usr --sysconfdir=/etc --disable-static
  make -j"$(nproc)"
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/${NAME}-${VERSION}"
  make DESTDIR="$pkgdir" install
}




# Final audited source digests
SHA256SUMS=("5c8253428e181840cd20d41f3ca16557a9cc04bad4a3d04cce84808677fa1061")
