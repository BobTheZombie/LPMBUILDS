#!/bin/bash
# LPM build script for qt6-wayland

NAME="qt6-wayland"
VERSION="6.7.2"
RELEASE="2"
ARCH="${ARCH:-x86_64}"
SUMMARY="Qt 6 Wayland platform plugin and compositor APIs"
URL="https://www.qt.io/"
LICENSE=("GPL-3.0-only" "LGPL-3.0-only" "GPL-2.0-only")

SOURCE=(
  "https://download.qt.io/archive/qt/6.7/${VERSION}/submodules/qtwayland-everywhere-src-${VERSION}.tar.xz"
)

SHA256SUMS=("SKIP")

REQUIRES=(
  "glibc"
  "qt6-base"
  "qt6-declarative"
  "wayland"
  "libxkbcommon"
  "mesa"
)

BUILD_REQUIRES=(
  "cmake"
  "ninja"
  "perl"
  "python"
  "pkgconf"
  "qt6-base"
  "qt6-declarative"
  "wayland"
  "wayland-protocols"
  "libxkbcommon"
  "mesa"
)

PROVIDES=(
  "qt6-wayland"
  "Qt6WaylandClient"
  "Qt6WaylandCompositor"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"

  rm -rf build
  mkdir -p build
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir/build"

   qt-configure-module .. -- \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=ON \
    -DQT_BUILD_EXAMPLES=OFF \
    -DQT_BUILD_TESTS=OFF

  ninja
}

check() {
  true
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir/build"

  DESTDIR="$pkgdir" ninja install

  for f in LICENSES/* LICENSE*; do
    if [ -f "$SRCROOT/$_srcdir/$f" ]; then
      install -Dm644 "$SRCROOT/$_srcdir/$f" \
        "$pkgdir/usr/share/licenses/$NAME/$(basename "$f")"
    fi
  done
}