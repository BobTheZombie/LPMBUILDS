#!/bin/bash
# LPM build script for font-alias

NAME="font-alias"
VERSION="1.0.5"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="X.Org font aliases"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=(
  "https://www.x.org/releases/individual/font/font-alias-${VERSION}.tar.xz"
)

REQUIRES=(
  "glibc"
  "font-util"
  "encodings"
)

PROVIDES=("font-alias")
CONFLICTS=()
OBSOLETES=()

_srcdir="font-alias-${VERSION}"

prepare() {
    set -euxo pipefail
    cd "$SRCROOT"
    tar xf "font-alias-${VERSION}.tar.xz"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    ./configure --prefix=/usr
    make -j"$(nproc)"
}

check() {
    true
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    DESTDIR="$pkgdir" make install

    if [ -f COPYING ]; then
        install -Dm644 COPYING "$pkgdir/usr/share/licenses/$NAME/COPYING"
    fi
}
