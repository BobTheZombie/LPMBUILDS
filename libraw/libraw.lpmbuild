#!/bin/bash
# LPM Linux - LibRaw camera RAW decoder (Autotools source distribution)
NAME="libraw"
VERSION="0.22.3"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Library for reading digital camera RAW files"
URL="https://www.libraw.org/"
LICENSE=("LGPL-2.1-only" "CDDL-1.0")
SOURCE=("https://www.libraw.org/data/LibRaw-${VERSION}.tar.gz")
SHA256SUMS=("SKIP") # Pin verified upstream release archive SHA-256 for production
PATCHES=()
REQUIRES=("glibc" "gcc-libs" "zlib" "libjpeg" "lcms2")
BUILD_REQUIRES=("gcc" "make" "pkgconf" "zlib" "libjpeg" "lcms2")
PROVIDES=("LibRaw")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() {
    set -euo pipefail
}

build() {
    set -euxo pipefail
    local src="${SRCROOT}/${NAME}-${VERSION}"
    # Build outside the unpacked source if supported by Autotools.
    mkdir -p "$src/build"
    cd "$src/build"
    ../configure \
        --prefix=/usr \
        --libdir=/usr/lib \
        --enable-shared \
        --disable-static \
        --enable-lcms \
        --disable-examples
    make -j "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    local src="${SRCROOT}/${NAME}-${VERSION}"
    make -C "$src/build" DESTDIR="${pkgdir:?}" install
    test -f "$pkgdir/usr/include/libraw/libraw.h"
    test -f "$pkgdir/usr/lib/pkgconfig/libraw.pc"
    find "$pkgdir/usr/lib" -maxdepth 1 -name 'libraw.so*' -print -quit | grep -q .
}
