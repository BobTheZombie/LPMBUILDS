#!/bin/bash
# LPM Linux: prebuilt upstream PySide6 wheels + CMake development-file bridges.
# Target: x86_64 glibc >= 2.34, CPython 3.10+ (abi3 wheels), Qt 6.12.x.
# The bundled Qt libraries remain private to the PySide6 Python package.

NAME="pyside6"
VERSION="6.12.0"
RELEASE="1"
ARCH="x86_64"

SUMMARY="Official Qt for Python 6.12 binary wheels with discoverable CMake configs"
URL="https://doc.qt.io/qtforpython-6/"
LICENSE=("LGPL-3.0-only" "GPL-3.0-only")

# PyPI wheels are selected/downloaded during prepare() for this interpreter.
# No sdist exists for PySide6 6.12.0 on PyPI.
SOURCE=()
SHA256SUMS=()
PATCHES=()

REQUIRES=("python>=3.10" "glibc")
BUILD_REQUIRES=("python>=3.10")
PROVIDES=(
    "pyside6"
    "python-pyside6"
    "python-shiboken6"
    "pypi(pyside6)"
    "pypi(pyside6-essentials)"
    "pypi(pyside6-addons)"
    "pypi(pyside6-webengine)"
    "pypi(pyside6-pdf)"
    "pypi(shiboken6)"
)
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

# Explicitly use Python's current pip; do not invoke LPM's sdist-only pip path.
_lpm_py() {
    command -v python3 >/dev/null 2>&1 || {
        echo "[pyside6] python3 is required" >&2; return 1;
    }
    python3 "$@"
}

_wheel_dir() {
    printf '%s\n' "$SRCROOT/pyside6-wheels"
}

prepare() {
    set -euo pipefail
    test "$(uname -m)" = "x86_64" || {
        echo "[pyside6] this wheel recipe supports x86_64 only" >&2; return 1;
    }
    _lpm_py -c 'import sys; assert sys.version_info >= (3,10), "Python >= 3.10 required"'
    _lpm_py -m pip --version

    local wheels
    wheels="$(_wheel_dir)"
    mkdir -p "$wheels"
    # Includes essentials, addons, PDF, WebEngine, and Shiboken. Download
    # wheels only; force a consistent, exact PySide6 version.
    _lpm_py -m pip download \
        --only-binary=:all: \
        --dest "$wheels" \
        --disable-pip-version-check \
        --progress-bar off \
        "PySide6==${VERSION}"

    # Reject unexpected source archives and incomplete downloads.
    test -n "$(find "$wheels" -maxdepth 1 -type f -name 'pyside6_essentials-*.whl' -print -quit)" || {
        echo "[pyside6] PySide6_Essentials wheel missing" >&2; return 1;
    }
    test -n "$(find "$wheels" -maxdepth 1 -type f -name 'shiboken6-*.whl' -print -quit)" || {
        echo "[pyside6] Shiboken6 wheel missing" >&2; return 1;
    }
}

build() {
    # Precompiled binaries: intentionally no C++ compilation.
    true
}

check() {
    # The staged artifacts and their CMake configs are checked in staging().
    true
}

# Create a forwarding CMake package in /usr/lib/cmake/NAME without moving
# wheel-provided config files or targets. CMake executes the real package
# config *in place* inside site-packages, preserving its relative paths.
# A relative wrapper path also works in DESTDIR before installation.
_install_cmake_bridge() {
    local cmake_name="$1" python_name="$2" wheel_cfg dir rel target
    local -a found=()

    mapfile -t found < <(find "$pkgdir/usr" -type f \
        -path "*/site-packages/${python_name}/lib/cmake/${cmake_name}/${cmake_name}Config.cmake" \
        -print | sort)

    if ((${#found[@]} != 1)); then
        printf '[pyside6] expected exactly one %sConfig.cmake in staged wheel, found %d\n' \
            "$cmake_name" "${#found[@]}" >&2
        return 1
    fi

    wheel_cfg="${found[0]}"
    dir="$(dirname "$wheel_cfg")"
    rel="${wheel_cfg#"$pkgdir/usr/"}"
    target="$pkgdir/usr/lib/cmake/$cmake_name"

    test -f "$dir/${cmake_name}ConfigVersion.cmake" || {
        echo "[pyside6] missing wheel CMake version config for $cmake_name" >&2
        return 1
    }

    install -dm755 "$target"
    cat > "$target/${cmake_name}Config.cmake" <<EOF_CMAKE
# LPM wheel-backed ${cmake_name} config, generated by pyside6.lpmbuild.
# Do not move the original wheel CMake exports: their paths are relocatable
# relative to the directory below.
get_filename_component(_LPM_${cmake_name}_USR_ROOT "\${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
include("\${_LPM_${cmake_name}_USR_ROOT}/${rel}")
unset(_LPM_${cmake_name}_USR_ROOT)
EOF_CMAKE
    install -m644 "$dir/${cmake_name}ConfigVersion.cmake" \
        "$target/${cmake_name}ConfigVersion.cmake"
}

staging() {
    set -euo pipefail
    : "${pkgdir:?LPM pkgdir not set}"
    : "${SRCROOT:?LPM SRCROOT not set}"
    local wheels
    wheels="$(_wheel_dir)"
    test -d "$wheels"
    install -dm755 "$pkgdir/usr"

    # Stage all six official wheel distributions as one LPM-owned package.
    # --root and --prefix prevent writing to the live chroot.
    _lpm_py -m pip install \
        --no-index --find-links "$wheels" \
        --only-binary=:all: \
        --no-compile --no-deps --ignore-installed \
        --root "$pkgdir" --prefix /usr \
        --disable-pip-version-check \
        "PySide6==${VERSION}" \
        "PySide6_Essentials==${VERSION}" \
        "PySide6_Addons==${VERSION}" \
        "PySide6_WebEngine==${VERSION}.140" \
        "PySide6_Pdf==${VERSION}.140" \
        "shiboken6==${VERSION}"

    # The wheel CMake packages live inside the Python installation, so
    # place tiny discoverable forwarding configs in the standard location.
    _install_cmake_bridge "PySide6" "PySide6"
    _install_cmake_bridge "Shiboken6" "shiboken6"

    # Avoid a second copy of Qt under /usr/lib; the wheel owns its private
    # Qt/lib, Qt/plugins and QML trees within site-packages/PySide6/Qt.
    test -n "$(find "$pkgdir/usr" -path '*/site-packages/PySide6/QtCore.abi3.so' -print -quit)" || {
        echo "[pyside6] QtCore.abi3.so missing from staged wheels" >&2; return 1;
    }
    test -f "$pkgdir/usr/lib/cmake/PySide6/PySide6Config.cmake"
    test -f "$pkgdir/usr/lib/cmake/Shiboken6/Shiboken6Config.cmake"
}
