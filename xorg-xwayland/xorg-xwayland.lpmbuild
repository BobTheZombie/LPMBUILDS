#!/bin/bash
# LPM build script for Xwayland
# LPM always extracts to: $SRCROOT/$NAME-$VERSION
NAME="xorg-xwayland"
VERSION="24.1.14"
RELEASE="2"
ARCH="${ARCH:-x86_64}"

SUMMARY="Xwayland X server for Wayland-only desktops"
URL="https://www.x.org/wiki/"
LICENSE=("MIT")

SOURCE=("https://www.x.org/pub/individual/xserver/xwayland-${VERSION}.tar.xz")
SHA256SUMS=("SKIP")
PATCHES=()

REQUIRES=(
    "libei"
    "libxcvt"
    "libepoxy"
    "libxfont2"
    "libxshmfence"
    "libdrm"
    "mesa"
    "wayland"
    "pixman"
    "libglvnd"
)

BUILD_REQUIRES=(
    "meson"
    "ninja"
    "pkgconf"
    "wayland-protocols"
    "xorgproto"
    "xtrans"
    "libxkbfile"
)

PROVIDES=("xorg-xwayland")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

_srcdir() {
    # LPM normalizes the extracted directory using NAME, not archive basename.
    printf '%s\n' "${SRCROOT:?SRCROOT must be defined}/${NAME}-${VERSION}"
}

prepare() {
    set -euo pipefail
    local src
    src="$(_srcdir)"

    if [[ ! -f "$src/meson.build" ]]; then
        echo "[ERROR] Missing $src/meson.build" >&2
        return 1
    fi
}

build() {
    set -euxo pipefail
    local src builddir
    src="$(_srcdir)"
    builddir="$src/build-lpm"

    meson setup "$builddir" "$src" \
        --prefix=/usr \
        --libdir=lib \
        --buildtype=release \
        -Dxkb_output_dir=/var/lib/xkb \
        -Dsecure-rpc=false

    meson compile -C "$builddir" \
        -j "${LPM_BUILD_JOBS:-$(nproc)}"
}

staging() {
    set -euxo pipefail
    local src builddir
    src="$(_srcdir)"
    builddir="$src/build-lpm"

    DESTDIR="${pkgdir:?pkgdir must be defined}" meson install -C "$builddir"

    test -x "$pkgdir/usr/bin/Xwayland"
}