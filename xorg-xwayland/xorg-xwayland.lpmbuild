#!/bin/bash
# LPM source recipe - staged installation only; review build features before use.
NAME="xorg-xwayland"
VERSION="24.1.14"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Xwayland X server for Wayland-only desktops"
URL="https://www.x.org/wiki/"
LICENSE=("MIT")
SOURCE=("https://www.x.org/pub/individual/xserver/xwayland-${VERSION}.tar.xz")
SHA256SUMS=("SKIP")
PATCHES=()
REQUIRES=(
    "libei"
    "libxcvt"
    "libepoxy"
    "libxfont2"
    "libxshmfence"
    "libdrm"
    "mesa"
    "wayland"
    "pixman"
    "libglvnd"
)
BUILD_REQUIRES=(
    "meson"
    "ninja"
    "pkgconf"
    "wayland-protocols"
    "xorgproto"
    "xtrans"
    "libxkbfile"
)
PROVIDES=("xorg-xwayland")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

_srcdir() {
    local d="$SRCROOT/xwayland-${VERSION}"
    test -d "$d" || { printf 'Expected source directory not found: %s\n' "$d" >&2; return 1; }
    printf '%s\n' "$d"
}

prepare() {
    set -euo pipefail
    test -d "$(_srcdir)"
}

build() {
    set -euo pipefail
    local src
    src="$(_srcdir)"
    meson setup "$src/build-lpm" "$src" --prefix=/usr --libdir=lib --buildtype=release \
        -D xkb_output_dir=/var/lib/xkb
    ninja -C "$src/build-lpm"
}

staging() {
    set -euo pipefail
    local src
    src="$(_srcdir)"
    DESTDIR="$pkgdir" ninja -C "$src/build-lpm" install
    test -e "$pkgdir/usr/bin/Xwayland"
}
