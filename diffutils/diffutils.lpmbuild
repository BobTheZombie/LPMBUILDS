#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="diffutils"
VERSION="3.12"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="GNU diff utilities"
URL="https://ftpmirror.gnu.org/diffutils/diffutils-3.12.tar.xz"
LICENSE=("GPL-3.0-or-later")
SOURCE=("https://ftpmirror.gnu.org/diffutils/diffutils-3.12.tar.xz")
SHA256SUMS=("7c8b7f9fc8609141fdea9cece85249d308624391ff61dedaf528fcb337727dfd")
PATCHES=()
REQUIRES=("glibc")
BUILD_REQUIRES=("gcc" "make" "pkgconf")
PROVIDES=("diffutils")
CONFLICTS=()
OBSOLETES=()

_srcdir="diffutils-3.12"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    :
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    ./configure --prefix=/usr
    make -j"${JOBS:-$(nproc)}"
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    make DESTDIR="$pkgdir" install

    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
