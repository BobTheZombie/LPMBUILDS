NAME="diffutils"
VERSION="3.12"
RELEASE="1"
ARCH="x86_64"
SUMMARY="GNU diff utilities"
URL="https://www.gnu.org/software/diffutils/"
SOURCE=("https://ftp.wayne.edu/gnu/diffutils/diffutils-${VERSION}.tar.xz")
LICENSE=("GPL-3.0-or-later")

REQUIRES=("glibc")
PROVIDES=("diffutils" "diff" "cmp" "sdiff")
CONFLICTS=()
OBSOLETES=()

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/diffutils-${VERSION}"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/diffutils-${VERSION}"
    ./configure --prefix=/usr --libdir=/usr/lib
    make -j"$(nproc)"
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/diffutils-${VERSION}"
    make DESTDIR="$pkgdir" install
}





# Final audited source digests
SHA256SUMS=("7c8b7f9fc8609141fdea9cece85249d308624391ff61dedaf528fcb337727dfd")
