#!/bin/bash
# LPM build script for font-bh-type1

NAME="font-bh-type1"
VERSION="1.0.4"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Lucidux (Bigelow and Holmes) Type1 fonts for X.Org"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=(
  "https://www.x.org/releases/individual/font/font-bh-type1-${VERSION}.tar.xz"
)

REQUIRES=(
  "glibc"
  "font-util"
  "encodings"
)

PROVIDES=("font-bh-type1")
CONFLICTS=()
OBSOLETES=()

_srcdir="font-bh-type1-${VERSION}"

prepare() {
    set -euxo pipefail
    cd "$SRCROOT"
    tar xf "font-bh-type1-${VERSION}.tar.xz"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    ./configure --prefix=/usr
    make -j"$(nproc)"
}

check() {
    true
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    DESTDIR="$pkgdir" make install

    if [ -f COPYING ]; then
        install -Dm644 COPYING "$pkgdir/usr/share/licenses/$NAME/COPYING"
    fi
}
