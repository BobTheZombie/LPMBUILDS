#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="python-markupsafe"
VERSION="3.0.3"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="MarkupSafe"
URL="https://pypi.org/packages/source/M/MarkupSafe/markupsafe-3.0.3.tar.gz"
LICENSE=("BSD-3-Clause")
SOURCE=("https://pypi.org/packages/source/M/MarkupSafe/markupsafe-3.0.3.tar.gz")
SHA256SUMS=("722695808f4b6457b320fdc131280796bdceb04ab50fe1795cd540799ebe1698")
PATCHES=()
REQUIRES=("python")
BUILD_REQUIRES=("python" "python-setuptools")
PROVIDES=("python-markupsafe")
CONFLICTS=()
OBSOLETES=()

_srcdir="markupsafe-3.0.3"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    :
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    python3 -m pip wheel --no-cache-dir --no-build-isolation --no-deps --wheel-dir=dist .
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    python3 -m pip install --root="$pkgdir" --prefix=/usr --ignore-installed --no-deps --no-index --no-compile dist/*.whl

    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}

