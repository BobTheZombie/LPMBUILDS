# LPM build script for libxscrnsaver
NAME="libxscrnsaver"
VERSION="1.2.5"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="X11 Screen Saver extension library"
URL="https://www.x.org/"
LICENSE="MIT"
SOURCE=("https://xorg.freedesktop.org/archive/individual/lib/libXScrnSaver-${VERSION}.tar.xz")
CHECKSUMS=("5057365f847253e0e275871441e10ff7846c8322a5d88e1e187d326de1cd8d00")
REQUIRES=("glibc" "libX11" "libXext" "xorgproto")
PROVIDES=("libxscrnsaver")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() { set -euxo pipefail; cd "$SRCROOT"; }

build() {
  set -euxo pipefail
  cd "$SRCROOT"
  ./configure --prefix=/usr --sysconfdir=/etc --disable-static
  make -j"$(nproc)"
}

staging() {
  set -euxo pipefail
  cd "$SRCROOT"
  make DESTDIR="$pkgdir" install
}




# Final audited source digests
SHA256SUMS=("5057365f847253e0e275871441e10ff7846c8322a5d88e1e187d326de1cd8d00")
