#!/bin/bash
NAME="libXi"
VERSION="1.8.4"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="libXi from X.Org"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=(
  "https://xorg.freedesktop.org/archive/individual/lib/${NAME}-${VERSION}.tar.xz"
  
)

REQUIRES=(
  "glibc"
  "libX11"
  "libXfixes"
)

PROVIDES=("libXi")
CONFLICTS=()
OBSOLETES=("libxi")

_srcdir="${NAME}-${VERSION}"

prepare() {
  set -euxo pipefail
}

build() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  ./configure --prefix=/usr
  make -j"$(nproc)"
}

check() { true; }

staging() {
  set -euxo pipefail
  cd "$SRCROOT/$_srcdir"
  DESTDIR="$pkgdir" make install
  [ -f COPYING ] && install -Dm644 COPYING "$pkgdir/usr/share/licenses/$NAME/COPYING"
}




# Final audited source digests
SHA256SUMS=("ddd6057b89a91903bc2f884d55c8467440906945e482c36547260dff28661afc")
