NAME="lz4"
VERSION="1.10.0"
RELEASE="1"
ARCH="x86_64"
SUMMARY="Extremely Fast Compression algorithm"
URL="https://github.com/lz4/lz4"
SOURCE=("https://github.com/lz4/lz4/archive/refs/tags/v${VERSION}.tar.gz")
LICENSE=("BSD-2-Clause" "GPL-2.0-only")

REQUIRES=("glibc")

PROVIDES=(
     "lz4"
      "liblz4.so"
)

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/$NAME-$VERSION"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$NAME-$VERSION"
    make PREFIX=/usr
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$NAME-$VERSION"
    make PREFIX=/usr DESTDIR="$pkgdir" install

    # Ensure library symlinks are present
    if [ -f "$pkgdir/usr/lib/liblz4.so.1" ]; then
        ln -sf liblz4.so.1 "$pkgdir/usr/lib/liblz4.so"
    fi
}





# Final audited source digests
SHA256SUMS=("537512904744b35e232912055ccf8ec66d768639ff3abe5788d90d792ec5f48b")
