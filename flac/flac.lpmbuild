# LPM build script for flac
NAME="flac"
VERSION="1.5.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Free Lossless Audio Codec library and tools"
URL="https://xiph.org/flac/"
LICENSE="BSD"
SOURCE=("https://downloads.xiph.org/releases/flac/flac-${VERSION}.tar.xz")
CHECKSUMS=("f2c1c76592a82ffff8413ba3c4a1299b6c7ab06c734dee03fd88630485c2b920")
REQUIRES=("glibc" "libogg")
PROVIDES=("flac")
CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

prepare() { 
  set -euxo pipefail
  cd "$SRCROOT/${NAME}-${VERSION}"
}

build() {
  set -euxo pipefail
     cd "$SRCROOT/${NAME}-${VERSION}"
  ./configure --prefix=/usr --sysconfdir=/etc --disable-static
  make -j"$(nproc)"
}

staging() {
  set -euxo pipefail
     cd "$SRCROOT/${NAME}-${VERSION}"
  make DESTDIR="$pkgdir" install
}




# Final audited source digests
SHA256SUMS=("f2c1c76592a82ffff8413ba3c4a1299b6c7ab06c734dee03fd88630485c2b920")
