#!/bin/bash
# LPM build script for cosmic-applibrary

NAME="cosmic-applibrary"
VERSION="1.0.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="COSMIC application library / launcher backend"
URL="https://github.com/pop-os/cosmic-applibrary"
LICENSE=("GPL-3.0-or-later")

SOURCE=(
  "git+https://github.com/pop-os/cosmic-applibrary.git#tag=epoch-${VERSION}"
)

# Runtime deps (baseline; adjust per component as you refine)
REQUIRES=(
  "glibc"
  "wayland"
  "libxkbcommon"
  "libinput"
  "libseat"
  "mesa"
  "dbus"
)

# Build deps
REQUIRES+=(
  "rust"
  "cargo"
  "pkg-config"
  "gcc"
)

PROVIDES=(
  "cosmic-applibrary"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="cosmic-applibrary"

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    just build-release --frozen
}

check() {
    true
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"
    just rootdir="${pkgdir}" install
    
}
