#!/bin/bash
# LPM build script for GNU tar

NAME="tar"
VERSION="1.35"
RELEASE="2"
ARCH="${ARCH:-x86_64}"

SUMMARY="GNU archive creation and extraction utility"
URL="https://www.gnu.org/software/tar/"
LICENSE=("GPL-3.0-or-later")

SOURCE=(
    "https://ftp.wayne.edu/gnu/tar/tar-${VERSION}.tar.xz"
)

SHA256SUMS=("SKIP")
PATCHES=()

REQUIRES=(
    "acl"
    "glibc"
)

BUILD_REQUIRES=(
    "make"
)

# GNU tar invokes external programs for compressed archives.
RECOMMENDS=(
    "gzip"
    "bzip2"
    "xz"
    "zstd"
)

PROVIDES=("tar")
CONFLICTS=()
OBSOLETES=()
SUGGESTS=()

BUILD_OPTIONS=(
    "@--stripping"
    "@--optimize=2"
)

prepare() {
    set -euxo pipefail

    cd "$SRCROOT/${NAME}-${VERSION}"

    test -f configure
    test -f Makefile.in
    test -f COPYING
    
    sed -i \
    -e 's/\bacl_get_file_at\b/tar_acl_get_file_at/g' \
    -e 's/\bacl_set_file_at\b/tar_acl_set_file_at/g' \
    -e 's/\bacl_delete_def_file_at\b/tar_acl_delete_def_file_at/g' \
    src/xattrs.c

    make distclean 2>/dev/null || true
}

build() {
    set -euxo pipefail

    cd "$SRCROOT/${NAME}-${VERSION}"

    # Required when configuring as root inside the bootstrap chroot.
    FORCE_UNSAFE_CONFIGURE=1 \
        ./configure \
            --prefix=/usr \
            --bindir=/usr/bin \
            --libexecdir=/usr/libexec \
            --mandir=/usr/share/man \
            --infodir=/usr/share/info \
            --disable-dependency-tracking

    make -j"$(nproc)"
}

check() {
    set -euxo pipefail

    cd "$SRCROOT/${NAME}-${VERSION}"

    test -x src/tar

    local testdir
    testdir="$(mktemp -d "$PWD/.lpm-tar-test.XXXXXX")"

    mkdir -p "$testdir/input" "$testdir/output"

    printf '%s\n' 'LPM GNU tar archive test' \
        > "$testdir/input/example.txt"

    src/tar \
        -cf "$testdir/test.tar" \
        -C "$testdir/input" \
        example.txt

    src/tar \
        -xf "$testdir/test.tar" \
        -C "$testdir/output"

    cmp \
        "$testdir/input/example.txt" \
        "$testdir/output/example.txt"

    rm -rf "$testdir"
}

staging() {
    set -euxo pipefail

    cd "$SRCROOT/${NAME}-${VERSION}"

    make DESTDIR="$pkgdir" install

    # The global Info index is generated separately.
    rm -f "$pkgdir/usr/share/info/dir"

    test -x "$pkgdir/usr/bin/tar"

    local version_output
    version_output="$("$pkgdir/usr/bin/tar" --version)"

    case "$version_output" in
        "tar (GNU tar) ${VERSION}"$'\n'*)
            ;;
        *)
            echo "[ERROR] Unexpected staged tar version: $version_output" >&2
            return 1
            ;;
    esac

    local info_file
    info_file="$(
        find "$pkgdir/usr/share/info" \
            -maxdepth 1 \
            -type f \
            -name 'tar.info*' \
            -print \
            -quit
    )"

    if [ -z "$info_file" ]; then
        echo "[ERROR] Missing GNU tar Info documentation" >&2
        return 1
    fi

    install -Dm644 \
        COPYING \
        "$pkgdir/usr/share/licenses/$NAME/COPYING"
}




# Final audited source digests
SHA256SUMS=("4d62ff37342ec7aed748535323930c7cf94acf71c3591882b26a7ea50f3edc16")
