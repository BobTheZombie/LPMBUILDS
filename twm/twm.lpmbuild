#!/bin/bash
# LPM build script for twm
# Tom's Window Manager (classic X.Org window manager)

NAME="twm"
VERSION="1.0.13.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="Tom's Window Manager for the X Window System"
URL="https://www.x.org/"
LICENSE="MIT"

SOURCE=(
  "https://www.x.org/releases/individual/app/twm-${VERSION}.tar.xz"
)

REQUIRES=(
  "glibc"
  "libX11"
  "libXext"
  "libXmu"
  "libXt"
  "xbitmaps"
  "xorgproto"
  "util-macros"
  "pkg-config"
  "make"
  "autoconf"
  "automake"
  "libtool"
)

PROVIDES=(
  "twm"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="twm-${VERSION}"

prepare() {
    set -euxo pipefail
    cd "$SRCROOT"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    ./configure \
        --prefix=/usr \
        --sysconfdir=/etc \
        --libdir=/usr/lib

    make -j"$(nproc)"
}

check() {
    # No need to run tests for this tiny app
    true
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    DESTDIR="$pkgdir" make install

    # Config example (global system.twmrc if present)
    if [ -f system.twmrc ]; then
        install -Dm644 system.twmrc "$pkgdir/etc/X11/twm/system.twmrc"
    fi

    # License / docs
    if [ -f COPYING ]; then
        install -Dm644 COPYING "$pkgdir/usr/share/licenses/$NAME/COPYING"
    fi
    if [ -f README ]; then
        install -Dm644 README "$pkgdir/usr/share/doc/$NAME/README"
    fi

    # Strip ELF
    if command -v strip >/dev/null 2>&1; then
        find "$pkgdir/usr" -type f -exec sh -c '
            case "$(file -b "$1")" in
              *ELF*executable*|*ELF*shared\ object*)
                  strip --strip-unneeded "$1" 2>/dev/null || true
              ;;
            esac
        ' _ {} \;
    fi
}

