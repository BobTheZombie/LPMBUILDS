#!/bin/bash
NAME="xdg-user-dirs-gtk"
VERSION="0.16"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="xdg-user-dirs-gtk upstream package"
URL="https://download.gnome.org/sources/xdg-user-dirs-gtk/0.16/"
LICENSE=("GPL-2.0-or-later")
SOURCE=("https://download.gnome.org/sources/xdg-user-dirs-gtk/0.16/xdg-user-dirs-gtk-0.16.tar.xz")
SHA256SUMS=("be825de7f89175db5ead0cd3744d2761109c70943251a87092259163025520a9")
PATCHES=()
REQUIRES=("glib2" "gtk3" "xdg-user-dirs")
BUILD_REQUIRES=("gettext" "glib2" "gtk3" "meson" "ninja" "pkgconf")
PROVIDES=("xdg-user-dirs-gtk")
CONFLICTS=()
OBSOLETES=()
BUILD_OPTIONS=("@--stripping" "@--optimize=2")
prepare() { set -euxo pipefail; cd "$SRCROOT/${NAME}-${VERSION}"; }
build() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    meson setup build --prefix=/usr --libdir=lib --buildtype=release --wrap-mode=nodownload 
    meson compile -C build -j "${LPM_BUILD_JOBS:-$(nproc)}"
}
staging() {
    set -euxo pipefail
    cd "$SRCROOT/${NAME}-${VERSION}"
    meson install -C build --no-rebuild --destdir "$pkgdir"
    local f
    for f in COPYING COPYING.LIB LICENSE LICENSE.md LICENSE.txt; do
        if [ -f "$f" ]; then install -Dm644 "$f" "$pkgdir/usr/share/licenses/$NAME/$f"; fi
    done
    if [ -d LICENSES ]; then
        install -dm755 "$pkgdir/usr/share/licenses/$NAME"
        cp -a LICENSES/. "$pkgdir/usr/share/licenses/$NAME/"
    fi
}



# Final audited source digests
SHA256SUMS=("be825de7f89175db5ead0cd3744d2761109c70943251a87092259163025520a9")
