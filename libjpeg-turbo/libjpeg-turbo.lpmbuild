#!/bin/bash
NAME="libjpeg-turbo"
VERSION="3.2.0"
RELEASE="2"
ARCH="any"
SUMMARY="Compatibility dependency on libjpeg"
URL="https://gitlab.com/lpm-org/packages"
LICENSE=("MIT")
SOURCE=()
SHA256SUMS=()
PATCHES=()
REQUIRES=("libjpeg")
BUILD_REQUIRES=()
PROVIDES=("libjpeg-turbo")
CONFLICTS=()
OBSOLETES=()
prepare() { true; }
build() { true; }
staging() {
    install -dm755 "$pkgdir/usr/share/doc/$NAME"
    printf '%s\n' 'Compatibility dependency: libjpeg owns the payload.' > "$pkgdir/usr/share/doc/$NAME/README"
}




# Final audited source digests
SHA256SUMS=()
