#!/bin/bash
# LPM build script for GNU MPC

NAME="mpc"
VERSION="1.4.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"

SUMMARY="GNU C library for arbitrary-precision complex arithmetic"
URL="https://www.multiprecision.org/mpc/"
LICENSE=("LGPL-3.0-or-later")

SOURCE=(
    "https://ftp.wayne.edu/gnu/mpc/mpc-${VERSION}.tar.xz"
)

SHA256SUMS=(
    "91204cd32f164bd3b7c992d4a6a8ce6519511aadab30f78b6982d0bf8d73e931"
)

PATCHES=()

REQUIRES=(
    "glibc"
    "gmp"
    "mpfr"
)

BUILD_REQUIRES=(
    "glibc"
    "gmp"
    "make"
    "mpfr"
    "pkgconf"
    "texinfo"
)

PROVIDES=(
    "mpc"
    "libmpc.so"
    "libmpc.so.3"
)

CONFLICTS=()
OBSOLETES=()
RECOMMENDS=()
SUGGESTS=()

BUILD_OPTIONS=(
    "@--stripping"
    "@--optimize=2"
)

prepare() {
    set -euxo pipefail

    SRCDIR="$SRCROOT/${NAME}-${VERSION}"
    BUILDDIR="$SRCDIR/build"

}

build() {
    set -euxo pipefail

    SRCDIR="$SRCROOT/${NAME}-${VERSION}"
    BUILDDIR="$SRCDIR/build"
    
    mkdir -pv $BUILDDIR
    cd "$BUILDDIR"

    ../configure \
        --prefix=/usr \
        --bindir=/usr/bin \
        --libdir=/usr/lib \
        --includedir=/usr/include \
        --datadir=/usr/share \
        --mandir=/usr/share/man \
        --infodir=/usr/share/info \
        --docdir="/usr/share/doc/mpc-${VERSION}" \
        --with-gmp=/usr \
        --with-mpfr=/usr \
        --enable-shared \
        --disable-static

    test -f "$BUILDDIR/libtool"

    #
    # Optimize shared-library linking and eliminate unnecessary DT_NEEDED
    # entries.
    #

    sed -i \
        -e 's/ -shared / -Wl,-O1,--as-needed\0/g' \
        "$BUILDDIR/libtool"

    make -j"$(nproc)"
}

check() {
    set -euxo pipefail

    SRCDIR="$SRCROOT/${NAME}-${VERSION}"
    BUILDDIR="$SRCDIR/build"

    #
    # Do not run MPC's complete test suite during bootstrap package builds.
    #

    LIBMPC="$(
        find "$BUILDDIR/src/.libs" \
            -maxdepth 1 \
            -type f \
            -name 'libmpc.so.*' \
            -print \
            -quit
    )"

    if [ -z "$LIBMPC" ] || [ ! -f "$LIBMPC" ]; then
        echo "[ERROR] Missing build-tree libmpc shared library" >&2
        return 1
    fi

    MPC_HEADER="$BUILDDIR/.lpm-mpc-header"
    MPC_DYNAMIC="$BUILDDIR/.lpm-mpc-dynamic"

    readelf -h "$LIBMPC" > "$MPC_HEADER"
    grep -Fq 'ELF64' "$MPC_HEADER"

    readelf -d "$LIBMPC" > "$MPC_DYNAMIC"

    grep -Fq \
        'Library soname: [libmpc.so.3]' \
        "$MPC_DYNAMIC"

    grep -Fq \
        'libmpfr.so' \
        "$MPC_DYNAMIC"

    grep -Fq \
        'libgmp.so' \
        "$MPC_DYNAMIC"

    rm -f \
        "$MPC_HEADER" \
        "$MPC_DYNAMIC"
}

staging() {
    set -euxo pipefail

    SRCDIR="$SRCROOT/${NAME}-${VERSION}"
    BUILDDIR="$SRCDIR/build"

    make \
        -C "$BUILDDIR" \
        DESTDIR="$pkgdir" \
        install

    #
    # Remove static and Libtool libraries.
    #

    find "$pkgdir/usr/lib" \
        -type f \
        \( -name '*.a' -o -name '*.la' \) \
        -delete

    #
    # Remove the global Info index. It should be maintained by an LPM
    # transaction hook.
    #

    rm -f "$pkgdir/usr/share/info/dir"

    #
    # Validate shared-library compatibility names.
    #

    test -L "$pkgdir/usr/lib/libmpc.so"
    test -e "$pkgdir/usr/lib/libmpc.so.3"

    LIBMPC="$(
        find "$pkgdir/usr/lib" \
            -maxdepth 1 \
            -type f \
            -name 'libmpc.so.3.*' \
            -print \
            -quit
    )"

    if [ -z "$LIBMPC" ] || [ ! -f "$LIBMPC" ]; then
        echo "[ERROR] Missing real libmpc shared library" >&2
        return 1
    fi

    #
    # Validate ELF architecture, SONAME, and library dependencies.
    #

    MPC_HEADER="$SRCDIR/.lpm-mpc-header"
    MPC_DYNAMIC="$SRCDIR/.lpm-mpc-dynamic"

    readelf -h "$LIBMPC" > "$MPC_HEADER"
    grep -Fq 'ELF64' "$MPC_HEADER"

    readelf -d "$LIBMPC" > "$MPC_DYNAMIC"

    grep -Fq \
        'Library soname: [libmpc.so.3]' \
        "$MPC_DYNAMIC"

    grep -Fq \
        'libmpfr.so' \
        "$MPC_DYNAMIC"

    grep -Fq \
        'libgmp.so' \
        "$MPC_DYNAMIC"

    rm -f \
        "$MPC_HEADER" \
        "$MPC_DYNAMIC"

    #
    # Validate the development header.
    #

    test -f "$pkgdir/usr/include/mpc.h"

    grep -Eq \
        '^#define[[:space:]]+MPC_VERSION_MAJOR[[:space:]]+1$' \
        "$pkgdir/usr/include/mpc.h"

    grep -Eq \
        '^#define[[:space:]]+MPC_VERSION_MINOR[[:space:]]+4$' \
        "$pkgdir/usr/include/mpc.h"

    grep -Eq \
        '^#define[[:space:]]+MPC_VERSION_PATCHLEVEL[[:space:]]+1$' \
        "$pkgdir/usr/include/mpc.h"

    #
    # Validate pkg-config metadata when supplied by upstream.
    #

    if [ -f "$pkgdir/usr/lib/pkgconfig/mpc.pc" ]; then
        MPC_PC_VERSION="$(
            PKG_CONFIG_PATH= \
            PKG_CONFIG_LIBDIR="$pkgdir/usr/lib/pkgconfig" \
            pkgconf \
                --modversion \
                mpc
        )"

        if [ "$MPC_PC_VERSION" != "$VERSION" ]; then
            echo "[ERROR] Unexpected MPC pkg-config version: $MPC_PC_VERSION" >&2
            return 1
        fi
    fi

    #
    # Validate Info documentation.
    #

    MPC_INFO="$(
        find "$pkgdir/usr/share/info" \
            -maxdepth 1 \
            -type f \
            -name 'mpc.info*' \
            -print \
            -quit
    )"

    if [ -z "$MPC_INFO" ] || [ ! -f "$MPC_INFO" ]; then
        echo "[ERROR] Missing MPC Info documentation" >&2
        return 1
    fi

    #
    # Install licensing information.
    #

    install -Dm644 \
        "$SRCDIR/COPYING.LESSER" \
        "$pkgdir/usr/share/licenses/$NAME/COPYING.LESSER"
}




# Final audited source digests
SHA256SUMS=("91204cd32f164bd3b7c992d4a6a8ce6519511aadab30f78b6982d0bf8d73e931")
