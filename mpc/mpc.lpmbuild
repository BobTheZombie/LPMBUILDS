#!/bin/bash
# LFS 13.1-systemd baseline; see docs/lfs-13.1.md for patch provenance.
NAME="mpc"
VERSION="1.4.1"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="C library for complex arithmetic"
URL="https://ftpmirror.gnu.org/mpc/mpc-1.4.1.tar.xz"
LICENSE=("GPL-3.0-or-later")
SOURCE=("https://ftpmirror.gnu.org/mpc/mpc-1.4.1.tar.xz")
SHA256SUMS=("91204cd32f164bd3b7c992d4a6a8ce6519511aadab30f78b6982d0bf8d73e931")
PATCHES=()
REQUIRES=("glibc")
BUILD_REQUIRES=("gcc" "make" "pkgconf")
PROVIDES=("mpc")
CONFLICTS=()
OBSOLETES=()

_srcdir="mpc-1.4.1"

prepare() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    :
}

build() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    ./configure --prefix=/usr
    make -j"${JOBS:-$(nproc)}"
}

staging() {
    set -euo pipefail
    cd "$SRCROOT/$_srcdir"
    make DESTDIR="$pkgdir" install

    rm -f "$pkgdir/usr/share/info/dir"
    find "$pkgdir/usr/lib" -name "*.la" -delete 2>/dev/null || true
}
