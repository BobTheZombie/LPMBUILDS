#!/bin/bash
# LPM build script for cosmic-icons

NAME="cosmic-icons"
VERSION="1.0.0"
RELEASE="1"
ARCH="${ARCH:-x86_64}"
SUMMARY="COSMIC icon theme"
URL="https://github.com/pop-os/cosmic-icons"
LICENSE=("GPL-3.0-or-later")

SOURCE=(
  "git+https://github.com/pop-os/cosmic-icons.git"
)

# Runtime deps (baseline; adjust per component as you refine)
REQUIRES=(
  "glibc"
  "wayland"
  "libxkbcommon"
  "libinput"
  "libseat"
  "mesa"
  "dbus"
)

# Build deps
REQUIRES+=(
  "rust"
  "cargo"
  "pkg-config"
  "gcc"
)

PROVIDES=(
  "cosmic-icons"
)

CONFLICTS=()
OBSOLETES=()

_srcdir="cosmic-icons"

prepare() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"
}

build() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

}

check() {
    true
}

staging() {
    set -euxo pipefail
    cd "$SRCROOT/$_srcdir"

    just rootdir="${pkgdir}" install
}
